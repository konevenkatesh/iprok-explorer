  {
    "@id": "_:nf830c23705484f82a43e7a17c4846dbeb300",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "netPayable must equal currentGross minus totalRecoveries (arithmetic integrity check, tolerance ±₹0.01)."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this\n            WHERE {\n                $this <https://w3id.org/iprok/billing#netPayable> ?net ;\n                      <https://w3id.org/iprok/billing#currentGross> ?gross ;\n                      <https://w3id.org/iprok/billing#totalRecoveries> ?rec .\n                FILTER (ABS(?net - ?gross + ?rec) > 0.01)\n            }\n        "
      }
    ]
  },
