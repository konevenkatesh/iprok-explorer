  <rdf:Description rdf:nodeID="nf830c23705484f82a43e7a17c4846dbeb504">
    <rdf:rest rdf:nodeID="nf830c23705484f82a43e7a17c4846dbeb505"/>
    <rdf:first>Aggregate</rdf:first>
