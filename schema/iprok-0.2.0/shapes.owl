  <rdf:Description rdf:nodeID="nf830c23705484f82a43e7a17c4846dbeb300">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
    <sh:select>
            SELECT $this
            WHERE {
                $this &lt;https://w3id.org/iprok/billing#netPayable&gt; ?net ;
                      &lt;https://w3id.org/iprok/billing#currentGross&gt; ?gross ;
                      &lt;https://w3id.org/iprok/billing#totalRecoveries&gt; ?rec .
                FILTER (ABS(?net - ?gross + ?rec) &gt; 0.01)
            }
        </sh:select>
    <sh:message>netPayable must equal currentGross minus totalRecoveries (arithmetic integrity check, tolerance ±₹0.01).</sh:message>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf830c23705484f82a43e7a17c4846dbeb537">
    <sh:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</sh:minInclusive>
