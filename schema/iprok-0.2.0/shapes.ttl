<https://w3id.org/IproK/shapes#MeasurementShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "Measurement must reference exactly one BOQ item (IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/billing#measuredItem> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Measurement must carry a non-negative quantity." ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/billing#quantity> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Measurement must carry a unit." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path integrated:unit ],
        [ sh:maxCount 1 ;
            sh:message "Measurement must point at the User who recorded it (IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/billing#measuredBy> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Measurement must record a measuredAt timestamp." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#measuredAt> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "measurementNo must be a positive integer (>= 1)." ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path <https://w3id.org/IproK/billing#measurementNo> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Optional IFC GUID linking this measurement to a <https://w3id.org/IproK/building#Element>." ;
            sh:path <https://w3id.org/IproK/billing#linkedElement> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Optional Measurement Book page reference." ;
            sh:path <https://w3id.org/IproK/billing#mbPageRef> ],
        [ sh:datatype xsd:boolean ;
