        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path integrated:computedAt ],
        [ sh:maxCount 1 ;
            sh:message "EVMSnapshot must link to its project via <https://w3id.org/IproK/integrated#ofProject>." ;
            sh:minCount 1 ;
