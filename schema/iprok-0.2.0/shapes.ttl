@prefix cost: <https://w3id.org/IproK/cost#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix integrated: <https://w3id.org/IproK/integrated#> .
@prefix iprok: <https://w3id.org/IproK#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix resource: <https://w3id.org/IproK/resource#> .
@prefix schedule: <https://w3id.org/IproK/schedule#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/IproK/shapes#ActivityBudgetShape> a sh:NodeShape ;
    sh:message "A budget share must name the BOQ line it is a share of (<https://w3id.org/IproK/schedule#boqShareOf>)." ;
    sh:or ( [ sh:property [ sh:maxCount 0 ;
                        sh:path schedule:budgetedCost ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schedule:boqShareOf ] ] ) ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path schedule:budgetedCost ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path schedule:budgetedQuantity ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path schedule:boqShareOf ] ;
    sh:targetClass schedule:Activity .

<https://w3id.org/IproK/shapes#ActivityDurationEstimateShape> a sh:NodeShape ;
    sh:message "A measured rate must record how many site observations it rests on." ;
    sh:or ( [ sh:property [ sh:hasValue "seeded" ;
                        sh:path integrated:normSource ] ] [ sh:property [ sh:datatype xsd:integer ;
                        sh:minCount 1 ;
                        sh:minInclusive 1 ;
                        sh:path integrated:observationCount ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path schedule:estimateId ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:forActivity ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path integrated:workType ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path schedule:plannedQuantity ],
        [ sh:maxCount 1 ;
            sh:path integrated:unit ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path schedule:crewCount ],
        [ sh:maxCount 1 ;
            sh:path schedule:crewDescription ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:path integrated:crewSize ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minExclusive 0.0 ;
            sh:path schedule:dailyOutput ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minExclusive 0.0 ;
            sh:path schedule:seededDailyOutput ],
        [ sh:in ( "measured" "seeded" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path integrated:normSource ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path integrated:observationCount ],
        [ sh:datatype xsd:integer ;
            sh:lessThanOrEquals schedule:finalDays ;
            sh:maxCount 1 ;
            sh:message "Allowances only lengthen an activity: base days cannot exceed final days." ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path schedule:baseDays ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path schedule:finalDays ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path schedule:weatherPadPct ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path schedule:labourPadPct ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path schedule:durationBasis ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schedule:estimatedAt ],
        [ sh:maxCount 1 ;
            sh:path schedule:scheduleRevision ] ;
    sh:targetClass schedule:ActivityDurationEstimate .

<https://w3id.org/IproK/shapes#ActivityPredictionShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "ActivityPrediction must link to its <https://w3id.org/IproK/schedule#Activity>." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:forActivity ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:message "delayRisk must be in [0.0, 1.0]." ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path <https://w3id.org/IproK/prediction#delayRisk> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:message "costOverrunRisk must be in [0.0, 1.0]." ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path <https://w3id.org/IproK/prediction#costOverrunRisk> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 30.0 ;
            sh:minInclusive -30.0 ;
            sh:path <https://w3id.org/IproK/prediction#predictedFloatChange> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1.0 ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path <https://w3id.org/IproK/prediction#confidenceScore> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/prediction#modelVersion> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/prediction#predictedAt> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/prediction#ActivityPrediction> .

<https://w3id.org/IproK/shapes#ActivityShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "activityId, when set, is a single string." ;
            sh:path schedule:activityId ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "activityName, when set, is a single string." ;
            sh:path schedule:activityName ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "plannedStart, when set, must be a single xsd:dateTime." ;
            sh:path schedule:activityPlannedStartDate ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "plannedFinish, when set, must be a single xsd:dateTime." ;
            sh:path schedule:activityPlannedFinishDate ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:message "percentComplete, when set, is a single decimal in 0-100." ;
            sh:minInclusive 0 ;
            sh:path schedule:percentComplete ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "isCritical, when set, is a single boolean." ;
            sh:path schedule:isCritical ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "totalFloat, when set, is a single decimal (days)." ;
            sh:path schedule:totalFloat ] ;
    sh:targetClass schedule:Activity .

<https://w3id.org/IproK/shapes#AnalysisAdditionShape> a sh:NodeShape ;
    sh:message "An addition names its analysis, position, label, a percentage from 0 to 100 and its base; only a Cost or Running base can leave out a group of lines." ;
    sh:or ( [ sh:property [ sh:maxCount 0 ;
                        sh:path cost:excludesGroup ] ] [ sh:property [ sh:in ( "Cost" "Running" ) ;
                        sh:path cost:additionBase ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path cost:inAnalysis ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path cost:lineOrder ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 2 ;
            sh:path cost:additionLabel ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path cost:additionPercent ],
        [ sh:in ( "Labour" "Material" "Plant" "Cost" "Running" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cost:additionBase ],
        [ sh:path cost:excludesGroup ;
            sh:pattern "^[A-Z]$" ] ;
    sh:targetClass cost:AnalysisAddition .

<https://w3id.org/IproK/shapes#AnalysisLineShape> a sh:NodeShape ;
    sh:message "An analysis line names its analysis, position, resource, kind and a quantity of zero or more; a group is one capital letter." ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path cost:inAnalysis ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path cost:lineOrder ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cost:resourceCode ],
        [ sh:in ( "gang" "perUnit" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cost:lineKind ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path cost:lineQuantity ],
        [ sh:maxCount 1 ;
            sh:path cost:lineGroup ;
            sh:pattern "^[A-Z]$" ],
        [ sh:maxCount 1 ;
            sh:minLength 1 ;
            sh:path cost:lineNote ] ;
    sh:targetClass cost:AnalysisLine .

<https://w3id.org/IproK/shapes#AnnotationShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "RevisionCloud" "Callout" "Text" "Dimension" "Stamp" ) ;
            sh:maxCount 1 ;
            sh:message "annotationType must be one of RevisionCloud / Callout / Text / Dimension / Stamp." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/document#annotationType> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "Annotation must carry a 1-based pageNumber." ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path <https://w3id.org/IproK/document#pageNumber> ],
        [ sh:datatype xsd:string ;
            sh:message "Annotation must carry geometry (SVG path / coord JSON)." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/document#geometry> ],
        [ sh:maxCount 1 ;
            sh:message "Annotation must point at its drawing (onDrawing, IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/document#onDrawing> ],
        [ sh:maxCount 1 ;
            sh:message "Annotation must record who made it (annotatedBy, IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/document#annotatedBy> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Annotation must record annotatedAt." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/document#annotatedAt> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/document#annotationText> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/document#stampType> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/document#colour> ] ;
    sh:targetClass <https://w3id.org/IproK/document#Annotation> .

<https://w3id.org/IproK/shapes#ApprovalShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Approval must carry an approvalId." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/approval#approvalId> ],
        [ sh:in ( "PlanSanction" "CommencementCertificate" "NALAConversion" "FireNOC" "AirportHeightNOC" "PCBConsent" "EnvironmentalClearance" "WaterSewerageNOC" "ElectricityNOC" "MortgageToULB" "RERARegistration" "APFApproval" "LiftLicence" "FireFinalNOC" "OccupancyCertificate" "CompletionCertificate" ) ;
            sh:maxCount 1 ;
            sh:message "approvalType must be one of the statutory chain types." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/approval#approvalType> ],
        [ sh:in ( "NotStarted" "Preparing" "Submitted" "QueryRound" "Approved" "Rejected" ) ;
            sh:maxCount 1 ;
            sh:message "approvalStatus must be NotStarted / Preparing / Submitted / QueryRound / Approved / Rejected." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/approval#approvalStatus> ],
        [ sh:maxCount 1 ;
            sh:message "Approval must belong to a project." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/approval#slaDays> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/approval#applicationRef> ] ;
    sh:targetClass <https://w3id.org/IproK/approval#Approval> .

<https://w3id.org/IproK/shapes#BOQItemShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "BOQ item must carry an itemCode." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path integrated:itemCode ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "BOQ item must carry a description." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/billing#description> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "BOQ item must carry a unit (e.g. m³, m², m, nos, kg)." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path integrated:unit ],
        [ sh:maxCount 1 ;
            sh:message "BOQ item must point at its parent Project (IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "BOQ item must carry boqItemNo (e.g. '1.1', '2.3.4')." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#boqItemNo> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "BOQ item must carry quotedRate (INR, xsd:decimal)." ;
            sh:minCount 1 ;
            sh:path integrated:quotedRate ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "BOQ item must carry amount = tenderedQty × quotedRate (server-computed)." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#amount> ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "BOQ item must declare isStarRate (xsd:boolean)." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#isStarRate> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/billing#rateFromAnalysis> ] ;
    sh:targetClass <https://w3id.org/IproK/billing#BOQItem> .

<https://w3id.org/IproK/shapes#BaselineEntryShape> a sh:NodeShape ;
    sh:message "A baseline entry names its baseline, the activity it froze, that activity's id and name, a first day no later than its last, a duration of a day or more, and at most one budget of zero or more." ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path schedule:inBaseline ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path schedule:baselineOf ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path schedule:baselineActivityId ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schedule:baselineActivityName ],
        [ sh:datatype xsd:date ;
            sh:lessThanOrEquals schedule:baselineLastDay ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schedule:baselineStart ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schedule:baselineLastDay ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path schedule:baselineDurationDays ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path schedule:baselineCost ] ;
    sh:targetClass schedule:BaselineEntry .

<https://w3id.org/IproK/shapes#BidRecommendationShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/tender#forTender> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#totalQuoted> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#contingencyPct> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#contingencyAmount> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#recommendedBid> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#itemCount> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path integrated:computedAt ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#highRiskCount> ] ;
    sh:targetClass <https://w3id.org/IproK/tender#BidRecommendation> .

<https://w3id.org/IproK/shapes#ChecklistItemShape> a sh:NodeShape ;
    sh:message "A failed checklist item must carry a failureNote." ;
    sh:or ( [ sh:property [ sh:hasValue "pass" ;
                        sh:path <https://w3id.org/IproK/quality#itemResult> ] ] [ sh:property [ sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:minLength 1 ;
                        sh:path <https://w3id.org/IproK/quality#failureNote> ] ] ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "Checklist item must have an itemCode." ;
            sh:minCount 1 ;
            sh:path integrated:itemCode ],
        [ sh:datatype xsd:string ;
            sh:in ( "pass" "fail" ) ;
            sh:maxCount 1 ;
            sh:message "Checklist item result must be 'pass' or 'fail'." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/quality#itemResult> ] ;
    sh:targetClass <https://w3id.org/IproK/quality#ChecklistItem> .

<https://w3id.org/IproK/shapes#ClashBatchShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "ClashBatch must carry a batchId." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/coordination#batchId> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/coordination#importedAt> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/coordination#sourceFile> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/coordination#totalClashes> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/coordination#openClashes> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/coordination#resolvedClashes> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/coordination#closureRate> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/coordination#ClashBatch> .

<https://w3id.org/IproK/shapes#CollectionReceiptShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#receiptId> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/finance#forUnit> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minExclusive 0 ;
            sh:path <https://w3id.org/IproK/finance#receiptAmount> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#receiptDate> ],
        [ sh:in ( "Cheque" "NEFT" "RTGS" "UPI" "Cash" "Other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#receiptMode> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#escrowShare> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#operatingShare> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/finance#CollectionReceipt> .

<https://w3id.org/IproK/shapes#ComparableProjectShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/tender#forTender> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/tender#similarProject> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#similarityScore> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path integrated:computedAt ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#matchedBOQItems> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/tender#avgRateVariance> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#actualCPI> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#deviationCount> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#riskMaterialisedCount> ] ;
    sh:targetClass <https://w3id.org/IproK/tender#ComparableProject> .

<https://w3id.org/IproK/shapes#ConstraintShape> a sh:NodeShape ;
    sh:message "A constraint names its owner, need-by date and activities; clearing or withdrawing it records who and when, and a withdrawal says why." ;
    sh:or ( [ sh:property [ sh:not [ sh:hasValue "Withdrawn" ] ;
                        sh:path iprok:constraintStatus ] ] [ sh:property [ sh:minCount 1 ;
                        sh:minLength 3 ;
                        sh:path integrated:closureNote ] ] ),
        ( [ sh:property [ sh:in ( "Open" ) ;
                        sh:path iprok:constraintStatus ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path integrated:resolvedBy ],
                    [ sh:minCount 1 ;
                        sh:path integrated:resolvedAt ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path iprok:constraintId ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 3 ;
            sh:path iprok:constraintText ],
        [ sh:in ( "PrerequisiteWork" "Information" "Materials" "Labour" "Equipment" "Space" "External" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path iprok:constraintFlow ],
        [ sh:in ( "Open" "Cleared" "Withdrawn" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path iprok:constraintStatus ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path iprok:owner ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path iprok:dueDate ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path iprok:affectsActivity ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:raisedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path integrated:raisedAt ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:resolvedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path integrated:resolvedAt ],
        [ sh:maxCount 1 ;
            sh:path integrated:closureNote ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass schedule:WorkConstraint .

<https://w3id.org/IproK/shapes#CostResourceShape> a sh:NodeShape ;
    sh:message "A basic rate names its code, kind and unit; a priced resource says when and from where the rate came; an imported resource names its source record, edition, code and citation (and the record's version, written on every import since the N40 review; resources imported before it carry none and must stay priceable)." ;
    sh:or ( [ sh:property [ sh:maxCount 0 ;
                        sh:path cost:basicRate ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path cost:rateAsOf ],
                    [ sh:minCount 1 ;
                        sh:path cost:rateSource ] ] ),
        ( [ sh:property [ sh:maxCount 0 ;
                        sh:path cost:importedFrom ] ] [ sh:property [ sh:maxCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:path cost:importedFrom ],
                    [ sh:maxCount 1 ;
                        sh:path cost:importedRecordVersion ;
                        sh:pattern "^sha256:[0-9a-f]{64}$" ],
                    [ sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path cost:importedEdition ],
                    [ sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path cost:importedItemCode ],
                    [ sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:minLength 10 ;
                        sh:path cost:sourceCitation ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cost:resourceCode ;
            sh:pattern "^[A-Z0-9][A-Z0-9._-]{0,39}$" ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 2 ;
            sh:path cost:resourceName ],
        [ sh:in ( "Labour" "Material" "Plant" "Carriage" "Other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cost:resourceKind ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path integrated:unit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path cost:basicRate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path cost:rateAsOf ],
        [ sh:maxCount 1 ;
            sh:minLength 2 ;
            sh:path cost:rateSource ] ;
    sh:targetClass cost:CostResource .

<https://w3id.org/IproK/shapes#CrewCompositionShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path resource:compositionRole ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path resource:compositionCount ],
        [ sh:in ( "Skilled" "SemiSkilled" "Unskilled" ) ;
            sh:maxCount 1 ;
            sh:path resource:skillLevel ] ;
    sh:targetClass resource:CrewComposition .

<https://w3id.org/IproK/shapes#CrewTypeShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path resource:crewTypeId ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path resource:crewTypeName ],
        [ sh:in ( "Masonry" "Concrete" "Reinforcement" "Shuttering" "Finishing" "MEP" "Earthwork" "General" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path resource:crewTrade ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path integrated:crewSize ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofOrganisation ] ;
    sh:targetClass resource:CrewType .

<https://w3id.org/IproK/shapes#DLPDefectShape> a sh:NodeShape ;
    sh:or ( [ sh:property [ sh:not [ sh:hasValue "Rectified" ] ;
                        sh:path <https://w3id.org/IproK/handover#defectStatus> ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path <https://w3id.org/IproK/handover#rectifiedAt> ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/handover#defectId> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path integrated:defectDescription ],
        [ sh:in ( "Reported" "InRepair" "Rectified" "Disputed" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/handover#defectStatus> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path integrated:reportedAt ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/handover#DLPDefect> .

<https://w3id.org/IproK/shapes#DPREntryShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "DPR entry must reference exactly one Activity (IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/reporting#reportedAgainst> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 12 ;
            sh:message "weatherHoursLost must be a decimal from 0 to 12 hours." ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/reporting#weatherHoursLost> ],
        [ sh:datatype xsd:decimal ;
            sh:message "DPR entry must include a non-negative reported quantity." ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/reporting#reportedQuantity> ],
        [ sh:datatype xsd:string ;
            sh:message "DPR entry must specify a unit (e.g. m³, kg, m²)." ;
            sh:minCount 1 ;
            sh:path integrated:unit ],
        [ sh:datatype xsd:dateTime ;
            sh:message "DPR entry must have a reportedAt timestamp." ;
            sh:minCount 1 ;
            sh:path integrated:reportedAt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "If provided, clientId must be a UUID." ;
            sh:path <https://w3id.org/IproK/reporting#clientId> ;
            sh:pattern "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" ],
        [ sh:in ( "Fair" "Cloudy" "LightRain" "HeavyRain" "Waterlogged" "ExtremeHeat" "HighWind" ) ;
            sh:maxCount 1 ;
            sh:message "weatherCondition must be one of Fair, Cloudy, LightRain, HeavyRain, Waterlogged, ExtremeHeat, HighWind." ;
            sh:path <https://w3id.org/IproK/reporting#weatherCondition> ] ;
    sh:targetClass <https://w3id.org/IproK/reporting#DPREntry> .

<https://w3id.org/IproK/shapes#DPRWeatherHoursNeedConditionShape> a sh:NodeShape ;
    sh:message "Hours lost to weather need the weather that caused them (weatherCondition)." ;
    sh:or ( [ sh:maxCount 0 ;
                sh:path <https://w3id.org/IproK/reporting#weatherHoursLost> ] [ sh:minCount 1 ;
                sh:path <https://w3id.org/IproK/reporting#weatherCondition> ] ) ;
    sh:targetClass <https://w3id.org/IproK/reporting#DPREntry> .

<https://w3id.org/IproK/shapes#DPRWeatherHoursNeedStoppingWeatherShape> a sh:NodeShape ;
    sh:message "Fair or cloudy weather costs no working hours — record the rain, waterlogging, heat or wind that did." ;
    sh:or ( [ sh:in ( "LightRain" "HeavyRain" "Waterlogged" "ExtremeHeat" "HighWind" ) ;
                sh:path <https://w3id.org/IproK/reporting#weatherCondition> ] [ sh:maxInclusive 0 ;
                sh:path <https://w3id.org/IproK/reporting#weatherHoursLost> ] ) ;
    sh:targetClass <https://w3id.org/IproK/reporting#DPREntry> .

<https://w3id.org/IproK/shapes#DecisionShape> a sh:NodeShape ;
    sh:message "A decision closed in any way records who, when and what; an open one names who must decide, by when." ;
    sh:or ( [ sh:property [ sh:in ( "Open" ) ;
                        sh:path iprok:decisionStatus ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path iprok:decidedBy ],
                    [ sh:minCount 1 ;
                        sh:path iprok:decidedAt ],
                    [ sh:minCount 1 ;
                        sh:path iprok:decisionText ] ] ),
        ( [ sh:property [ sh:not [ sh:hasValue "Open" ] ;
                        sh:path iprok:decisionStatus ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path iprok:owner ],
                    [ sh:minCount 1 ;
                        sh:path iprok:dueDate ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path iprok:decisionId ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path iprok:decisionQuestion ],
        [ sh:in ( "Open" "Decided" "Superseded" "Withdrawn" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path iprok:decisionStatus ],
        [ sh:maxCount 1 ;
            sh:minLength 1 ;
            sh:path iprok:decisionText ],
        [ sh:maxCount 1 ;
            sh:path iprok:decisionBasis ],
        [ sh:maxCount 1 ;
            sh:path iprok:decisionSource ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path iprok:decidedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path iprok:decidedAt ],
        [ sh:nodeKind sh:IRI ;
            sh:path iprok:affectsActivity ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path iprok:owner ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path iprok:dueDate ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:raisedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path integrated:raisedAt ],
        [ sh:maxCount 1 ;
            sh:path iprok:decisionOptions ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path prov:wasRevisionOf ] ;
    sh:targetClass iprok:Decision .

<https://w3id.org/IproK/shapes#DemandNoteShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#demandId> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/finance#forUnit> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/finance#forMilestone> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minExclusive 0 ;
            sh:path <https://w3id.org/IproK/finance#demandAmount> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#demandDate> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#dueDate2> ],
        [ sh:in ( "Raised" "Cancelled" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#demandStatus> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/finance#DemandNote> .

<https://w3id.org/IproK/shapes#DesignOptionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "DesignOption must carry an optionId." ;
            sh:minCount 1 ;
            sh:path cost:optionId ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "DesignOption must carry an optionTitle." ;
            sh:minCount 1 ;
            sh:path cost:optionTitle ],
        [ sh:in ( "Architecture" "Structure" "MEP" "Finishes" ) ;
            sh:maxCount 1 ;
            sh:message "optionDiscipline must be Architecture / Structure / MEP / Finishes." ;
            sh:minCount 1 ;
            sh:path cost:optionDiscipline ],
        [ sh:in ( "Proposed" "Approved" "Rejected" "Superseded" ) ;
            sh:maxCount 1 ;
            sh:message "optionStatus must be Proposed / Approved / Rejected / Superseded." ;
            sh:minCount 1 ;
            sh:path cost:optionStatus ],
        [ sh:maxCount 1 ;
            sh:message "DesignOption must belong to a project." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path cost:costDeltaAmount ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path cost:timeDeltaDays ],
        [ sh:maxCount 1 ;
            sh:maxInclusive 5 ;
            sh:minInclusive 1 ;
            sh:path cost:qualityRating ],
        [ sh:maxCount 1 ;
            sh:maxInclusive 5 ;
            sh:minInclusive 1 ;
            sh:path cost:maintainabilityRating ],
        [ sh:maxCount 1 ;
            sh:maxInclusive 5 ;
            sh:minInclusive 1 ;
            sh:path cost:userValueRating ],
        [ sh:maxCount 1 ;
            sh:maxInclusive 5 ;
            sh:minInclusive 1 ;
            sh:path cost:flexibilityRating ],
        [ sh:maxCount 1 ;
            sh:maxInclusive 5 ;
            sh:minInclusive 1 ;
            sh:path cost:executionReadinessRating ] ;
    sh:targetClass cost:DesignOption .

<https://w3id.org/IproK/shapes#DeviationShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "Deviation must link to its <https://w3id.org/IproK/billing#BOQItem> via <https://w3id.org/IproK/integrated#forBOQItem>." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:forBOQItem ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Deviation must carry the tendered quantity." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#tenderedQty> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Deviation must carry the measured quantity." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#measuredQty> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Deviation must carry deviationPct." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#deviationPct> ],
        [ sh:in ( "Pending" "ApprovedEE" "ApprovedSE" "ApprovedCE" "Rejected" ) ;
            sh:maxCount 1 ;
            sh:message "Deviation must carry a valid deviationState." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#deviationState> ],
        [ sh:maxCount 1 ;
            sh:message "Deviation must link to its parent RABill via <https://w3id.org/IproK/billing#forBill>." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/billing#forBill> ] ;
    sh:targetClass <https://w3id.org/IproK/billing#Deviation> .

<https://w3id.org/IproK/shapes#DrawingChangeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "Added" "Removed" "Modified" ) ;
            sh:maxCount 1 ;
            sh:message "changeType must be one of Added / Removed / Modified." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/document#changeType> ],
        [ sh:datatype xsd:string ;
            sh:message "DrawingChange must carry a non-empty description." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/document#changeDescription> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "DrawingChange must record detectedAt." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/document#detectedAt> ],
        [ sh:datatype xsd:string ;
            sh:message "DrawingChange must name the model that detected it." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/document#detectedBy> ],
        [ sh:maxCount 1 ;
            sh:message "DrawingChange must point at the (new) drawing (inDrawing, IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/document#inDrawing> ],
        [ sh:maxCount 1 ;
            sh:message "DrawingChange must point at the prior revision (comparedWith, IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/document#comparedWith> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "locationHint, when set, is a single string." ;
            sh:path <https://w3id.org/IproK/document#locationHint> ] ;
    sh:targetClass <https://w3id.org/IproK/document#DrawingChange> .

<https://w3id.org/IproK/shapes#DrawingShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Drawing must carry a project-unique drawingId." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/document#drawingId> ],
        [ sh:datatype xsd:string ;
            sh:message "Drawing must carry a title." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/document#drawingTitle> ],
        [ sh:in ( integrated:WIP integrated:Shared integrated:Published integrated:Archived integrated:Superseded ) ;
            sh:maxCount 1 ;
            sh:message "lifecycleState must be one of <https://w3id.org/IproK/integrated#WIP> / <https://w3id.org/IproK/integrated#Shared> / <https://w3id.org/IproK/integrated#Published> / <https://w3id.org/IproK/integrated#Archived> / <https://w3id.org/IproK/integrated#Superseded>." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/document#lifecycleState> ],
        [ sh:maxCount 1 ;
            sh:message "Drawing must reference its stored file (fileRef)." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/document#fileRef> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Drawing must record an uploadedAt timestamp." ;
            sh:minCount 1 ;
            sh:path integrated:uploadedAt ],
        [ sh:maxCount 1 ;
            sh:message "Drawing must point at its owning project (ofProject, IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/document#Drawing> .

<https://w3id.org/IproK/shapes#EVMSnapshotShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:message "EVMSnapshot must carry a statusDate." ;
