<https://w3id.org/IproK/shapes#ElementCountedAsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "countedAsElement must be an IFC GlobalId (22 characters)." ;
            sh:path integrated:countedAsElement ;
            sh:pattern "^[0-9A-Za-z_$]{22}$" ],
        [ sh:maxCount 1 ;
            sh:message "An element counted from another model's copy names that one model (countedInModel)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:countedInModel ] ;
    sh:targetSubjectsOf integrated:countedAsElement .

<https://w3id.org/IproK/shapes#ElementCountedInShape> a sh:NodeShape ;
    sh:property [ sh:message "An element counted in another model names the GlobalId(s) it was counted as (countedAsElement)." ;
            sh:minCount 1 ;
            sh:path integrated:countedAsElement ] ;
    sh:targetSubjectsOf integrated:countedInModel .

<https://w3id.org/IproK/shapes#ElementCountedNotPricedShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 0 ;
            sh:message "An element counted from another model's copy is not priced itself — a BOQ line governing it would count the same work twice." ;
            sh:path integrated:governedByBOQ ] ;
    sh:targetSubjectsOf integrated:countedAsElement .

<https://w3id.org/IproK/shapes#ElementDuplicateInertShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 0 ;
            sh:message "A retired duplicate is not priced — its BOQ line belongs to the node it duplicates." ;
            sh:path integrated:governedByBOQ ],
        [ sh:maxCount 0 ;
            sh:message "A retired duplicate records no copy relation — it belongs to the node it duplicates." ;
            sh:path integrated:countedInModel ],
        [ sh:maxCount 0 ;
            sh:message "A retired duplicate records no copy relation — it belongs to the node it duplicates." ;
            sh:path integrated:countedAsElement ],
        [ sh:maxCount 0 ;
            sh:message "A retired duplicate links no activity — the link belongs to the node it duplicates." ;
            sh:path <https://w3id.org/IproK/safety#linkedActivity> ] ;
    sh:targetSubjectsOf integrated:duplicateOf .

<https://w3id.org/IproK/shapes#ElementDuplicateRetiredShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A duplicate element node names the one node that carries the element now (duplicateOf)." ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:duplicateOf ],
        [ sh:message "An element node that is a duplicate of another is retired (prov:invalidatedAtTime)." ;
            sh:minCount 1 ;
            sh:path prov:invalidatedAtTime ] ;
    sh:targetSubjectsOf integrated:duplicateOf .

<https://w3id.org/IproK/shapes#ElementDuplicatesRetiredShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "A duplicate retirement says when it started." ;
            sh:minCount 1 ;
            sh:path prov:startedAtTime ],
        [ sh:message "A duplicate retirement names the agent that ran it." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path prov:wasAssociatedWith ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "elementsRetired is one whole number, 0 or more." ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/building#elementsRetired> ] ;
    sh:targetClass <https://w3id.org/IproK/building#ElementDuplicatesRetired> .

<https://w3id.org/IproK/shapes#ElementShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Element must carry the IFC GlobalId via <https://w3id.org/IproK/building#ifcGuid>." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/building#ifcGuid> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Element must declare its IFC class via <https://w3id.org/IproK/building#elementType> (e.g. 'IfcWall')." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/building#elementType> ],
        [ sh:maxCount 1 ;
            sh:message "Element must point at its owning project (ofProject, IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/building#Element> .

<https://w3id.org/IproK/shapes#EscrowAccountShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#escrowBank> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#escrowAccountRef> ],
        [ sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minCount 1 ;
            sh:minInclusive 50 ;
            sh:path <https://w3id.org/IproK/finance#escrowSplitPct> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#escrowSetupAt> ] ;
    sh:targetClass <https://w3id.org/IproK/finance#EscrowAccount> .

<https://w3id.org/IproK/shapes#EscrowWithdrawalShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#withdrawalId> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minExclusive 0 ;
            sh:path <https://w3id.org/IproK/finance#withdrawalAmount> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#withdrawalDate> ],
        [ sh:in ( "Land" "Construction" "Statutory" "Consultants" "Finance" "Other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#costHead> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 3 ;
            sh:path <https://w3id.org/IproK/finance#certificateRef> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/finance#EscrowWithdrawal> .

<https://w3id.org/IproK/shapes#GoodsReceiptShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "GoodsReceipt must carry a grnNumber (SAP MBLNR)." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/procurement#grnNumber> ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/procurement#grnDate> ],
        [ sh:maxCount 1 ;
            sh:message "GoodsReceipt must link to its PurchaseOrder via <https://w3id.org/IproK/procurement#forPO>." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/procurement#forPO> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/procurement#receivedAmount> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/procurement#receivedQty> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/procurement#GoodsReceipt> .

<https://w3id.org/IproK/shapes#HandoverPackageShape> a sh:NodeShape ;
    sh:or ( [ sh:property [ sh:not [ sh:hasValue "Transferred" ] ;
                        sh:path <https://w3id.org/IproK/handover#handoverStatus> ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path <https://w3id.org/IproK/handover#transferredAt> ],
                    [ sh:minCount 1 ;
                        sh:path <https://w3id.org/IproK/handover#transferredTo> ] ] ) ;
    sh:property [ sh:in ( "Preparing" "Transferred" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/handover#handoverStatus> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/handover#committedHandoverDate> ],
        [ sh:maxCount 1 ;
            sh:maxInclusive 120 ;
            sh:minCount 1 ;
            sh:minInclusive 12 ;
            sh:path <https://w3id.org/IproK/handover#dlpMonths> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/handover#HandoverPackage> .

<https://w3id.org/IproK/shapes#HistoricalWeatherProfileShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:forProject ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 90 ;
            sh:minCount 1 ;
            sh:minInclusive -90 ;
            sh:path <https://w3id.org/IproK/signal#profileLat> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 180 ;
            sh:minCount 1 ;
            sh:minInclusive -180 ;
            sh:path <https://w3id.org/IproK/signal#profileLng> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path <https://w3id.org/IproK/signal#sourceYears> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/signal#fetchedAt> ] ;
    sh:targetClass <https://w3id.org/IproK/signal#HistoricalWeatherProfile> .

<https://w3id.org/IproK/shapes#HistoricalWeatherWeekShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 53 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path <https://w3id.org/IproK/signal#weekOfYear> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/signal#avgRainfallMM> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/signal#rainProbability> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/signal#heatProbability> ] ;
    sh:targetClass <https://w3id.org/IproK/signal#HistoricalWeatherWeek> .

<https://w3id.org/IproK/shapes#HoldPointShape> a sh:NodeShape ;
    sh:or ( [ sh:property [ sh:not [ sh:hasValue "Released" ] ;
                        sh:path <https://w3id.org/IproK/quality#holdStatus> ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path <https://w3id.org/IproK/quality#releasedBy> ],
                    [ sh:minCount 1 ;
                        sh:path <https://w3id.org/IproK/quality#releasedAt> ],
                    [ sh:minCount 1 ;
                        sh:path <https://w3id.org/IproK/quality#releaseOTPRef> ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/quality#holdPointId> ],
        [ sh:in ( "Hold" "Witness" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/quality#holdPointType> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/quality#holdDescription> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:forActivity ],
        [ sh:in ( "Pending" "OfferedForInspection" "Released" "Waived" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/quality#holdStatus> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/quality#HoldPoint> .

<https://w3id.org/IproK/shapes#IncidentShape> a sh:NodeShape ;
    sh:property [ sh:in ( integrated:NearMiss integrated:FirstAid integrated:LostTimeInjury integrated:Fatality ) ;
            sh:maxCount 1 ;
            sh:message "Incident must have an incidentType (NearMiss / FirstAid / LostTimeInjury / Fatality)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/safety#incidentType> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Incident must record an incidentAt timestamp." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/safety#incidentAt> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "personsInvolved must be a positive integer (≥ 1)." ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path <https://w3id.org/IproK/safety#personsInvolved> ],
        [ sh:datatype xsd:string ;
            sh:message "Incident must include an immediate-cause note." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/safety#immediateCause> ],
        [ sh:maxCount 1 ;
            sh:message "Incident must point at the User who reported it (IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/safety#reportedBy> ] ;
    sh:targetClass <https://w3id.org/IproK/safety#Incident> .

<https://w3id.org/IproK/shapes#InspectionShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "Inspection must reference exactly one Activity (IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/quality#inspectedActivity> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Inspection must have an inspectedAt timestamp." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/quality#inspectedAt> ],
        [ sh:datatype xsd:string ;
            sh:in ( "pass" "fail" ) ;
            sh:maxCount 1 ;
            sh:message "Inspection must have an overallResult of 'pass' or 'fail'." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/quality#overallResult> ],
        [ sh:datatype xsd:string ;
            sh:in ( "quality" "safety" ) ;
            sh:maxCount 1 ;
            sh:message "Inspection must declare <https://w3id.org/IproK/quality#inspectionCategory> of 'quality' or 'safety'." ;
            sh:minCount 1 ;
