            sh:path <https://w3id.org/IproK/billing#jointSignatureRequired> ] ;
    sh:targetClass <https://w3id.org/IproK/billing#Measurement> .

<https://w3id.org/IproK/shapes#MemberIdentityShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "A member identity names the model it was asked for." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/building#forModel> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ],
        [ sh:message "A member identity covers at least one member (its GlobalId)." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/building#ifcGuid> ],
        [ sh:in ( "vidhi.element-identity/1" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/building#vidhiContract> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/building#inputSha256> ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/building#memberSignature> ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/building#contentVersion> ;
            sh:pattern "^sha256:[0-9a-f]{64}$" ],
        [ sh:in ( "proposed" "approved" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/building#reviewState> ],
        [ sh:maxCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/building#reviewLabel> ],
        [ sh:in ( "is808_exact" "is808_ambiguous" "measurement_too_uncertain" "foreign" "unidentified" "inconsistent" "not_in_catalogue" ) ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/building#sectionStatus> ],
        [ sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/building#sectionDesignation> ],
        [ sh:in ( "is2062" "foreign_stated" "stated_strength" "assumed" "not_stated" "unrecognised" ) ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/building#gradeStatus> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/building#identityJson> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/building#identifiedAt> ] ;
    sh:targetClass <https://w3id.org/IproK/building#MemberIdentity> .

<https://w3id.org/IproK/shapes#ModelCommentShape> a sh:NodeShape ;
    sh:or ( [ sh:property [ sh:not [ sh:hasValue "Resolved" ] ;
                        sh:path <https://w3id.org/IproK/building#commentStatus> ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path integrated:resolvedBy ],
                    [ sh:minCount 1 ;
                        sh:path integrated:resolvedAt ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/building#commentId> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/building#onModel> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/building#commentText> ],
        [ sh:in ( "Open" "Resolved" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/building#commentStatus> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:raisedBy ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path integrated:createdAt ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ],
        [ sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/building#viewName> ],
        [ sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/building#viewpointJson> ],
        [ sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/building#markupJson> ],
        [ sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/building#ifcGuid> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/building#replyTo> ],
        [ sh:maxCount 1 ;
            sh:path integrated:resolvedBy ],
        [ sh:maxCount 1 ;
            sh:path integrated:resolvedAt ] ;
    sh:targetClass <https://w3id.org/IproK/building#ModelComment> .

<https://w3id.org/IproK/shapes#ModelHealthCheckShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/building#healthCheckId> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/building#forModel> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/building#checkedAt> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 100.0 ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path <https://w3id.org/IproK/building#overallScore> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/building#elementsAudited> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/building#readinessJson> ],
        [ sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/building#checklistJson> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/building#quantitiesWritten> ],
        [ sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/building#enrichedFileRef> ] ;
    sh:targetClass <https://w3id.org/IproK/building#ModelHealthCheck> .

<https://w3id.org/IproK/shapes#NCRShape> a sh:NodeShape ;
    sh:message "A Closed NCR must carry closedBy, closedAt, and closureNote." ;
    sh:or ( [ sh:not [ sh:property [ sh:hasValue integrated:Closed ;
                                sh:path <https://w3id.org/IproK/quality#status> ] ] ] [ sh:property [ sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:path <https://w3id.org/IproK/quality#closedBy> ],
                    [ sh:datatype xsd:dateTime ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path <https://w3id.org/IproK/quality#closedAt> ],
                    [ sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:minLength 1 ;
                        sh:path integrated:closureNote ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:message "NCR must point to exactly one Inspection (IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/quality#relatedInspection> ],
        [ sh:maxCount 1 ;
            sh:message "NCR must point to exactly one Activity (IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/quality#relatedActivity> ],
        [ sh:in ( integrated:Open integrated:UnderReview integrated:Closed integrated:Rejected ) ;
            sh:maxCount 1 ;
            sh:message "NCR status must be one of <https://w3id.org/IproK/integrated#Open> / <https://w3id.org/IproK/integrated#UnderReview> / <https://w3id.org/IproK/integrated#Closed> / <https://w3id.org/IproK/integrated#Rejected>." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/quality#status> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path integrated:raisedAt ],
        [ sh:datatype xsd:string ;
            sh:message "NCR must carry the failure note copied from the failed item." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/quality#failureNote> ] ;
    sh:targetClass <https://w3id.org/IproK/quality#NCR> .

<https://w3id.org/IproK/shapes#OrgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Organisation must have orgName." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path iprok:orgName ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "orgSlug must be 2-50 lowercase letters / digits / hyphens (no leading hyphen)." ;
            sh:minCount 1 ;
            sh:path iprok:orgSlug ;
            sh:pattern "^[a-z0-9][a-z0-9-]{1,49}$" ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Organisation must have a createdAt timestamp." ;
            sh:minCount 1 ;
            sh:path integrated:createdAt ],
        [ sh:datatype xsd:string ;
            sh:in ( "pilot" "project" "enterprise" "sovereign" ) ;
            sh:maxCount 1 ;
            sh:message "orgPlan, when set, must be pilot / project / enterprise / sovereign." ;
            sh:path iprok:orgPlan ],
        [ sh:in ( integrated:Invited integrated:Active integrated:Churned integrated:Converted ) ;
            sh:maxCount 1 ;
            sh:message "pilotStatus, when set, must be one of <https://w3id.org/IproK/integrated#Invited> / <https://w3id.org/IproK/integrated#Active> / <https://w3id.org/IproK/integrated#Churned> / <https://w3id.org/IproK/integrated#Converted>." ;
            sh:path iprok:pilotStatus ] ;
    sh:targetClass iprok:Organisation .

<https://w3id.org/IproK/shapes#OrganisationMastersShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path iprok:mastersVersion ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofOrganisation ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path iprok:mastersSetAt ],
        [ sh:maxCount 1 ;
            sh:path iprok:mastersNote ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 100.0 ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path iprok:securityDepositPct ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path iprok:gstTdsApplicable ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path iprok:labourCessApplicable ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 100.0 ;
            sh:minCount 1 ;
            sh:minExclusive 0.0 ;
            sh:path iprok:deviationThresholdPct ],
        [ sh:datatype xsd:decimal ;
            sh:lessThan iprok:approvalLevel2Limit ;
            sh:maxCount 1 ;
            sh:message "Level-1 approval limit must be below the level-2 limit." ;
            sh:minCount 1 ;
            sh:minExclusive 0.0 ;
            sh:path iprok:approvalLevel1Limit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minExclusive 0.0 ;
            sh:path iprok:approvalLevel2Limit ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path iprok:approvalLevel1Label ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path iprok:approvalLevel2Label ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path iprok:approvalLevel3Label ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 12 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path iprok:fyStartMonth ],
        [ sh:maxCount 1 ;
            sh:path iprok:legalName ],
        [ sh:maxCount 1 ;
            sh:message "GSTIN must be 15 characters: state code, PAN, entity, Z, checksum." ;
            sh:path iprok:gstin ;
            sh:pattern "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$" ],
        [ sh:maxCount 1 ;
            sh:message "PAN must be 5 letters, 4 digits, 1 letter." ;
            sh:path iprok:pan ;
            sh:pattern "^[A-Z]{5}[0-9]{4}[A-Z]$" ],
        [ sh:maxCount 1 ;
            sh:message "CIN must be 21 characters, e.g. U72100AP2025PTC122937." ;
            sh:path iprok:cin ;
            sh:pattern "^[LU][0-9]{5}[A-Z]{2}[0-9]{4}[A-Z]{3}[0-9]{6}$" ] ;
    sh:targetClass iprok:OrganisationMasters .

<https://w3id.org/IproK/shapes#PaymentMilestoneShape> a sh:NodeShape ;
    sh:or ( [ sh:property [ sh:not [ sh:hasValue "Achieved" ] ;
                        sh:path <https://w3id.org/IproK/finance#milestoneStatus> ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path <https://w3id.org/IproK/finance#achievedAt> ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#milestoneId> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#milestoneName> ],
        [ sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minCount 1 ;
            sh:minExclusive 0 ;
            sh:path <https://w3id.org/IproK/finance#milestonePct> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#milestoneOrder> ],
        [ sh:in ( "Pending" "Achieved" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/finance#milestoneStatus> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/finance#PaymentMilestone> .

<https://w3id.org/IproK/shapes#PaymentShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Payment must carry a paymentId (Tally voucher number)." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#paymentId> ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:message "Payment must carry a paymentDate." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#paymentDate> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Payment must carry a paymentAmount." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#paymentAmount> ],
        [ sh:maxCount 1 ;
            sh:message "Payment must link to its project via <https://w3id.org/IproK/integrated#ofProject>." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/billing#Payment> .

<https://w3id.org/IproK/shapes#PhotoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:message "Photo must include exactly one photoUri." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/reporting#photoUri> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Photo must have a reportedAt timestamp." ;
            sh:minCount 1 ;
            sh:path integrated:reportedAt ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "If provided, locationWkt must be POINT(lng lat) format." ;
            sh:path <https://w3id.org/IproK/reporting#locationWkt> ;
            sh:pattern "^POINT\\(-?[0-9]+(\\.[0-9]+)? -?[0-9]+(\\.[0-9]+)?\\)$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "If provided, clientId must be a UUID." ;
            sh:path <https://w3id.org/IproK/reporting#clientId> ;
            sh:pattern "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" ] ;
    sh:targetClass <https://w3id.org/IproK/reporting#Photo> .

<https://w3id.org/IproK/shapes#ProductOfferShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/procurement#offerId> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/procurement#offerProduct> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/procurement#byVendor> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minExclusive 0 ;
            sh:path <https://w3id.org/IproK/procurement#unitRate> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path integrated:unit ],
        [ sh:maxCount 1 ;
            sh:maxInclusive 365 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/procurement#leadTimeDays> ],
        [ sh:maxCount 1 ;
            sh:maxInclusive 5 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path <https://w3id.org/IproK/procurement#qualityGrade> ] ;
    sh:targetClass <https://w3id.org/IproK/procurement#ProductOffer> .

<https://w3id.org/IproK/shapes#ProductivityContributionShape> a sh:NodeShape ;
    sh:message "A withdrawn publication records who withdrew it and why." ;
    sh:or ( [ sh:property [ sh:maxCount 0 ;
                        sh:path resource:withdrawnAt ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path resource:withdrawnBy ],
                    [ sh:minCount 1 ;
                        sh:path resource:withdrawalReason ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path resource:contributingProject ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path resource:contributedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path resource:contributedAt ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofOrganisation ],
        [ sh:maxCount 1 ;
            sh:minLength 3 ;
            sh:path resource:withdrawalReason ] ;
    sh:targetClass resource:ProductivityContribution .

<https://w3id.org/IproK/shapes#ProductivityNormShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path resource:normId ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path integrated:workType ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minExclusive 0.0 ;
            sh:path resource:normRate ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path resource:observedUnit ],
        [ sh:in ( "measured" "seeded" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path integrated:normSource ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path integrated:observationCount ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path resource:normComputedAt ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path resource:reportCount ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path resource:projectCount ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path resource:steadyDayCount ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path resource:handObservationCount ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofOrganisation ] ;
    sh:targetClass resource:ProductivityNorm .

<https://w3id.org/IproK/shapes#ProductivityObservationShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path resource:observationId ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path resource:observedQuantity ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path resource:observedUnit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minExclusive 0.0 ;
            sh:path resource:crewDays ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0.0 ;
            sh:path resource:productivityRate ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path integrated:workType ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path resource:observedOn ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass resource:ProductivityObservation .

<https://w3id.org/IproK/shapes#ProjectMembershipShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "ProjectMembership must reference exactly one User (IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path iprok:ofUser ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "ProjectMembership must record a joinedAt timestamp." ;
            sh:minCount 1 ;
            sh:path iprok:joinedAt ] ;
    sh:targetClass iprok:ProjectMembership .

<https://w3id.org/IproK/shapes#ProjectResourcePriceShape> a sh:NodeShape ;
    sh:message "A project price names its resource, a rate of zero or more, where it came from and when." ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cost:resourceCode ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path cost:priceRate ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 2 ;
            sh:path cost:priceSource ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cost:priceAsOf ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass cost:ProjectResourcePrice .

<https://w3id.org/IproK/shapes#ProjectShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "Project must have a title." ;
            sh:minCount 1 ;
            sh:path dct:title ] ;
    sh:targetClass schedule:Project .

<https://w3id.org/IproK/shapes#PurchaseOrderShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "PurchaseOrder must carry a poNumber (SAP EBELN)." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/procurement#poNumber> ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/procurement#poDate> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/procurement#vendor> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/procurement#poAmount> ],
        [ sh:in ( "Open" "PartiallyDelivered" "FullyDelivered" "Cancelled" ) ;
            sh:maxCount 1 ;
            sh:message "poStatus must be Open / PartiallyDelivered / FullyDelivered / Cancelled." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/procurement#poStatus> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/procurement#PurchaseOrder> .

<https://w3id.org/IproK/shapes#RABillShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "RABill must carry a billNo (e.g. RA-1)." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/billing#billNo> ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:message "RABill must carry a billDate." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#billDate> ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:message "RABill must carry a billingPeriodStart." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#billingPeriodStart> ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:message "RABill must carry a billingPeriodEnd." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#billingPeriodEnd> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "RABill must carry cumulativeGross." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#cumulativeGross> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "RABill must carry previousBillAmount." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#previousBillAmount> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "RABill must carry currentGross." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#currentGross> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "RABill must carry totalRecoveries." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#totalRecoveries> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "RABill must carry netPayable." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#netPayable> ],
        [ sh:in ( integrated:BillDraft integrated:BillSubmitted integrated:BillApproved integrated:BillFinalised ) ;
            sh:maxCount 1 ;
            sh:message "billState must be one of the four <https://w3id.org/IproK/billing#BillState> individuals." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/billing#billState> ],
        [ sh:maxCount 1 ;
            sh:message "RABill must link to its project via <https://w3id.org/IproK/integrated#ofProject>." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ],
        [ sh:maxCount 1 ;
            sh:message "RABill must identify its preparer via <https://w3id.org/IproK/billing#preparedBy>." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/billing#preparedBy> ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "netPayable must equal currentGross minus totalRecoveries (arithmetic integrity check, tolerance ±₹0.01)." ;
            sh:select """
            SELECT $this
            WHERE {
                $this <https://w3id.org/IproK/billing#netPayable> ?net ;
                      <https://w3id.org/IproK/billing#currentGross> ?gross ;
                      <https://w3id.org/IproK/billing#totalRecoveries> ?rec .
                FILTER (ABS(?net - ?gross + ?rec) > 0.01)
            }
        """ ] ;
    sh:targetClass <https://w3id.org/IproK/billing#RABill> .

<https://w3id.org/IproK/shapes#RFIShape> a sh:NodeShape ;
    sh:message "An Answered RFI must carry answeredBy and rfiAnswer." ;
    sh:or ( [ sh:not [ sh:property [ sh:hasValue integrated:RFIAnswered ;
                                sh:path <https://w3id.org/IproK/document#rfiState> ] ] ] [ sh:property [ sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:path <https://w3id.org/IproK/document#answeredBy> ],
                    [ sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:minLength 1 ;
                        sh:path <https://w3id.org/IproK/document#rfiAnswer> ] ] ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "RFI must carry a project-unique rfiId (RFI-NNNN)." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/document#rfiId> ],
        [ sh:datatype xsd:string ;
            sh:message "RFI must carry a subject." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/document#rfiSubject> ],
        [ sh:datatype xsd:string ;
            sh:message "RFI must carry a body (the question)." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/document#rfiBody> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "RFI must carry a discipline." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/document#discipline> ],
        [ sh:in ( integrated:RFIDraft integrated:RFISubmitted integrated:RFIUnderReview integrated:RFIAnswered integrated:RFIClosed integrated:RFICancelled ) ;
            sh:maxCount 1 ;
            sh:message "rfiState must be one of <https://w3id.org/IproK/integrated#RFIDraft> / RFISubmitted / RFIUnderReview / RFIAnswered / RFIClosed / RFICancelled." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/document#rfiState> ],
        [ sh:maxCount 1 ;
            sh:message "RFI must record who raised it (raisedBy, IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:raisedBy ],
        [ sh:maxCount 1 ;
            sh:message "RFI must point at its owning project (ofProject, IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/document#RFI> .

<https://w3id.org/IproK/shapes#RateAnalysisShape> a sh:NodeShape ;
    sh:message "An analysis version names its id, version, work, unit, the quantity it is for and where its figures come from; a project analysis names its BOQ line; a measured output says how many site days stand behind it; an imported version names its source record, version, edition, item, citation, review state and check." ;
    sh:or ( [ sh:property [ sh:in ( "library" ) ;
                        sh:path cost:analysisScope ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path integrated:forBOQItem ],
                    [ sh:minCount 1 ;
                        sh:path integrated:ofProject ] ] ),
        ( [ sh:property [ sh:not [ sh:hasValue "measured" ] ;
                        sh:path cost:outputSource ] ] [ sh:property [ sh:minCount 1 ;
                        sh:minInclusive 1 ;
                        sh:path cost:outputObservations ] ] ),
        ( [ sh:property [ sh:maxCount 0 ;
                        sh:path cost:importedFrom ] ] [ sh:property [ sh:maxCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:path cost:importedFrom ],
                    [ sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path cost:importedRecordVersion ;
                        sh:pattern "^sha256:[0-9a-f]{64}$" ],
                    [ sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path cost:importedEdition ],
                    [ sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path cost:importedItemCode ],
                    [ sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:minLength 10 ;
                        sh:path cost:sourceCitation ],
                    [ sh:in ( "proposed" "approved" ) ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path cost:importedReviewState ],
                    [ sh:in ( "reconciled" "reconciled_with_unchecked" "flagged" ) ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path cost:importedCheckStatus ] ] ) ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cost:analysisId ;
            sh:pattern "^R[AL]-[0-9]{4,}$" ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path cost:analysisVersion ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 3 ;
            sh:path cost:analysisTitle ],
        [ sh:in ( "library" "project" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cost:analysisScope ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path integrated:unit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minExclusive 0 ;
            sh:path cost:analysedQuantity ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minExclusive 0 ;
            sh:path cost:gangOutput ],
        [ sh:in ( "typed" "measured" "library" ) ;
            sh:maxCount 1 ;
            sh:path cost:outputSource ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path cost:outputObservations ],
        [ sh:maxCount 1 ;
            sh:path integrated:workType ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 3 ;
            sh:path cost:analysisSource ],
        [ sh:maxCount 1 ;
            sh:path cost:analysisNote ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:forBOQItem ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path cost:fromLibraryAnalysis ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass cost:RateAnalysis .

<https://w3id.org/IproK/shapes#RecoveryShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Recovery must carry a recoveryType." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/billing#recoveryType> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Recovery must carry a recoveryRate." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#recoveryRate> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Recovery must carry a recoveryAmount." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#recoveryAmount> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Recovery must carry a recoveryBase." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/billing#recoveryBase> ],
        [ sh:maxCount 1 ;
            sh:message "Recovery must link to its parent RABill via <https://w3id.org/IproK/billing#forBill>." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/billing#forBill> ] ;
    sh:targetClass <https://w3id.org/IproK/billing#Recovery> .

<https://w3id.org/IproK/shapes#RecurrenceAlertShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "RecurrenceAlert must reference exactly one Activity (IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/quality#alertedActivity> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "RecurrenceAlert must carry a non-empty defectDescription." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path integrated:defectDescription ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "occurrenceCount must be at least 2 — a single occurrence is not a recurrence." ;
            sh:minCount 1 ;
            sh:minInclusive 2 ;
            sh:path <https://w3id.org/IproK/quality#occurrenceCount> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "RecurrenceAlert must record a firstSeenAt timestamp." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/quality#firstSeenAt> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "RecurrenceAlert must record a lastSeenAt timestamp." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/quality#lastSeenAt> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "RecurrenceAlert must record a generatedAt timestamp." ;
            sh:minCount 1 ;
            sh:path integrated:generatedAt ],
        [ sh:in ( integrated:Open integrated:Acknowledged ) ;
            sh:maxCount 1 ;
            sh:message "RecurrenceAlert status must be <https://w3id.org/IproK/integrated#Open> or <https://w3id.org/IproK/integrated#Acknowledged>." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/quality#status> ] ;
    sh:targetClass <https://w3id.org/IproK/quality#RecurrenceAlert> .

<https://w3id.org/IproK/shapes#ResourceMappingShape> a sh:NodeShape ;
    sh:message "A resource mapping names the outside code list, the outside code and the organisation's resource code." ;
    sh:property [ sh:in ( "cpwd-dar-resource" "cpwd-dar-item" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cost:externalScheme ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path cost:externalCode ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cost:resourceCode ;
            sh:pattern "^[A-Z0-9][A-Z0-9._-]{0,39}$" ] ;
    sh:targetClass cost:ResourceMapping .

<https://w3id.org/IproK/shapes#RiskShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Risk must carry a riskId." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/coordination#riskId> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Risk must carry a riskTitle." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/coordination#riskTitle> ],
        [ sh:in ( "Design" "Commercial" "Resource" "External" "Technical" "Regulatory" "Environmental" "Safety" ) ;
            sh:maxCount 1 ;
            sh:message "Risk category must be one of the 8 standard buckets." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/coordination#riskCategory> ],
        [ sh:in ( "Low" "Medium" "High" "Critical" ) ;
            sh:maxCount 1 ;
            sh:message "Probability must be Low / Medium / High / Critical." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/coordination#probability> ],
        [ sh:in ( "Low" "Medium" "High" "Critical" ) ;
            sh:maxCount 1 ;
            sh:message "Impact must be Low / Medium / High / Critical." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/coordination#impact> ],
        [ sh:in ( "Open" "Mitigating" "Closed" "Accepted" ) ;
            sh:maxCount 1 ;
            sh:message "Risk status must be Open / Mitigating / Closed / Accepted." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/coordination#riskStatus> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/coordination#riskScore> ],
        [ sh:maxCount 1 ;
            sh:message "Risk must record who raised it." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:raisedBy ],
        [ sh:maxCount 1 ;
            sh:message "Risk must link to its project via <https://w3id.org/IproK/integrated#ofProject>." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/coordination#Risk> .

<https://w3id.org/IproK/shapes#SORItemShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "SORItem must carry sorCode." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/tender#sorCode> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "SORItem must carry sorDescription." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/tender#sorDescription> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "SORItem must carry unit." ;
            sh:minCount 1 ;
            sh:path integrated:unit ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "SORItem must carry baseRate." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/tender#baseRate> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "SORItem must carry rateYear." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/tender#rateYear> ],
        [ sh:maxCount 1 ;
            sh:message "SORItem must link to its parent SORLibrary via <https://w3id.org/IproK/tender#partOf>." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/tender#partOf> ] ;
    sh:targetClass <https://w3id.org/IproK/tender#SORItem> .

<https://w3id.org/IproK/shapes#SORLibraryShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "SORLibrary must carry a sorLibraryId." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/tender#sorLibraryId> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "SORLibrary must carry a publisher." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/tender#publisher> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "SORLibrary must carry sorYear." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/tender#sorYear> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "SORLibrary must carry ingestedAt." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/tender#ingestedAt> ] ;
    sh:targetClass <https://w3id.org/IproK/tender#SORLibrary> .

<https://w3id.org/IproK/shapes#SavedQueryShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "SavedQuery must carry a queryName." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/reporting#queryName> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "SavedQuery must carry sparqlText." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/reporting#sparqlText> ],
        [ sh:in ( "Any" "PM" "Director" "Auditor" ) ;
            sh:maxCount 1 ;
            sh:message "queryRole must be Any / PM / Director / Auditor." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/reporting#queryRole> ],
        [ sh:in ( "table" "number" "bar" "line" "pie" ) ;
            sh:maxCount 1 ;
            sh:message "visualType must be table / number / bar / line / pie." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/reporting#visualType> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/reporting#displayOrder> ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/reporting#isPinned> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/reporting#createdBy> ] ;
    sh:targetClass <https://w3id.org/IproK/reporting#SavedQuery> .

<https://w3id.org/IproK/shapes#ScheduleBaselineShape> a sh:NodeShape ;
    sh:message "A baseline names its number, label, basis, data date, approver and time, project, first and last day and how many activities it froze; an extension of time names its Clause 5 sub-clause and the days granted; a revision says why." ;
    sh:or ( [ sh:property [ sh:not [ sh:hasValue "ExtensionOfTime" ] ;
                        sh:path schedule:baselineBasis ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path schedule:eotClause ],
                    [ sh:minCount 1 ;
                        sh:path schedule:extensionDays ] ] ),
        ( [ sh:property [ sh:hasValue "ApprovedProgramme" ;
                        sh:path schedule:baselineBasis ] ] [ sh:property [ sh:minCount 1 ;
                        sh:minLength 3 ;
                        sh:path schedule:baselineReason ] ] ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path schedule:baselineNo ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 2 ;
            sh:path schedule:baselineLabel ],
        [ sh:in ( "ApprovedProgramme" "AgreedAmendment" "ExtensionOfTime" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schedule:baselineBasis ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schedule:dataDate ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path schedule:approvedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schedule:approvedAt ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ],
        [ sh:datatype xsd:date ;
            sh:lessThanOrEquals schedule:baselineFinishDate ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schedule:baselineStartDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schedule:baselineFinishDate ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:path schedule:stipulatedFinishDate ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path schedule:entryCount ],
        [ sh:in ( "5.2" "5.3" ) ;
            sh:maxCount 1 ;
            sh:path schedule:eotClause ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:path schedule:extensionDays ] ;
    sh:targetClass schedule:ScheduleBaseline .

<https://w3id.org/IproK/shapes#ScheduleLinkShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "ScheduleLink must name its predecessor activity (linkSource)." ;
            sh:minCount 1 ;
            sh:path schedule:linkSource ],
        [ sh:datatype xsd:string ;
            sh:in ( "FS" "SS" "FF" "SF" ) ;
            sh:maxCount 1 ;
            sh:message "ScheduleLink type must be one of FS / SS / FF / SF." ;
            sh:minCount 1 ;
            sh:path schedule:linkType ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "linkLag, when set, is a single decimal (days)." ;
            sh:path schedule:linkLag ] ;
    sh:targetClass schedule:ScheduleLink .

<https://w3id.org/IproK/shapes#SignatureEventShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "SignatureEvent must carry a unique signatureId." ;
            sh:minCount 1 ;
            sh:path iprok:signatureId ],
        [ sh:maxCount 1 ;
            sh:message "SignatureEvent must record the signer (signedBy, IRI of <https://w3id.org/IproK#User>)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path iprok:signedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "SignatureEvent must record when the signature was applied (signedAt, xsd:dateTime)." ;
            sh:minCount 1 ;
            sh:path iprok:signedAt ],
        [ sh:datatype xsd:string ;
            sh:in ( "eMudhra" "DigiLocker" "Stub" ) ;
            sh:maxCount 1 ;
            sh:message "signatureProvider must be one of: eMudhra, DigiLocker, Stub." ;
            sh:minCount 1 ;
            sh:path iprok:signatureProvider ],
        [ sh:datatype xsd:string ;
            sh:in ( "DrawingApproval" "RFIConfirmation" "TransmittalApproval" "JointMeasurement" ) ;
            sh:maxCount 1 ;
            sh:message "signaturePurpose must be one of: DrawingApproval, RFIConfirmation, TransmittalApproval, JointMeasurement." ;
            sh:minCount 1 ;
            sh:path iprok:signaturePurpose ],
        [ sh:maxCount 1 ;
            sh:message "SignatureEvent must reference the signed document (signedDocument, IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path iprok:signedDocument ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "SignatureEvent must declare legallyBinding (xsd:boolean)." ;
            sh:minCount 1 ;
            sh:path iprok:legallyBinding ] ;
    sh:targetClass iprok:SignatureEvent .

<https://w3id.org/IproK/shapes#SiteClimateShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxInclusive 52 ;
            sh:message "monsoonOnsetWeek must be ISO week 1-52" ;
            sh:minInclusive 1 ;
            sh:path <https://w3id.org/IproK/site#monsoonOnsetWeek> ],
        [ sh:datatype xsd:integer ;
            sh:maxInclusive 52 ;
            sh:message "monsoonWithdrawalWeek must be ISO week 1-52" ;
            sh:minInclusive 1 ;
            sh:path <https://w3id.org/IproK/site#monsoonWithdrawalWeek> ],
        [ sh:datatype xsd:decimal ;
            sh:message "annualRainfallMM must be >= 0" ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/site#annualRainfallMM> ] ;
    sh:targetClass <https://w3id.org/IproK/site#SiteClimate> .

<https://w3id.org/IproK/shapes#SiteHydrologyShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:message "Post-monsoon groundwater depth must be >= 0m" ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/site#groundwaterDepthPostMonsoonM> ],
        [ sh:datatype xsd:boolean ;
            sh:message "dewateringRequired flag is mandatory" ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/site#dewateringRequired> ],
        [ sh:in ( "Safe" "Semi-Critical" "Critical" "Over-exploited" ) ;
            sh:message "cgwbBlockCategory must be Safe|Semi-Critical|Critical|Over-exploited" ;
            sh:path <https://w3id.org/IproK/site#cgwbBlockCategory> ] ;
    sh:targetClass <https://w3id.org/IproK/site#SiteHydrology> .

<https://w3id.org/IproK/shapes#SiteIntelligenceShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "SiteIntelligence must link to exactly one Project" ;
            sh:minCount 1 ;
            sh:path integrated:forProject ],
        [ sh:datatype xsd:dateTime ;
            sh:message "SiteIntelligence must have a generatedAt timestamp" ;
            sh:minCount 1 ;
            sh:path integrated:generatedAt ] ;
    sh:targetClass <https://w3id.org/IproK/site#SiteIntelligence> .

<https://w3id.org/IproK/shapes#SiteLabourShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:message "labourColonyDistanceKm must be >= 0" ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/site#labourColonyDistanceKm> ],
        [ sh:datatype xsd:boolean ;
            sh:message "labourAccommodationNeeded flag is mandatory" ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/site#labourAccommodationNeeded> ] ;
    sh:targetClass <https://w3id.org/IproK/site#SiteLabour> .

<https://w3id.org/IproK/shapes#SiteLogisticsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:message "rmc1DistanceKm must be >= 0" ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/site#rmc1DistanceKm> ],
        [ sh:datatype xsd:boolean ;
            sh:message "heavyVehicleAccess flag is mandatory" ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/site#heavyVehicleAccess> ] ;
    sh:targetClass <https://w3id.org/IproK/site#SiteLogistics> .

<https://w3id.org/IproK/shapes#SiteUtilitiesShape> a sh:NodeShape ;
    sh:property [ sh:in ( "Low" "Medium" "High" ) ;
            sh:message "undergroundUtilityRisk must be Low|Medium|High" ;
            sh:path <https://w3id.org/IproK/site#undergroundUtilityRisk> ],
        [ sh:datatype xsd:boolean ;
            sh:message "overheadHTLinePresent flag is mandatory" ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/site#overheadHTLinePresent> ] ;
    sh:targetClass <https://w3id.org/IproK/site#SiteUtilities> .

<https://w3id.org/IproK/shapes#SiteWorkerSafetyShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:message "hospitalDistanceKm must be >= 0" ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/site#hospitalDistanceKm> ],
        [ sh:datatype xsd:decimal ;
            sh:maxInclusive 55 ;
            sh:message "peakHeatMonthWBGT must be between 20 and 55 degrees C" ;
            sh:minInclusive 20 ;
            sh:path <https://w3id.org/IproK/site#peakHeatMonthWBGT> ],
        [ sh:in ( "Good" "Satisfactory" "Moderate" "Poor" "Very Poor" "Severe" ) ;
            sh:message "aqiZone must be a valid CPCB AQI category" ;
            sh:path <https://w3id.org/IproK/site#aqiZone> ] ;
    sh:targetClass <https://w3id.org/IproK/site#SiteWorkerSafety> .

<https://w3id.org/IproK/shapes#SkillCertificationShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path resource:certificationName ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path resource:certifiedWorker ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path resource:validFrom ],
        [ sh:maxCount 1 ;
            sh:path resource:validUntil ] ;
    sh:targetClass resource:SkillCertification .

<https://w3id.org/IproK/shapes#SnagItemShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/handover#snagId> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/handover#snagDescription> ],
        [ sh:in ( "Minor" "Major" "Critical" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/handover#snagSeverity> ],
        [ sh:in ( "Open" "Fixed" "Verified" "Deferred" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/handover#snagStatus> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path integrated:raisedAt ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/handover#SnagItem> .

<https://w3id.org/IproK/shapes#TenderBOQItemShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path <https://w3id.org/IproK/tender#tenderBoqSno> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/tender#tenderItemDescription> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 80 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/tender#tenderShortDesc> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#tenderEstQty> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/tender#tenderUnit> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#tenderRate> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#tenderAmount> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/tender#ofTender> ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/tender#needsReview> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:path <https://w3id.org/IproK/tender#dedupCount> ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/tender#matchedSORItem> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#matchConfidence> ],
        [ sh:in ( "exact-code" "fuzzy-desc" "jargon-normalised" "no-match" ) ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/tender#matchStrategy> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path integrated:quotedRate ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/tender#rateVariance> ] ;
    sh:targetClass <https://w3id.org/IproK/tender#TenderBOQItem> .

<https://w3id.org/IproK/shapes#TenderShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/tender#tenderId> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/tender#tenderTitle> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofOrganisation ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path integrated:uploadedAt ],
        [ sh:in ( integrated:Pending integrated:Running integrated:Complete integrated:Failed integrated:NeedsReview ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/tender#extractionStatus> ],
        [ sh:in ( "Single" "Two" "Three" ) ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/tender#coverSystem> ],
        [ sh:in ( "Open" "Limited" "Single" "Two-Stage" "Reverse" ) ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/tender#procurementMode> ],
        [ sh:in ( "Lump-sum" "Rate" "BOT" "Other" ) ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/tender#contractForm> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#estimatedValue> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#emdPercentage> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/tender#pbgPercentage> ] ;
    sh:targetClass <https://w3id.org/IproK/tender#Tender> .

<https://w3id.org/IproK/shapes#TowerShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Tower must carry a towerId." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/property#towerId> ],
        [ sh:maxCount 1 ;
            sh:message "Tower must belong to a project." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/property#Tower> .

<https://w3id.org/IproK/shapes#TransmittalShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Transmittal must carry a project-unique transmittalId (T-NNNN)." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/document#transmittalId> ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Transmittal must record transmittalDate." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/document#transmittalDate> ],
        [ sh:maxCount 1 ;
            sh:message "Transmittal must record who issued it (issuedBy, IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/document#issuedBy> ],
        [ sh:message "Transmittal must be issued to at least one user (issuedTo, IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/document#issuedTo> ],
        [ sh:datatype xsd:string ;
            sh:in ( "ForConstruction" "ForReview" "ForApproval" "ForInformation" "AsBuilt" "Superseded" ) ;
            sh:maxCount 1 ;
            sh:message "purpose must be ForConstruction / ForReview / ForApproval / ForInformation / AsBuilt / Superseded." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/document#purpose> ],
        [ sh:message "Transmittal must include at least one drawing (includesDrawings, IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/document#includesDrawings> ],
        [ sh:maxCount 1 ;
            sh:message "Transmittal must point at its owning project (ofProject, IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/document#Transmittal> .

<https://w3id.org/IproK/shapes#UnitShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Unit must carry a unitId." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/property#unitId> ],
        [ sh:in ( "Available" "Blocked" "Booked" "Agreement" "Registered" "Possession" ) ;
            sh:maxCount 1 ;
            sh:message "unitStatus must be Available / Blocked / Booked / Agreement / Registered / Possession." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/property#unitStatus> ],
        [ sh:maxCount 1 ;
            sh:message "Unit must belong to a tower." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/property#ofTower> ],
        [ sh:maxCount 1 ;
            sh:message "Unit must reference its unit type." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/property#ofUnitType> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/property#floorNo> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/property#unitNo> ] ;
    sh:targetClass <https://w3id.org/IproK/property#Unit> .

<https://w3id.org/IproK/shapes#UnitTypeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "UnitType must carry a unitTypeId." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/property#unitTypeId> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "UnitType must carry a unitTypeName." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/property#unitTypeName> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "UnitType must carry carpetAreaSqft." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/property#carpetAreaSqft> ],
        [ sh:maxCount 1 ;
            sh:message "UnitType must belong to a project." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/property#UnitType> .

<https://w3id.org/IproK/shapes#UserShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "User must have a valid E.164-format phone number." ;
            sh:minCount 1 ;
            sh:path iprok:phoneNumber ;
            sh:pattern "^\\+[0-9]{10,15}$" ],
        [ sh:datatype xsd:string ;
            sh:in ( "SiteEngineer" "QC" "Safety" "PM" "Planning" "BIM" "Director" "Auditor" "Admin" ) ;
            sh:message "User must have a recognised role." ;
            sh:minCount 1 ;
            sh:path iprok:userRole ] ;
    sh:targetClass iprok:User .

<https://w3id.org/IproK/shapes#VendorShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/procurement#vendorId> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/procurement#vendorName> ],
        [ sh:in ( "Material" "Equipment" "Labour" "Services" "Fixtures" "Other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/procurement#vendorCategory> ] ;
    sh:targetClass <https://w3id.org/IproK/procurement#Vendor> .

<https://w3id.org/IproK/shapes#WBSNodeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "WBS node must carry a wbsCode." ;
            sh:minCount 1 ;
            sh:path schedule:wbsCode ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "WBS node must carry a wbsName." ;
            sh:minCount 1 ;
            sh:path schedule:wbsName ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "WBS node must carry a wbsLevel >= 1." ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path schedule:wbsLevel ],
        [ sh:maxCount 1 ;
            sh:message "WBS node must link to its project via <https://w3id.org/IproK/integrated#ofProject>." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ],
        [ sh:maxCount 1 ;
            sh:message "WBS node may have at most one parentWBS." ;
            sh:nodeKind sh:IRI ;
            sh:path schedule:parentWBS ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path schedule:isWorkPackage ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path schedule:wbsPlannedCost ] ;
    sh:targetClass schedule:WBSNode .

<https://w3id.org/IproK/shapes#WarrantyRecordShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/handover#warrantyId> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/handover#warrantyAsset> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/handover#warrantyVendor> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/handover#warrantyStartDate> ],
        [ sh:maxCount 1 ;
            sh:maxInclusive 240 ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path <https://w3id.org/IproK/handover#warrantyMonths> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ] ;
    sh:targetClass <https://w3id.org/IproK/handover#WarrantyRecord> .

<https://w3id.org/IproK/shapes#WeatherSignalShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/signal#signalDate> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/signal#rainfallMM> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/signal#maxTempC> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path <https://w3id.org/IproK/signal#workingDayLossRisk> ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path <https://w3id.org/IproK/signal#isMonsoonPeriod> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:forProject ] ;
    sh:targetClass <https://w3id.org/IproK/signal#WeatherSignal> .

<https://w3id.org/IproK/shapes#WorkerShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path resource:workerId ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path resource:workerName ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path resource:workerTrade ],
        [ sh:in ( "Skilled" "SemiSkilled" "Unskilled" ) ;
            sh:maxCount 1 ;
            sh:path resource:skillLevel ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofOrganisation ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path resource:workerAccount ] ;
    sh:targetClass resource:Worker .

