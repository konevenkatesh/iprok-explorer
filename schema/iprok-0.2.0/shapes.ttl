        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schedule:ev ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schedule:ac ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path schedule:bac ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path schedule:cpi ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path schedule:spi ],
        [ sh:datatype xsd:decimal ;
