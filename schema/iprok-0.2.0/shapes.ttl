<https://w3id.org/IproK/shapes#IssueShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Issue must carry a project-unique issueId." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/coordination#issueId> ],
        [ sh:datatype xsd:string ;
            sh:message "Issue must carry a title." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/coordination#issueTitle> ],
        [ sh:datatype xsd:string ;
            sh:in ( "Clash" "Coordination" "Design" "Construction" "Safety" "Other" ) ;
            sh:maxCount 1 ;
            sh:message "issueType must be Clash / Coordination / Design / Construction / Safety / Other." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/coordination#issueType> ],
        [ sh:datatype xsd:string ;
            sh:in ( "Open" "InProgress" "Resolved" "Closed" "ReOpened" "WontFix" ) ;
            sh:maxCount 1 ;
            sh:message "issueStatus must be Open / InProgress / Resolved / Closed / ReOpened / WontFix." ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/IproK/coordination#issueStatus> ],
        [ sh:maxCount 1 ;
            sh:message "Issue must point at its owning project (ofProject, IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path integrated:ofProject ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Issue must record createdAt." ;
            sh:minCount 1 ;
            sh:path integrated:createdAt ] ;
    sh:targetClass <https://w3id.org/IproK/coordination#Issue> .

<https://w3id.org/IproK/shapes#JointMeasurementShape> a sh:NodeShape ;
    sh:or ( [ sh:not [ sh:property [ sh:hasValue integrated:JMComplete ;
                                sh:path <https://w3id.org/IproK/billing#jmStatus> ] ] ] [ sh:property [ sh:datatype xsd:dateTime ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path <https://w3id.org/IproK/billing#contractorSignedAt> ],
                    [ sh:datatype xsd:dateTime ;
                        sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:path <https://w3id.org/IproK/billing#departmentalSignedAt> ] ] ),
        ( [ sh:not [ sh:property [ sh:hasValue integrated:JMRejected ;
                                sh:path <https://w3id.org/IproK/billing#jmStatus> ] ] ] [ sh:property [ sh:maxCount 1 ;
                        sh:minCount 1 ;
                        sh:nodeKind sh:IRI ;
                        sh:path <https://w3id.org/IproK/billing#rejectedBy> ],
                    [ sh:datatype xsd:string ;
                        sh:minCount 1 ;
                        sh:minLength 1 ;
                        sh:path <https://w3id.org/IproK/billing#rejectionReason> ] ] ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "JointMeasurement must carry a jmId (e.g. JM-0001)." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://w3id.org/IproK/billing#jmId> ],
        [ sh:in ( integrated:JMPendingContractor integrated:JMPendingDepartmental integrated:JMComplete integrated:JMRejected ) ;
            sh:maxCount 1 ;
            sh:message "jmStatus must be one of the four <https://w3id.org/IproK/billing#JMStatus> individuals." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/billing#jmStatus> ],
        [ sh:maxCount 1 ;
            sh:message "JointMeasurement must identify the contractor signatory (IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/billing#contractorSignatory> ],
        [ sh:maxCount 1 ;
            sh:message "JointMeasurement must identify the departmental signatory JE/AE (IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/billing#departmentalSignatory> ],
        [ sh:maxCount 1 ;
            sh:message "JointMeasurement must reference the BOQ item (IRI)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://w3id.org/IproK/billing#measuredItem> ] ;
    sh:targetClass <https://w3id.org/IproK/billing#JointMeasurement> .

