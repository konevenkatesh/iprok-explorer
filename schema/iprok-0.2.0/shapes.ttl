<https://w3id.org/IproK/shapes#MaterialIssueShape> a sh:NodeShape ;
    sh:property [ sh:in ( "Cement" "Steel" "Bitumen" "Sand" "Aggregate" "Brick" "Other" ) ;
            sh:maxCount 1 ;
            sh:message "MaterialIssue must carry a valid material name." ;
