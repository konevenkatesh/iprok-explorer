  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#allocationForActivity">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:comment xml:lang="en">The platform activity represented by a resource allocation, refining the published task allocation connection.</rdfs:comment>
