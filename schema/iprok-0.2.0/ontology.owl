  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#forBill">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/forBill"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>for bill</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:comment>Links a &lt;https://w3id.org/iprok/billing#Recovery&gt; to its parent &lt;https://w3id.org/iprok/billing#RABill&gt;. Mandatory. Domain unspecified (antipattern #8).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/quality#overallResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/quality#Inspection"/>
