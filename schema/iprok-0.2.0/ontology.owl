    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/rateFromAnalysis"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#hasResourceType">
    <rdfs:comment xml:lang="en">The has resource type property in the integrated project information model. Its declared domain is Resource and its declared range is ResourceType.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/resource#Resource"/>
