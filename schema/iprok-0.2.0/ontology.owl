    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label>heavy vehicle access</rdfs:label>
    <rdfs:comment>False triggers an auto-risk (cement/steel can't reach site at scale).</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#compositionCount">
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">The composition count property in the integrated project information model.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/compositionCount"/>
    <rdfs:label xml:lang="en">composition Count</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#quantitiesWritten">
    <rdfs:label xml:lang="en">quantities Written</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/quantitiesWritten"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>Quantities project information interface computed and wrote back on the enrichment pass, if one ran.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#sv">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>EV − PV. Positive = ahead of schedule. INR-equivalent. Mandatory on &lt;https://w3id.org/iprok/schedule#EVMSnapshot&gt;.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/sv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:label>Schedule Variance</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#projectAddress">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">projectAddress</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Project"/>
    <rdfs:comment xml:lang="en">The project address property in the integrated project information model. Its declared domain is Project and its declared range is string.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#baselineCost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The activity's budget when frozen, in rupees. No rdfs:domain.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:label xml:lang="en">baseline Cost</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/baselineCost"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#decidedBy">
    <rdfs:label xml:lang="en">decided By</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:comment>The person who took the decision. No rdfs:domain / rdfs:range (antipattern #8).</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/decidedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#avgRainfallMM">
    <rdfs:label>average rainfall (mm)</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>10-year mean of weekly rainfall (mm) for this calendar week at this site. Drives the historical_rain_mm_avg_this_week GNN feature.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/avgRainfallMM"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/coordination#issueId">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/coordination"/>
    <rdfs:label>issue id</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/issueId"/>
    <rdfs:comment>Project-unique short id. For BCF-imported topics this is the BCF topic GUID; for manually-raised ones it's an auto-generated short id. Domain unspecified (antipattern #8).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/prediction#costOverrunRisk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/costOverrunRisk"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/prediction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>cost overrun risk (0–1)</rdfs:label>
    <rdfs:comment>Probability the activity's BOQ-linked cost will overrun by &gt;10%. Sigmoid output of the GAT cost head.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#linkedAnnotation">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:label>linked annotation</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/linkedAnnotation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Optional — the &lt;https://w3id.org/iprok/document#Annotation&gt; markup that raised this RFI (the cross-domain join markup→RFI). Domain unspecified (antipattern #8).</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/iprok/document#Annotation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#ProductivityNorm">
    <rdfs:label xml:lang="en">Productivity Norm</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>The organisation's rolled-up rate for a work type + crew type, derived from observations. Falls back to a seeded default until enough observations exist.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/ProductivityNorm"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#previousBillAmount">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>previous bill amount</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/previousBillAmount"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Value of work done up to the immediately preceding RA Bill: that bill's cumulativeGross (INR), as CPWD Form 26 deducts it. NOT its netPayable — recoveries are payments made on the contractor's behalf, not unbilled work. Zero for the first bill. Mandatory. Domain unspecified.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#tenderUnit">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/tenderUnit"/>
    <rdfs:comment xml:lang="en">The tender unit property in the integrated project information model.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdfs:label>tender unit (canonical)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#queryRole">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <rdfs:comment>One of Any / PM / Director / Auditor. Enforced in the route layer with a role-rank comparison.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/queryRole"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>minimum role to view this widget</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#RFIUnderReview">
    <rdfs:label>Under review</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/iprok/document#RFIState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/procurement#vendorCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">vendor Category</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/vendorCategory"/>
