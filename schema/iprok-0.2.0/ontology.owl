  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#reportedAgainst">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/reportedAgainst"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:comment xml:lang="en">The reported against property in the integrated project information model. Its declared domain is DPREntry and its declared range is Activity.</rdfs:comment>
    <rdfs:label>reported against</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#Activity"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/reporting#DPREntry"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
