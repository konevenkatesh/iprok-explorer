  <rdf:Description rdf:about="https://w3id.org/iprok/tender#Tender">
    <rdfs:label>Tender</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/Tender"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdfs:comment>A tender document under consideration by the org. Lives in the org catalogue graph (data/org/{oid}); pre-award. Becomes a &lt;https://w3id.org/iprok/schedule#Project&gt; only on award.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#WBSNode">
    <rdfs:label>WBS node</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>One node in the project work-breakdown structure. Recursive via &lt;https://w3id.org/iprok/schedule#parentWBS&gt;; a leaf (&lt;https://w3id.org/iprok/schedule#isWorkPackage&gt; true) is a work package.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/WBSNode"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#spi">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:label>Schedule Performance Index</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/spi"/>
    <rdfs:comment>EV / PV. &gt;1.0 ahead of schedule, &lt;1.0 behind. Optional — undefined (omitted) when PV=0.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#decisionStatus">
    <rdfs:label xml:lang="en">decision Status</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/decisionStatus"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:comment>Open | Decided | Superseded | Withdrawn. No rdfs:domain.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/property#towerId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/towerId"/>
