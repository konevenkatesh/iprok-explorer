  <rdf:Description rdf:about="https://w3id.org/iprok/site#stateAgriCalendarJson">
    <rdfs:comment>ICAR state×crop×month JSON. Kharif/Rabi harvest weeks and labour impact score. The P2B Planning Module reads this to reduce crew availability 20-35% on harvest weeks.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteLabour"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <rdfs:label>state agricultural calendar (JSON)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/stateAgriCalendarJson"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#freeFloat">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/freeFloat"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>free float (days)</rdfs:label>
    <rdfs:comment>Mirrors iprok:freeFloat. Slack available without delaying any successor. Always &lt;= totalFloat.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#demandForUnit">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/property#Unit"/>
    <rdfs:comment xml:lang="en">The unit against which a payment demand is raised.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:label xml:lang="en">demand For Unit</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/finance#DemandNote"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#highRiskCount">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/highRiskCount"/>
    <rdfs:comment>Count of line items the recommender flagged as risk_level=High (historical deviation OR rate_variance &gt; 30%).</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdfs:label>high-risk count</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#importedEdition">
    <rdfs:comment>The source edition, e.g. cpwd-dar-2023. No rdfs:domain.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdfs:label xml:lang="en">imported Edition</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/importedEdition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#gangOutput">
    <rdfs:label xml:lang="en">gang Output</rdfs:label>
    <rdfs:comment>What one gang produces in a day, in the analysis unit. Labour and plant per unit = gang size ÷ this. No rdfs:domain.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/gangOutput"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/coordination#riskCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>One of Design / Commercial / Resource / External / Technical / Regulatory / Environmental / Safety. Enforced by RiskShape sh:in.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/coordination"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/riskCategory"/>
    <rdfs:label>risk category</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#length">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:comment>Length in metres. Optional — direct-quantity entries skip the L×B×D fields.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/billing#Measurement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>length</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/length"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#fragmentsGeneratedAt">
    <rdfs:label xml:lang="en">fragments Generated At</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The fragments generated at property in the integrated project information model.</rdfs:comment>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/fragmentsGeneratedAt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#inBatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>in batch</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/inBatch"/>
    <rdfs:comment>Link from a &lt;https://w3id.org/iprok/coordination#Issue&gt; back to its &lt;https://w3id.org/iprok/coordination#ClashBatch&gt; import. Domain unspecified (antipattern #8) — re-usable on future batch-style imports.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#orgSlug">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok#Organisation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>URL-safe short identifier; unique across the platform.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:label>organisation slug</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/orgSlug"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#unitHasType">
    <rdfs:label xml:lang="en">unit Has Type</rdfs:label>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/property#UnitType"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/property#Unit"/>
    <rdfs:comment xml:lang="en">The unit archetype used to classify the sellable unit.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <vann:preferredNamespacePrefix>iprok</vann:preferredNamespacePrefix>
    <dct:description xml:lang="en">Proposed expansion of the published IproK ontology using retained platform schema declarations. Historical sources are preserved; expanded identifiers are explicitly migrated to the registered lowercase namespace. Schema validation is dated engineering verification, not historical thesis evidence.</dct:description>
    <owl:versionInfo>0.2.0-draft</owl:versionInfo>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dct:creator>Venkatesh Kone</dct:creator>
    <dct:source rdf:resource="https://github.com/konevenkatesh/IprokDoc/tree/ee4cf206af08a47db3363fa4404ac51cce1868de"/>
    <vann:preferredNamespaceUri>https://w3id.org/iprok#</vann:preferredNamespaceUri>
    <owl:imports rdf:resource="http://www.opengis.net/ont/geosparql"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/prov"/>
    <owl:imports rdf:resource="http://www.w3.org/2006/time"/>
    <owl:versionIRI rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <dct:contributor>Prof. Gangadhar Mahesh</dct:contributor>
    <dct:title xml:lang="en">Integrated Project Knowledge (IproK) ontology: expanded project-control schema</dct:title>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#workType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Optional category inferred from the SOR discipline, e.g. 'Civil', 'Electrical', 'MEP'. Domain unspecified.</rdfs:comment>
    <rdfs:comment>The work-type bucket a norm applies to, matching the P2B phase vocabulary.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/workType"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:label>work type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/document#DrawingChange">
    <rdfs:comment>One AI-detected change between two drawing revisions (added / removed / modified element, dimension, annotation, or spec). Produced by the compare_revisions task; never hand-authored.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/document"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/DrawingChange"/>
    <rdfs:label>Drawing change</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#lateFinish">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/lateFinish"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label>late finish (CPM backward pass)</rdfs:label>
    <rdfs:comment xml:lang="en">The late finish property in the integrated project information model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#totalFloat">
    <rdfs:comment>Mirrors iprok:totalFloat. Days; may be negative on a behind-schedule critical path.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/totalFloat"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>total float (days)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#effectiveDateForRate">
    <rdfs:label xml:lang="en">effectiveDateForRate</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The effective date for rate property in the integrated project information model. Its declared domain is Resource and its declared range is dateTime.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/resource#Resource"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#netPayable">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/netPayable"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:label>net payable</rdfs:label>
    <rdfs:comment>currentGross minus totalRecoveries (INR). The actual payment due to the contractor. Mandatory. SHACL arithmetic invariant: netPayable = currentGross − totalRecoveries (tolerance ±₹0.01). Domain unspecified.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nafd84519a6504ed5aa8ceabb9eb30fd0b2">
    <rdf:first rdf:resource="https://w3id.org/iprok/cost#EquipmentCost"/>
    <rdf:rest rdf:nodeID="nafd84519a6504ed5aa8ceabb9eb30fd0b3"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#projectCategory">
    <rdfs:label xml:lang="en">projectCategory</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The project category property in the integrated project information model. Its declared domain is Project and its declared range is string.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Project"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/approval#applicationRef">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/approval"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/applicationRef"/>
    <rdfs:label>application reference</rdfs:label>
    <rdfs:comment>The authority's application / file number once submitted. Domain unspecified (antipattern #8).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#weatherProfileForProject">
    <rdfs:domain rdf:resource="https://w3id.org/iprok/signal#HistoricalWeatherProfile"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#Project"/>
    <rdfs:comment xml:lang="en">The project location described by the climatology profile.</rdfs:comment>
    <rdfs:label xml:lang="en">weather Profile For Project</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#gridVoltageKV">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <rdfs:label>grid voltage (kV)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:comment xml:lang="en">The grid voltage kv property in the integrated project information model. Its declared domain is SiteUtilities and its declared range is decimal.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/gridVoltageKV"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteUtilities"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#recomputeToken">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/recomputeToken"/>
    <rdfs:label xml:lang="en">recompute Token</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>The token of the recompute that last wrote the rates. Polymorphic — antipattern #8.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#titleBlockConfirmedAt">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/titleBlockConfirmedAt"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The title block confirmed at property in the integrated project information model.</rdfs:comment>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label>title block confirmed at</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#RFIDraft">
    <rdf:type rdf:resource="https://w3id.org/iprok/document#RFIState"/>
    <rdfs:label>Draft</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#projectHasScheduleBaseline">
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:label xml:lang="en">project Has Schedule Baseline</rdfs:label>
    <rdfs:comment xml:lang="en">A frozen programme version belonging to the project.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Project"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#ScheduleBaseline"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/quality#relatedInspection">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/quality"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/quality#Inspection"/>
    <rdfs:comment xml:lang="en">The related inspection property in the integrated project information model. Its declared domain is NCR and its declared range is Inspection.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/relatedInspection"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/quality#NCR"/>
    <rdfs:label>related inspection</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/procurement#receivedAmount">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/procurement"/>
    <rdfs:label>received amount (INR)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/receivedAmount"/>
    <rdfs:comment xml:lang="en">The received amount property in the integrated project information model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#hospitalName">
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <rdfs:comment xml:lang="en">The hospital name property in the integrated project information model. Its declared domain is SiteWorkerSafety and its declared range is string.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/hospitalName"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">hospital Name</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteWorkerSafety"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#titleBlockJson">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/titleBlockJson"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>title block JSON</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>The raw AI extraction as a JSON string: {field: {value, confidence}} for drawing_number / drawing_title / revision / discipline / scale / drawn_by / checked_by / approved_by / date / project_name. The GET .../title-block endpoint returns this verbatim. Kept as one literal so the ontology stays lean (the spec mandates only titleBlockExtracted + needsReview as new predicates).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#crewHasComposition">
    <rdfs:range rdf:resource="https://w3id.org/iprok/resource#CrewComposition"/>
    <rdfs:label xml:lang="en">crew Has Composition</rdfs:label>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:comment xml:lang="en">A trade and skill composition line within a crew type.</rdfs:comment>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/resource#CrewType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#actualFinish">
