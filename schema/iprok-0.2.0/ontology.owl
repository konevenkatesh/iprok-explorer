    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/resource#ResourceType"/>
    <rdfs:label>UserDefinedResource</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#JointMeasurement">
