  <rdf:Description rdf:about="https://w3id.org/iprok/document#changeType">
    <rdfs:label>change type</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/document"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/changeType"/>
    <rdfs:comment>Added / Removed / Modified. SHACL constrains via sh:in (string literal — same idiom as &lt;https://w3id.org/iprok/schedule#linkType&gt;).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#elementType">
