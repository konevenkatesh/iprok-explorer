    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#activityHasProductivityObservation">
    <rdfs:comment xml:lang="en">A measured quantity, crew and time observation associated with the activity.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:label xml:lang="en">activity Has Productivity Observation</rdfs:label>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/resource#ProductivityObservation"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Activity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#reviewState">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">review State</rdfs:label>
    <rdfs:comment>VIDHI's review state of an answer: proposed or approved. No rdfs:domain.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/reviewState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#ifcGuid">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/ifcGuid"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>IfcGloballyUniqueId of the element the issue is on. The single most important field for cross-domain joins (Clash on IFC element → Drawing → Activity).</rdfs:comment>
    <rdfs:label>IFC GUID</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#observedActivity">
    <rdfs:comment>The &lt;https://w3id.org/iprok/schedule#Activity&gt; the work was booked against.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/observedActivity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">observed Activity</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#elementsRecorded">
    <rdfs:label xml:lang="en">elements Recorded</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>How many elements an ElementCopiesRecorded activity changed. No rdfs:domain.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/elementsRecorded"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#hasIFCScope">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/hasIFCScope"/>
    <rdfs:comment>IFC GlobalId (22-char string) of a physical element that this BOQ item covers. Repeatable — one BOQ item can span many elements (e.g. all M30 columns on a floor). Written by the BOQ-to-IFC mapper. Domain unspecified (antipattern #8).</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>has IFC scope</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#owner">
    <rdfs:comment>User responsible for managing a graph node (S4.5: &lt;https://w3id.org/iprok/coordination#Risk&gt;). Domain unspecified (antipattern #8).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:label>owner</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/owner"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#baselineLastDay">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/baselineLastDay"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:comment>The activity's last day in the baseline (inclusive). No rdfs:domain.</rdfs:comment>
    <rdfs:label xml:lang="en">baseline Last Day</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#withdrawnBy">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/withdrawnBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Who took the project's days out of the organisation's rates.</rdfs:comment>
    <rdfs:label xml:lang="en">withdrawn By</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#hasMember">
    <rdfs:comment xml:lang="en">The has member property in the integrated project information model. Its declared domain is Project and its declared range is ProjectMembership.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Project"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/hasMember"/>
