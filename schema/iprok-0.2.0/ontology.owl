    <rdfs:label xml:lang="en">Model Comment</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/ModelComment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#issuingDepartment">
