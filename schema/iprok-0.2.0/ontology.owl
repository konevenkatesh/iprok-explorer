    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#tenderSorCodeHint">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
