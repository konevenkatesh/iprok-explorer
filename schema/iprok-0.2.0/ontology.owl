    <rdfs:label>Joint Measurement</rdfs:label>
    <rdfs:comment>A joint measurement record supporting separate contractor and departmental sign-off roles.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/JointMeasurement"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#cgwbBlockCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
