    <rdfs:label>SLA breached</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>Computed boolean — true when dueDate &lt; now and state not in {Answered, Closed, Cancelled}. Set by the daily rfi_sla Celery task and on the Answered transition. Domain unspecified (antipattern #8).</rdfs:comment>
  </rdf:Description>
