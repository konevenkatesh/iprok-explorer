    <rdfs:label xml:lang="en">allocation For Activity</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/integrated#ResourceAllocation"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#projectPriceForCostResource">
    <rdfs:range rdf:resource="https://w3id.org/iprok/cost#CostResource"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/cost#ProjectResourcePrice"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:label xml:lang="en">project Price For Cost Resource</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
