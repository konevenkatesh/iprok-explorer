    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#rateVariance">
    <rdfs:comment>(quotedRate − sorBaseRate) / sorBaseRate × 100. Positive = tender priced higher than SOR; negative = tender priced lower. |variance| &gt; 20% is flagged in the match report. Absent when no SOR match OR quotedRate is null.</rdfs:comment>
    <rdfs:label>rate variance (percent, signed)</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/rateVariance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#tenderHasExtractionStatus">
    <rdfs:domain rdf:resource="https://w3id.org/iprok/tender#Tender"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:range rdf:resource="https://w3id.org/iprok/tender#ExtractionStatus"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdfs:comment xml:lang="en">The lifecycle classification of the tender extraction process.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">tender Has Extraction Status</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#generatedAt">
    <rdfs:label>generated at</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:comment>Timestamp the recurrence-detection task wrote (or last refreshed) this alert. Polymorphic — also reused by S6.2 &lt;https://w3id.org/iprok/site#SiteIntelligence&gt; (auto-generated site-context report). Domain-free per antipattern #8 so RDFS inference doesn't cross-contaminate the two classes.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/generatedAt"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#countedInModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/countedInModel"/>
    <rdfs:comment>On a &lt;https://w3id.org/iprok/building#Element&gt; whose work another model also carries: the &lt;https://w3id.org/iprok/building#IfcModel&gt; whose copy the take-off counted. No rdfs:domain.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:label>counted in model</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#estimatedValue">
    <rdfs:label>estimated value (INR)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/estimatedValue"/>
    <rdfs:comment xml:lang="en">The estimated value property in the integrated project information model.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#isWorkPackage">
    <rdfs:comment>True when this is a leaf work package — the unit of planning + control that governs BOQ / IFC / Activity. Domain unspecified (antipattern #8).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/isWorkPackage"/>
    <rdfs:label>is work package</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#closureNote">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>closure note</rdfs:label>
    <rdfs:comment xml:lang="en">The closure note property in the integrated project information model.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/closureNote"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#decisionId">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/decisionId"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:comment>Human-facing id, DEC-NNNN. No rdfs:domain.</rdfs:comment>
    <rdfs:label xml:lang="en">decision Id</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#stateCode">
    <rdfs:label>Indian state ISO code</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/stateCode"/>
    <rdfs:comment>Two-letter state code (KA / TN / MH / TG / AP / UP). Labour signals are state-specific because the festival calendar differs by region.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#elementCount">
    <rdfs:label>element count</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/elementCount"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>Number of &lt;https://w3id.org/iprok/building#Element&gt; triples extracted from a model upload. Polymorphic — domain unspecified (antipattern #8).</rdfs:comment>
