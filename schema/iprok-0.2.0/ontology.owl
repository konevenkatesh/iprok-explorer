    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The project to which an uploaded building-model revision belongs.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/building#IfcModel"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:label xml:lang="en">model For Project</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#decisionSource">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:comment>Where the question came from, e.g. plan-check. No rdfs:domain.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/decisionSource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">decision Source</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#ExpenseItem">
    <rdfs:label>ExpenseItem</rdfs:label>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:comment xml:lang="en">A cost-type classification for other project expenses.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/cost#CostType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#HistoricalWeatherProfile">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/HistoricalWeatherProfile"/>
    <rdfs:comment>10-year climatology snapshot at a project's GPS; 52 weekly buckets, each with avg rainfall + rain probability + extreme-heat probability. Source: NASA POWER (power.larc.nasa.gov), free climatology API, no auth required. Fetched once at project geocoding; treated as static climate context (re-fetch only if site GPS changes).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/signal#ExternalSignal"/>
    <rdfs:label>historical weather profile</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/document#Document">
    <rdfs:comment>A controlled project document / drawing artefact (ISO 19650 information container).</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/document"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/Document"/>
    <rdfs:label>Document</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#contingencyAmount">
    <rdfs:comment>total_quoted × contingency_pct / 100. Domain-free.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/contingencyAmount"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>contingency amount (INR)</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#contractorSignedAt">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label>contractor signed at</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/contractorSignedAt"/>
    <rdfs:comment>Timestamp of contractor OTP verification. Set when jmStatus transitions from JMPendingContractor to JMPendingDepartmental. Domain unspecified.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/document#includesDrawings">
    <rdfs:label>includes drawings</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/includesDrawings"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/document#Drawing"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/document"/>
    <rdfs:comment>Repeatable. SHACL requires sh:minCount 1 — a transmittal with no drawings is meaningless. Domain unspecified (antipattern #8).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#UserDefinedResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
