    <rdfs:label>Earned Value (BCWP)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Budgeted cost of work actually performed by statusDate. INR. Mandatory on &lt;https://w3id.org/iprok/schedule#EVMSnapshot&gt;. Domain unspecified.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#approvalSubmittedAt">
    <rdfs:label>submitted at</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/approvalSubmittedAt"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment xml:lang="en">The approval submitted at property in the integrated project information model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#priceOverride">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/priceOverride"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Optional total-price override for this unit (floor-rise, PLC, corner premium baked in). When absent, price = SBA × baseRatePerSqft.</rdfs:comment>
    <rdfs:label xml:lang="en">price Override</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#allocatedUnits">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/integrated#ResourceAllocation"/>
    <rdfs:label xml:lang="en">allocatedUnits</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:comment></rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/quality#inspectedActivity">
    <rdfs:domain rdf:resource="https://w3id.org/iprok/quality#Inspection"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/inspectedActivity"/>
    <rdfs:comment xml:lang="en">The inspected activity property in the integrated project information model. Its declared domain is Inspection and its declared range is Activity.</rdfs:comment>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#Activity"/>
    <rdfs:label>inspected activity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/quality"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#withdrawnAt">
    <rdfs:label xml:lang="en">withdrawn At</rdfs:label>
    <rdfs:comment xml:lang="en">The withdrawn at property in the integrated project information model.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/withdrawnAt"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#adoptedMastersVersion">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/adoptedMastersVersion"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:label xml:lang="en">adopted Masters Version</rdfs:label>
    <rdfs:comment xml:lang="en">The adopted masters version property in the integrated project information model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#forProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Cross-graph link from a signal in data/external/signals/{type} to the &lt;https://w3id.org/iprok/schedule#Project&gt; it pertains to. Domain-free (antipattern #8) so other downstream entities can reuse it without RDFS-inference cross-contamination.</rdfs:comment>
    <rdfs:label>for project</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/forProject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#ofOrganisation">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok#Organisation"/>
    <rdfs:label>of organisation</rdfs:label>
    <rdfs:comment>Mandatory from V0.30 on every &lt;https://w3id.org/iprok/schedule#Project&gt;. Same naming convention as &lt;https://w3id.org/iprok/integrated#ofProject&gt; (V0.29) and &lt;https://w3id.org/iprok#ofUser&gt; (V0.22). Domain intentionally unspecified so the predicate stays polymorphic — V0.31's SPARQL firewall will use it on user / project / drawing nodes alike.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/ofOrganisation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#elementName">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>element name</rdfs:label>
    <rdfs:comment>The IFC Name attribute (optional in IFC, may be empty). Free text — surfaced in the element tree + detail panel.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/elementName"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#actualCPI">
    <rdfs:label>actual CPI</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/actualCPI"/>
    <rdfs:comment>The historical project's most recent CPI (cost-performance index) from &lt;https://w3id.org/iprok/schedule#EVMSnapshot&gt; (S4.2). &gt; 1.0 = under budget; &lt; 1.0 = over budget. Null when the project has no EVM history. Domain-free.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#RABill">
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/document#Document"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/RABill"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:comment>A Running Account Bill (RA Bill); the payment instrument in Indian government and PSU construction contracts. Aggregates all approved measurements for a billing period, applies BOQ rates, deducts previous payments and recoveries, and produces the net payable amount.</rdfs:comment>
    <rdfs:label>Running Account Bill</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#phoneNumber">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/phoneNumber"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:comment xml:lang="en">The phone number property in the integrated project information model. Its declared domain is User and its declared range is string.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok#User"/>
    <rdfs:label>phone number</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#itemCount">
    <rdfs:comment>Count of &lt;https://w3id.org/iprok/tender#TenderBOQItem&gt; rows in the recommendation (matched items only — unmatched are excluded since no rate can be recommended).</rdfs:comment>
    <rdfs:comment>Denormalised count of SOR items in a library. Polymorphic — domain unspecified.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/itemCount"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdfs:label>item count</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#milestonePct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
