    <rdfs:label>ResourceConstraint</rdfs:label>
    <rdfs:comment xml:lang="en">A condition restricting the availability or use of a resource.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/document#transmittalId">
    <rdfs:comment>Project-unique zero-padded short id, e.g. "T-0042". SPARQL MAX+1 (V0.29 measurementNo posture, same as RFI-NNNN). Domain unspecified (antipattern #8).</rdfs:comment>
    <rdfs:label>transmittal id</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/document"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/transmittalId"/>
  </rdf:Description>
