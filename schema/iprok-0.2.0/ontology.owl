  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#hasSuccessorDependency">
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Task"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasSuccessorDependency</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#TaskDependency"/>
    <rdfs:comment xml:lang="en">The has successor dependency property in the integrated project information model. Its declared domain is Task and its declared range is TaskDependency.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#earlyStart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Earliest the activity can start given its predecessors. Domain-free (antipattern #8).</rdfs:comment>
    <rdfs:label>early start (CPM forward pass)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
