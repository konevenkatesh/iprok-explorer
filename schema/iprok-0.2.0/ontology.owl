  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#isPinned">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>pinned to project home?</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/isPinned"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>Pinned widgets appear on the project home below the V0.23 SummaryBar.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
