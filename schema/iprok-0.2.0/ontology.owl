    <rdfs:comment xml:lang="en">The e procurement flag property in the integrated project information model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#approvalNote">
    <rdfs:comment>Justification note recorded when a deviation is approved or rejected. Domain unspecified.</rdfs:comment>
