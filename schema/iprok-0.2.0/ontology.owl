  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/document#rfiState">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/rfiState"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/document"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/document#RFIState"/>
    <rdfs:comment>Points at one &lt;https://w3id.org/iprok/document#RFIState&gt; individual. SHACL constrains via sh:in (sh:in ONLY, no sh:class — the API validates a node's turtle in isolation, per the V0.37 cross-graph caveat). Domain unspecified (antipattern #8).</rdfs:comment>
    <rdfs:label>RFI state</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#reportCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
    <rdfs:comment>Daily reports of this work type considered for a norm — counted or set aside.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/reportCount"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">report Count</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#hasWorkPackage">
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Project"/>
