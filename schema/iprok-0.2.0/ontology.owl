    <dct:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:comment>Site latitude (degrees, WGS84) the profile was fetched for. Stored on the profile so a later GPS edit can compare + decide whether to refetch.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/profileLat"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
