    <rdfs:comment xml:lang="en">The basic-rate resource to which the project-specific price applies.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#labourCessApplicable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:label xml:lang="en">labour Cess Applicable</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/labourCessApplicable"/>
    <rdfs:comment>Whether BOCW cess is deducted from contractor bills (rather than paid at plan approval).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#demandDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
