  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#inAnalysis">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdfs:label xml:lang="en">in Analysis</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>The analysis version a line or addition belongs to. No rdfs:domain.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/inAnalysis"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#wbsName">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/wbsName"/>
    <rdfs:comment>Human-readable name of the WBS node (e.g. 'Block A', 'Substructure', 'Footing RCC'). Domain unspecified (antipattern #8).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:label>WBS node name</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/document#geometry">
    <rdfs:label>geometry</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/document"/>
    <rdfs:comment>SVG path data or a coordinate-JSON string. Page-normalised so it survives zoom. Domain unspecified (antipattern #8).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/geometry"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/approval#slaDays">
    <rdfs:comment>Statutory or practical service-level clock in days from submission (TG-bPASS style deemed approvals). 0 = no clock. Domain unspecified (antipattern #8).</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/slaDays"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/approval"/>
    <rdfs:label>SLA / deemed-approval days</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#rainProbability">
    <rdfs:comment>Empirical probability [0, 1] that this calendar week sees &gt; 25mm total rainfall, computed across the 10 years of the climatology window. Activities planned in high-rain-prob weeks should learn a delay bias.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>rain probability</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/rainProbability"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#maintainabilityRating">
    <rdfs:comment xml:lang="en">The maintainability rating property in the integrated project information model.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
