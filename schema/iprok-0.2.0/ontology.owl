    <rdfs:label xml:lang="en">actualStartDate</rdfs:label>
    <rdfs:comment xml:lang="en">The actual start date property in the integrated project information model. Its declared domain is TaskTime and its declared range is dateTime.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#queryDescription">
