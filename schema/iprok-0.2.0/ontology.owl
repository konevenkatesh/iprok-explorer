  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#materialIssueFromReceipt">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdfs:comment xml:lang="en">The receipt record supporting the site-store material issue.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/procurement#MaterialIssue"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/procurement#GoodsReceipt"/>
