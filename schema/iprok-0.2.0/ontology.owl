    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Reference to the checklist library template this inspection used (e.g. 'IS-456-concrete-pour-v0'). Hardcoded in v0; resolves to a real catalogue node in a later slice.</rdfs:comment>
    <rdfs:label>checklist template id</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/checklistTemplate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/procurement#vendorName">
