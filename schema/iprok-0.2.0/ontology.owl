    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#peakMonsoonWeek">
    <rdfs:comment xml:lang="en">The peak monsoon week property in the integrated project information model. Its declared domain is SiteClimate and its declared range is integer.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteClimate"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/peakMonsoonWeek"/>
    <rdfs:label>peak monsoon ISO week</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#ScheduleBaseline">
    <rdfs:comment>A frozen copy of the programme. Baseline 0 is the approved programme (Clause 5.1); later ones are revised programmes (Clause 5.4), each with its basis, reason and approver. Never changed or removed; the newest is the active baseline that variance and planned value are measured against.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/ScheduleBaseline"/>
    <rdfs:label xml:lang="en">Schedule Baseline</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#monsoonActiveWeeks">
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteClimate"/>
    <rdfs:comment xml:lang="en">The monsoon active weeks property in the integrated project information model. Its declared domain is SiteClimate and its declared range is integer.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/monsoonActiveWeeks"/>
    <rdfs:label>monsoon active weeks</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/quality#HoldPoint">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/quality"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/HoldPoint"/>
    <rdfs:label xml:lang="en">Hold Point</rdfs:label>
    <rdfs:comment>One inspection/witness point from the ITP, bound to a schedule activity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#breadth">
    <rdfs:comment xml:lang="en">The breadth property in the integrated project information model. Its declared domain is Measurement and its declared range is decimal.</rdfs:comment>
