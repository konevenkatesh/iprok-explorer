    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/visualType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#baselineStartDate">
    <rdfs:comment>The baseline's first planned day. No rdfs:domain.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">baseline Start Date</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/baselineStartDate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#allocationPlannedFinishDate">
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:comment xml:lang="en">The allocation planned finish date property in the integrated project information model. Its declared domain is ResourceAllocation and its declared range is dateTime.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/integrated#ResourceAllocation"/>
