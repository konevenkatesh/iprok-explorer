    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#ExtractionStatus">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/ExtractionStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdfs:label>Extraction Status</rdfs:label>
    <rdfs:comment>Lifecycle state of the tender PDF → BOQ extraction pipeline. Values: Pending, Running, Complete, Failed, NeedsReview.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#createdBy">
    <rdfs:label>created by</rdfs:label>
    <rdfs:comment>User who authored a graph node (S4.6: &lt;https://w3id.org/iprok/reporting#SavedQuery&gt;). Domain unspecified (antipattern #8).</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/createdBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#coversMeasurement">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Links a &lt;https://w3id.org/iprok/billing#JointMeasurement&gt; to the &lt;https://w3id.org/iprok/billing#Measurement&gt; nodes it certifies. Repeatable. Domain unspecified.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/coversMeasurement"/>
    <rdfs:label>covers measurement</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#activityPlannedFinishDate">
    <rdfs:comment>Mirrors iprok:plannedFinishDate. Domain unspecified (antipattern #8).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/plannedFinishDate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label>planned finish (datetime)</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#collectionToEscrow">
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:comment xml:lang="en">The designated escrow account receiving the escrow portion of the collection.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
