    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#JMComplete">
    <rdf:type rdf:resource="https://w3id.org/iprok/billing#JMStatus"/>
    <rdfs:label>Complete</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#recommendedBid">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/recommendedBid"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>recommended bid (INR)</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>total_quoted + contingency_amount. The MD-facing single number. Domain-free.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#revision">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:label>revision</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/revision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Revision tag, e.g. "Rev A", "P1", "C3". Domain unspecified (antipattern #8).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#activityPlannedStartDate">
    <rdfs:label>planned start (datetime)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Mirrors iprok:plannedStartDate. Domain unspecified (antipattern #8). Distinct from the V0.22 Project &lt;https://w3id.org/iprok#plannedStart&gt;.</rdfs:comment>
