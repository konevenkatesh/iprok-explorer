  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#pv">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/pv"/>
