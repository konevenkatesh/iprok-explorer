>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#wbsCode">
    <rdfs:label>WBS code</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/wbsCode"/>
    <rdfs:comment xml:lang="en">The wbs code property in the integrated project information model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#projectHasDocument">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Project"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/document#Document"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:label xml:lang="en">project Has Document</rdfs:label>
    <rdfs:comment xml:lang="en">A controlled document belonging to the project.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#sorItemSupportsBOQItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:comment xml:lang="en">A reference-rate item supporting a project BOQ item.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/tender#SORItem"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/billing#BOQItem"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:label xml:lang="en">sor Item Supports BOQItem</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#resourceMappingToCostResource">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/cost#ResourceMapping"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/cost#CostResource"/>
    <rdfs:label xml:lang="en">resource Mapping To Cost Resource</rdfs:label>
    <rdfs:comment xml:lang="en">The organisation cost resource represented by an external resource mapping.</rdfs:comment>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#matchStrategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>How the match landed. Values: 'exact-code' | 'fuzzy-desc' | 'jargon-normalised' | 'no-match'. SHACL sh:in (string literals, antipattern #13).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/matchStrategy"/>
    <rdfs:label>match strategy</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#governedBy">
    <rdfs:comment>Link from &lt;https://w3id.org/iprok/billing#BOQItem&gt; to the &lt;https://w3id.org/iprok/tender#SORItem&gt; that provides its rate. Null for star-rate items. Domain unspecified — antipattern #8.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/governedBy"/>
    <rdfs:label>governed by</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#LabourSignal">
    <rdfs:label>labour signal</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:comment>Per-week per-state labour availability score (0-1, where 0 = peak festival/harvest absence). Reason field carries the cause: Diwali / Pongal / Kharif harvest / Normal. Source: calendarific.com API + ICAR crop calendar.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/LabourSignal"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/signal#ExternalSignal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#ComparableProject">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/ComparableProject"/>
    <rdfs:comment>One row of the bid-intelligence audit trail for a tender. Links a &lt;https://w3id.org/iprok/tender#Tender&gt; to a historical &lt;https://w3id.org/iprok/schedule#Project&gt; that the comparator scored as similar, with the score decomposition + the historical project's outcome signals attached.</rdfs:comment>
    <rdfs:label>Comparable Project</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#mastersSetAt">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/mastersSetAt"/>
    <rdfs:label xml:lang="en">masters Set At</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:comment xml:lang="en">The masters set at property in the integrated project information model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#bcfGuid">
    <rdfs:comment>The original BCF topic GUID — used for idempotent round-trip import/export (same GUID → update, not duplicate).</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/bcfGuid"/>
    <rdfs:label>BCF GUID</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#dueDate2">
    <rdfs:label xml:lang="en">due Date2</rdfs:label>
    <rdfs:comment>Payment due date. Named dueDate2 because &lt;https://w3id.org/iprok#dueDate&gt; exists with task semantics elsewhere; both stay domain-free.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/dueDate2"/>
  </rdf:Description>
