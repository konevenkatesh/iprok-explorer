    <rdfs:comment>Server-computed: receiptAmount − escrowShare (no penny drift).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#dependsOnApproval">
    <rdfs:comment>Chain edge: this approval is normally taken up after the referenced one (e.g. CC depends on PlanSanction). Advisory ordering, not a hard gate. Domain unspecified (antipattern #8).</rdfs:comment>
    <rdfs:label>depends on approval</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/dependsOnApproval"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/approval#Approval"/>
