  <rdf:Description rdf:about="https://w3id.org/iprok/document#RFIState">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/document"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>RFI state</rdfs:label>
    <rdfs:comment>RFI lifecycle. Transitions (enforced in the API): Draft-&gt;Submitted (raiser); Submitted-&gt;UnderReview (assignee/PM); UnderReview-&gt;Answered (assignee); Answered-&gt;Closed (raiser confirms); Answered-&gt;UnderReview (raiser rejects); any-&gt;Cancelled (PM/Admin). Modelled like &lt;https://w3id.org/iprok/document#DrawingState&gt; / &lt;https://w3id.org/iprok/quality#NCRStatus&gt;.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/RFIState"/>
  </rdf:Description>
