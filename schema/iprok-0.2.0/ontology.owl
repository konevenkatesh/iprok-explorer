    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/crewHeadcount"/>
    <rdfs:comment>People on the job for this DPR entry. Optional — pre-P2A DPRs have none and must stay conformant.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">crew Headcount</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
  </rdf:Description>
