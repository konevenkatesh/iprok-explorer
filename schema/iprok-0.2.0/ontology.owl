    <rdfs:range rdf:resource="https://w3id.org/iprok#Actor"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:comment xml:lang="en">The actor assigned responsibility for the activity.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#defectDescription">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/defectDescription"/>
    <rdfs:label>defect description</rdfs:label>
    <rdfs:comment>Lowercase-normalised, whitespace-collapsed copy of the repeated &lt;https://w3id.org/iprok/quality#failureNote&gt;. Normalisation lives in the Celery task and is the join key — keep it stable. Also reused by &lt;https://w3id.org/iprok/handover#DLPDefect&gt; (N8).</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#measuredItem">
    <rdfs:label>measured item</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/measuredItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:comment>Polymorphic — links either a &lt;https://w3id.org/iprok/billing#Measurement&gt; or &lt;https://w3id.org/iprok/billing#JointMeasurement&gt; to the &lt;https://w3id.org/iprok/billing#BOQItem&gt; it covers. Domain intentionally left unspecified (antipattern #8): declaring rdfs:domain &lt;https://w3id.org/iprok/billing#Measurement&gt; would cause RDFS inference to classify every &lt;https://w3id.org/iprok/billing#JointMeasurement&gt; that carries this predicate as also a &lt;https://w3id.org/iprok/billing#Measurement&gt;, tripping MeasurementShape.</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/iprok/billing#BOQItem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#withdrawalFromEscrow">
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:label xml:lang="en">withdrawal From Escrow</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The designated account from which certified funds are withdrawn.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/finance#EscrowWithdrawal"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/finance#EscrowAccount"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#demandStatus">
    <rdfs:comment>Raised | Cancelled. Settled/overdue are computed from receipts, never asserted.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/demandStatus"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:label xml:lang="en">demand Status</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#signatureCertificate">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:comment>Optional PEM/base64 certificate provided by the signature provider.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/signatureCertificate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>signature certificate</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#decisionQuestion">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:comment>What had to be decided, in plain language. No rdfs:domain.</rdfs:comment>
    <rdfs:label xml:lang="en">decision Question</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/decisionQuestion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/procurement#offerId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:comment xml:lang="en">The offer id property in the integrated project information model.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/procurement"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/offerId"/>
    <rdfs:label xml:lang="en">offer Id</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#overallScore">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">overall Score</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/overallScore"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Mean readiness across the uses that bear on this model, 0-100. Uses with no applicable element are skipped, never scored zero.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/coordination#Issue">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/coordination"/>
    <rdfs:label>Issue</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/coordination#Event"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/Issue"/>
    <rdfs:comment>A BCF-imported clash / coordination / design / safety / construction issue, or a manually-raised graph-native one. Linked to an IFC element GUID + optionally to an RFI / Drawing / Activity; the cross-domain closure chain (Clash → RFI → Drawing → Activity) that no point solution can answer natively.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#affectsSoldUnits">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/affectsSoldUnits"/>
    <rdfs:comment>True when the option changes sanctioned plans or specs of sold units — triggers the RERA Section 14(2) 2/3-allottee-consent gate at decision time.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">affects Sold Units</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#baselineOf">
    <rdfs:comment>The live activity an entry froze. No rdfs:domain.</rdfs:comment>
    <rdfs:label xml:lang="en">baseline Of</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/baselineOf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#plannedEnd">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Project"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:comment xml:lang="en">The planned end property in the integrated project information model. Its declared domain is Project and its declared range is date.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/plannedEnd"/>
    <rdfs:label>planned end date</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/quality#inspectedAt">
    <rdfs:comment xml:lang="en">The inspected at property in the integrated project information model. Its declared domain is Inspection and its declared range is dateTime.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/quality"/>
    <rdfs:label>inspected at</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/quality#Inspection"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/inspectedAt"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#stipulatedFinishDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:label xml:lang="en">stipulated Finish Date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:comment>The completion date the contract stipulates while this baseline is in force: the approved programme's last day plus every extension of time granted (CPWD Clause 5.2/5.3). Clause 5.4's 10% is of the period to this date. An agreed amendment does not move it. No rdfs:domain.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/stipulatedFinishDate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#Organisation">
    <rdfs:comment>An organisation owning project records and defining a tenant boundary.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:label>Organisation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/Organisation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#workerAccount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">worker Account</rdfs:label>
    <rdfs:comment>Optional link to a &lt;https://w3id.org/iprok#User&gt;, when this worker also has a platform login. Most do not.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/workerAccount"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#rateAsOf">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdfs:label xml:lang="en">rate As Of</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/rateAsOf"/>
    <rdfs:comment>The date a rate was last confirmed. No rdfs:domain.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#SkillCertification">
    <rdfs:label xml:lang="en">Skill Certification</rdfs:label>
    <rdfs:comment>A certification held by a worker, with a validity window so expiry is queryable.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/SkillCertification"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#predictionUsesBaseline">
    <rdfs:comment xml:lang="en">The schedule baseline against which the activity outcome is defined.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/prediction#ActivityPrediction"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#ScheduleBaseline"/>
    <rdfs:label xml:lang="en">prediction Uses Baseline</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#priceRate">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>The project's rate per unit, in rupees. No rdfs:domain.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/priceRate"/>
    <rdfs:label xml:lang="en">price Rate</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#Rejected">
    <rdfs:label>Rejected</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/iprok/quality#NCRStatus"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#SiteClimate">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/site#SiteIntelligence"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/SiteClimate"/>
    <rdfs:label>Site Climate</rdfs:label>
    <rdfs:comment>NASA POWER 10-year climatology: monsoon onset/withdrawal ISO weeks + annual rainfall + heat-wave days/year. Companion to the S6.6+ &lt;https://w3id.org/iprok/signal#HistoricalWeatherProfile&gt; (which holds the 52-week probability profile).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#reportedQuantity">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <rdfs:comment xml:lang="en">The reported quantity property in the integrated project information model. Its declared domain is DPREntry and its declared range is decimal.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>reported quantity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/reporting#DPREntry"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/reportedQuantity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#dewateringRequired">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/dewateringRequired"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>dewatering required</rdfs:label>
    <rdfs:comment>True when groundwaterDepthPreMonsoonM &lt; 3.0 — i.e. excavation will hit water table.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteHydrology"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#RFIAnswered">
    <rdf:type rdf:resource="https://w3id.org/iprok/document#RFIState"/>
    <rdfs:label>Answered</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#integrityPactFlag">
    <rdfs:comment xml:lang="en">The integrity pact flag property in the integrated project information model.</rdfs:comment>
    <rdfs:label>integrity pact flag</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/integrityPactFlag"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#checkedAt">
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:comment xml:lang="en">The checked at property in the integrated project information model.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label xml:lang="en">checked At</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/checkedAt"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#rateAnalysisHasAddition">
    <rdfs:domain rdf:resource="https://w3id.org/iprok/cost#RateAnalysis"/>
    <rdfs:comment xml:lang="en">An ordered percentage addition in the analysis of rates.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:label xml:lang="en">rate Analysis Has Addition</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/iprok/cost#AnalysisAddition"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#deviationPct">
    <rdfs:comment>Deviation as a percentage of tendered quantity: (measured - tendered) / tendered × 100. Mandatory. Domain unspecified.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:label>deviation percentage</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/deviationPct"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#sourceCitation">
    <rdfs:comment>Document, edition, volume, page and item of the printed source, in words a quantity surveyor can look up. No rdfs:domain.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/sourceCitation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">source Citation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#sorCode">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/sorCode"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>SOR code</rdfs:label>
    <rdfs:comment>Rate-book item code, e.g. '2.1.1.1'. Polymorphic — domain unspecified (antipattern #8).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#sorLibraryHasItem">
    <rdfs:comment xml:lang="en">A rate item contained in a schedule-of-rates publication.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/tender#SORLibrary"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/tender#SORItem"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdfs:label xml:lang="en">sor Library Has Item</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
  </rdf:Description>
