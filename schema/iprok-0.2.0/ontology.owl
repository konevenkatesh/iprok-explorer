    <rdfs:comment>Server commit timestamp on Issue / future Event subclasses. Polymorphic — domain unspecified (antipattern #8).</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/createdAt"/>
    <rdfs:label>created at</rdfs:label>
