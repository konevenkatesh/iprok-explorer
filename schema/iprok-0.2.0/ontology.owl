    <rdfs:range rdf:resource="https://w3id.org/iprok#ProjectMembership"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#predictionUsesWeatherProfile">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:label xml:lang="en">prediction Uses Weather Profile</rdfs:label>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/prediction#ActivityPrediction"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/signal#HistoricalWeatherProfile"/>
    <rdfs:comment xml:lang="en">The retained climatology profile referenced as an input source for the prediction record.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#viewName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/viewName"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">view Name</rdfs:label>
    <rdfs:comment>Which generated view the comment was made in — '3D', a storey plan name, or an elevation name.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/safety#linkedActivity">
    <rdfs:domain rdf:resource="https://w3id.org/iprok/safety#Incident"/>
    <rdfs:label>linked activity</rdfs:label>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/safety"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#Activity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The linked activity property in the integrated project information model. Its declared domain is Incident and its declared range is Activity.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/linkedActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#HistoricalWeatherWeek">
    <rdfs:label>historical weather week</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/HistoricalWeatherWeek"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:comment>One ISO week-of-year bucket (1..53) of the climatology profile. 52 instances per HistoricalWeatherProfile; the GNN reads three scalars from the week-bucket whose ISO week matches an activity's planned-start.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#recoveryRate">
    <rdfs:comment>Percentage rate applied to the recovery base (e.g. 0.02 for 2%). Mandatory. Domain unspecified.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/recoveryRate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>recovery rate</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#LaborResource">
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:label>LaborResource</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/resource#ResourceType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A resource-type classification for labour.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#hasTaskTime">
    <rdfs:label>hasTaskTime</rdfs:label>
    <rdfs:comment xml:lang="en">The has task time property in the integrated project information model. Its declared domain is Task and its declared range is TaskTime.</rdfs:comment>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Task"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#TaskTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#locationRef">
    <rdfs:comment>Free-text location label (e.g. 'Col C-12, Floor 2'). Distinct from &lt;https://w3id.org/iprok/reporting#locationWkt&gt; (GPS) and &lt;https://w3id.org/iprok/integrated#zone&gt; (auto-inferred from GPS).</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/locationRef"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/billing#Measurement"/>
    <rdfs:label>location reference</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#processGroup">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/processGroup"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:comment>Initiation | Planning | Execution | Monitoring | Closing. Polymorphic — domain-free per antipattern #8 (every PG-affiliated entity carries this predicate).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>PMBOK process group</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#linkedElement">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/linkedElement"/>
    <rdfs:comment>Optional — an IFC GlobalId (GUID) the markup points at. The cross-domain join to the model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:label>linked element</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#weatherCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>The weather on site for this report: Fair | Cloudy | LightRain | HeavyRain | Waterlogged | ExtremeHeat | HighWind. Polymorphic — antipattern #8.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/weatherCondition"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <rdfs:label xml:lang="en">weather Condition</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#ProductivityRecompute">
    <rdfs:label>Productivity recompute</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>The per-organisation claim token for writing measured rates.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/ProductivityRecompute"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#withdrawalDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:comment xml:lang="en">The withdrawal date property in the integrated project information model.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/withdrawalDate"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:label xml:lang="en">withdrawal Date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#finalDays">
    <rdfs:label xml:lang="en">final Days</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/finalDays"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>Planned duration after allowances. No rdfs:domain.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/procurement#unitRate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:label xml:lang="en">unit Rate</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/procurement"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/unitRate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="en">The unit rate property in the integrated project information model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/prediction#predictedFloatChange">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/predictedFloatChange"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/prediction"/>
    <rdfs:comment>tanh-bounded change in totalFloat. Negative = float will shrink. Range [-30, +30].</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>predicted float change (days)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#valueAfter">
    <rdfs:comment>A value the property has after the change (IRI or literal). No rdfs:domain.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/valueAfter"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#externalCode">
    <rdfs:label xml:lang="en">external Code</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/externalCode"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>A code of an outside source, e.g. the DAR resource code 0114. No rdfs:domain.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#costDeltaAmount">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/costDeltaAmount"/>
    <rdfs:label xml:lang="en">cost Delta Amount</rdfs:label>
    <rdfs:comment>Signed cost impact in ₹ against the working estimate.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#photoUri">
    <rdfs:comment xml:lang="en">The photo uri property in the integrated project information model. Its declared domain is Photo and its declared range is anyURI.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/reporting#Photo"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <rdfs:label>photo URI</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/photoUri"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#publicTransportDistanceM">
    <rdfs:label>public transport distance (m)</rdfs:label>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/publicTransportDistanceM"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="en">The public transport distance m property in the integrated project information model. Its declared domain is SiteLabour and its declared range is decimal.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteLabour"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#receiptId">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/receiptId"/>
    <rdfs:label xml:lang="en">receipt Id</rdfs:label>
    <rdfs:comment xml:lang="en">The receipt id property in the integrated project information model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#hasTrackingTag">
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasTrackingTag</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/iprok/resource#TrackingTag"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/resource#Resource"/>
    <rdfs:comment xml:lang="en">The has tracking tag property in the integrated project information model. Its declared domain is Resource and its declared range is TrackingTag.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#titleBlockExtracted">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:label>title block extracted</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Boolean on &lt;https://w3id.org/iprok/document#Drawing&gt; — true once the extract_title_block task has run (success OR fail-soft no-op marks nothing; only a successful extraction sets it true). Domain unspecified (antipattern #8).</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/titleBlockExtracted"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#jointMeasurementIncludesMeasurement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/billing#Measurement"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:label xml:lang="en">joint Measurement Includes Measurement</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/billing#JointMeasurement"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:comment xml:lang="en">A measurement included in a joint-signature record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#sourceChunk">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/sourceChunk"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:label>source chunk index</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:comment xml:lang="en">The source chunk property in the integrated project information model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#vendorName">
    <rdfs:label xml:lang="en">vendorName</rdfs:label>
    <rdfs:comment xml:lang="en">The vendor name property in the integrated project information model. Its declared domain is CostItem and its declared range is string.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/cost#CostItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#resolvedBy">
    <rdfs:comment>Who resolved this comment. Range undeclared (antipattern #8).</rdfs:comment>
    <rdfs:label xml:lang="en">resolved By</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/resolvedBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#ElementCopiesRecorded">
    <rdfs:comment>N41.1; the act of keeping, on each copy, which model's element the take-off counted it as. Carries the person, the time, the take-off it came from (rdfs:comment) and how many elements changed; each changed element points back at it (prov:wasInfluencedBy).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/ElementCopiesRecorded"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
    <rdfs:label>element copies recorded</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#pilotStatus">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/pilotStatus"/>
    <rdfs:label>pilot status</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok#PilotStatus"/>
    <rdfs:comment>An Organisation's pilot-lifecycle state. Domain intentionally unspecified (polymorphic-predicate discipline, antipattern #8) even though v0 uses it only on &lt;https://w3id.org/iprok#Organisation&gt;; OrgShape constrains the allowed individuals.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/document#Drawing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/document#Document"/>
    <rdfs:label>Drawing</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/document"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/Drawing"/>
    <rdfs:comment>A construction drawing (GA / Detail / Section / Elevation / Layout / Schematic). One node per (drawingId, revision); &lt;https://w3id.org/iprok/integrated#supersedes&gt; links a new revision to the one it replaces (S2.1).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#paymentAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:comment>INR amount of the payment (absolute value — Tally stores as negative). Mandatory.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/paymentAmount"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>payment amount</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#description">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:label>description</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/description"/>
    <rdfs:comment xml:lang="en">The description property in the integrated project information model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/creator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/quality#failureNote">
    <rdfs:comment>Free-text explanation of a quality failure. Used on both &lt;https://w3id.org/iprok/quality#ChecklistItem&gt; (where SHACL requires it iff itemResult='fail') and &lt;https://w3id.org/iprok/quality#NCR&gt; (where it's copied from the failed item). Domain intentionally left unspecified — adding `rdfs:domain &lt;https://w3id.org/iprok/quality#ChecklistItem&gt;` would make every NCR get RDFS-inferred as a ChecklistItem and trip ChecklistItemShape.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/failureNote"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/quality"/>
    <rdfs:label>failure note</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/coordination#ClashBatch">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/ClashBatch"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/coordination"/>
    <rdfs:label>BCF clash batch</rdfs:label>
    <rdfs:comment>One BCF-zip import. Used by the clash lifecycle dashboard to roll up closure rates per batch.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#importedRecordVersion">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/importedRecordVersion"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The outside record's content version at import, e.g. sha256:… — the key for 'already imported, unchanged'. No rdfs:domain.</rdfs:comment>
    <rdfs:label xml:lang="en">imported Record Version</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#productivityRate">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/productivityRate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">productivity Rate</rdfs:label>
    <rdfs:comment>observedQuantity ÷ crewDays, i.e. output per person-day. Server-computed; never trusted from the client.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#tenderDiscipline">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/tenderDiscipline"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>tender discipline</rdfs:label>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The tender discipline property in the integrated project information model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#signalDate">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/signalDate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:comment>Calendar date the signal value pertains to (weather: that day; material price: that week's settlement; labour: week start). Domain-free.</rdfs:comment>
    <rdfs:label>signal date</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#contractorSignatory">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/contractorSignatory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:label>contractor signatory</rdfs:label>
    <rdfs:comment>Points at the &lt;https://w3id.org/iprok#User&gt; who represents the contractor. Mandatory. Domain unspecified.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#CrewType">
    <rdfs:comment>A named gang the organisation deploys; 'Mason gang (6)', 'Bar bender gang (4)'. Org-level catalogue.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Crew Type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/CrewType"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/safety#immediateCause">
    <rdfs:domain rdf:resource="https://w3id.org/iprok/safety#Incident"/>
    <rdfs:comment>Free-text first-pass cause. Root-cause analysis lives at V0.28.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/immediateCause"/>
