    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdfs:label xml:lang="en">adoption Uses Masters</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/iprok#OrganisationMasters"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok#MastersAdoption"/>
    <rdfs:comment xml:lang="en">The masters version adopted by a project.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#SiteLogistics">
    <rdfs:label>Site Logistics</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/SiteLogistics"/>
    <rdfs:comment>OSM-derived road / RMC / steel depot / rail / air. Drives the no-heavy-vehicle-access auto-risk.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/site#SiteIntelligence"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#securityDepositPct">
    <rdfs:label xml:lang="en">security Deposit Pct</rdfs:label>
    <rdfs:comment>Retention deducted from each contractor bill, in percent.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/securityDepositPct"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#SORLibrary">
    <rdfs:comment>A Schedule of Rates publication ingested into the platform. Platform-wide reference data, not per-project.</rdfs:comment>
    <rdfs:label>SOR Library</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/SORLibrary"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#resourceName">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/resourceName"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">resource Name</rdfs:label>
    <rdfs:comment>What the resource is, e.g. 'Cement OPC 53 grade, 50 kg bag'. No rdfs:domain.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#gradeStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/gradeStatus"/>
    <rdfs:comment>is2062 | foreign_stated | stated_strength | assumed | not_stated | unrecognised; absent when VIDHI refused the member whole. No rdfs:domain.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">grade Status</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#statusDate">
    <rdfs:comment>The data-date of the EVM snapshot — every activity and bill is rolled up as of this calendar day. Mandatory on &lt;https://w3id.org/iprok/schedule#EVMSnapshot&gt;. Domain unspecified (antipattern #8).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:label>EVM status date</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/statusDate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#isPrimaryResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">isPrimaryResource</rdfs:label>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:comment xml:lang="en">The is primary resource property in the integrated project information model. Its declared domain is Resource and its declared range is boolean.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/resource#Resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#paymentDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/paymentDate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:comment>Date the payment was made (from Tally voucher DATE tag). Mandatory.</rdfs:comment>
    <rdfs:label>payment date</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#material">
    <rdfs:comment>Material identifier: 'Steel-TMT' | 'Cement' | 'Bitumen' | 'Aggregate' | 'Sand' | 'Brick'. Polymorphic; matches the &lt;https://w3id.org/iprok/procurement#MaterialIssue&gt;.material vocabulary.</rdfs:comment>
    <rdfs:comment>Material type: Cement, Steel, Bitumen, Sand, Aggregate, Brick, Other. Mandatory. Domain unspecified.</rdfs:comment>
    <rdfs:label>material name</rdfs:label>
    <rdfs:label>material</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/material"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#jointSignatureRequired">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>Computed server-side: true when the cumulative amount for this BOQ item (sum of measurement quantities × quoted rate) exceeds the project's joint_measurement_threshold. A true flag primes the SE to get the JE/AE co-sign in S3.5. Domain unspecified (antipattern #8).</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/jointSignatureRequired"/>
    <rdfs:label>joint signature required</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#rmc2DistanceKm">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/rmc2DistanceKm"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>RMC plant 2 distance (km)</rdfs:label>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteLogistics"/>
    <rdfs:comment xml:lang="en">The rmc2distance km property in the integrated project information model. Its declared domain is SiteLogistics and its declared range is decimal.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#needsReview">
    <rdfs:comment>Boolean — set true when any AI-extracted title-block field has confidence &lt; 0.7, cleared when a user confirms the extraction. Polymorphic (any AI-written node can carry it); domain unspecified (antipattern #8).</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/needsReview"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label>needs review</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#dustRiskMonths">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>dust risk months</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteWorkerSafety"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Comma-separated month abbreviations where PM10 &gt; 250 µg/m³ typical.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/dustRiskMonths"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#locationWkt">
    <rdfs:label>location (WKT)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/locationWkt"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Inline WKT POINT(lng lat) literal. Used on DPREntry and Photo.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#ElementDuplicatesRetired">
    <rdfs:comment>N41.2; the startup migration retiring, in one project graph, the extra element nodes the pre-N41.2 parser wrote. Carries when it started and ended, how many nodes it retired, and (&lt;https://w3id.org/iprok/integrated#hadChange&gt;) each model element count it corrected from the duplicated count to the number of distinct elements.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/ElementDuplicatesRetired"/>
    <rdfs:label>element duplicates retired</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#demandId">
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/demandId"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The demand id property in the integrated project information model.</rdfs:comment>
    <rdfs:label xml:lang="en">demand Id</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#rmc1DistanceKm">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/rmc1DistanceKm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <rdfs:label>RMC plant 1 distance (km)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteLogistics"/>
    <rdfs:comment xml:lang="en">The rmc1distance km property in the integrated project information model. Its declared domain is SiteLogistics and its declared range is decimal.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/coordination#batchId">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/coordination"/>
    <rdfs:label>batch id (BCH-NNNN)</rdfs:label>
    <rdfs:comment xml:lang="en">The batch id property in the integrated project information model.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/batchId"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/procurement#leadTimeDays">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/procurement"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/leadTimeDays"/>
    <rdfs:comment xml:lang="en">The lead time days property in the integrated project information model.</rdfs:comment>
    <rdfs:label xml:lang="en">lead Time Days</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#groundwaterDepthPostMonsoonM">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteHydrology"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <rdfs:comment xml:lang="en">The groundwater depth post monsoon m property in the integrated project information model. Its declared domain is SiteHydrology and its declared range is decimal.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/groundwaterDepthPostMonsoonM"/>
    <rdfs:label>groundwater depth post-monsoon (m)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#projectRequiresApproval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/approval#Approval"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Project"/>
    <rdfs:label xml:lang="en">project Requires Approval</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:comment xml:lang="en">A statutory approval required or tracked by the project.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/document#drawingId">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>drawing id</rdfs:label>
    <rdfs:comment>Project-unique sheet number, e.g. "S-101". Domain unspecified (antipattern #8).</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/document"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/drawingId"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#Decision">
    <rdfs:comment>A question about the project and the answer a named person gave to it.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/Decision"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">Decision</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#workerPerformsActivity">
    <rdfs:domain rdf:resource="https://w3id.org/iprok/resource#Worker"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of Worker and Activity; not a claim that the retained runtime already writes this predicate.</dct:description>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:label xml:lang="en">worker Performs Activity</rdfs:label>
    <rdfs:comment xml:lang="en">The scheduled activity to which the worker is assigned to perform site work.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#Activity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#measurementNo">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/measurementNo"/>
    <rdfs:label>measurement number</rdfs:label>
    <rdfs:comment>Sequential entry number within a single BOQ item (1, 2, 3, …). Auto-assigned server-side via SPARQL MAX(?n)+1; the mobile UI does not pick this.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/billing#Measurement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#optionId">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdfs:comment>Stable id within the project (DO-0001). Domain unspecified (antipattern #8).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/optionId"/>
    <rdfs:label xml:lang="en">option Id</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/document#rfiId">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/document"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/rfiId"/>
    <rdfs:comment>Project-unique, zero-padded, e.g. "RFI-0042". Sequential per project (SPARQL MAX+1, same proven pattern as V0.29 measurementNo — FusekiRepo is Fuseki-only per the Layering rule, so no Redis client in the SPARQL layer). Domain unspecified (antipattern #8).</rdfs:comment>
    <rdfs:label>RFI id</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#measuredQty">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>Cumulative measured quantity at the time of the bill computation. Mandatory on Deviation. Domain unspecified.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:label>measured quantity</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/measuredQty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#resourceCode">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdfs:comment>The organisation's code for a cost resource, e.g. MAT-CEMENT-OPC53. Lines and project prices refer to it. No rdfs:domain.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/resourceCode"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">resource Code</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/quality#NCR">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/NCR"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>Raised automatically when a checklist item fails. Status starts Open; closure flow added in V0.19.</rdfs:comment>
    <rdfs:label>Non-Conformance Report</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/quality"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#signalForProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#Project"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/signal#ExternalSignal"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdfs:comment xml:lang="en">The project context to which an external signal is applied.</rdfs:comment>
    <rdfs:label xml:lang="en">signal For Project</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#taskRelationshipType">
    <rdfs:comment xml:lang="en">The task relationship type property in the integrated project information model. Its declared domain is TaskDependency and its declared range is string.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#TaskDependency"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:label xml:lang="en">taskRelationshipType</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#purchaseOrderToVendor">
    <rdfs:range rdf:resource="https://w3id.org/iprok/procurement#Vendor"/>
    <rdfs:label xml:lang="en">purchase Order To Vendor</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/procurement#PurchaseOrder"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:comment xml:lang="en">The supplier to which the purchase order is issued.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/prediction#modelVersion">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>model version</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/prediction"/>
    <rdfs:comment>Model identifier like 'gat-v1'. Lets the UI flag stale predictions when the model is retrained.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/modelVersion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#seededDailyOutput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The default (CPWD-style) crew-day output, kept beside a measured rate so the difference stays visible. No rdfs:domain.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:label xml:lang="en">seeded Daily Output</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/seededDailyOutput"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/quality#RecurrenceAlert">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/RecurrenceAlert"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/quality"/>
    <rdfs:comment>A repeated defect on the same activity, surfaced from grouping failed checklist items by (activity, normalised failure note). Status uses the &lt;https://w3id.org/iprok/quality#NCRStatus&gt; IRIs (&lt;https://w3id.org/iprok/integrated#Open&gt; / &lt;https://w3id.org/iprok/integrated#Acknowledged&gt; at V0.28; UnderReview/Closed/Rejected reserved for later).</rdfs:comment>
    <rdfs:label>Recurrence alert</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/quality#relatedItem">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/quality"/>
    <rdfs:label>related checklist item</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/iprok/quality#ChecklistItem"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/quality#NCR"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/relatedItem"/>
    <rdfs:comment xml:lang="en">The related item property in the integrated project information model. Its declared domain is NCR and its declared range is ChecklistItem.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#budgetedUnits">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:label xml:lang="en">budgetedUnits</rdfs:label>
    <rdfs:comment xml:lang="en">The budgeted units property in the integrated project information model. Its declared domain is Resource and its declared range is decimal.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/resource#Resource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#AnalysisAddition">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:comment>A percentage added to an analysis in order, on a stated base; water charges on cost, contractor's profit and overheads on the running total.</rdfs:comment>
    <rdfs:label xml:lang="en">Analysis Addition</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/AnalysisAddition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#ac">
    <rdfs:comment>Sum of approved/finalised RA Bill netPayable by statusDate. INR. Mandatory on &lt;https://w3id.org/iprok/schedule#EVMSnapshot&gt;. Domain unspecified.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/ac"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>Actual Cost (ACWP)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#profileLng">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/profileLng"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:label>profile longitude</rdfs:label>
    <rdfs:comment>Site longitude (degrees, WGS84) the profile was fetched for.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#recomputeForOrganisation">
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/resource#ProductivityRecompute"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:label xml:lang="en">recompute For Organisation</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/iprok#Organisation"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:comment xml:lang="en">The organisation whose measured norms are recomputed.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#readinessJson">
    <rdfs:comment>JSON array of {use, score, verdict, fields[]} — caller-defined requirement set, so JSON-as-TEXT (the &lt;https://w3id.org/iprok#zoneConfig&gt; precedent).</rdfs:comment>
    <rdfs:label xml:lang="en">readiness Json</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/readinessJson"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/document#issuedBy">
    <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/document"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>issued by</rdfs:label>
    <rdfs:comment>The &lt;https://w3id.org/iprok#User&gt; who issued the transmittal. Domain unspecified (antipattern #8).</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/issuedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#warrantyVendor">
    <rdfs:comment xml:lang="en">The warranty vendor property in the integrated project information model.</rdfs:comment>
    <rdfs:label xml:lang="en">warranty Vendor</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/warrantyVendor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#lineGroup">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/lineGroup"/>
    <rdfs:comment>A group letter on an analysis line (CPWD marks lines that use another item's rate with 'A'), so an addition can leave the group out. No rdfs:domain.</rdfs:comment>
    <rdfs:label xml:lang="en">line Group</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#recoveryAmount">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/recoveryAmount"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>recovery amount</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Computed recovery amount in INR (rate × base amount). Mandatory. Domain unspecified.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#Calendar">
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:label>Calendar</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A definition of working and non-working periods used to interpret scheduled work.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok#IproKThing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/coordination#probability">
    <rdfs:label>probability</rdfs:label>
    <rdfs:comment>Low / Medium / High / Critical. Mapped to 1/2/3/4 for scoring.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/probability"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/coordination"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#ncrFromInspection">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:range rdf:resource="https://w3id.org/iprok/quality#Inspection"/>
    <rdfs:comment xml:lang="en">The inspection from which the non-conformance record originates.</rdfs:comment>
    <rdfs:label xml:lang="en">ncr From Inspection</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/quality#NCR"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#workerHasCertification">
    <rdfs:label xml:lang="en">worker Has Certification</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/iprok/resource#SkillCertification"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/resource#Worker"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">A skill certification held by the worker.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#preparedBy">
    <rdfs:label>prepared by</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/preparedBy"/>
    <rdfs:comment>Points at the &lt;https://w3id.org/iprok#User&gt; (PM/Admin) who prepared the bill. Mandatory. Domain unspecified (antipattern #8).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#workConstraintAssignedUser">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#WorkConstraint"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok#User"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The user responsible for clearing the work-readiness constraint.</rdfs:comment>
    <rdfs:label xml:lang="en">work Constraint Assigned User</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#mbPageRef">
    <rdfs:comment>Optional free-text reference to the physical Measurement Book page, e.g. 'Page 42, Item 7'. Written by the mobile entry form. Domain unspecified (antipattern #8).</rdfs:comment>
    <rdfs:label>MB page reference</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/mbPageRef"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#baselineReason">
    <rdfs:comment>Why the programme was revised. No rdfs:domain.</rdfs:comment>
    <rdfs:label xml:lang="en">baseline Reason</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/baselineReason"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/quality#closurePhoto">
    <rdfs:label>closure photo URI</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/closurePhoto"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/quality"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:comment>s3:// URI of the evidence photo uploaded with the closure (optional).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/quality#NCR"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/coordination#riskStatus">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/riskStatus"/>
    <rdfs:label>risk status</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/coordination"/>
    <rdfs:comment>Open / Mitigating / Closed / Accepted. Transitions enforced in route layer; sh:in in RiskShape.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#hospitalType">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/hospitalType"/>
    <rdfs:comment>Trauma Centre | Multi-speciality | Government | Primary Health Centre | Other.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteWorkerSafety"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>hospital type</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#plannedFinishDate">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The planned finish date property in the integrated project information model. Its declared domain is TaskTime and its declared range is dateTime.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#TaskTime"/>
    <rdfs:label xml:lang="en">plannedFinishDate</rdfs:label>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#riskMaterialisedCount">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/riskMaterialisedCount"/>
    <rdfs:comment>Number of &lt;https://w3id.org/iprok/coordination#Risk&gt; nodes (S4.5) on the historical project whose &lt;https://w3id.org/iprok/integrated#linkedIssue&gt; is set — risks that became real issues. Useful as a proxy for how well risk management worked. Domain-free.</rdfs:comment>
    <rdfs:label>risks that materialised</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/document#annotatedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:label>annotated at</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/annotatedAt"/>
    <rdfs:comment xml:lang="en">The annotated at property in the integrated project information model.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/document"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#countedAsElement">
    <rdfs:comment>On a &lt;https://w3id.org/iprok/building#Element&gt; whose work another model also carries: the IFC GlobalId of an element of the model the take-off counted it from — the same work, occupying the same space. Repeatable (a placeholder slab is counted as the planks under it). A literal GlobalId, because that is how BOQ lines and activities scope their elements (&lt;https://w3id.org/iprok/integrated#hasIFCScope&gt;). Polymorphic — no rdfs:domain (antipattern #8).</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/countedAsElement"/>
    <rdfs:label>counted as element</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#escrowAccountRef">
    <rdfs:comment>Masked account reference — never the full account number.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:label xml:lang="en">escrow Account Ref</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/escrowAccountRef"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#linkedBOQItem">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:label>linked BOQ item</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/linkedBOQItem"/>
    <rdfs:comment>Cross-domain bridge from &lt;https://w3id.org/iprok/schedule#Activity&gt; to its governing &lt;https://w3id.org/iprok/billing#BOQItem&gt; (alternative to BOQItem.linkedActivity). Domain unspecified (antipattern #8). S4.2.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#extensionDays">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/extensionDays"/>
    <rdfs:label xml:lang="en">extension Days</rdfs:label>
    <rdfs:comment>Days of extension granted. No rdfs:domain.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#Element">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label>IFC Element</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/Element"/>
    <rdfs:comment>One parseable IFC entity (wall / column / beam / slab / door / MEP fixture) extracted from an uploaded IFC model and persisted as triples for cross-domain joins. The single most important predicate is &lt;https://w3id.org/iprok/building#ifcGuid&gt;; every Issue / Annotation / future cost+schedule attribution that already carries an ifcGuid lights up automatically.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#milestoneOrder">
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">milestone Order</rdfs:label>
    <rdfs:comment xml:lang="en">The milestone order property in the integrated project information model.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/milestoneOrder"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#analysisId">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">analysis Id</rdfs:label>
    <rdfs:comment>Human-facing id: RL-NNNN in the organisation library, RA-NNNN in a project. Shared by every version. No rdfs:domain.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/analysisId"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#rateYear">
    <rdfs:label>rate year</rdfs:label>
    <rdfs:comment xml:lang="en">The rate year property in the integrated project information model.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/rateYear"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#hasPhoto">
    <rdfs:comment xml:lang="en">The has photo property in the integrated project information model.</rdfs:comment>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/hasPhoto"/>
    <rdfs:label>has photo</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/reporting#Photo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#hasConstraint">
    <rdfs:comment xml:lang="en">The has constraint property in the integrated project information model. Its declared domain is Task and its declared range is Constraint.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:label>hasConstraint</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/iprok#Constraint"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Task"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#reason">
    <rdfs:label>labour availability reason</rdfs:label>
    <rdfs:comment>Free-text reason: 'Diwali' | 'Pongal' | 'Kharif harvest' | 'Rabi harvest' | 'Holi' | 'Normal'. Surfaced on the UI alongside the score.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/reason"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#taskGeneratesCostItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/cost#CostItem"/>
    <rdfs:label>taskGeneratesCostItem</rdfs:label>
    <rdfs:comment xml:lang="en">The task generates cost item property in the integrated project information model. Its declared domain is Task and its declared range is CostItem.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Task"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#approvalConditions">
    <rdfs:label>conditions of approval</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/approvalConditions"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Free-text conditions attached by the authority on approval. Domain unspecified (antipattern #8).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#certifiedWorker">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/certifiedWorker"/>
    <rdfs:comment xml:lang="en">The certified worker property in the integrated project information model.</rdfs:comment>
    <rdfs:label xml:lang="en">certified Worker</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#pbgPercentage">
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:label>PBG percentage</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/pbgPercentage"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdfs:comment xml:lang="en">The pbg percentage property in the integrated project information model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#baselineStart">
    <rdfs:comment>The activity's first day in the baseline. No rdfs:domain.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/baselineStart"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:label xml:lang="en">baseline Start</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#hasWBS">
    <rdfs:comment xml:lang="en">The has wbs property in the integrated project information model. Its declared domain is WorkPackage and its declared range is WBS_Element.</rdfs:comment>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#WBS_Element"/>
    <rdfs:label>hasWBS</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#WorkPackage"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#avgRateVariance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/avgRateVariance"/>
    <rdfs:label>average rate variance (percent, signed)</rdfs:label>
    <rdfs:comment>Mean of the tender BOQ items' rateVariance across the rows that matched into this historical project. Positive = tender priced higher than the historical actual; negative = lower. Domain-free.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#observationUsesCrew">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/resource#CrewType"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">observation Uses Crew</rdfs:label>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:comment xml:lang="en">The crew type used in the productivity observation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/resource#ProductivityObservation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#dedupCount">
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>dedup count</rdfs:label>
    <rdfs:comment xml:lang="en">The dedup count property in the integrated project information model.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/dedupCount"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#BOQItem">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/BOQItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>BOQ item</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:comment>One line in the project's Bill of Quantities. Catalogue node; measurements reference it via &lt;https://w3id.org/iprok/billing#measuredItem&gt;.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#vidhiContract">
    <rdfs:comment>The VIDHI contract an answer was given under (vidhi.element-identity/1). No rdfs:domain.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/vidhiContract"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">vidhi Contract</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#IfcModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>IFC Model</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/document#Document"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
    <rdfs:comment>One uploaded IFC model revision. Carries fileRef, fileFormat ('IFC'), uploadedAt, modelRevision, elementCount, ofProject. Element-level detail lives in &lt;https://w3id.org/iprok/building#Element&gt; triples.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/IfcModel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#availabilityScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Score in [0, 1]. 0 = peak festival absence (Diwali week, Pongal week, Kharif harvest); 1 = normal availability. &lt;0.5 triggers the festival_labour_shortage auto-risk.</rdfs:comment>
    <rdfs:label>labour availability score</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/availabilityScore"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/quality#holdStatus">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/quality"/>
    <rdfs:label xml:lang="en">hold Status</rdfs:label>
    <rdfs:comment>Pending | OfferedForInspection | Released | Waived.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/holdStatus"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#approvalLevel1Limit">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/approvalLevel1Limit"/>
    <rdfs:label xml:lang="en">approval Level1Limit</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:comment>Deviation value (INR) up to which level 1 approves.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#optionDiscipline">
    <rdfs:label xml:lang="en">option Discipline</rdfs:label>
    <rdfs:comment>Architecture / Structure / MEP / Finishes. Domain unspecified (antipattern #8).</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/optionDiscipline"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/procurement#poStatus">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/procurement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>PO status</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/poStatus"/>
    <rdfs:comment>Open / PartiallyDelivered / FullyDelivered / Cancelled. Mirrors SAP EKKO.STATU but flattened to the four states a IproK framework PM actually cares about.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/procurement#forPO">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/forPO"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/procurement"/>
    <rdfs:label>for purchase order</rdfs:label>
    <rdfs:comment>Link from a &lt;https://w3id.org/iprok/procurement#GoodsReceipt&gt; to its &lt;https://w3id.org/iprok/procurement#PurchaseOrder&gt;. Domain unspecified (antipattern #8).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#CostItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok#IproKThing"/>
    <rdfs:label>CostItem</rdfs:label>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:comment xml:lang="en">A cost record associated with scheduled work or a resource allocation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#warrantyMonths">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/warrantyMonths"/>
    <rdfs:comment xml:lang="en">The warranty months property in the integrated project information model.</rdfs:comment>
    <rdfs:label xml:lang="en">warranty Months</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/document#fileRef">
    <rdfs:label>file ref</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/fileRef"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <rdfs:comment>Canonical s3:// URI of the stored original. Domain unspecified (antipattern #8 — M2 reuse).</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/document"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#Photo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A geo-tagged site photo, stored in MinIO and linked to the entity it documents.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <rdfs:label>Photo</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/Photo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#weeklyStats">
    <rdfs:label>weekly stats</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/weeklyStats"/>
    <rdfs:comment>Link from a HistoricalWeatherProfile to its 52 HistoricalWeatherWeek buckets. Domain-free.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#contentVersion">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/contentVersion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>VIDHI's content version of an answer (sha256:…); it excludes the review state, so a review changes the label, not the version. No rdfs:domain.</rdfs:comment>
    <rdfs:label xml:lang="en">content Version</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#atCompleteUnits">
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:comment xml:lang="en">The at complete units property in the integrated project information model. Its declared domain is Resource and its declared range is decimal.</rdfs:comment>
    <rdfs:label xml:lang="en">atCompleteUnits</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/resource#Resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/document#rfiSubject">
    <rdfs:comment xml:lang="en">The rfi subject property in the integrated project information model.</rdfs:comment>
    <rdfs:label>RFI subject</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/document"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/rfiSubject"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#activityName">
    <rdfs:comment>Domain intentionally unspecified — antipattern #8. ActivityShape constrains format.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/activityName"/>
    <rdfs:label>activity name</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#heatProbability">
    <rdfs:comment>Empirical probability [0, 1] that this calendar week sees at least one day with max temp &gt; 40°C, computed across the 10 years of the climatology window. Indian-summer concrete-pour productivity drops sharply above 40°C.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>extreme heat probability</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/heatProbability"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#hasPredecessor">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/hasPredecessor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#ScheduleLink"/>
    <rdfs:label>has predecessor</rdfs:label>
    <rdfs:comment xml:lang="en">The has predecessor property in the integrated project information model.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#pageCount">
    <rdfs:label>page count</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/pageCount"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:comment xml:lang="en">The page count property in the integrated project information model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#baselineWriteToken">
    <rdfs:comment>Concurrency state, not a fact: proves which of two simultaneous approvals was written. No rdfs:domain.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/baselineWriteToken"/>
    <rdfs:label xml:lang="en">baseline Write Token</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#snagForElement">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdfs:comment xml:lang="en">The building-model element affected by a handover snag.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/handover#SnagItem"/>
    <rdfs:label xml:lang="en">snag For Element</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/building#Element"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#zone">
    <rdfs:label>zone</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/zone"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:comment>Inferred zone name. Written at DPR-submit time from project's &lt;https://w3id.org/iprok#zoneConfig&gt; + GPS. Domain intentionally unspecified — V0.26 reuses the same property on &lt;https://w3id.org/iprok/safety#Incident&gt;, and an `rdfs:domain &lt;https://w3id.org/iprok/reporting#DPREntry&gt;` declaration would make every incident-with-zone get RDFS-classified as a DPREntry (same trap as V0.17's &lt;https://w3id.org/iprok/quality#failureNote&gt;, see CLAUDE.md antipattern #8).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#WBS_Element">
    <rdfs:label>WBS_Element</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok#IproKThing"/>
    <rdfs:comment xml:lang="en">An element of the work breakdown structure used to organise tasks.</rdfs:comment>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#billDate">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/billDate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Date the bill was prepared. Mandatory. Domain unspecified.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:label>bill date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#importedReviewState">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/importedReviewState"/>
    <rdfs:comment>The source's review state at import: proposed (machine-extracted, not approved by an engineer) or approved. No rdfs:domain.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdfs:label xml:lang="en">imported Review State</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#wbsPlannedCost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:label>WBS planned cost (rollup)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>Rollup: sum of governed &lt;https://w3id.org/iprok/billing#BOQItem&gt; amounts at a work package, rolled up the tree to the root. In Slice 1 this is COMPUTED ON READ in list_wbs_nodes (never persisted) — always-correct and it sidesteps a Fuseki/TDB2 quirk deleting xsd:decimal triples. The property + optional SHACL stanza are reserved for a future slice that may persist a snapshot.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/wbsPlannedCost"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#fetchedAt">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/fetchedAt"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label>profile fetched at</rdfs:label>
    <rdfs:comment>When the NASA POWER fetch ran. The Celery worker re-fetches only when this is &gt; 1 year old.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/quality#itemResult">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/quality"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/itemResult"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>item result</rdfs:label>
    <rdfs:comment>Either 'pass' or 'fail'.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/quality#ChecklistItem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#projectHasDecision">
    <rdfs:label xml:lang="en">project Has Decision</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Project"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:comment xml:lang="en">A recorded project question and its accountable decision.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok#Decision"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#drawingType">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
