    <rdfs:label>deviation count</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/deviationCount"/>
    <rdfs:comment>Number of &lt;https://w3id.org/iprok/billing#Deviation&gt; nodes (S3.7) recorded on the historical project — counts how often measured quantity exceeded tendered quantity by &gt;25%. Domain-free.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
