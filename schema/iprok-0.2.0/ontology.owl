  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#analysedQuantity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The quantity the details of cost are for (a CPWD analysis is often for 10 m² or 1 quintal); the rate per unit is the total divided by it. No rdfs:domain.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/analysedQuantity"/>
    <rdfs:label xml:lang="en">analysed Quantity</rdfs:label>
