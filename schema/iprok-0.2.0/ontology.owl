    <rdfs:label>hasWorkPackage</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#WorkPackage"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#forModel">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/forModel"/>
    <rdfs:label xml:lang="en">for Model</rdfs:label>
