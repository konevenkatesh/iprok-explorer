    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The hold description property in the integrated project information model.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/quality"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#ofProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>of project</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/ofProject"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:comment>Same naming convention as &lt;https://w3id.org/iprok#ofUser&gt; on &lt;https://w3id.org/iprok#ProjectMembership&gt;. Domain intentionally unspecified so M3 / M4 can reuse the predicate on other classes (e.g. &lt;https://w3id.org/iprok/document#Drawing&gt;, &lt;https://w3id.org/iprok/billing#RABill&gt;) without retripping antipattern #8.</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#Project"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#projectHasActivity">
