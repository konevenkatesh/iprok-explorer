    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/overallResult"/>
    <rdfs:label>overall result</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#annualRainfallMM">
