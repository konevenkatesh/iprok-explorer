    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:comment>Polymorphic bridge (antipattern #8): placed on a &lt;https://w3id.org/iprok/billing#BOQItem&gt; / &lt;https://w3id.org/iprok/building#Element&gt; / &lt;https://w3id.org/iprok/schedule#Activity&gt; to point UP at its governing work package (&lt;https://w3id.org/iprok/schedule#WBSNode&gt;). The existing catalogue classes are otherwise untouched.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#snagId">
