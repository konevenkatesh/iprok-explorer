  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#BidRecommendation">
    <rdfs:label>Bid Recommendation</rdfs:label>
    <rdfs:comment>The final bid-output document for a tender: total quoted, contingency, recommended bid, item-count + high-risk-count breakdown. The line-item detail is NOT stored on this node; it is re-derivable from the underlying S5.2 + S5.3 graph state, and persisting it would create stale-data risk on a SOR-rate or comparable-project update. The PDF lives in MinIO via &lt;https://w3id.org/iprok/document#fileRef&gt;.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/BidRecommendation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/coordination#riskId">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/riskId"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/coordination"/>
    <rdfs:comment xml:lang="en">The risk id property in the integrated project information model.</rdfs:comment>
    <rdfs:label>risk id (RSK-NNNN)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
