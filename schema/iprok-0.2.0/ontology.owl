    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdfs:label>for tender</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/iprok/tender#Tender"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Link from &lt;https://w3id.org/iprok/tender#ComparableProject&gt; to the &lt;https://w3id.org/iprok/tender#Tender&gt; this comparison was run for. Domain-free (antipattern #8).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#optionDescription">
    <rdfs:comment xml:lang="en">The option description property in the integrated project information model.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/optionDescription"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">option Description</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#reportedAt">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/reportedAt"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:label>reported at</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment>Timestamp at which an entity (DPREntry, Photo, etc.) was reported. Domain widened in V0.14 from &lt;https://w3id.org/iprok/reporting#DPREntry&gt; only.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#actualDuration">
    <rdfs:label xml:lang="en">actualDuration</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The actual duration property in the integrated project information model. Its declared domain is TaskTime and its declared range is decimal.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#TaskTime"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#withdrawalReason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
    <rdfs:label xml:lang="en">withdrawal Reason</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/withdrawalReason"/>
    <rdfs:comment>Why the project's days no longer count — kept with the record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#vendorGSTIN">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/vendorGSTIN"/>
    <rdfs:comment xml:lang="en">The vendor gstin property in the integrated project information model.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:label xml:lang="en">vendor GSTIN</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#deviationThresholdPct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Measured quantity above tendered by more than this percent raises a deviation for approval.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:label xml:lang="en">deviation Threshold Pct</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/deviationThresholdPct"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#cpi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/cpi"/>
    <rdfs:comment>EV / AC. &gt;1.0 under budget, &lt;1.0 over budget. Optional — undefined (omitted) when AC=0.</rdfs:comment>
    <rdfs:label>Cost Performance Index</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#projectOwner">
    <rdfs:comment xml:lang="en">The project owner property in the integrated project information model. Its declared domain is Project and its declared range is string.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Project"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">projectOwner</rdfs:label>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#billingPeriodStart">
    <rdfs:comment>Start date of the billing period (inclusive). Mandatory. Domain unspecified.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/billingPeriodStart"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:label>billing period start</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#computedAt">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/computedAt"/>
    <rdfs:label>snapshot computed at</rdfs:label>
    <rdfs:label>computed at</rdfs:label>
    <rdfs:comment>Wall-clock time the snapshot was computed. Distinct from &lt;https://w3id.org/iprok/schedule#statusDate&gt; (which is the as-of data date). Mandatory on &lt;https://w3id.org/iprok/schedule#EVMSnapshot&gt;. Domain unspecified — reused on other ad-hoc analytics rows.</rdfs:comment>
    <rdfs:comment>Timestamp when the comparator wrote this ComparableProject node. Mandatory (every audit row must carry a timestamp).</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#commentText">
    <rdfs:comment xml:lang="en">The comment text property in the integrated project information model.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:label xml:lang="en">comment Text</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/commentText"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#rfiAboutDrawing">
    <rdfs:domain rdf:resource="https://w3id.org/iprok/document#RFI"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdfs:label xml:lang="en">rfi About Drawing</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The drawing to which a request for information refers.</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/iprok/document#Drawing"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/coordination#Event">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/coordination"/>
    <rdfs:comment>Superclass for issue-like nodes (BCF issues, future inspection events). No shape; concrete subclasses carry the constraints.</rdfs:comment>
    <rdfs:label>Event</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#rateSource">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/rateSource"/>
    <rdfs:label xml:lang="en">rate Source</rdfs:label>
    <rdfs:comment>Where a rate came from: a supplier quote, a purchase order, a published schedule. No rdfs:domain.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#valueBefore">
    <rdfs:comment>A value the property had before the change (IRI or literal). No rdfs:domain.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/valueBefore"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#issueDescription">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/issueDescription"/>
    <rdfs:label>issue description</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The issue description property in the integrated project information model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#markupJson">
    <rdfs:comment>Drawn markup strokes (pen / arrow / rect / text) in view-normalised 0–1 coordinates, as a JSON literal.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/markupJson"/>
    <rdfs:label xml:lang="en">markup Json</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#contributionIncludesObservation">
    <rdfs:range rdf:resource="https://w3id.org/iprok/resource#ProductivityObservation"/>
    <rdfs:comment xml:lang="en">An observation included in a productivity contribution.</rdfs:comment>
    <rdfs:label xml:lang="en">contribution Includes Observation</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/resource#ProductivityContribution"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#quotedRate">
    <rdfs:comment>Unit rate in INR as entered on the BOQ. Mandatory. Domain unspecified.</rdfs:comment>
    <rdfs:label>quoted rate</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/quotedRate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/quality#hasItem">
    <rdfs:domain rdf:resource="https://w3id.org/iprok/quality#Inspection"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/quality#ChecklistItem"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:comment xml:lang="en">The has item property in the integrated project information model. Its declared domain is Inspection and its declared range is ChecklistItem.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/hasItem"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/quality"/>
    <rdfs:label>has item</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#ProjectResourcePrice">
    <rdfs:comment>The one rate a project uses for a resource. Copied from the organisation's basic rates when first used; changed only by a person, and every change is recorded.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/ProjectResourcePrice"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">Project Resource Price</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#Closed">
    <rdfs:label>Closed</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/iprok/quality#NCRStatus"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/procurement#poAmount">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/poAmount"/>
    <rdfs:comment xml:lang="en">The po amount property in the integrated project information model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:label>PO net value (NETWR), INR</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/procurement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#activityUsesCalendar">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok#Calendar"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Activity"/>
    <rdfs:label xml:lang="en">activity Uses Calendar</rdfs:label>
    <rdfs:comment xml:lang="en">The calendar used to interpret working periods for the activity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#amount">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/amount"/>
    <rdfs:label>amount</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
    <rdfs:comment>Contract amount = tenderedQty × quotedRate, server-computed. Mandatory. Domain unspecified.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#ScheduleLink">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/ScheduleLink"/>
    <rdfs:label>Schedule link</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A reified predecessor edge: which activity precedes which, the P6 relationship type (FS/SS/FF/SF) and the lag in days.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#similarityScore">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdfs:label>similarity score (0–1)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/similarityScore"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>Weighted average of the comparator's three sub-scores: BOQ overlap (0.5) + work-type Jaccard (0.3) + scale similarity (0.2). Domain-free.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#SnagItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>One punch-list item found during handover inspection. Open Critical snags block transfer.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">Snag Item</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/SnagItem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#mastersNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/mastersNote"/>
    <rdfs:comment>Why this version was made — shown in the history.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:label xml:lang="en">masters Note</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#paymentAgainstBill">
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdfs:comment xml:lang="en">The certified bill settled in whole or part by the payment.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">payment Against Bill</rdfs:label>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/billing#Payment"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:range rdf:resource="https://w3id.org/iprok/billing#RABill"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#CostType">
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok#IproKThing"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>CostType</rdfs:label>
    <rdfs:comment xml:lang="en">A classification of expenditure by the kind of resource or expense involved.</rdfs:comment>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#paymentMode">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Mode of payment: RTGS, NEFT, Cheque, DD. Parsed from Tally narration. Domain unspecified.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/paymentMode"/>
    <rdfs:label>payment mode</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#lineNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">line Note</rdfs:label>
    <rdfs:comment>What the source printed for a line, when it differs from the resource's name (or several source lines merged into one). No rdfs:domain.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/lineNote"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/tender#extractionStatus">
    <rdfs:label>extraction status</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/tender"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/tender#ExtractionStatus"/>
    <rdfs:comment xml:lang="en">The extraction status property in the integrated project information model.</rdfs:comment>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/extractionStatus"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/property#unitId">
    <rdfs:label xml:lang="en">unit Id</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/unitId"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/property"/>
    <rdfs:comment>Stable id within the project, e.g. T1-0503 (tower-floor-unit). Domain unspecified (antipattern #8).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#currentGross">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/currentGross"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>cumulativeGross minus previousBillAmount (INR). The gross value for this billing period. Mandatory. Domain unspecified.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>current gross</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#tenderHasRecommendation">
    <rdfs:domain rdf:resource="https://w3id.org/iprok/tender#Tender"/>
    <rdfs:label xml:lang="en">tender Has Recommendation</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:comment xml:lang="en">A bid recommendation prepared for the tender.</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/iprok/tender#BidRecommendation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#observedCrewType">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/observedCrewType"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:comment xml:lang="en">The observed crew type property in the integrated project information model.</rdfs:comment>
    <rdfs:label xml:lang="en">observed Crew Type</rdfs:label>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#changedSubject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Which node a change record is about, when one activity changes several (a BOQ rate and the activity budgets split from it). No rdfs:domain.</rdfs:comment>
    <rdfs:label xml:lang="en">changed Subject</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/changedSubject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#onModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>The &lt;https://w3id.org/iprok/building#IfcModel&gt; upload/revision this comment was recorded against. Range undeclared (antipattern #8).</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/onModel"/>
    <rdfs:label xml:lang="en">on Model</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/building"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#bac">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>Total contract budget = sum of every BOQItem (tenderedQty × quotedRate). INR. Mandatory on &lt;https://w3id.org/iprok/schedule#EVMSnapshot&gt;.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:label>Budget at Completion (BAC)</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/bac"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/document#detectedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>detected at</rdfs:label>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/detectedAt"/>
    <rdfs:comment xml:lang="en">The detected at property in the integrated project information model.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/document"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#riskDescription">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:label>risk description</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/riskDescription"/>
    <rdfs:comment xml:lang="en">The risk description property in the integrated project information model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#holdPointForActivity">
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:comment xml:lang="en">The activity bound to an inspection or witness hold point.</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#Activity"/>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hold Point For Activity</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/quality#HoldPoint"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#MaterialCost">
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/cost#CostType"/>
    <rdfs:label>MaterialCost</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:comment xml:lang="en">A cost-type classification for material-related expenditure.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#normSource">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">norm Source</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/normSource"/>
    <rdfs:comment>measured | seeded — a seeded default must never be mistaken for a measured norm, the same posture as BS_Audit.QuantitySource on an enriched IFC.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#deviationAmount">
    <rdfs:label>deviation amount</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/deviationAmount"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Excess amount in INR at the BOQ rate: (measured - tendered) × rate. Mandatory. Domain unspecified.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#baseRate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/resource#Resource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">baseRate</rdfs:label>
    <rdfs:comment xml:lang="en">The base rate property in the integrated project information model. Its declared domain is Resource and its declared range is decimal.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#eotClause">
    <rdfs:label xml:lang="en">eot Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/eotClause"/>
    <rdfs:comment>The Clause 5 sub-clause an extension of time was granted under: 5.2 (beyond the contractor's control) or 5.3 (hindrance by the department). No rdfs:domain.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#thumbnailRef">
    <rdfs:comment>Canonical s3:// URI of the server-generated first-page thumbnail (written by the drawing_thumbnails Celery task). Optional. Domain unspecified (antipattern #8).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/thumbnailRef"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>thumbnail ref</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#supersedes">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/supersedes"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Links a new revision to the prior &lt;https://w3id.org/iprok/document#Drawing&gt; of the same drawingId it replaces. Domain unspecified (antipattern #8 — RFI/markup reuse later).</rdfs:comment>
    <rdfs:label>supersedes</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/iprok/document#Drawing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#NearMiss">
    <rdf:type rdf:resource="https://w3id.org/iprok/safety#IncidentType"/>
    <rdfs:label>Near miss</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#elementHasMemberIdentity">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:comment xml:lang="en">The structural-member identity associated with the model element.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/building#Element"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
    <rdfs:range rdf:resource="https://w3id.org/iprok/building#MemberIdentity"/>
    <rdfs:label xml:lang="en">element Has Member Identity</rdfs:label>
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#JMRejected">
    <rdfs:label>Rejected</rdfs:label>
    <rdf:type rdf:resource="https://w3id.org/iprok/billing#JMStatus"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#maxTempC">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>max temperature (°C)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Daily maximum temperature in degrees Celsius. &gt;42°C correlates with reduced productivity in north India.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/maxTempC"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#WarrantyRecord">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:comment>One asset/system warranty (vendor, start, duration) handed to operations.</rdfs:comment>
    <rdfs:label xml:lang="en">Warranty Record</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/WarrantyRecord"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#seasonalFluctuationM">
    <rdfs:comment xml:lang="en">The seasonal fluctuation m property in the integrated project information model. Its declared domain is SiteHydrology and its declared range is decimal.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteHydrology"/>
    <rdfs:label>seasonal fluctuation (m)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/seasonalFluctuationM"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#monsoonWithdrawalWeek">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteClimate"/>
    <rdfs:label>monsoon withdrawal ISO week</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/monsoonWithdrawalWeek"/>
    <rdfs:comment xml:lang="en">The monsoon withdrawal week property in the integrated project information model. Its declared domain is SiteClimate and its declared range is integer.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#UnderReview">
    <rdf:type rdf:resource="https://w3id.org/iprok/quality#NCRStatus"/>
    <rdfs:label>Under review</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#groundwaterDepthPreMonsoonM">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <rdfs:label>groundwater depth pre-monsoon (m)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/groundwaterDepthPreMonsoonM"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteHydrology"/>
    <rdfs:comment xml:lang="en">The groundwater depth pre monsoon m property in the integrated project information model. Its declared domain is SiteHydrology and its declared range is decimal.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#zoneConfig">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/zoneConfig"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Project"/>
    <rdfs:label>zone config (JSON)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>JSON array of {name, lat, lng, radius_m} dicts. v0 hack — gets a proper schema (and SHACL shape) when polygon zones land.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#issuePriority">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/issuePriority"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:comment>Low / Normal / High / Critical. Kept separate from &lt;https://w3id.org/iprok/integrated#priority&gt; (RFI semantics) to avoid cross-contamination of any future sh:in.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>issue priority</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#flexibilityRating">
    <rdfs:comment xml:lang="en">The flexibility rating property in the integrated project information model.</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/flexibilityRating"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdfs:label xml:lang="en">flexibility Rating</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#analysisTitle">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/analysisTitle"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">analysis Title</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The work the analysis prices, in plain words. No rdfs:domain.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#allocationForTask">
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>allocationForTask</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/integrated#ResourceAllocation"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#Task"/>
    <rdfs:comment xml:lang="en">The allocation for task property in the integrated project information model. Its declared domain is ResourceAllocation and its declared range is Task.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/prediction#confidenceScore">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/prediction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>model confidence (0–1)</rdfs:label>
    <rdfs:comment>Model's self-reported confidence in this prediction (1 − attention entropy, normalised).</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/confidenceScore"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#approvedBy">
    <rdfs:comment>IRI of the user who approved or rejected the deviation. Domain unspecified.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/approvedBy"/>
    <rdfs:label>approved by</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#analysisVersion">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">analysis Version</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/analysisVersion"/>
    <rdfs:comment>Version number of an analysis, from 1. No rdfs:domain.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/building#elementsAudited">
