  <rdf:Description rdf:about="https://w3id.org/iprok/billing#JMStatus">
    <rdfs:comment>State of a &lt;https://w3id.org/iprok/billing#JointMeasurement&gt;. Four individuals: JMPendingContractor (initial, awaiting contractor OTP), JMPendingDepartmental (contractor signed, awaiting JE/AE), JMComplete (both signed, legally binding), JMRejected (either party rejected).</rdfs:comment>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/JMStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Joint Measurement Status</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/billing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/document#DrawingState">
