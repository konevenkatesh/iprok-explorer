    <rdfs:comment xml:lang="en">The hospital distance km property in the integrated project information model. Its declared domain is SiteWorkerSafety and its declared range is decimal.</rdfs:comment>
    <rdfs:label>nearest emergency hospital distance (km)</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#partOfProject">
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/partOfProject"/>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#Project"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Activity"/>
    <rdfs:comment xml:lang="en">The part of project property in the integrated project information model. Its declared domain is Activity and its declared range is Project.</rdfs:comment>
    <rdfs:label>part of project</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/coordination#issueType">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
