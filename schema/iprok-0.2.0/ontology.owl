  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/billing#departmentalSignedAt">
    <rdfs:comment>Timestamp of departmental JE/AE OTP verification. Set when jmStatus transitions to JMComplete. Domain unspecified.</rdfs:comment>
    <rdfs:label>departmental signed at</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/departmentalSignedAt"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
