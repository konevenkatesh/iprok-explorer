    <rdfs:label>tender SOR code hint</rdfs:label>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/tenderSorCodeHint"/>
    <rdfs:comment xml:lang="en">The tender sor code hint property in the integrated project information model.</rdfs:comment>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#cv">
    <rdfs:label>Cost Variance</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/cv"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
