    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The issuing department property in the integrated project information model.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/issuingDepartment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#linksToSuccessorTask">
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#TaskDependency"/>
    <dct:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dct:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#Task"/>
    <rdfs:label>linksToSuccessorTask</rdfs:label>
    <rdfs:comment xml:lang="en">The links to successor task property in the integrated project information model. Its declared domain is TaskDependency and its declared range is Task.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#historicalWeeklyRainJson">
    <rdfs:comment>52-week array of {week, rain_mm} from NASA POWER 10-year mean. Cross-reference: &lt;https://w3id.org/iprok/signal#HistoricalWeatherProfile&gt; (S6.6+) holds the probabilistic version.</rdfs:comment>
    <rdfs:label>historical weekly rain (JSON)</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteClimate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/historicalWeeklyRainJson"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/cost#fromLibraryAnalysis">
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/cost"/>
    <rdfs:comment>The library analysis version a project analysis was copied from. No rdfs:domain.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:source rdf:resource="https://bimsaarthi.com/ontology/v0/fromLibraryAnalysis"/>
    <rdfs:label xml:lang="en">from Library Analysis</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#duplicateRetirementForProject">
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#Project"/>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The project scope of an element-duplicate retirement event.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/building#ElementDuplicatesRetired"/>
    <rdfs:label xml:lang="en">duplicate Retirement For Project</rdfs:label>
    <dct:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-19</dct:created>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#modelForProject">
    <dct:description xml:lang="en">Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/iprok/draft/0.2.0"/>
