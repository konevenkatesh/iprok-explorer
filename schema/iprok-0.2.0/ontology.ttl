    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/mastersVersion> ;
    rdfs:comment "1, 2, 3 … per organisation. Version 0 means the platform defaults (never stored)." ;
