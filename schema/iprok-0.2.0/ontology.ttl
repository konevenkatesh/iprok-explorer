    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/constraintStatus> ;
    rdfs:comment "Open | Cleared | Withdrawn. No rdfs:domain." ;
    rdfs:range xsd:string .

iprok:constraintText a owl:DatatypeProperty ;
    rdfs:label "constraint Text"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/constraintText> ;
    rdfs:comment "What must be cleared, in plain language. No rdfs:domain." ;
    rdfs:range xsd:string .

iprok:decidedAt a owl:DatatypeProperty ;
    rdfs:label "decided At"@en ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
