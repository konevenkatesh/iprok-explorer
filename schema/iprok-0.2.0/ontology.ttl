<https://w3id.org/IproK/tender#itemCount> a owl:DatatypeProperty ;
    rdfs:label "item count" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/itemCount> ;
    rdfs:comment "Count of <https://w3id.org/IproK/tender#TenderBOQItem> rows in the recommendation (matched items only — unmatched are excluded since no rate can be recommended).",
        "Denormalised count of SOR items in a library. Polymorphic — domain unspecified." ;
    rdfs:range xsd:integer .

<https://w3id.org/IproK/tender#matchConfidence> a owl:DatatypeProperty ;
    rdfs:label "match confidence (0–1)" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/matchConfidence> ;
    rdfs:comment "S3.2-style confidence: exact-code = 1.0; fuzzy-desc = 0.5 + 0.4×ratio; jargon-normalised = same but after Indian-PWD jargon stripped; no-match = 0.0. SHACL bounds enforce [0, 1]." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/tender#matchStrategy> a owl:DatatypeProperty ;
    rdfs:label "match strategy" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/matchStrategy> ;
    rdfs:comment "How the match landed. Values: 'exact-code' | 'fuzzy-desc' | 'jargon-normalised' | 'no-match'. SHACL sh:in (string literals, antipattern #13)." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/tender#matchedBOQItems> a owl:DatatypeProperty ;
    rdfs:label "matched BOQ items" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/matchedBOQItems> ;
    rdfs:comment "Count of tender BOQ items whose matchedSORItem also appears as <https://w3id.org/IproK/integrated#governedBy> on some <https://w3id.org/IproK/billing#BOQItem> in the historical project. The numerator of the BOQ-overlap sub-score. Domain-free." ;
    rdfs:range xsd:integer .

<https://w3id.org/IproK/tender#matchedSORItem> a owl:ObjectProperty ;
    rdfs:label "matched SOR item" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/matchedSORItem> ;
    rdfs:comment "IRI of the <https://w3id.org/IproK/tender#SORItem> the tender BOQ row matched against. Absent when match-strategy is 'no-match'." ;
    rdfs:range <https://w3id.org/IproK/tender#SORItem> .

<https://w3id.org/IproK/tender#needsReview> a owl:DatatypeProperty ;
    rdfs:label "needs review" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/needsReview> ;
    rdfs:comment "Boolean — set true when any AI-extracted title-block field has confidence < 0.7, cleared when a user confirms the extraction. Polymorphic (any AI-written node can carry it); domain unspecified (antipattern #8)." ;
    rdfs:range xsd:boolean .

