    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/constraintFlow> ;
    rdfs:comment "PrerequisiteWork | Information | Materials | Labour | Equipment | Space | External. No rdfs:domain." ;
    rdfs:range xsd:string .

iprok:constraintId a owl:DatatypeProperty ;
    rdfs:label "constraint Id"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/constraintId> ;
