    rdfs:comment "The adopted masters version property in the integrated project information model."@en ;
    rdfs:range xsd:integer .

iprok:affectsActivity a owl:ObjectProperty ;
    rdfs:label "affects Activity"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/affectsActivity> ;
    rdfs:comment "An activity the decision changes. Repeatable. No rdfs:domain / rdfs:range." .

iprok:approvalLevel1Label a owl:DatatypeProperty ;
    rdfs:label "approval Level1Label"@en ;
