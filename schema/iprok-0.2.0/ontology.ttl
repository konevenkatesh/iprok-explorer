    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/decisionOptions> ;
    rdfs:comment "The options considered, in plain language. No rdfs:domain." ;
    rdfs:range xsd:string .

iprok:decisionQuestion a owl:DatatypeProperty ;
    rdfs:label "decision Question"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/decisionQuestion> ;
    rdfs:comment "What had to be decided, in plain language. No rdfs:domain." ;
    rdfs:range xsd:string .

iprok:decisionSource a owl:DatatypeProperty ;
    rdfs:label "decision Source"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/decisionSource> ;
    rdfs:comment "Where the question came from, e.g. plan-check. No rdfs:domain." ;
    rdfs:range xsd:string .

iprok:decisionStatus a owl:DatatypeProperty ;
    rdfs:label "decision Status"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/decisionStatus> ;
    rdfs:comment "Open | Decided | Superseded | Withdrawn. No rdfs:domain." ;
    rdfs:range xsd:string .

iprok:decisionText a owl:DatatypeProperty ;
    rdfs:label "decision Text"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/decisionText> ;
    rdfs:comment "What was decided. No rdfs:domain." ;
    rdfs:range xsd:string .

iprok:deviationThresholdPct a owl:DatatypeProperty ;
    rdfs:label "deviation Threshold Pct"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/deviationThresholdPct> ;
    rdfs:comment "Measured quantity above tendered by more than this percent raises a deviation for approval." ;
    rdfs:range xsd:decimal .

iprok:dueDate a owl:DatatypeProperty ;
    rdfs:label "due date" ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/dueDate> ;
    rdfs:comment "Optional SLA target date. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:date .

iprok:fyStartMonth a owl:DatatypeProperty ;
    rdfs:label "fy Start Month"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/fyStartMonth> ;
    rdfs:comment "Month the financial year begins, 1–12 (India: 4)." ;
    rdfs:range xsd:integer .

iprok:gstTdsApplicable a owl:DatatypeProperty ;
    rdfs:label "gst Tds Applicable"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/gstTdsApplicable> ;
    rdfs:comment "Whether CGST s.51 TDS applies to this organisation (government bodies and notified persons only)." ;
    rdfs:range xsd:boolean .

iprok:gstin a owl:DatatypeProperty ;
    rdfs:label "gstin"@en ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/gstin> ;
    rdfs:comment "The gstin property in the integrated project information model."@en ;
    rdfs:range xsd:string .

iprok:hasDescription a owl:DatatypeProperty ;
    rdfs:label "hasDescription"@en ;
    rdfs:comment "A textual description of the entity." ;
    rdfs:domain iprok:IproKThing ;
    rdfs:range xsd:string .

iprok:hasGlobalId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "hasGlobalId"@en ;
    rdfs:comment "A globally unique identifier." ;
    rdfs:domain iprok:IproKThing ;
    rdfs:range xsd:string .

iprok:hasId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "hasId"@en ;
    rdfs:comment "A local or project-specific identifier." ;
    rdfs:domain iprok:IproKThing ;
    rdfs:range xsd:string .

iprok:hasMember a owl:ObjectProperty ;
    rdfs:label "has member" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/hasMember> ;
    rdfs:comment "The has member property in the integrated project information model. Its declared domain is Project and its declared range is ProjectMembership."@en ;
    rdfs:domain schedule:Project ;
    rdfs:range iprok:ProjectMembership .

iprok:hasName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "hasName"@en ;
    rdfs:comment "The common name of the entity." ;
    rdfs:domain iprok:IproKThing ;
    rdfs:range xsd:string .

iprok:joinedAt a owl:DatatypeProperty ;
    rdfs:label "joined at" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/joinedAt> ;
    rdfs:comment "The joined at property in the integrated project information model. Its declared domain is ProjectMembership and its declared range is dateTime."@en ;
    rdfs:domain iprok:ProjectMembership ;
    rdfs:range xsd:dateTime .

iprok:labourCessApplicable a owl:DatatypeProperty ;
    rdfs:label "labour Cess Applicable"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/labourCessApplicable> ;
