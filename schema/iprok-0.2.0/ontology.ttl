    rdfs:comment "The link source property in the integrated project information model."@en ;
    rdfs:range xsd:string .

schedule:linkType a owl:DatatypeProperty ;
    rdfs:label "relationship type" ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/linkType> ;
    rdfs:comment "One of FS / SS / FF / SF (P6 convention)." ;
    rdfs:range xsd:string .

schedule:linksToPredecessorTask a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "linksToPredecessorTask" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The links to predecessor task property in the integrated project information model. Its declared domain is TaskDependency and its declared range is Task."@en ;
    rdfs:domain schedule:TaskDependency ;
    rdfs:range schedule:Task .

schedule:linksToSuccessorTask a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "linksToSuccessorTask" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The links to successor task property in the integrated project information model. Its declared domain is TaskDependency and its declared range is Task."@en ;
    rdfs:domain schedule:TaskDependency ;
    rdfs:range schedule:Task .

schedule:parentWBS a owl:ObjectProperty ;
    rdfs:label "parent WBS node" ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/parentWBS> ;
    rdfs:comment "Self-referential link to the parent <https://w3id.org/IproK/schedule#WBSNode>. Absent on the project-root node. Domain unspecified (antipattern #8)." ;
    rdfs:range schedule:WBSNode .

schedule:partOfProject a owl:ObjectProperty ;
    rdfs:label "part of project" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/partOfProject> ;
    rdfs:comment "The part of project property in the integrated project information model. Its declared domain is Activity and its declared range is Project."@en ;
    rdfs:domain schedule:Activity ;
    rdfs:range schedule:Project .

schedule:percentComplete a owl:DatatypeProperty ;
    rdfs:label "percent complete (0-100)" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/percentComplete> ;
    rdfs:comment "The percent complete property in the integrated project information model."@en ;
    rdfs:range xsd:decimal .

schedule:plannedFinishDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "plannedFinishDate"@en ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The planned finish date property in the integrated project information model. Its declared domain is TaskTime and its declared range is dateTime."@en ;
    rdfs:domain schedule:TaskTime ;
    rdfs:range xsd:dateTime .

schedule:plannedQuantity a owl:DatatypeProperty ;
    rdfs:label "planned Quantity"@en ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/plannedQuantity> ;
    rdfs:comment "The quantity the activity is planned to deliver, in <https://w3id.org/IproK/integrated#unit>. Distinct from <https://w3id.org/IproK/billing#quantity> (a measurement). No rdfs:domain." ;
    rdfs:range xsd:decimal .

schedule:plannedStartDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "plannedFinishDate"@en ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The planned start date property in the integrated project information model. Its declared domain is TaskTime and its declared range is dateTime."@en ;
    rdfs:domain schedule:TaskTime ;
    rdfs:range xsd:dateTime .

schedule:projectAddress a owl:DatatypeProperty ;
    rdfs:label "projectAddress"@en ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The project address property in the integrated project information model. Its declared domain is Project and its declared range is string."@en ;
    rdfs:domain schedule:Project ;
    rdfs:range xsd:string .

schedule:projectCategory a owl:DatatypeProperty ;
    rdfs:label "projectCategory"@en ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The project category property in the integrated project information model. Its declared domain is Project and its declared range is string."@en ;
    rdfs:domain schedule:Project ;
    rdfs:range xsd:string .

schedule:projectOwner a owl:DatatypeProperty ;
    rdfs:label "projectOwner"@en ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The project owner property in the integrated project information model. Its declared domain is Project and its declared range is string."@en ;
    rdfs:domain schedule:Project ;
    rdfs:range xsd:string .

schedule:pv a owl:DatatypeProperty ;
    rdfs:label "Planned Value (BCWS)" ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/pv> ;
    rdfs:comment "Time-phased budget that should have been earned by statusDate. INR. Mandatory on <https://w3id.org/IproK/schedule#EVMSnapshot>. Domain unspecified." ;
    rdfs:range xsd:decimal .

schedule:remainingDuration a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "remainingDuration"@en ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The remaining duration property in the integrated project information model. Its declared domain is TaskTime and its declared range is decimal."@en ;
    rdfs:domain schedule:TaskTime ;
    rdfs:range xsd:decimal .

schedule:scheduleDuration a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "scheduleDuration"@en ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The schedule duration property in the integrated project information model. Its declared domain is TaskTime and its declared range is decimal."@en ;
    rdfs:domain schedule:TaskTime ;
    rdfs:range xsd:decimal .

schedule:scheduleRevision a owl:DatatypeProperty ;
    rdfs:label "schedule revision id" ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/scheduleRevision> ;
    rdfs:comment "UUID stamped on every <https://w3id.org/IproK/schedule#Activity> written by one POST /schedule/ingest/{id}/confirm. Lets a re-import supersede the prior revision (PROV-O) and the UI list revision history." ;
    rdfs:range xsd:string .

schedule:seededDailyOutput a owl:DatatypeProperty ;
    rdfs:label "seeded Daily Output"@en ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/seededDailyOutput> ;
    rdfs:comment "The default (CPWD-style) crew-day output, kept beside a measured rate so the difference stays visible. No rdfs:domain." ;
    rdfs:range xsd:decimal .

schedule:spi a owl:DatatypeProperty ;
    rdfs:label "Schedule Performance Index" ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/spi> ;
    rdfs:comment "EV / PV. >1.0 ahead of schedule, <1.0 behind. Optional — undefined (omitted) when PV=0." ;
    rdfs:range xsd:decimal .

schedule:statusDate a owl:DatatypeProperty ;
    rdfs:label "EVM status date" ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/statusDate> ;
    rdfs:comment "The data-date of the EVM snapshot — every activity and bill is rolled up as of this calendar day. Mandatory on <https://w3id.org/IproK/schedule#EVMSnapshot>. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:date .

schedule:stipulatedFinishDate a owl:DatatypeProperty ;
    rdfs:label "stipulated Finish Date"@en ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/stipulatedFinishDate> ;
    rdfs:comment "The completion date the contract stipulates while this baseline is in force: the approved programme's last day plus every extension of time granted (CPWD Clause 5.2/5.3). Clause 5.4's 10% is of the period to this date. An agreed amendment does not move it. No rdfs:domain." ;
    rdfs:range xsd:date .

schedule:sv a owl:DatatypeProperty ;
    rdfs:label "Schedule Variance" ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/sv> ;
    rdfs:comment "EV − PV. Positive = ahead of schedule. INR-equivalent. Mandatory on <https://w3id.org/IproK/schedule#EVMSnapshot>." ;
    rdfs:range xsd:decimal .

schedule:taskPriority a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "taskPriority"@en ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The task priority property in the integrated project information model. Its declared domain is Task and its declared range is integer."@en ;
    rdfs:domain schedule:Task ;
    rdfs:range xsd:integer .

schedule:taskRelationshipType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "taskRelationshipType"@en ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The task relationship type property in the integrated project information model. Its declared domain is TaskDependency and its declared range is string."@en ;
    rdfs:domain schedule:TaskDependency ;
    rdfs:range xsd:string .

schedule:totalFloat a owl:DatatypeProperty ;
    rdfs:label "total float (days)" ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/totalFloat> ;
    rdfs:comment "Mirrors iprok:totalFloat. Days; may be negative on a behind-schedule critical path." ;
    rdfs:range xsd:decimal .

schedule:vac a owl:DatatypeProperty ;
    rdfs:label "Variance at Completion" ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/vac> ;
    rdfs:comment "BAC − EAC. INR. Mandatory on <https://w3id.org/IproK/schedule#EVMSnapshot>." ;
    rdfs:range xsd:decimal .

schedule:wbsCode a owl:DatatypeProperty ;
    rdfs:label "WBS code" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/wbsCode> ;
    rdfs:comment "The wbs code property in the integrated project information model."@en ;
    rdfs:range xsd:string .

schedule:wbsLevel a owl:DatatypeProperty ;
    rdfs:label "WBS level" ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/wbsLevel> ;
    rdfs:comment "Depth in the tree: 1 = project root, 2 = block/zone, 3 = system, deeper = work packages. Server-assigned from parent depth." ;
    rdfs:range xsd:integer .

schedule:wbsName a owl:DatatypeProperty ;
    rdfs:label "WBS node name" ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/wbsName> ;
    rdfs:comment "Human-readable name of the WBS node (e.g. 'Block A', 'Substructure', 'Footing RCC'). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

schedule:wbsPlannedCost a owl:DatatypeProperty ;
    rdfs:label "WBS planned cost (rollup)" ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/wbsPlannedCost> ;
    rdfs:comment "Rollup: sum of governed <https://w3id.org/IproK/billing#BOQItem> amounts at a work package, rolled up the tree to the root. In Slice 1 this is COMPUTED ON READ in list_wbs_nodes (never persisted) — always-correct and it sidesteps a Fuseki/TDB2 quirk deleting xsd:decimal triples. The property + optional SHACL stanza are reserved for a future slice that may persist a snapshot." ;
    rdfs:range xsd:decimal .

schedule:weatherPadPct a owl:DatatypeProperty ;
    rdfs:label "weather Pad Pct"@en ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/weatherPadPct> ;
    rdfs:comment "Monsoon/heat allowance as a fraction of base days, for the window the activity actually occupies. No rdfs:domain." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/signal#LabourSignal> a owl:Class ;
    rdfs:label "labour signal" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/LabourSignal> ;
    rdfs:comment "Per-week per-state labour availability score (0-1, where 0 = peak festival/harvest absence). Reason field carries the cause: Diwali / Pongal / Kharif harvest / Normal. Source: calendarific.com API + ICAR crop calendar." ;
    rdfs:subClassOf <https://w3id.org/IproK/signal#ExternalSignal> .

<https://w3id.org/IproK/signal#MaterialPriceSignal> a owl:Class ;
    rdfs:label "material price signal" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/MaterialPriceSignal> ;
    rdfs:comment "Weekly market price for a material (Steel-TMT, Cement, Bitumen, etc.) with 30-day rolling volatility and percent-deviation vs the BOQ quoted rate. Sources: SAIL website scrape (steel), RBI WPI index (cement)." ;
    rdfs:subClassOf <https://w3id.org/IproK/signal#ExternalSignal> .

<https://w3id.org/IproK/signal#WeatherSignal> a owl:Class ;
    rdfs:label "weather signal" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/WeatherSignal> ;
    rdfs:comment "Daily weather snapshot at a project's GPS; rainfall, max temp, working-day-loss-risk. Source: IMD via indianapi.in (free tier) with OpenWeatherMap fallback." ;
    rdfs:subClassOf <https://w3id.org/IproK/signal#ExternalSignal> .

<https://w3id.org/IproK/signal#availabilityScore> a owl:DatatypeProperty ;
    rdfs:label "labour availability score" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/availabilityScore> ;
    rdfs:comment "Score in [0, 1]. 0 = peak festival absence (Diwali week, Pongal week, Kharif harvest); 1 = normal availability. <0.5 triggers the festival_labour_shortage auto-risk." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/signal#avgRainfallMM> a owl:DatatypeProperty ;
    rdfs:label "average rainfall (mm)" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/avgRainfallMM> ;
    rdfs:comment "10-year mean of weekly rainfall (mm) for this calendar week at this site. Drives the historical_rain_mm_avg_this_week GNN feature." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/signal#fetchedAt> a owl:DatatypeProperty ;
    rdfs:label "profile fetched at" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/fetchedAt> ;
    rdfs:comment "When the NASA POWER fetch ran. The Celery worker re-fetches only when this is > 1 year old." ;
    rdfs:range xsd:dateTime .

<https://w3id.org/IproK/signal#heatProbability> a owl:DatatypeProperty ;
    rdfs:label "extreme heat probability" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/heatProbability> ;
    rdfs:comment "Empirical probability [0, 1] that this calendar week sees at least one day with max temp > 40°C, computed across the 10 years of the climatology window. Indian-summer concrete-pour productivity drops sharply above 40°C." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/signal#isMonsoonPeriod> a owl:DatatypeProperty ;
    rdfs:label "monsoon period flag" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/isMonsoonPeriod> ;
    rdfs:comment "True when the signal date falls inside the regional monsoon window (SW: Jun–Sep all India; NE: Oct–Dec for Tamil Nadu/Andhra)." ;
    rdfs:range xsd:boolean .

<https://w3id.org/IproK/signal#maxTempC> a owl:DatatypeProperty ;
    rdfs:label "max temperature (°C)" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/maxTempC> ;
    rdfs:comment "Daily maximum temperature in degrees Celsius. >42°C correlates with reduced productivity in north India." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/signal#priceDate> a owl:DatatypeProperty ;
    rdfs:label "price observation date" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/priceDate> ;
    rdfs:comment "Date of the price snapshot — typically the Saturday of the week the price was sampled." ;
    rdfs:range xsd:date .

<https://w3id.org/IproK/signal#pricePerUnit> a owl:DatatypeProperty ;
    rdfs:label "market price per unit (INR)" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/pricePerUnit> ;
    rdfs:comment "Current market price in INR per the material's UOM (Steel: per MT; Cement: per bag; Bitumen: per MT)." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/signal#profileLat> a owl:DatatypeProperty ;
    rdfs:label "profile latitude" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/profileLat> ;
    rdfs:comment "Site latitude (degrees, WGS84) the profile was fetched for. Stored on the profile so a later GPS edit can compare + decide whether to refetch." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/signal#profileLng> a owl:DatatypeProperty ;
    rdfs:label "profile longitude" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/profileLng> ;
    rdfs:comment "Site longitude (degrees, WGS84) the profile was fetched for." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/signal#rainProbability> a owl:DatatypeProperty ;
    rdfs:label "rain probability" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/rainProbability> ;
    rdfs:comment "Empirical probability [0, 1] that this calendar week sees > 25mm total rainfall, computed across the 10 years of the climatology window. Activities planned in high-rain-prob weeks should learn a delay bias." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/signal#rainfallMM> a owl:DatatypeProperty ;
    rdfs:label "rainfall (mm)" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/rainfallMM> ;
    rdfs:comment "Daily rainfall in millimetres at the project's GPS coordinates. Used by the auto-risk engine to gate monsoon triggers." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/signal#reason> a owl:DatatypeProperty ;
    rdfs:label "labour availability reason" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/reason> ;
    rdfs:comment "Free-text reason: 'Diwali' | 'Pongal' | 'Kharif harvest' | 'Rabi harvest' | 'Holi' | 'Normal'. Surfaced on the UI alongside the score." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/signal#signalDate> a owl:DatatypeProperty ;
    rdfs:label "signal date" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/signalDate> ;
    rdfs:comment "Calendar date the signal value pertains to (weather: that day; material price: that week's settlement; labour: week start). Domain-free." ;
    rdfs:range xsd:date .

<https://w3id.org/IproK/signal#signalWeek> a owl:DatatypeProperty ;
    rdfs:label "signal week" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/signalWeek> ;
    rdfs:comment "ISO week the labour signal pertains to (gYearMonth gives month granularity; combined with a state code identifies the week)." ;
    rdfs:range xsd:gYearMonth .

<https://w3id.org/IproK/signal#sourceYears> a owl:DatatypeProperty ;
    rdfs:label "source years" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/sourceYears> ;
    rdfs:comment "Length of the climatology window in years (NASA POWER default: 10)." ;
    rdfs:range xsd:integer .

<https://w3id.org/IproK/signal#stateCode> a owl:DatatypeProperty ;
    rdfs:label "Indian state ISO code" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/stateCode> ;
    rdfs:comment "Two-letter state code (KA / TN / MH / TG / AP / UP). Labour signals are state-specific because the festival calendar differs by region." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/signal#volatility30d> a owl:DatatypeProperty ;
    rdfs:label "30-day rolling volatility" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/volatility30d> ;
    rdfs:comment "Coefficient of variation (stddev / mean) of the price over the trailing 30 days. >0.05 flags 'volatile' for the auto-risk engine." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/signal#vsQuotedRate> a owl:DatatypeProperty ;
    rdfs:label "deviation vs BOQ quoted rate" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/vsQuotedRate> ;
    rdfs:comment "Fractional deviation: (current_price - boq_quoted_rate) / boq_quoted_rate. Positive = market is above quoted; +0.15 (15%) is the steel-escalation trigger." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/signal#weekOfYear> a owl:DatatypeProperty ;
    rdfs:label "week of year" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/weekOfYear> ;
    rdfs:comment "ISO week number 1..53. Activities query historical features by computing ISO week from their planned_start date." ;
    rdfs:range xsd:integer .

<https://w3id.org/IproK/signal#workingDayLossRisk> a owl:DatatypeProperty ;
    rdfs:label "working day loss risk" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/workingDayLossRisk> ;
    rdfs:comment "Probability [0, 1] that this calendar day will be lost to weather (rain > 25mm, extreme heat, cyclone). Computed from the underlying numbers — the GNN consumes this scalar directly." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/site#aggregateQuarryKm> a owl:DatatypeProperty ;
