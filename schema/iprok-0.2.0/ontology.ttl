    rdfs:range xsd:decimal .

<https://w3id.org/IproK/tender#contingencyAmount> a owl:DatatypeProperty ;
    rdfs:label "contingency amount (INR)" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/contingencyAmount> ;
    rdfs:comment "total_quoted × contingency_pct / 100. Domain-free." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/tender#contingencyPct> a owl:DatatypeProperty ;
    rdfs:label "contingency percentage" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/contingencyPct> ;
    rdfs:comment "Risk buffer percentage applied to total_quoted. Selected from the comparable projects' average historical CPI: 5% when avg_CPI ≥ 1.0 (historicals delivered on budget), 10% when 0.9-1.0 (slight over-runs), 15% when < 0.9 (significant historical over-runs). Domain-free." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/tender#contractForm> a owl:DatatypeProperty ;
    rdfs:label "contract form" ;
