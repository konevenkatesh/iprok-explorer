    dct:source <https://bimsaarthi.com/ontology/v0/riskMaterialisedCount> ;
    rdfs:comment "Number of <https://w3id.org/IproK/coordination#Risk> nodes (S4.5) on the historical project whose <https://w3id.org/IproK/integrated#linkedIssue> is set — risks that became real issues. Useful as a proxy for how well risk management worked. Domain-free." ;
    rdfs:range xsd:integer .

<https://w3id.org/IproK/tender#similarProject> a owl:ObjectProperty ;
