    dct:isPartOf <https://w3id.org/IproK/document> ;
    dct:source <https://bimsaarthi.com/ontology/v0/rfiId> ;
    rdfs:comment "Project-unique, zero-padded, e.g. \"RFI-0042\". Sequential per project (SPARQL MAX+1, same proven pattern as V0.29 measurementNo — FusekiRepo is Fuseki-only per the Layering rule, so no Redis client in the SPARQL layer). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/document#rfiState> a owl:ObjectProperty ;
