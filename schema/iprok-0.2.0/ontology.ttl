    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/approvalLevel1Label> ;
    rdfs:comment "The approval level1label property in the integrated project information model."@en ;
    rdfs:range xsd:string .

iprok:approvalLevel1Limit a owl:DatatypeProperty ;
    rdfs:label "approval Level1Limit"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/approvalLevel1Limit> ;
    rdfs:comment "Deviation value (INR) up to which level 1 approves." ;
    rdfs:range xsd:decimal .

iprok:approvalLevel2Label a owl:DatatypeProperty ;
    rdfs:label "approval Level2Label"@en ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/approvalLevel2Label> ;
    rdfs:comment "The approval level2label property in the integrated project information model."@en ;
    rdfs:range xsd:string .

iprok:approvalLevel2Limit a owl:DatatypeProperty ;
    rdfs:label "approval Level2Limit"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/approvalLevel2Limit> ;
    rdfs:comment "Deviation value (INR) up to which level 2 approves; above it, level 3." ;
    rdfs:range xsd:decimal .

iprok:approvalLevel3Label a owl:DatatypeProperty ;
    rdfs:label "approval Level3Label"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/approvalLevel3Label> ;
    rdfs:comment "Display names only. The stored deviation states stay ApprovedEE / ApprovedSE / ApprovedCE, so a renamed level never orphans an approval." ;
    rdfs:range xsd:string .

iprok:cin a owl:DatatypeProperty ;
    rdfs:label "cin"@en ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/cin> ;
    rdfs:comment "The cin property in the integrated project information model."@en ;
    rdfs:range xsd:string .

