<https://w3id.org/IproK/document#issuedTo> a owl:ObjectProperty ;
    rdfs:label "issued to" ;
    dct:isPartOf <https://w3id.org/IproK/document> ;
    dct:source <https://bimsaarthi.com/ontology/v0/issuedTo> ;
    rdfs:comment "Repeatable — the <https://w3id.org/IproK#User>(s) the transmittal is addressed to. SHACL requires sh:minCount 1. Domain unspecified (antipattern #8)." ;
