    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/legalName> ;
    rdfs:comment "The legal name property in the integrated project information model."@en ;
    rdfs:range xsd:string .

iprok:legallyBinding a owl:DatatypeProperty ;
    rdfs:label "legally binding" ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/legallyBinding> ;
    rdfs:comment "xsd:boolean. True for real eMudhra/DigiLocker signatures; False for Stub mode. Allows queries to filter compliance-grade from development signatures." ;
    rdfs:range xsd:boolean .

