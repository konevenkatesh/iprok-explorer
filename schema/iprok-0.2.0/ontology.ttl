    rdfs:comment "The historical project's most recent CPI (cost-performance index) from <https://w3id.org/IproK/schedule#EVMSnapshot> (S4.2). > 1.0 = under budget; < 1.0 = over budget. Null when the project has no EVM history. Domain-free." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/tender#avgRateVariance> a owl:DatatypeProperty ;
    rdfs:label "average rate variance (percent, signed)" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/avgRateVariance> ;
    rdfs:comment "Mean of the tender BOQ items' rateVariance across the rows that matched into this historical project. Positive = tender priced higher than the historical actual; negative = lower. Domain-free." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/tender#baseRate> a owl:DatatypeProperty ;
    rdfs:label "base rate" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/baseRate> ;
