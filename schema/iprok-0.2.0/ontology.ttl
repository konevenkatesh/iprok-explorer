integrated:zone a owl:DatatypeProperty ;
    rdfs:label "zone" ;
    dct:isPartOf <https://w3id.org/IproK/integrated> ;
    dct:source <https://bimsaarthi.com/ontology/v0/zone> ;
    rdfs:comment "Inferred zone name. Written at DPR-submit time from project's <https://w3id.org/IproK#zoneConfig> + GPS. Domain intentionally unspecified — V0.26 reuses the same property on <https://w3id.org/IproK/safety#Incident>, and an `rdfs:domain <https://w3id.org/IproK/reporting#DPREntry>` declaration would make every incident-with-zone get RDFS-classified as a DPREntry (same trap as V0.17's <https://w3id.org/IproK/quality#failureNote>, see CLAUDE.md antipattern #8)." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/prediction#confidenceScore> a owl:DatatypeProperty ;
