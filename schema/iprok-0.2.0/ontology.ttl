    rdfs:comment "Issuing authority: CPWD, AP-PWD, MES, NHAI, Railway, State-PWD. Polymorphic — domain unspecified." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/tender#rateVariance> a owl:DatatypeProperty ;
    rdfs:label "rate variance (percent, signed)" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/rateVariance> ;
    rdfs:comment "(quotedRate − sorBaseRate) / sorBaseRate × 100. Positive = tender priced higher than SOR; negative = tender priced lower. |variance| > 20% is flagged in the match report. Absent when no SOR match OR quotedRate is null." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/tender#rateYear> a owl:DatatypeProperty ;
    rdfs:label "rate year" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/rateYear> ;
    rdfs:comment "The rate year property in the integrated project information model."@en ;
    rdfs:range xsd:integer .

<https://w3id.org/IproK/tender#recommendedBid> a owl:DatatypeProperty ;
    rdfs:label "recommended bid (INR)" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/recommendedBid> ;
