    rdfs:comment "The tender short desc property in the integrated project information model."@en ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/tender#tenderTitle> a owl:DatatypeProperty ;
    rdfs:label "tender title" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/tenderTitle> ;
    rdfs:comment "The tender title property in the integrated project information model."@en ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/tender#tenderUnit> a owl:DatatypeProperty ;
    rdfs:label "tender unit (canonical)" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/tenderUnit> ;
    rdfs:comment "The tender unit property in the integrated project information model."@en ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/tender#totalQuoted> a owl:DatatypeProperty ;
    rdfs:label "total quoted (INR)" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/totalQuoted> ;
    rdfs:comment "Sum of (recommended_rate × estimated_qty) across every matched <https://w3id.org/IproK/tender#TenderBOQItem>. The base bid before contingency. Domain-free (antipattern #8)." ;
    rdfs:range xsd:decimal .

iprok:Calendar a owl:Class ;
    rdfs:label "Calendar" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A definition of working and non-working periods used to interpret scheduled work."@en ;
    rdfs:subClassOf iprok:IproKThing .

iprok:IdSequence a owl:Class ;
    rdfs:label "Id Sequence"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/IdSequence> ;
    rdfs:comment "The last number issued for one kind of register id in one project." .

iprok:SignatureEvent a owl:Class ;
    rdfs:label "Signature Event" ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/SignatureEvent> ;
    rdfs:comment "A single act of signing a platform document via an e-signature provider. Carries who signed, when, the provider, purpose, and a reference to the signed document." ;
    rdfs:subClassOf prov:Activity .

<https://w3id.org/IproK/billing#Deviation> a owl:Class ;
    rdfs:label "Deviation" ;
    dct:isPartOf <https://w3id.org/IproK/billing> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Deviation> ;
    rdfs:comment "A BOQ quantity deviation: measured quantity exceeds tendered quantity by >25%. Triggers approval routing before bill submission. Defined in S3.7." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/billing#Payment> a owl:Class ;
    rdfs:label "Payment" ;
    dct:isPartOf <https://w3id.org/IproK/billing> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Payment> ;
    rdfs:comment "A payment made by the client against a certified RA Bill, imported from Tally ERP XML exports. Each payment corresponds to one Tally voucher." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/billing#Recovery> a owl:Class ;
    rdfs:label "Recovery" ;
    dct:isPartOf <https://w3id.org/IproK/billing> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Recovery> ;
    rdfs:comment "A single statutory deduction line item within a <https://w3id.org/IproK/billing#RABill>. Each recovery has a type (TDS-IT, GST-TDS, LabourCess, SecurityDeposit, AdvanceRecovery, WaterElectricity, Royalty, Other), a rate (percentage), and a computed amount. Defined in S3.6." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/building#ElementCopiesRecorded> a owl:Class ;
    rdfs:label "element copies recorded" ;
    dct:isPartOf <https://w3id.org/IproK/building> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ElementCopiesRecorded> ;
    rdfs:comment "N41.1; the act of keeping, on each copy, which model's element the take-off counted it as. Carries the person, the time, the take-off it came from (rdfs:comment) and how many elements changed; each changed element points back at it (prov:wasInfluencedBy)." ;
    rdfs:subClassOf prov:Activity .

<https://w3id.org/IproK/building#ElementDuplicatesRetired> a owl:Class ;
    rdfs:label "element duplicates retired" ;
    dct:isPartOf <https://w3id.org/IproK/building> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ElementDuplicatesRetired> ;
    rdfs:comment "N41.2; the startup migration retiring, in one project graph, the extra element nodes the pre-N41.2 parser wrote. Carries when it started and ended, how many nodes it retired, and (<https://w3id.org/IproK/integrated#hadChange>) each model element count it corrected from the duplicated count to the number of distinct elements." ;
    rdfs:subClassOf prov:Activity .

<https://w3id.org/IproK/building#MemberIdentity> a owl:Class ;
    rdfs:label "Member Identity"@en ;
    dct:isPartOf <https://w3id.org/IproK/building> ;
    dct:source <https://bimsaarthi.com/ontology/v0/MemberIdentity> ;
    rdfs:comment "VIDHI's IS-code identity of the steel members of one model that project information interface described identically." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/building#ModelComment> a owl:Class ;
    rdfs:label "Model Comment"@en ;
    dct:isPartOf <https://w3id.org/IproK/building> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ModelComment> ;
    rdfs:comment "One recorded design-review comment on an IFC model view; the graph-native markup that Bluebeam/BIMcollab keep in opaque files." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/building#ModelHealthCheck> a owl:Class ;
    rdfs:label "Model Health Check"@en ;
    dct:isPartOf <https://w3id.org/IproK/building> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ModelHealthCheck> ;
    rdfs:comment "One health audit of one IFC model at a point in time." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/coordination#ClashBatch> a owl:Class ;
    rdfs:label "BCF clash batch" ;
    dct:isPartOf <https://w3id.org/IproK/coordination> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ClashBatch> ;
    rdfs:comment "One BCF-zip import. Used by the clash lifecycle dashboard to roll up closure rates per batch." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/coordination#Risk> a owl:Class ;
    rdfs:label "Risk" ;
    dct:isPartOf <https://w3id.org/IproK/coordination> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Risk> ;
    rdfs:comment "A proactive risk-register row. Sub-class of <https://w3id.org/IproK/coordination#Event> so issue + risk reuse the same superclass; sub-class of prov:Entity for PROV-O attribution." ;
    rdfs:subClassOf prov:Entity,
        <https://w3id.org/IproK/coordination#Event> .

cost:AnalysisAddition a owl:Class ;
    rdfs:label "Analysis Addition"@en ;
    dct:isPartOf <https://w3id.org/IproK/cost> ;
    dct:source <https://bimsaarthi.com/ontology/v0/AnalysisAddition> ;
    rdfs:comment "A percentage added to an analysis in order, on a stated base; water charges on cost, contractor's profit and overheads on the running total." ;
    rdfs:subClassOf prov:Entity .

cost:CostCategory a owl:Class ;
    rdfs:label "CostCategory" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A classification grouping cost items by their purpose or accounting category."@en ;
    rdfs:subClassOf iprok:IproKThing .

cost:EquipmentCost a owl:Class ;
    rdfs:label "EquipmentCost" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A cost-type classification for equipment-related expenditure."@en ;
    rdfs:subClassOf cost:CostType .

cost:ExpenseItem a owl:Class ;
    rdfs:label "ExpenseItem" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A cost-type classification for other project expenses."@en ;
    rdfs:subClassOf cost:CostType .

cost:LaborCost a owl:Class ;
    rdfs:label "LaborCost" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A cost-type classification for labour-related expenditure."@en ;
    rdfs:subClassOf cost:CostType .

cost:MaterialCost a owl:Class ;
    rdfs:label "MaterialCost" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A cost-type classification for material-related expenditure."@en ;
    rdfs:subClassOf cost:CostType .

cost:ResourceMapping a owl:Class ;
    rdfs:label "Resource Mapping"@en ;
    dct:isPartOf <https://w3id.org/IproK/cost> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ResourceMapping> ;
    rdfs:comment "Which of the organisation's resources a code of an outside source stands for (a CPWD DAR resource code, a cited CPWD item). Chosen by a person, never guessed; a change supersedes the old mapping." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/document#DrawingChange> a owl:Class ;
    rdfs:label "Drawing change" ;
    dct:isPartOf <https://w3id.org/IproK/document> ;
    dct:source <https://bimsaarthi.com/ontology/v0/DrawingChange> ;
    rdfs:comment "One AI-detected change between two drawing revisions (added / removed / modified element, dimension, annotation, or spec). Produced by the compare_revisions task; never hand-authored." .

<https://w3id.org/IproK/document#Transmittal> a owl:Class ;
    rdfs:label "Transmittal" ;
    dct:isPartOf <https://w3id.org/IproK/document> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Transmittal> ;
    rdfs:comment "ISO-19650 transmittal record. Auto-numbered T-NNNN, auto-PDF, append-only; one per drawing state transition + ad-hoc batches via POST /transmittals." ;
    rdfs:subClassOf prov:Activity .

<https://w3id.org/IproK/handover#DLPDefect> a owl:Class ;
    rdfs:label "DLPDefect"@en ;
    dct:isPartOf <https://w3id.org/IproK/handover> ;
    dct:source <https://bimsaarthi.com/ontology/v0/DLPDefect> ;
    rdfs:comment "A post-handover defect inside the liability period; RERA S.14(3): rectify within 30 days." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/quality#HoldPoint> a owl:Class ;
    rdfs:label "Hold Point"@en ;
    dct:isPartOf <https://w3id.org/IproK/quality> ;
    dct:source <https://bimsaarthi.com/ontology/v0/HoldPoint> ;
    rdfs:comment "One inspection/witness point from the ITP, bound to a schedule activity." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/reporting#SavedQuery> a owl:Class ;
    rdfs:label "Saved SPARQL query (dashboard widget)" ;
    dct:isPartOf <https://w3id.org/IproK/reporting> ;
    dct:source <https://bimsaarthi.com/ontology/v0/SavedQuery> ;
    rdfs:comment "A persisted, named SPARQL query attached to a project. Renders as a dashboard widget per its visualType." ;
    rdfs:subClassOf prov:Entity .

resource:EquipmentResource a owl:Class ;
    rdfs:label "EquipmentResource" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A resource-type classification for equipment."@en ;
    rdfs:subClassOf resource:ResourceType .

resource:LaborResource a owl:Class ;
    rdfs:label "LaborResource" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A resource-type classification for labour."@en ;
    rdfs:subClassOf resource:ResourceType .

resource:MaterialResource a owl:Class ;
    rdfs:label "MaterialResource" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A resource-type classification for materials."@en ;
    rdfs:subClassOf resource:ResourceType .

resource:ProductivityRecompute a owl:Class ;
    rdfs:label "Productivity recompute" ;
    dct:isPartOf <https://w3id.org/IproK/resource> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ProductivityRecompute> ;
    rdfs:comment "The per-organisation claim token for writing measured rates." .

resource:ResourceConstraint a owl:Class ;
    rdfs:label "ResourceConstraint" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A condition restricting the availability or use of a resource."@en ;
    rdfs:subClassOf iprok:Constraint .

resource:SkillCertification a owl:Class ;
    rdfs:label "Skill Certification"@en ;
    dct:isPartOf <https://w3id.org/IproK/resource> ;
    dct:source <https://bimsaarthi.com/ontology/v0/SkillCertification> ;
    rdfs:comment "A certification held by a worker, with a validity window so expiry is queryable." ;
    rdfs:subClassOf prov:Entity .

resource:TrackingTag a owl:Class ;
    rdfs:label "TrackingTag" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "An identifier concept used to track a resource."@en ;
    rdfs:subClassOf iprok:IproKThing .

resource:Units a owl:Class ;
    rdfs:label "Units" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A unit of measure used to express a resource quantity."@en ;
    rdfs:subClassOf iprok:IproKThing .

resource:UserDefinedResource a owl:Class ;
    rdfs:label "UserDefinedResource" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A resource-type classification defined for a project-specific need."@en ;
    rdfs:subClassOf resource:ResourceType .

schedule:EVMSnapshot a owl:Class ;
    rdfs:label "EVM snapshot" ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/EVMSnapshot> ;
    rdfs:comment "One computation of PV/EV/AC and derived metrics for a project at a status date." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/signal#HistoricalWeatherWeek> a owl:Class ;
    rdfs:label "historical weather week" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/HistoricalWeatherWeek> ;
    rdfs:comment "One ISO week-of-year bucket (1..53) of the climatology profile. 52 instances per HistoricalWeatherProfile; the GNN reads three scalars from the week-bucket whose ISO week matches an activity's planned-start." .

<https://w3id.org/IproK/tender#BidRecommendation> a owl:Class ;
    rdfs:label "Bid Recommendation" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/BidRecommendation> ;
    rdfs:comment "The final bid-output document for a tender: total quoted, contingency, recommended bid, item-count + high-risk-count breakdown. The line-item detail is NOT stored on this node; it is re-derivable from the underlying S5.2 + S5.3 graph state, and persisting it would create stale-data risk on a SOR-rate or comparable-project update. The PDF lives in MinIO via <https://w3id.org/IproK/document#fileRef>." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/tender#SORLibrary> a owl:Class ;
    rdfs:label "SOR Library" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/SORLibrary> ;
    rdfs:comment "A Schedule of Rates publication ingested into the platform. Platform-wide reference data, not per-project." .

<https://w3id.org/IproK/tender#TenderBOQItem> a owl:Class ;
    rdfs:label "Tender BOQ Item" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/TenderBOQItem> ;
    rdfs:comment "One BOQ row extracted from a tender PDF during ingestion. Distinct from <https://w3id.org/IproK/billing#BOQItem> (post-award, project-side). Carries <https://w3id.org/IproK/tender#ofTender>, <https://w3id.org/IproK/tender#needsReview> (L24 hallucination guard), and <https://w3id.org/IproK/tender#dedupCount> (5-gram Jaccard collapse)." ;
    rdfs:subClassOf prov:Entity .

iprok:Actor a owl:Class ;
    rdfs:label "Actor" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A person or organisational actor to whom scheduled work can be assigned."@en ;
    rdfs:subClassOf iprok:IproKThing .

iprok:Decision a owl:Class ;
    rdfs:label "Decision"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Decision> ;
    rdfs:comment "A question about the project and the answer a named person gave to it." ;
    rdfs:subClassOf prov:Entity .

iprok:MastersAdoption a owl:Class ;
    rdfs:label "Masters adoption" ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/MastersAdoption> ;
    rdfs:comment "A project taking a version of its organisation's masters; at creation or when its PM adopts a newer one." ;
    rdfs:subClassOf prov:Entity .

iprok:OrganisationMasters a owl:Class ;
    rdfs:label "Organisation masters" ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/OrganisationMasters> ;
    rdfs:comment "One version of an organisation's defaults: contract deductions, deviation routing, financial year and legal identity." ;
    rdfs:subClassOf prov:Entity .

cost:AnalysisLine a owl:Class ;
    rdfs:label "Analysis Line"@en ;
    dct:isPartOf <https://w3id.org/IproK/cost> ;
    dct:source <https://bimsaarthi.com/ontology/v0/AnalysisLine> ;
    rdfs:comment "One resource line of an analysis version." ;
    rdfs:subClassOf prov:Entity .

cost:DesignOption a owl:Class ;
    rdfs:label "Design option" ;
    dct:isPartOf <https://w3id.org/IproK/cost> ;
    dct:source <https://bimsaarthi.com/ontology/v0/DesignOption> ;
    rdfs:comment "A priced design decision under consideration or decided. Decisions are PROV-O supersessions; Approved options move the working estimate." ;
    rdfs:subClassOf prov:Entity .

cost:ProjectResourcePrice a owl:Class ;
    rdfs:label "Project Resource Price"@en ;
    dct:isPartOf <https://w3id.org/IproK/cost> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ProjectResourcePrice> ;
    rdfs:comment "The one rate a project uses for a resource. Copied from the organisation's basic rates when first used; changed only by a person, and every change is recorded." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/document#Annotation> a owl:Class ;
    rdfs:label "Annotation" ;
    dct:isPartOf <https://w3id.org/IproK/document> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Annotation> ;
    rdfs:comment "One SVG markup on a drawing (revision cloud / callout / text / dimension / stamp). Append-only: a deleted markup is prov:invalidated, never removed. Modelled like <https://w3id.org/IproK/quality#RecurrenceAlert> (prov:Entity subclass)." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/finance#CollectionReceipt> a owl:Class ;
    rdfs:label "Collection Receipt"@en ;
    dct:isPartOf <https://w3id.org/IproK/finance> ;
    dct:source <https://bimsaarthi.com/ontology/v0/CollectionReceipt> ;
    rdfs:comment "One buyer payment against a unit, split escrow/operating at receipt time." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/finance#DemandNote> a owl:Class ;
    rdfs:label "Demand Note"@en ;
    dct:isPartOf <https://w3id.org/IproK/finance> ;
    dct:source <https://bimsaarthi.com/ontology/v0/DemandNote> ;
    rdfs:comment "One payment demand to one unit's allottee against an achieved milestone." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/finance#EscrowWithdrawal> a owl:Class ;
    rdfs:label "Escrow Withdrawal"@en ;
    dct:isPartOf <https://w3id.org/IproK/finance> ;
    dct:source <https://bimsaarthi.com/ontology/v0/EscrowWithdrawal> ;
    rdfs:comment "One utilization of escrow funds against a cost head, certificate-backed per RERA S.4(2)(l)(D)." ;
    rdfs:subClassOf prov:Activity .

<https://w3id.org/IproK/finance#PaymentMilestone> a owl:Class ;
    rdfs:label "Payment Milestone"@en ;
    dct:isPartOf <https://w3id.org/IproK/finance> ;
    dct:source <https://bimsaarthi.com/ontology/v0/PaymentMilestone> ;
    rdfs:comment "One instalment trigger in the project's payment schedule; e.g. 'Plinth completion; 15%'." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/handover#SnagItem> a owl:Class ;
    rdfs:label "Snag Item"@en ;
    dct:isPartOf <https://w3id.org/IproK/handover> ;
    dct:source <https://bimsaarthi.com/ontology/v0/SnagItem> ;
    rdfs:comment "One punch-list item found during handover inspection. Open Critical snags block transfer." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/handover#WarrantyRecord> a owl:Class ;
    rdfs:label "Warranty Record"@en ;
    dct:isPartOf <https://w3id.org/IproK/handover> ;
    dct:source <https://bimsaarthi.com/ontology/v0/WarrantyRecord> ;
    rdfs:comment "One asset/system warranty (vendor, start, duration) handed to operations." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/procurement#GoodsReceipt> a owl:Class ;
    rdfs:label "Goods receipt (SAP)" ;
    dct:isPartOf <https://w3id.org/IproK/procurement> ;
    dct:source <https://bimsaarthi.com/ontology/v0/GoodsReceipt> ;
    rdfs:comment "One SAP material-document line (MIGO MIGO_GR). Links back to its <https://w3id.org/IproK/procurement#PurchaseOrder> via <https://w3id.org/IproK/procurement#forPO>." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/procurement#MaterialIssue> a owl:Class ;
    rdfs:label "Material Issue" ;
    dct:isPartOf <https://w3id.org/IproK/procurement> ;
    dct:source <https://bimsaarthi.com/ontology/v0/MaterialIssue> ;
    rdfs:comment "A site store issue of construction material (cement, steel, etc.) against a project activity. Used for IS-coefficient-based consumption reconciliation." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/procurement#ProductOffer> a owl:Class ;
    rdfs:label "Product Offer"@en ;
    dct:isPartOf <https://w3id.org/IproK/procurement> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ProductOffer> ;
    rdfs:comment "One vendor's offer for a product/spec: rate, lead time, quality, warranty." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/procurement#Vendor> a owl:Class ;
    rdfs:label "Vendor"@en ;
    dct:isPartOf <https://w3id.org/IproK/procurement> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Vendor> ;
    rdfs:comment "One supplier/subcontractor in the org's vendor database." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/property#UnitType> a owl:Class ;
    rdfs:label "Unit type" ;
    dct:isPartOf <https://w3id.org/IproK/property> ;
    dct:source <https://bimsaarthi.com/ontology/v0/UnitType> ;
    rdfs:comment "A sellable unit archetype (2BHK / 3BHK …) with its area set and base rate." ;
    rdfs:subClassOf prov:Entity .

resource:CrewComposition a owl:Class ;
    rdfs:label "Crew Composition"@en ;
    dct:isPartOf <https://w3id.org/IproK/resource> ;
    dct:source <https://bimsaarthi.com/ontology/v0/CrewComposition> ;
    rdfs:comment "One trade line within a crew type: N of a given trade at a given skill level." ;
    rdfs:subClassOf prov:Entity .

resource:ProductivityContribution a owl:Class ;
    rdfs:label "Productivity Contribution"@en ;
    dct:isPartOf <https://w3id.org/IproK/resource> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ProductivityContribution> ;
    rdfs:comment "A project's site days counted in its organisation's measured rates. Withdrawn by prov:invalidatedAtTime with who and why; publishing again creates a new one." ;
    rdfs:subClassOf prov:Entity .

resource:ProductivityNorm a owl:Class ;
    rdfs:label "Productivity Norm"@en ;
    dct:isPartOf <https://w3id.org/IproK/resource> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ProductivityNorm> ;
    rdfs:comment "The organisation's rolled-up rate for a work type + crew type, derived from observations. Falls back to a seeded default until enough observations exist." ;
    rdfs:subClassOf prov:Entity .

resource:Worker a owl:Class ;
    rdfs:label "Worker"@en ;
    dct:isPartOf <https://w3id.org/IproK/resource> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Worker> ;
    rdfs:comment "A person performing site labour. NOT a <https://w3id.org/IproK#User>; most site labour never logs in. Org-level catalogue." ;
    rdfs:subClassOf prov:Agent .

schedule:ActivityDurationEstimate a owl:Class ;
    rdfs:label "Activity Duration Estimate"@en ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ActivityDurationEstimate> ;
    rdfs:comment "How a planned activity's duration was reached: quantity, crew, rate and its source, allowances. Superseded, never overwritten." ;
    rdfs:subClassOf prov:Entity .

schedule:BaselineEntry a owl:Class ;
    rdfs:label "Baseline Entry"@en ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/BaselineEntry> ;
    rdfs:comment "One activity as a baseline froze it: its start, last day and budget then." ;
    rdfs:subClassOf prov:Entity .

schedule:WBS_Element a owl:Class ;
    rdfs:label "WBS_Element" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "An element of the work breakdown structure used to organise tasks."@en ;
    rdfs:subClassOf iprok:IproKThing .

schedule:WorkConstraint a owl:Class ;
    rdfs:label "Work Constraint"@en ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Constraint> ;
    rdfs:comment "Something that must be cleared, by a named person and date, before planned work can proceed." ;
    rdfs:subClassOf prov:Entity,
        iprok:Constraint .

schedule:WorkPackage a owl:Class ;
    rdfs:label "WorkPackage" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A grouping of project work represented in the work breakdown structure."@en ;
    rdfs:subClassOf iprok:IproKThing .

<https://w3id.org/IproK/tender#ComparableProject> a owl:Class ;
    rdfs:label "Comparable Project" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ComparableProject> ;
    rdfs:comment "One row of the bid-intelligence audit trail for a tender. Links a <https://w3id.org/IproK/tender#Tender> to a historical <https://w3id.org/IproK/schedule#Project> that the comparator scored as similar, with the score decomposition + the historical project's outcome signals attached." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/approval#Approval> a owl:Class ;
    rdfs:label "Statutory approval" ;
    dct:isPartOf <https://w3id.org/IproK/approval> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Approval> ;
    rdfs:comment "A statutory approval, NOC, registration or certificate the project must obtain. Status transitions are PROV-O supersessions; the record is append-only." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/billing#JointMeasurement> a owl:Class ;
    rdfs:label "Joint Measurement" ;
    dct:isPartOf <https://w3id.org/IproK/billing> ;
    dct:source <https://bimsaarthi.com/ontology/v0/JointMeasurement> ;
    rdfs:comment "A joint measurement record supporting separate contractor and departmental sign-off roles." ;
    rdfs:subClassOf prov:Activity .

<https://w3id.org/IproK/coordination#Event> a owl:Class ;
    rdfs:label "Event" ;
    dct:isPartOf <https://w3id.org/IproK/coordination> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Event> ;
    rdfs:comment "Superclass for issue-like nodes (BCF issues, future inspection events). No shape; concrete subclasses carry the constraints." .

<https://w3id.org/IproK/coordination#Issue> a owl:Class ;
    rdfs:label "Issue" ;
    dct:isPartOf <https://w3id.org/IproK/coordination> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Issue> ;
    rdfs:comment "A BCF-imported clash / coordination / design / safety / construction issue, or a manually-raised graph-native one. Linked to an IFC element GUID + optionally to an RFI / Drawing / Activity; the cross-domain closure chain (Clash → RFI → Drawing → Activity) that no point solution can answer natively." ;
    rdfs:subClassOf prov:Entity,
        <https://w3id.org/IproK/coordination#Event> .

cost:RateAnalysis a owl:Class ;
    rdfs:label "Rate Analysis"@en ;
    dct:isPartOf <https://w3id.org/IproK/cost> ;
    dct:source <https://bimsaarthi.com/ontology/v0/RateAnalysis> ;
    rdfs:comment "One version of an analysis of rates: a library analysis the organisation keeps, or the analysis behind one BOQ line of a project. A save writes a new version and supersedes the old one." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/finance#EscrowAccount> a owl:Class ;
    rdfs:label "Escrow Account"@en ;
    dct:isPartOf <https://w3id.org/IproK/finance> ;
    dct:source <https://bimsaarthi.com/ontology/v0/EscrowAccount> ;
    rdfs:comment "The project's RERA collection account discipline: a designated escrow account receiving the statutory share (default 70%) of every buyer collection." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/prediction#ActivityPrediction> a owl:Class ;
    rdfs:label "Activity prediction (GAT-derived)" ;
    dct:isPartOf <https://w3id.org/IproK/prediction> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ActivityPrediction> ;
    rdfs:comment "A versioned record describing an activity-level prediction and its input, model and baseline provenance." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/procurement#PurchaseOrder> a owl:Class ;
    rdfs:label "Purchase order (SAP)" ;
    dct:isPartOf <https://w3id.org/IproK/procurement> ;
    dct:source <https://bimsaarthi.com/ontology/v0/PurchaseOrder> ;
    rdfs:comment "One SAP PO header. linkedBOQItem connects procurement back to the contract chain so the gap-report engine can compute committed vs certified per BOQ row." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/property#Tower> a owl:Class ;
    rdfs:label "Tower / wing" ;
    dct:isPartOf <https://w3id.org/IproK/property> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Tower> ;
    rdfs:comment "A tower, wing or block of the project." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/reporting#Photo> a owl:Class ;
    rdfs:label "Photo" ;
    dct:isPartOf <https://w3id.org/IproK/reporting> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Photo> ;
    rdfs:comment "A geo-tagged site photo, stored in MinIO and linked to the entity it documents." .

resource:ProductivityObservation a owl:Class ;
    rdfs:label "Productivity Observation"@en ;
    dct:isPartOf <https://w3id.org/IproK/resource> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ProductivityObservation> ;
    rdfs:comment "One measured data point: quantity achieved by a crew of a known size over a known period on a known activity." ;
    rdfs:subClassOf prov:Entity .

schedule:ScheduleBaseline a owl:Class ;
    rdfs:label "Schedule Baseline"@en ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ScheduleBaseline> ;
    rdfs:comment "A frozen copy of the programme. Baseline 0 is the approved programme (Clause 5.1); later ones are revised programmes (Clause 5.4), each with its basis, reason and approver. Never changed or removed; the newest is the active baseline that variance and planned value are measured against." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/signal#HistoricalWeatherProfile> a owl:Class ;
    rdfs:label "historical weather profile" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/HistoricalWeatherProfile> ;
    rdfs:comment "10-year climatology snapshot at a project's GPS; 52 weekly buckets, each with avg rainfall + rain probability + extreme-heat probability. Source: NASA POWER (power.larc.nasa.gov), free climatology API, no auth required. Fetched once at project geocoding; treated as static climate context (re-fetch only if site GPS changes)." ;
    rdfs:subClassOf <https://w3id.org/IproK/signal#ExternalSignal> .

<https://w3id.org/IproK/tender#SORItem> a owl:Class ;
    rdfs:label "SOR Item" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/SORItem> ;
    rdfs:comment "One rate item from a <https://w3id.org/IproK/tender#SORLibrary>. Carries sorCode + description + unit + baseRate." .

<https://w3id.org/IproK/billing#RABill> a owl:Class ;
    rdfs:label "Running Account Bill" ;
    dct:isPartOf <https://w3id.org/IproK/billing> ;
    dct:source <https://bimsaarthi.com/ontology/v0/RABill> ;
    rdfs:comment "A Running Account Bill (RA Bill); the payment instrument in Indian government and PSU construction contracts. Aggregates all approved measurements for a billing period, applies BOQ rates, deducts previous payments and recoveries, and produces the net payable amount." ;
    rdfs:subClassOf prov:Entity,
        <https://w3id.org/IproK/document#Document> .

<https://w3id.org/IproK/document#RFI> a owl:Class ;
    rdfs:label "RFI" ;
    dct:isPartOf <https://w3id.org/IproK/document> ;
    dct:source <https://bimsaarthi.com/ontology/v0/RFI> ;
    rdfs:comment "Request For Information; the core Indian-EPC document workflow, modelled as a graph node with a 6-state machine and SLA tracking, linked to the drawing / markup / activity that raised it." ;
    rdfs:subClassOf prov:Entity,
        <https://w3id.org/IproK/document#Document> .

<https://w3id.org/IproK/property#Unit> a owl:Class ;
    rdfs:label "Unit" ;
    dct:isPartOf <https://w3id.org/IproK/property> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Unit> ;
    rdfs:comment "One sellable unit. Status transitions are PROV-O supersessions." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/reporting#DPREntry> a owl:Class ;
    rdfs:label "Daily Progress Report Entry" ;
    dct:isPartOf <https://w3id.org/IproK/reporting> ;
    dct:source <https://bimsaarthi.com/ontology/v0/DPREntry> ;
    rdfs:comment "A single field-reported progress entry against an Activity." ;
    rdfs:subClassOf prov:Activity .

resource:CrewType a owl:Class ;
    rdfs:label "Crew Type"@en ;
    dct:isPartOf <https://w3id.org/IproK/resource> ;
    dct:source <https://bimsaarthi.com/ontology/v0/CrewType> ;
    rdfs:comment "A named gang the organisation deploys; 'Mason gang (6)', 'Bar bender gang (4)'. Org-level catalogue." ;
    rdfs:subClassOf prov:Entity .

schedule:ScheduleLink a owl:Class ;
    rdfs:label "Schedule link" ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ScheduleLink> ;
    rdfs:comment "A reified predecessor edge: which activity precedes which, the P6 relationship type (FS/SS/FF/SF) and the lag in days." .

schedule:WBSNode a owl:Class ;
    rdfs:label "WBS node" ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/WBSNode> ;
    rdfs:comment "One node in the project work-breakdown structure. Recursive via <https://w3id.org/IproK/schedule#parentWBS>; a leaf (<https://w3id.org/IproK/schedule#isWorkPackage> true) is a work package." ;
    rdfs:subClassOf prov:Entity .

iprok:Constraint a owl:Class ;
    rdfs:label "Constraint" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A condition restricting the execution or organisation of project work."@en ;
    rdfs:subClassOf iprok:IproKThing .

iprok:ProjectMembership a owl:Class ;
    rdfs:label "Project membership" ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ProjectMembership> ;
    rdfs:comment "An (project, user) edge with a joinedAt timestamp." .

<https://w3id.org/IproK/billing#BillState> a owl:Class ;
    rdfs:label "Bill State" ;
    dct:isPartOf <https://w3id.org/IproK/billing> ;
    dct:source <https://bimsaarthi.com/ontology/v0/BillState> ;
    rdfs:comment "Lifecycle state of a <https://w3id.org/IproK/billing#RABill>. Four individuals: BillDraft (initial, editable), BillSubmitted (sent for approval), BillApproved (departmental approval given), BillFinalised (payment authorised, immutable)." .

<https://w3id.org/IproK/billing#JMStatus> a owl:Class ;
    rdfs:label "Joint Measurement Status" ;
    dct:isPartOf <https://w3id.org/IproK/billing> ;
    dct:source <https://bimsaarthi.com/ontology/v0/JMStatus> ;
    rdfs:comment "State of a <https://w3id.org/IproK/billing#JointMeasurement>. Four individuals: JMPendingContractor (initial, awaiting contractor OTP), JMPendingDepartmental (contractor signed, awaiting JE/AE), JMComplete (both signed, legally binding), JMRejected (either party rejected)." .

<https://w3id.org/IproK/building#IfcModel> a owl:Class ;
    rdfs:label "IFC Model" ;
    dct:isPartOf <https://w3id.org/IproK/building> ;
    dct:source <https://bimsaarthi.com/ontology/v0/IfcModel> ;
    rdfs:comment "One uploaded IFC model revision. Carries fileRef, fileFormat ('IFC'), uploadedAt, modelRevision, elementCount, ofProject. Element-level detail lives in <https://w3id.org/IproK/building#Element> triples." ;
    rdfs:subClassOf <https://w3id.org/IproK/document#Document> .

cost:CostResource a owl:Class ;
    rdfs:label "Cost Resource"@en ;
    dct:isPartOf <https://w3id.org/IproK/cost> ;
    dct:source <https://bimsaarthi.com/ontology/v0/CostResource> ;
    rdfs:comment "An entry in an organisation's book of basic rates: a trade, material, plant item or other cost with its unit and current rate." ;
    rdfs:subClassOf prov:Entity .

cost:CostType a owl:Class ;
    rdfs:label "CostType" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A classification of expenditure by the kind of resource or expense involved."@en ;
    rdfs:subClassOf iprok:IproKThing .

<https://w3id.org/IproK/handover#HandoverPackage> a owl:Class ;
    rdfs:label "Handover Package"@en ;
    dct:isPartOf <https://w3id.org/IproK/handover> ;
    dct:source <https://bimsaarthi.com/ontology/v0/HandoverPackage> ;
    rdfs:comment "The project's digital handover record: readiness, transfer, and the defect-liability window." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/quality#ChecklistItem> a owl:Class ;
    rdfs:label "Checklist item" ;
    dct:isPartOf <https://w3id.org/IproK/quality> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ChecklistItem> ;
    rdfs:comment "One row of an inspection checklist with a pass/fail outcome and an optional failure note." .

<https://w3id.org/IproK/quality#RecurrenceAlert> a owl:Class ;
    rdfs:label "Recurrence alert" ;
    dct:isPartOf <https://w3id.org/IproK/quality> ;
    dct:source <https://bimsaarthi.com/ontology/v0/RecurrenceAlert> ;
    rdfs:comment "A repeated defect on the same activity, surfaced from grouping failed checklist items by (activity, normalised failure note). Status uses the <https://w3id.org/IproK/quality#NCRStatus> IRIs (<https://w3id.org/IproK/integrated#Open> / <https://w3id.org/IproK/integrated#Acknowledged> at V0.28; UnderReview/Closed/Rejected reserved for later)." ;
    rdfs:subClassOf prov:Entity .

resource:ResourceType a owl:Class ;
    rdfs:label "ResourceType" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A classification describing the kind of a resource."@en ;
    rdfs:subClassOf iprok:IproKThing .

<https://w3id.org/IproK/signal#ExternalSignal> a owl:Class ;
    rdfs:label "external signal" ;
    dct:isPartOf <https://w3id.org/IproK/signal> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ExternalSignal> ;
    rdfs:comment "Abstract parent; concrete subclasses (WeatherSignal, MaterialPriceSignal, LabourSignal) carry the data. Domain-free; signal triples are written to data/external/signals/{type}." .

iprok:PilotStatus a owl:Class ;
    rdfs:label "Pilot Status" ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/PilotStatus> ;
    rdfs:comment "Enum of organisation pilot-lifecycle states." .

<https://w3id.org/IproK/safety#IncidentType> a owl:Class ;
    rdfs:label "Incident type" ;
    dct:isPartOf <https://w3id.org/IproK/safety> ;
    dct:source <https://bimsaarthi.com/ontology/v0/IncidentType> ;
    rdfs:comment "Severity bucket for safety incidents. Four-level scale follows IS 14489 / DGMS site-safety classification." .

schedule:TaskDependency a owl:Class ;
    rdfs:label "TaskDependency" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A relationship record describing precedence between scheduled tasks."@en ;
    rdfs:subClassOf iprok:IproKThing .

<https://w3id.org/IproK/site#SiteLabour> a owl:Class ;
    rdfs:label "Site Labour" ;
    dct:isPartOf <https://w3id.org/IproK/site> ;
    dct:source <https://bimsaarthi.com/ontology/v0/SiteLabour> ;
    rdfs:comment "OSM labour colony + public transport + ICAR state agri calendar. Feeds the labour-availability adjustment in P2B planning." ;
    rdfs:subClassOf <https://w3id.org/IproK/site#SiteIntelligence> .

<https://w3id.org/IproK/billing#BOQItem> a owl:Class ;
    rdfs:label "BOQ item" ;
    dct:isPartOf <https://w3id.org/IproK/billing> ;
    dct:source <https://bimsaarthi.com/ontology/v0/BOQItem> ;
    rdfs:comment "One line in the project's Bill of Quantities. Catalogue node; measurements reference it via <https://w3id.org/IproK/billing#measuredItem>." .

<https://w3id.org/IproK/document#DrawingState> a owl:Class ;
    rdfs:label "Drawing state" ;
    dct:isPartOf <https://w3id.org/IproK/document> ;
    dct:source <https://bimsaarthi.com/ontology/v0/DrawingState> ;
    rdfs:comment "ISO 19650 information-container lifecycle state. Transitions: WIP->Shared->Published->Archived; any->Superseded on a newer published revision. Modelled like <https://w3id.org/IproK/quality#NCRStatus> / <https://w3id.org/IproK/safety#IncidentType>." .

<https://w3id.org/IproK/quality#NCRStatus> a owl:Class ;
    rdfs:label "NCR Status" ;
    dct:isPartOf <https://w3id.org/IproK/quality> ;
    dct:source <https://bimsaarthi.com/ontology/v0/NCRStatus> ;
    rdfs:comment "Enum of possible NCR lifecycle states." .

<https://w3id.org/IproK/tender#ExtractionStatus> a owl:Class ;
    rdfs:label "Extraction Status" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/ExtractionStatus> ;
    rdfs:comment "Lifecycle state of the tender PDF → BOQ extraction pipeline. Values: Pending, Running, Complete, Failed, NeedsReview." .

<https://w3id.org/IproK/building#Element> a owl:Class ;
    rdfs:label "IFC Element" ;
    dct:isPartOf <https://w3id.org/IproK/building> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Element> ;
    rdfs:comment "One parseable IFC entity (wall / column / beam / slab / door / MEP fixture) extracted from an uploaded IFC model and persisted as triples for cross-domain joins. The single most important predicate is <https://w3id.org/IproK/building#ifcGuid>; every Issue / Annotation / future cost+schedule attribution that already carries an ifcGuid lights up automatically." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/document#RFIState> a owl:Class ;
    rdfs:label "RFI state" ;
    dct:isPartOf <https://w3id.org/IproK/document> ;
    dct:source <https://bimsaarthi.com/ontology/v0/RFIState> ;
    rdfs:comment "RFI lifecycle. Transitions (enforced in the API): Draft->Submitted (raiser); Submitted->UnderReview (assignee/PM); UnderReview->Answered (assignee); Answered->Closed (raiser confirms); Answered->UnderReview (raiser rejects); any->Cancelled (PM/Admin). Modelled like <https://w3id.org/IproK/document#DrawingState> / <https://w3id.org/IproK/quality#NCRStatus>." .

integrated:ResourceAllocation a owl:Class ;
    rdfs:label "ResourceAllocation" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "An assignment record connecting scheduled work, an allocated resource and an associated cost item."@en ;
    rdfs:subClassOf iprok:IproKThing .

<https://w3id.org/IproK/quality#Inspection> a owl:Class ;
    rdfs:label "Inspection" ;
    dct:isPartOf <https://w3id.org/IproK/quality> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Inspection> ;
    rdfs:comment "A quality-checklist run against a single <https://w3id.org/IproK/schedule#Activity>." ;
    rdfs:subClassOf prov:Activity .

<https://w3id.org/IproK/safety#Incident> a owl:Class ;
    rdfs:label "Safety incident" ;
    dct:isPartOf <https://w3id.org/IproK/safety> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Incident> ;
    rdfs:comment "A recorded site safety event with its severity, activity context and follow-up information." ;
    rdfs:subClassOf prov:Activity .

<https://w3id.org/IproK/site#SiteClimate> a owl:Class ;
    rdfs:label "Site Climate" ;
    dct:isPartOf <https://w3id.org/IproK/site> ;
    dct:source <https://bimsaarthi.com/ontology/v0/SiteClimate> ;
    rdfs:comment "NASA POWER 10-year climatology: monsoon onset/withdrawal ISO weeks + annual rainfall + heat-wave days/year. Companion to the S6.6+ <https://w3id.org/IproK/signal#HistoricalWeatherProfile> (which holds the 52-week probability profile)." ;
    rdfs:subClassOf <https://w3id.org/IproK/site#SiteIntelligence> .

<https://w3id.org/IproK/site#SiteHydrology> a owl:Class ;
    rdfs:label "Site Hydrology" ;
    dct:isPartOf <https://w3id.org/IproK/site> ;
    dct:source <https://bimsaarthi.com/ontology/v0/SiteHydrology> ;
    rdfs:comment "CGWB groundwater + nearest water source. Drives the groundwater < 3m and CGWB over-exploited block auto-risks." ;
    rdfs:subClassOf <https://w3id.org/IproK/site#SiteIntelligence> .

<https://w3id.org/IproK/site#SiteUtilities> a owl:Class ;
    rdfs:label "Site Utilities" ;
    dct:isPartOf <https://w3id.org/IproK/site> ;
    dct:source <https://bimsaarthi.com/ontology/v0/SiteUtilities> ;
    rdfs:comment "OSM grid substation + overhead HT line detection within 200m. The overhead-HT-line-present case is safety-critical and auto-creates a Score 16 risk." ;
    rdfs:subClassOf <https://w3id.org/IproK/site#SiteIntelligence> .

<https://w3id.org/IproK/tender#Tender> a owl:Class ;
    rdfs:label "Tender" ;
    dct:isPartOf <https://w3id.org/IproK/tender> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Tender> ;
    rdfs:comment "A tender document under consideration by the org. Lives in the org catalogue graph (data/org/{oid}); pre-award. Becomes a <https://w3id.org/IproK/schedule#Project> only on award." ;
    rdfs:subClassOf prov:Entity .

iprok:User a owl:Class ;
    rdfs:label "User" ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/User> ;
    rdfs:comment "An authenticated platform user, such as a site engineer, quality controller or project manager." ;
    rdfs:subClassOf prov:Agent .

<https://w3id.org/IproK/quality#NCR> a owl:Class ;
    rdfs:label "Non-Conformance Report" ;
    dct:isPartOf <https://w3id.org/IproK/quality> ;
    dct:source <https://bimsaarthi.com/ontology/v0/NCR> ;
    rdfs:comment "Raised automatically when a checklist item fails. Status starts Open; closure flow added in V0.19." .

schedule:TaskTime a owl:Class ;
    rdfs:label "TaskTime" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A time record associated with a scheduled task."@en ;
    rdfs:subClassOf iprok:IproKThing .

iprok:Organisation a owl:Class ;
    rdfs:label "Organisation" ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Organisation> ;
    rdfs:comment "An organisation owning project records and defining a tenant boundary." .

cost:CostItem a owl:Class ;
    rdfs:label "CostItem" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A cost record associated with scheduled work or a resource allocation."@en ;
    rdfs:subClassOf iprok:IproKThing .

<https://w3id.org/IproK/document#Document> a owl:Class ;
    rdfs:label "Document" ;
    dct:isPartOf <https://w3id.org/IproK/document> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Document> ;
    rdfs:comment "A controlled project document / drawing artefact (ISO 19650 information container)." .

<https://w3id.org/IproK/site#SiteWorkerSafety> a owl:Class ;
    rdfs:label "Site Worker Safety" ;
    dct:isPartOf <https://w3id.org/IproK/site> ;
    dct:source <https://bimsaarthi.com/ontology/v0/SiteWorkerSafety> ;
    rdfs:comment "NASA POWER heat stress (WBGT > 32°C per IS 3786) + nearest hospital + AQI. Drives the hospital > 15km auto-risk." ;
    rdfs:subClassOf <https://w3id.org/IproK/site#SiteIntelligence> .

<https://w3id.org/IproK/document#Drawing> a owl:Class ;
    rdfs:label "Drawing" ;
    dct:isPartOf <https://w3id.org/IproK/document> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Drawing> ;
    rdfs:comment "A construction drawing (GA / Detail / Section / Elevation / Layout / Schematic). One node per (drawingId, revision); <https://w3id.org/IproK/integrated#supersedes> links a new revision to the one it replaces (S2.1)." ;
    rdfs:subClassOf <https://w3id.org/IproK/document#Document> .

<https://w3id.org/IproK/billing#Measurement> a owl:Class ;
    rdfs:label "Measurement" ;
    dct:isPartOf <https://w3id.org/IproK/billing> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Measurement> ;
    rdfs:comment "One MB entry: dimensions or direct quantity for one BOQ item, captured by a Site Engineer / QC. Joint OTP signature is M3; V0.29 just records the measurement." ;
    rdfs:subClassOf prov:Activity .

<https://w3id.org/IproK/site#SiteIntelligence> a owl:Class ;
    rdfs:label "Site Intelligence Report" ;
    dct:isPartOf <https://w3id.org/IproK/site> ;
    dct:source <https://bimsaarthi.com/ontology/v0/SiteIntelligence> ;
    rdfs:comment "Auto-generated site context report at project GPS setup. Holds six typed sub-domains (Hydrology / Logistics / Worker Safety / Utilities / Labour / Climate). Six threshold-based auto-risks (v2.0 §3.2) seeded at initiation from this report." .

<https://w3id.org/IproK/site#SiteLogistics> a owl:Class ;
    rdfs:label "Site Logistics" ;
    dct:isPartOf <https://w3id.org/IproK/site> ;
    dct:source <https://bimsaarthi.com/ontology/v0/SiteLogistics> ;
    rdfs:comment "OSM-derived road / RMC / steel depot / rail / air. Drives the no-heavy-vehicle-access auto-risk." ;
    rdfs:subClassOf <https://w3id.org/IproK/site#SiteIntelligence> .

resource:Resource a owl:Class ;
    rdfs:label "Resource" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A resource available for allocation to a task or activity."@en ;
    rdfs:subClassOf iprok:IproKThing .

schedule:Task a owl:Class ;
    rdfs:label "Task" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A unit of scheduled work within a project."@en ;
    rdfs:subClassOf iprok:IproKThing .

iprok:IproKThing a owl:Class ;
    rdfs:label "IproKThing" ;
    dct:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The common parent class for the published IproK project-information concepts."@en ;
    rdfs:subClassOf owl:Thing .

xsd:date a rdfs:Datatype .

schedule:Activity a owl:Class ;
    rdfs:label "Activity" ;
    dct:isPartOf <https://w3id.org/IproK/schedule> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Activity> ;
    rdfs:comment "A schedule activity. In v0, manually entered; in v1 ingested from P6." ;
    rdfs:subClassOf schedule:Task .

schedule:Project a owl:Class ;
    rdfs:label "Project" ;
    dct:isPartOf <https://w3id.org/IproK> ;
    dct:source <https://bimsaarthi.com/ontology/v0/Project> ;
    rdfs:comment "The construction-project context in which work, records and control decisions are organised."@en ;
    rdfs:subClassOf iprok:IproKThing .

<https://w3id.org/IproK> a owl:Ontology ;
    dct:contributor "Prof. Gangadhar Mahesh" ;
    dct:created "2026-10-19"^^xsd:date ;
    dct:creator "Venkatesh Kone" ;
    dct:description "Proposed expansion of the published IproK ontology using retained platform schema declarations. Original identifiers are preserved. Schema validation is dated engineering verification, not historical thesis evidence."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source <https://github.com/konevenkatesh/IprokDoc/tree/ee4cf206af08a47db3363fa4404ac51cce1868de> ;
    dct:title "Integrated Project Knowledge (IproK) ontology: expanded project-control schema"@en ;
    vann:preferredNamespacePrefix "iprok" ;
    vann:preferredNamespaceUri "https://w3id.org/IproK#" ;
    owl:imports <http://www.opengis.net/ont/geosparql>,
        <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/prov> ;
    owl:versionIRI <https://w3id.org/IproK/0.2.0> ;
    owl:versionInfo "0.2.0-draft" .

[] a owl:AllDisjointClasses ;
    owl:members ( cost:EquipmentCost cost:ExpenseItem cost:LaborCost cost:MaterialCost ) .

[] a owl:AllDisjointClasses ;
    owl:members ( resource:EquipmentResource resource:LaborResource resource:MaterialResource resource:UserDefinedResource ) .

