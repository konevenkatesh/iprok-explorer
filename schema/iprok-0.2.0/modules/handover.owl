    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#warrantyAsset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Asset/system covered — lifts, DG set, waterproofing, STP…</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/warrantyAsset"/>
    <rdfs:label xml:lang="en">warranty Asset</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#committedHandoverDate">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/committedHandoverDate"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:label xml:lang="en">committed Handover Date</rdfs:label>
    <rdfs:comment xml:lang="en">The committed handover date property in the integrated project information model.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#snagStatus">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/snagStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">snag Status</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:comment>Open | Fixed | Verified | Deferred.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#warrantyStartDate">
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:comment xml:lang="en">The warranty start date property in the integrated project information model.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/warrantyStartDate"/>
    <rdfs:label xml:lang="en">warranty Start Date</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#transferredTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Receiving party — owner, RWA, or facility team.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/transferredTo"/>
    <rdfs:label xml:lang="en">transferred To</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#defectStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Reported | InRepair | Rectified | Disputed.</rdfs:comment>
    <rdfs:label xml:lang="en">defect Status</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/defectStatus"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#rectifiedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment xml:lang="en">The rectified at property in the integrated project information model.</rdfs:comment>
    <rdfs:label xml:lang="en">rectified At</rdfs:label>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/rectifiedAt"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#dlpMonths">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>DLP (months)</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/dlpMonths"/>
    <rdfs:comment>Defect-liability window in months. RERA default 60 (5 years from possession).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#WarrantyRecord">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:comment>One asset/system warranty (vendor, start, duration) handed to operations.</rdfs:comment>
    <rdfs:label xml:lang="en">Warranty Record</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/WarrantyRecord"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#snagId">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/snagId"/>
    <rdfs:label xml:lang="en">snag Id</rdfs:label>
    <rdfs:comment xml:lang="en">The snag id property in the integrated project information model.</rdfs:comment>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#HandoverPackage">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:label xml:lang="en">Handover Package</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/HandoverPackage"/>
    <rdfs:comment>The project's digital handover record: readiness, transfer, and the defect-liability window.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#warrantyId">
