>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#SnagItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>One punch-list item found during handover inspection. Open Critical snags block transfer.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">Snag Item</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/SnagItem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#warrantyMonths">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/warrantyMonths"/>
    <rdfs:comment xml:lang="en">The warranty months property in the integrated project information model.</rdfs:comment>
    <rdfs:label xml:lang="en">warranty Months</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#snagDescription">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:label xml:lang="en">snag Description</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/snagDescription"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The snag description property in the integrated project information model.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#snagSeverity">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Minor | Major | Critical.</rdfs:comment>
    <rdfs:label xml:lang="en">snag Severity</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/snagSeverity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#DLPDefect">
    <rdfs:label xml:lang="en">DLPDefect</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:comment>A post-handover defect inside the liability period; RERA S.14(3): rectify within 30 days.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/DLPDefect"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#transferredAt">
    <rdfs:label xml:lang="en">transferred At</rdfs:label>
    <rdfs:comment xml:lang="en">The transferred at property in the integrated project information model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/transferredAt"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#warrantyVendor">
    <rdfs:comment xml:lang="en">The warranty vendor property in the integrated project information model.</rdfs:comment>
    <rdfs:label xml:lang="en">warranty Vendor</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/warrantyVendor"/>
