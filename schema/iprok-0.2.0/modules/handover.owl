    <rdfs:label xml:lang="en">warranty Id</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/warrantyId"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#defectId">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">defect Id</rdfs:label>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:comment xml:lang="en">The defect id property in the integrated project information model.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/defectId"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/handover#handoverStatus">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/handover"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">handover Status</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/handoverStatus"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
