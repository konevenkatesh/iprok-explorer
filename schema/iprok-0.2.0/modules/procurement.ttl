    rdfs:comment "The vendor id property in the integrated project information model."@en ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/procurement#vendorName> a owl:DatatypeProperty ;
    rdfs:label "vendor Name"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/iprok/procurement> ;
