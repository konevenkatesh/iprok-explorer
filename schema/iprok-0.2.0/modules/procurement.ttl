    rdfs:comment "The unit rate property in the integrated project information model."@en ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/procurement#vendor> a owl:DatatypeProperty ;
    rdfs:label "vendor name / SAP vendor code (LIFNR)" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/iprok/procurement> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/vendor> ;
    rdfs:comment "The vendor property in the integrated project information model."@en ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/procurement#vendorCategory> a owl:DatatypeProperty ;
    rdfs:label "vendor Category"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/procurement> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/vendorCategory> ;
    rdfs:comment "Material | Equipment | Labour | Services | Fixtures | Other." ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/procurement#vendorId> a owl:DatatypeProperty ;
    rdfs:label "vendor Id"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/iprok/procurement> ;
