  {
    "@id": "https://w3id.org/iprok/tender#BidRecommendation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "https://w3id.org/iprok/tender"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://bimsaarthi.com/ontology/v0/BidRecommendation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The final bid-output document for a tender: total quoted, contingency, recommended bid, item-count + high-risk-count breakdown. The line-item detail is NOT stored on this node; it is re-derivable from the underlying S5.2 + S5.3 graph state, and persisting it would create stale-data risk on a SOR-rate or comparable-project update. The PDF lives in MinIO via <https://w3id.org/iprok/document#fileRef>."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Bid Recommendation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/iprok/tender#actualCPI",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "https://w3id.org/iprok/tender"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://bimsaarthi.com/ontology/v0/actualCPI"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The historical project's most recent CPI (cost-performance index) from <https://w3id.org/iprok/schedule#EVMSnapshot> (S4.2). > 1.0 = under budget; < 1.0 = over budget. Null when the project has no EVM history. Domain-free."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "actual CPI"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/iprok/tender#matchConfidence",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "https://w3id.org/iprok/tender"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://bimsaarthi.com/ontology/v0/matchConfidence"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "S3.2-style confidence: exact-code = 1.0; fuzzy-desc = 0.5 + 0.4×ratio; jargon-normalised = same but after Indian-PWD jargon stripped; no-match = 0.0. SHACL bounds enforce [0, 1]."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "match confidence (0–1)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/iprok/tender#sorYear",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
