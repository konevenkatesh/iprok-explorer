    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Number of <https://w3id.org/iprok/coordination#Risk> nodes (S4.5) on the historical project whose <https://w3id.org/iprok/integrated#linkedIssue> is set — risks that became real issues. Useful as a proxy for how well risk management worked. Domain-free."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "risks that materialised"
      }
    ],
