      {
        "@id": "https://bimsaarthi.com/ontology/v0/matchStrategy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "How the match landed. Values: 'exact-code' | 'fuzzy-desc' | 'jargon-normalised' | 'no-match'. SHACL sh:in (string literals, antipattern #13)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "match strategy"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/iprok/tender#totalQuoted",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "https://w3id.org/iprok/tender"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://bimsaarthi.com/ontology/v0/totalQuoted"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Sum of (recommended_rate × estimated_qty) across every matched <https://w3id.org/iprok/tender#TenderBOQItem>. The base bid before contingency. Domain-free (antipattern #8)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "total quoted (INR)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
