<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/iprok/property#Tower">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label>Tower / wing</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/property"/>
    <rdfs:comment>A tower, wing or block of the project.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/Tower"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/property#unitTypeId">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/property"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/unitTypeId"/>
    <rdfs:label xml:lang="en">unit Type Id</rdfs:label>
    <rdfs:comment>Stable id within the project (UT1 …). Domain unspecified (antipattern #8).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/property#floorNo">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/floorNo"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">The floor no property in the integrated project information model.</rdfs:comment>
    <rdfs:label xml:lang="en">floor No</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/property#unitTypeName">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/unitTypeName"/>
    <rdfs:comment xml:lang="en">The unit type name property in the integrated project information model.</rdfs:comment>
    <rdfs:label xml:lang="en">unit Type Name</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/property#UnitType">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/UnitType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A sellable unit archetype (2BHK / 3BHK …) with its area set and base rate.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/property"/>
    <rdfs:label>Unit type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/property#ofUnitType">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/ofUnitType"/>
    <rdfs:comment>Unit → its archetype. Domain unspecified (antipattern #8).</rdfs:comment>
    <rdfs:label xml:lang="en">of Unit Type</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/property"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/property#UnitType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/property#carpetAreaSqft">
    <rdfs:label xml:lang="en">carpet Area Sqft</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>RERA carpet area, sqft. Domain unspecified (antipattern #8).</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/property"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/carpetAreaSqft"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/property#Unit">
    <rdfs:label>Unit</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/property"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:comment>One sellable unit. Status transitions are PROV-O supersessions.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/Unit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/property#unitId">
    <rdfs:label xml:lang="en">unit Id</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/unitId"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/property"/>
    <rdfs:comment>Stable id within the project, e.g. T1-0503 (tower-floor-unit). Domain unspecified (antipattern #8).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/property#unitStatus">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/unitStatus"/>
    <rdfs:label xml:lang="en">unit Status</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Available / Blocked / Booked / Agreement / Registered / Possession. Domain unspecified (antipattern #8).</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/property#towerId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/towerId"/>
    <rdfs:comment>Stable id within the project (T1, T2 …). Domain unspecified (antipattern #8).</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/property"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">tower Id</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/property#ofTower">
    <rdfs:comment>Unit → its tower. Domain unspecified (antipattern #8).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/property"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/ofTower"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/property#Tower"/>
    <rdfs:label xml:lang="en">of Tower</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/property#unitNo">
    <rdfs:label xml:lang="en">unit No</rdfs:label>
    <rdfs:comment>Door number on the floor (1, 2, 3 …).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/property"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/unitNo"/>
  </rdf:Description>
</rdf:RDF>
