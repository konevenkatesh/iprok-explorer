    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "The completion date the contract stipulates while this baseline is in force: the approved programme's last day plus every extension of time granted (CPWD Clause 5.2/5.3). Clause 5.4's 10% is of the period to this date. An agreed amendment does not move it. No rdfs:domain."
      }
    ],
