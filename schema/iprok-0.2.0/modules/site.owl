  <rdf:Description rdf:about="https://w3id.org/iprok/site#SiteIntelligence">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Site Intelligence Report</rdfs:label>
    <rdfs:comment>Auto-generated site context report at project GPS setup. Holds six typed sub-domains (Hydrology / Logistics / Worker Safety / Utilities / Labour / Climate). Six threshold-based auto-risks (v2.0 §3.2) seeded at initiation from this report.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/SiteIntelligence"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#SiteLogistics">
    <rdfs:label>Site Logistics</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/SiteLogistics"/>
    <rdfs:comment>OSM-derived road / RMC / steel depot / rail / air. Drives the no-heavy-vehicle-access auto-risk.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/site#SiteIntelligence"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#roadAccessClass">
