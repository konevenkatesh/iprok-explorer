    <rdfs:label>road access class</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>NH | SH | MDR | ODR | VR (per OSM highway tag).</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteLogistics"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/roadAccessClass"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#annualRainfallMM">
