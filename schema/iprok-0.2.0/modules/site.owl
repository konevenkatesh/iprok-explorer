  <rdf:Description rdf:about="https://w3id.org/iprok/site#dataVersion">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <rdfs:comment>Semantic version of the site-intel fetcher schema. Bump on any breaking change to a sub-domain's property set so old reports can be re-fetched.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteIntelligence"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/dataVersion"/>
