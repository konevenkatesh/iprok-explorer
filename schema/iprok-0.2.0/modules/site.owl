  <rdf:Description rdf:about="https://w3id.org/iprok/site#hospitalType">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/hospitalType"/>
    <rdfs:comment>Trauma Centre | Multi-speciality | Government | Primary Health Centre | Other.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteWorkerSafety"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>hospital type</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#SiteHydrology">
    <rdfs:comment>CGWB groundwater + nearest water source. Drives the groundwater &lt; 3m and CGWB over-exploited block auto-risks.</rdfs:comment>
    <rdfs:label>Site Hydrology</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/site#SiteIntelligence"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/SiteHydrology"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/site#dewateringRequired">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/dewateringRequired"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>dewatering required</rdfs:label>
    <rdfs:comment>True when groundwaterDepthPreMonsoonM &lt; 3.0 — i.e. excavation will hit water table.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/site#SiteHydrology"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/site"/>
  </rdf:Description>
