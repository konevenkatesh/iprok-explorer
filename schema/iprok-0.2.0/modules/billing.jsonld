      {
        "@id": "https://w3id.org/iprok/billing"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://bimsaarthi.com/ontology/v0/departmentalSignatory"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Points at the <https://w3id.org/iprok#User> (JE/AE) who counter-signs on behalf of the department. Mandatory. Domain unspecified."
      }
