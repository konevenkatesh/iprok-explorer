      {
        "@id": "https://bimsaarthi.com/ontology/v0/isStarRate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "True when this BOQ item has no SOR match (star-rate / DSR-deviation item). Mandatory. Domain unspecified."
