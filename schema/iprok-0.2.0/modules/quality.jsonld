  {
    "@id": "https://w3id.org/iprok/quality#failureNote",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "https://w3id.org/iprok/quality"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://bimsaarthi.com/ontology/v0/failureNote"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Free-text explanation of a quality failure. Used on both <https://w3id.org/iprok/quality#ChecklistItem> (where SHACL requires it iff itemResult='fail') and <https://w3id.org/iprok/quality#NCR> (where it's copied from the failed item). Domain intentionally left unspecified — adding `rdfs:domain <https://w3id.org/iprok/quality#ChecklistItem>` would make every NCR get RDFS-inferred as a ChecklistItem and trip ChecklistItemShape."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "failure note"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
