      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Polymorphic lifecycle status. Domain intentionally left unspecified — adding `rdfs:domain <https://w3id.org/iprok/quality#NCR>` would mark every node carrying <https://w3id.org/iprok/quality#status> as an NCR (the same RDFS-domain trap that bit V0.17's <https://w3id.org/iprok/quality#failureNote>, see CLAUDE.md antipattern #8). v0 uses <https://w3id.org/iprok/quality#status> only on <https://w3id.org/iprok/quality#NCR>; SHACL constrains it via NCRShape."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "status"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/iprok/quality#NCRStatus"
      }
    ]
  },
