        "@id": "https://bimsaarthi.com/ontology/v0/inspectionCategory"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Either 'quality' (IS-456 concrete pour, IS-1786 reinforcement, etc.) or 'safety' (IS 7969 site / MoRTH highway / confined-space). Mandatory on every <https://w3id.org/iprok/quality#Inspection> from V0.27 onwards. Pre-V0.27 inspections default to 'quality' on read."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "inspection category"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
