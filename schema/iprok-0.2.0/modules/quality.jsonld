    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "https://w3id.org/iprok/quality"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://bimsaarthi.com/ontology/v0/overallResult"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Either 'pass' (every item passed) or 'fail' (at least one item failed)."
      }
    ],
