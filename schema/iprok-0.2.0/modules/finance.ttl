    rdfs:comment "The milestone name property in the integrated project information model."@en ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/finance#milestoneOrder> a owl:DatatypeProperty ;
    rdfs:label "milestone Order"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/finance> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/milestoneOrder> ;
    rdfs:comment "The milestone order property in the integrated project information model."@en ;
    rdfs:range xsd:integer .

<https://w3id.org/IproK/finance#milestonePct> a owl:DatatypeProperty ;
    rdfs:label "milestone Pct"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/finance> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/milestonePct> ;
    rdfs:comment "Instalment share of the unit price (0–100]." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/finance#milestoneStatus> a owl:DatatypeProperty ;
    rdfs:label "milestone Status"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/finance> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/milestoneStatus> ;
    rdfs:comment "Pending | Achieved." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/finance#operatingShare> a owl:DatatypeProperty ;
    rdfs:label "operating Share"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/finance> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/operatingShare> ;
    rdfs:comment "Server-computed: receiptAmount − escrowShare (no penny drift)." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/finance#receiptAmount> a owl:DatatypeProperty ;
    rdfs:label "receipt Amount"@en ;
