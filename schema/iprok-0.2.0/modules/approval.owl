<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/iprok/approval#approvalStatus">
    <rdfs:comment>NotStarted / Preparing / Submitted / QueryRound / Approved / Rejected. Domain unspecified (antipattern #8).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/approval"/>
    <rdfs:label>approval status</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/approvalStatus"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/approval#applicationRef">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/approval"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/applicationRef"/>
    <rdfs:label>application reference</rdfs:label>
    <rdfs:comment>The authority's application / file number once submitted. Domain unspecified (antipattern #8).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/approval#Approval">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/approval"/>
    <rdfs:label>Statutory approval</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/Approval"/>
    <rdfs:comment>A statutory approval, NOC, registration or certificate the project must obtain. Status transitions are PROV-O supersessions; the record is append-only.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/approval#slaDays">
    <rdfs:comment>Statutory or practical service-level clock in days from submission (TG-bPASS style deemed approvals). 0 = no clock. Domain unspecified (antipattern #8).</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/slaDays"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/approval"/>
    <rdfs:label>SLA / deemed-approval days</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/approval#approvalId">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/approval"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/approvalId"/>
    <rdfs:label>approval id</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Stable id within the project, e.g. APR-0003. Domain unspecified (antipattern #8).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/approval#approvalType">
    <rdfs:label>approval type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/approvalType"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/approval"/>
    <rdfs:comment>One of the ApprovalShape sh:in set (PlanSanction / CommencementCertificate / NALAConversion / FireNOC / …). Domain unspecified (antipattern #8).</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
