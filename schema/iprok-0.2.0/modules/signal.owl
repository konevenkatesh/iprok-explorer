<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#heatProbability">
    <rdfs:comment>Empirical probability [0, 1] that this calendar week sees at least one day with max temp &gt; 40°C, computed across the 10 years of the climatology window. Indian-summer concrete-pour productivity drops sharply above 40°C.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>extreme heat probability</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/heatProbability"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#pricePerUnit">
    <rdfs:comment>Current market price in INR per the material's UOM (Steel: per MT; Cement: per bag; Bitumen: per MT).</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/pricePerUnit"/>
    <rdfs:label>market price per unit (INR)</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#profileLat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:comment>Site latitude (degrees, WGS84) the profile was fetched for. Stored on the profile so a later GPS edit can compare + decide whether to refetch.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/profileLat"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>profile latitude</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#HistoricalWeatherProfile">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/HistoricalWeatherProfile"/>
    <rdfs:comment>10-year climatology snapshot at a project's GPS; 52 weekly buckets, each with avg rainfall + rain probability + extreme-heat probability. Source: NASA POWER (power.larc.nasa.gov), free climatology API, no auth required. Fetched once at project geocoding; treated as static climate context (re-fetch only if site GPS changes).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/signal#ExternalSignal"/>
    <rdfs:label>historical weather profile</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#maxTempC">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>max temperature (°C)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Daily maximum temperature in degrees Celsius. &gt;42°C correlates with reduced productivity in north India.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/maxTempC"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#LabourSignal">
    <rdfs:label>labour signal</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:comment>Per-week per-state labour availability score (0-1, where 0 = peak festival/harvest absence). Reason field carries the cause: Diwali / Pongal / Kharif harvest / Normal. Source: calendarific.com API + ICAR crop calendar.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/LabourSignal"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/signal#ExternalSignal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#stateCode">
    <rdfs:label>Indian state ISO code</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/stateCode"/>
    <rdfs:comment>Two-letter state code (KA / TN / MH / TG / AP / UP). Labour signals are state-specific because the festival calendar differs by region.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#avgRainfallMM">
    <rdfs:label>average rainfall (mm)</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>10-year mean of weekly rainfall (mm) for this calendar week at this site. Drives the historical_rain_mm_avg_this_week GNN feature.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/avgRainfallMM"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#profileLng">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/profileLng"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:label>profile longitude</rdfs:label>
    <rdfs:comment>Site longitude (degrees, WGS84) the profile was fetched for.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#fetchedAt">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/fetchedAt"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:label>profile fetched at</rdfs:label>
    <rdfs:comment>When the NASA POWER fetch ran. The Celery worker re-fetches only when this is &gt; 1 year old.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#WeatherSignal">
    <rdfs:label>weather signal</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/signal#ExternalSignal"/>
    <rdfs:comment>Daily weather snapshot at a project's GPS; rainfall, max temp, working-day-loss-risk. Source: IMD via indianapi.in (free tier) with OpenWeatherMap fallback.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/WeatherSignal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#workingDayLossRisk">
    <rdfs:label>working day loss risk</rdfs:label>
    <rdfs:comment>Probability [0, 1] that this calendar day will be lost to weather (rain &gt; 25mm, extreme heat, cyclone). Computed from the underlying numbers — the GNN consumes this scalar directly.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/workingDayLossRisk"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#isMonsoonPeriod">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/isMonsoonPeriod"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>monsoon period flag</rdfs:label>
    <rdfs:comment>True when the signal date falls inside the regional monsoon window (SW: Jun–Sep all India; NE: Oct–Dec for Tamil Nadu/Andhra).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#priceDate">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/priceDate"/>
    <rdfs:label>price observation date</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:comment>Date of the price snapshot — typically the Saturday of the week the price was sampled.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#reason">
    <rdfs:label>labour availability reason</rdfs:label>
    <rdfs:comment>Free-text reason: 'Diwali' | 'Pongal' | 'Kharif harvest' | 'Rabi harvest' | 'Holi' | 'Normal'. Surfaced on the UI alongside the score.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/reason"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#MaterialPriceSignal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok/signal#ExternalSignal"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:comment>Weekly market price for a material (Steel-TMT, Cement, Bitumen, etc.) with 30-day rolling volatility and percent-deviation vs the BOQ quoted rate. Sources: SAIL website scrape (steel), RBI WPI index (cement).</rdfs:comment>
    <rdfs:label>material price signal</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/MaterialPriceSignal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#volatility30d">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>30-day rolling volatility</rdfs:label>
    <rdfs:comment>Coefficient of variation (stddev / mean) of the price over the trailing 30 days. &gt;0.05 flags 'volatile' for the auto-risk engine.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/volatility30d"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#rainProbability">
    <rdfs:comment>Empirical probability [0, 1] that this calendar week sees &gt; 25mm total rainfall, computed across the 10 years of the climatology window. Activities planned in high-rain-prob weeks should learn a delay bias.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>rain probability</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/rainProbability"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#availabilityScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Score in [0, 1]. 0 = peak festival absence (Diwali week, Pongal week, Kharif harvest); 1 = normal availability. &lt;0.5 triggers the festival_labour_shortage auto-risk.</rdfs:comment>
    <rdfs:label>labour availability score</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/availabilityScore"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#signalDate">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/signalDate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:comment>Calendar date the signal value pertains to (weather: that day; material price: that week's settlement; labour: week start). Domain-free.</rdfs:comment>
    <rdfs:label>signal date</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#sourceYears">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>source years</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:comment>Length of the climatology window in years (NASA POWER default: 10).</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/sourceYears"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#HistoricalWeatherWeek">
    <rdfs:label>historical weather week</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/HistoricalWeatherWeek"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:comment>One ISO week-of-year bucket (1..53) of the climatology profile. 52 instances per HistoricalWeatherProfile; the GNN reads three scalars from the week-bucket whose ISO week matches an activity's planned-start.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#vsQuotedRate">
    <rdfs:label>deviation vs BOQ quoted rate</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/vsQuotedRate"/>
    <rdfs:comment>Fractional deviation: (current_price - boq_quoted_rate) / boq_quoted_rate. Positive = market is above quoted; +0.15 (15%) is the steel-escalation trigger.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#ExternalSignal">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/ExternalSignal"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdfs:comment>Abstract parent; concrete subclasses (WeatherSignal, MaterialPriceSignal, LabourSignal) carry the data. Domain-free; signal triples are written to data/external/signals/{type}.</rdfs:comment>
    <rdfs:label>external signal</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#weekOfYear">
    <rdfs:comment>ISO week number 1..53. Activities query historical features by computing ISO week from their planned_start date.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>week of year</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/weekOfYear"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#signalWeek">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYearMonth"/>
    <rdfs:comment>ISO week the labour signal pertains to (gYearMonth gives month granularity; combined with a state code identifies the week).</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/signalWeek"/>
    <rdfs:label>signal week</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/signal#rainfallMM">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/signal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Daily rainfall in millimetres at the project's GPS coordinates. Used by the auto-risk engine to gate monsoon triggers.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/rainfallMM"/>
    <rdfs:label>rainfall (mm)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
</rdf:RDF>
