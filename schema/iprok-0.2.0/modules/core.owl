    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:comment xml:lang="en">The of user property in the integrated project information model. Its declared domain is ProjectMembership and its declared range is User.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#Organisation">
