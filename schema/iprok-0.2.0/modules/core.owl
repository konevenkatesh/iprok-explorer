    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#hasDescription">
    <rdfs:label xml:lang="en">hasDescription</rdfs:label>
