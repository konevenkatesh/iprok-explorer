    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#decisionText">
    <rdfs:label xml:lang="en">decision Text</rdfs:label>
    <rdfs:comment>What was decided. No rdfs:domain.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/decisionText"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#constraintFlow">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:label xml:lang="en">constraint Flow</rdfs:label>
