    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/adoptedMastersVersion"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:label xml:lang="en">adopted Masters Version</rdfs:label>
    <rdfs:comment xml:lang="en">The adopted masters version property in the integrated project information model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#hasName">
    <rdfs:domain rdf:resource="https://w3id.org/iprok#IproKThing"/>
    <rdfs:comment>The common name of the entity.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">hasName</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#orgSlug">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok#Organisation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>URL-safe short identifier; unique across the platform.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:label>organisation slug</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/orgSlug"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#IdSequence">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/IdSequence"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:comment>The last number issued for one kind of register id in one project.</rdfs:comment>
    <rdfs:label xml:lang="en">Id Sequence</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#decisionStatus">
    <rdfs:label xml:lang="en">decision Status</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/decisionStatus"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:comment>Open | Decided | Superseded | Withdrawn. No rdfs:domain.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#hasId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>A local or project-specific identifier.</rdfs:comment>
    <rdfs:label xml:lang="en">hasId</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/iprok#IproKThing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#approvalLevel2Label">
    <rdfs:label xml:lang="en">approval Level2Label</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/approvalLevel2Label"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:comment xml:lang="en">The approval level2label property in the integrated project information model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#approvalLevel1Label">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/approvalLevel1Label"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:label xml:lang="en">approval Level1Label</rdfs:label>
    <rdfs:comment xml:lang="en">The approval level1label property in the integrated project information model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#PilotStatus">
    <rdfs:comment>Enum of organisation pilot-lifecycle states.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/PilotStatus"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:label>Pilot Status</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#decisionBasis">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/decisionBasis"/>
    <rdfs:comment>Why — the rule or evidence the decision rests on. No rdfs:domain.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">decision Basis</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#affectsActivity">
    <rdfs:comment>An activity the decision changes. Repeatable. No rdfs:domain / rdfs:range.</rdfs:comment>
    <rdfs:label xml:lang="en">affects Activity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/affectsActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#hasGlobalId">
    <rdfs:domain rdf:resource="https://w3id.org/iprok#IproKThing"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>A globally unique identifier.</rdfs:comment>
    <rdfs:label xml:lang="en">hasGlobalId</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#orgPlan">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/orgPlan"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok#Organisation"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:label>organisation plan</rdfs:label>
    <rdfs:comment>Subscription tier. One of pilot / project / enterprise / sovereign.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#signedDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>signed document</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/signedDocument"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:comment>IRI of the &lt;https://w3id.org/iprok/document#Drawing&gt;, &lt;https://w3id.org/iprok/document#RFI&gt;, &lt;https://w3id.org/iprok/document#Transmittal&gt;, or &lt;https://w3id.org/iprok/billing#Measurement&gt; that was signed. Mandatory.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#signaturePurpose">
    <rdfs:label>signature purpose</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/signaturePurpose"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:comment>Why the document was signed. One of: DrawingApproval, RFIConfirmation, TransmittalApproval, JointMeasurement. sh:in in SignatureEventShape.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#signedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>signed by</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:comment>IRI of the &lt;https://w3id.org/iprok#User&gt; who performed the signing action. Polymorphic — also used on &lt;https://w3id.org/iprok/billing#JointMeasurement&gt; (M3).</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/signedBy"/>
  </rdf:Description>
</rdf:RDF>
