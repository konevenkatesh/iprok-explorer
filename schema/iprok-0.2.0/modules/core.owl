    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok"/>
    <rdfs:comment>Human-facing id, DEC-NNNN. No rdfs:domain.</rdfs:comment>
    <rdfs:label xml:lang="en">decision Id</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#ofUser">
    <rdfs:label>of user</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/iprok#User"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/ofUser"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
