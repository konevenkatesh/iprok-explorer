    <rdfs:comment xml:lang="en">The gstin property in the integrated project information model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok#decisionId">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/decisionId"/>
