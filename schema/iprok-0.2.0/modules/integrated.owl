    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/zone"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:comment>Inferred zone name. Written at DPR-submit time from project's &lt;https://w3id.org/iprok#zoneConfig&gt; + GPS. Domain intentionally unspecified — V0.26 reuses the same property on &lt;https://w3id.org/iprok/safety#Incident&gt;, and an `rdfs:domain &lt;https://w3id.org/iprok/reporting#DPREntry&gt;` declaration would make every incident-with-zone get RDFS-classified as a DPREntry (same trap as V0.17's &lt;https://w3id.org/iprok/quality#failureNote&gt;, see CLAUDE.md antipattern #8).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
