  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#countedAsElement">
    <rdfs:comment>On a &lt;https://w3id.org/iprok/building#Element&gt; whose work another model also carries: the IFC GlobalId of an element of the model the take-off counted it from — the same work, occupying the same space. Repeatable (a placeholder slab is counted as the planks under it). A literal GlobalId, because that is how BOQ lines and activities scope their elements (&lt;https://w3id.org/iprok/integrated#hasIFCScope&gt;). Polymorphic — no rdfs:domain (antipattern #8).</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
