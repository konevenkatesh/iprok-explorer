  <rdf:Description rdf:about="https://w3id.org/iprok/integrated#duplicateOf">
    <rdfs:comment>On a retired &lt;https://w3id.org/iprok/building#Element&gt;: the node that carries the same element (same GlobalId, same model revision) now. The retired node keeps only its identity and generation triples. No rdfs:domain.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/integrated"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/duplicateOf"/>
