<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#demandStatus">
    <rdfs:comment>Raised | Cancelled. Settled/overdue are computed from receipts, never asserted.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/demandStatus"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:label xml:lang="en">demand Status</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#demandAmount">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/demandAmount"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment xml:lang="en">The demand amount property in the integrated project information model.</rdfs:comment>
    <rdfs:label xml:lang="en">demand Amount</rdfs:label>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#escrowShare">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:comment>Server-computed: receiptAmount × escrowSplitPct/100, 2dp.</rdfs:comment>
    <rdfs:label xml:lang="en">escrow Share</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/escrowShare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#EscrowWithdrawal">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:comment>One utilization of escrow funds against a cost head, certificate-backed per RERA S.4(2)(l)(D).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Escrow Withdrawal</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/EscrowWithdrawal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#DemandNote">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:label xml:lang="en">Demand Note</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:comment>One payment demand to one unit's allottee against an achieved milestone.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/DemandNote"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#dueDate2">
    <rdfs:label xml:lang="en">due Date2</rdfs:label>
    <rdfs:comment>Payment due date. Named dueDate2 because &lt;https://w3id.org/iprok#dueDate&gt; exists with task semantics elsewhere; both stay domain-free.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/dueDate2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#withdrawalDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:comment xml:lang="en">The withdrawal date property in the integrated project information model.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/withdrawalDate"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:label xml:lang="en">withdrawal Date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#escrowBank">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/escrowBank"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The escrow bank property in the integrated project information model.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:label xml:lang="en">escrow Bank</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#escrowAccountRef">
    <rdfs:comment>Masked account reference — never the full account number.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:label xml:lang="en">escrow Account Ref</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/escrowAccountRef"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#milestoneStatus">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/milestoneStatus"/>
    <rdfs:comment>Pending | Achieved.</rdfs:comment>
    <rdfs:label xml:lang="en">milestone Status</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#milestoneName">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/milestoneName"/>
    <rdfs:label xml:lang="en">milestone Name</rdfs:label>
    <rdfs:comment xml:lang="en">The milestone name property in the integrated project information model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#milestoneId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The milestone id property in the integrated project information model.</rdfs:comment>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">milestone Id</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/milestoneId"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#demandDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:comment xml:lang="en">The demand date property in the integrated project information model.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:label xml:lang="en">demand Date</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/demandDate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#PaymentMilestone">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:label xml:lang="en">Payment Milestone</rdfs:label>
    <rdfs:comment>One instalment trigger in the project's payment schedule; e.g. 'Plinth completion; 15%'.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/PaymentMilestone"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#receiptMode">
    <rdfs:comment xml:lang="en">The receipt mode property in the integrated project information model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">receipt Mode</rdfs:label>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/receiptMode"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#escrowSplitPct">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/escrowSplitPct"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Statutory share of every collection routed to escrow. RERA default 70.</rdfs:comment>
    <rdfs:label xml:lang="en">escrow Split Pct</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#forMilestone">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/forMilestone"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:comment>The achieved &lt;https://w3id.org/iprok/finance#PaymentMilestone&gt; this demand cites. Range undeclared (antipattern #8).</rdfs:comment>
    <rdfs:label xml:lang="en">for Milestone</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#withdrawalAmount">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/withdrawalAmount"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:label xml:lang="en">withdrawal Amount</rdfs:label>
    <rdfs:comment xml:lang="en">The withdrawal amount property in the integrated project information model.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#operatingShare">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/operatingShare"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">operating Share</rdfs:label>
    <rdfs:comment>Server-computed: receiptAmount − escrowShare (no penny drift).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#achievedAt">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/achievedAt"/>
    <rdfs:comment xml:lang="en">The achieved at property in the integrated project information model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:label xml:lang="en">achieved At</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#CollectionReceipt">
    <rdfs:label xml:lang="en">Collection Receipt</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/CollectionReceipt"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:comment>One buyer payment against a unit, split escrow/operating at receipt time.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#forUnit">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:label xml:lang="en">for Unit</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/forUnit"/>
    <rdfs:comment>The &lt;https://w3id.org/iprok/property#Unit&gt; this receipt pays against. Range left undeclared so RDFS inference never re-classifies referenced IRIs (antipattern #8).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#receiptAmount">
    <rdfs:comment xml:lang="en">The receipt amount property in the integrated project information model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/receiptAmount"/>
    <rdfs:label xml:lang="en">receipt Amount</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#EscrowAccount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Escrow Account</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/EscrowAccount"/>
    <rdfs:comment>The project's RERA collection account discipline: a designated escrow account receiving the statutory share (default 70%) of every buyer collection.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#certificateRef">
    <rdfs:comment>Reference to the engineer + architect + CA certificate that authorises this withdrawal (RERA S.4(2)(l)(D)). Mandatory.</rdfs:comment>
    <rdfs:label xml:lang="en">certificate Ref</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/certificateRef"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#escrowSetupAt">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/escrowSetupAt"/>
    <rdfs:comment xml:lang="en">The escrow setup at property in the integrated project information model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:label xml:lang="en">escrow Setup At</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#milestonePct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">milestone Pct</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/milestonePct"/>
    <rdfs:comment>Instalment share of the unit price (0–100].</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#demandId">
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/demandId"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The demand id property in the integrated project information model.</rdfs:comment>
    <rdfs:label xml:lang="en">demand Id</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#receiptId">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/receiptId"/>
    <rdfs:label xml:lang="en">receipt Id</rdfs:label>
    <rdfs:comment xml:lang="en">The receipt id property in the integrated project information model.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#withdrawalId">
    <rdfs:comment xml:lang="en">The withdrawal id property in the integrated project information model.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
