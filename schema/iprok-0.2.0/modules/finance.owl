  <rdf:Description rdf:about="https://w3id.org/iprok/finance#milestoneOrder">
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">milestone Order</rdfs:label>
    <rdfs:comment xml:lang="en">The milestone order property in the integrated project information model.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/finance"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/milestoneOrder"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/finance#costHead">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>RERA utilization head: Land | Construction | Statutory | Consultants | Finance | Other.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
