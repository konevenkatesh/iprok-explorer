  {
    "@id": "https://w3id.org/iprok/integrated#countedAsElement",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "https://w3id.org/iprok/integrated"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://bimsaarthi.com/ontology/v0/countedAsElement"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "On a <https://w3id.org/iprok/building#Element> whose work another model also carries: the IFC GlobalId of an element of the model the take-off counted it from — the same work, occupying the same space. Repeatable (a placeholder slab is counted as the planks under it). A literal GlobalId, because that is how BOQ lines and activities scope their elements (<https://w3id.org/iprok/integrated#hasIFCScope>). Polymorphic — no rdfs:domain (antipattern #8)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "counted as element"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
