<https://w3id.org/iprok/site#dataVersion> a owl:DatatypeProperty ;
    rdfs:label "data version" ;
    dcterms:isPartOf <https://w3id.org/iprok/site> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/dataVersion> ;
    rdfs:comment "Semantic version of the site-intel fetcher schema. Bump on any breaking change to a sub-domain's property set so old reports can be re-fetched." ;
    rdfs:domain <https://w3id.org/iprok/site#SiteIntelligence> ;
    rdfs:range xsd:string .

