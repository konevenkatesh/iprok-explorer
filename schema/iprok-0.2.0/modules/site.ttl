@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/iprok/site#aggregateQuarryKm> a owl:DatatypeProperty ;
    rdfs:label "aggregate quarry distance (km)" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/iprok/site> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/aggregateQuarryKm> ;
    rdfs:comment "The aggregate quarry km property in the integrated project information model. Its declared domain is SiteLogistics and its declared range is decimal."@en ;
    rdfs:domain <https://w3id.org/iprok/site#SiteLogistics> ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/site#annualRainfallMM> a owl:DatatypeProperty ;
