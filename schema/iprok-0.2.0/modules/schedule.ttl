    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The task relationship type property in the integrated project information model. Its declared domain is TaskDependency and its declared range is string."@en ;
    rdfs:domain <https://w3id.org/iprok/schedule#TaskDependency> ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/schedule#totalFloat> a owl:DatatypeProperty ;
