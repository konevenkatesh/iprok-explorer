@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/iprok/schedule#ActivityDurationEstimate> a owl:Class ;
    rdfs:label "Activity Duration Estimate"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/ActivityDurationEstimate> ;
    rdfs:comment "How a planned activity's duration was reached: quantity, crew, rate and its source, allowances. Superseded, never overwritten." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/iprok/schedule#BaselineEntry> a owl:Class ;
    rdfs:label "Baseline Entry"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/BaselineEntry> ;
    rdfs:comment "One activity as a baseline froze it: its start, last day and budget then." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/iprok/schedule#EVMSnapshot> a owl:Class ;
    rdfs:label "EVM snapshot" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/EVMSnapshot> ;
    rdfs:comment "One computation of PV/EV/AC and derived metrics for a project at a status date." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/iprok/schedule#Milestone> a owl:Class ;
    rdfs:label "Milestone" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A task representing a significant scheduled event or control point."@en ;
    rdfs:subClassOf <https://w3id.org/iprok/schedule#Task> .

<https://w3id.org/iprok/schedule#ScheduleBaseline> a owl:Class ;
    rdfs:label "Schedule Baseline"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/ScheduleBaseline> ;
    rdfs:comment "A frozen copy of the programme. Baseline 0 is the approved programme (Clause 5.1); later ones are revised programmes (Clause 5.4), each with its basis, reason and approver. Never changed or removed; the newest is the active baseline that variance and planned value are measured against." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/iprok/schedule#ScheduleLink> a owl:Class ;
    rdfs:label "Schedule link" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/ScheduleLink> ;
    rdfs:comment "A reified predecessor edge: which activity precedes which, the P6 relationship type (FS/SS/FF/SF) and the lag in days." .

<https://w3id.org/iprok/schedule#WorkConstraint> a owl:Class ;
    rdfs:label "Work Constraint"@en ;
    dcterms:isPartOf <https://w3id.org/iprok> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/Constraint> ;
    rdfs:comment "Something that must be cleared, by a named person and date, before planned work can proceed." ;
    rdfs:subClassOf prov:Entity,
        <https://w3id.org/iprok#Constraint> .

<https://w3id.org/iprok/schedule#ac> a owl:DatatypeProperty ;
    rdfs:label "Actual Cost (ACWP)" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/ac> ;
    rdfs:comment "Sum of approved/finalised RA Bill netPayable by statusDate. INR. Mandatory on <https://w3id.org/iprok/schedule#EVMSnapshot>. Domain unspecified." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#activityId> a owl:DatatypeProperty ;
    rdfs:label "activity id" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/activityId> ;
    rdfs:comment "Source-schedule unique id (P6 task_code / MSP UID / sheet key). Stable across re-imports so revisions supersede rather than duplicate." ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/schedule#activityName> a owl:DatatypeProperty ;
    rdfs:label "activity name" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/activityName> ;
    rdfs:comment "Domain intentionally unspecified — antipattern #8. ActivityShape constrains format." ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/schedule#activityPlannedFinishDate> a owl:DatatypeProperty ;
    rdfs:label "planned finish (datetime)" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/plannedFinishDate> ;
    rdfs:comment "Mirrors iprok:plannedFinishDate. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:dateTime .

<https://w3id.org/iprok/schedule#activityPlannedStartDate> a owl:DatatypeProperty ;
    rdfs:label "planned start (datetime)" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/plannedStartDate> ;
    rdfs:comment "Mirrors iprok:plannedStartDate. Domain unspecified (antipattern #8). Distinct from the V0.22 Project <https://w3id.org/iprok#plannedStart>." ;
    rdfs:range xsd:dateTime .

<https://w3id.org/iprok/schedule#actualDuration> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "actualDuration"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The actual duration property in the integrated project information model. Its declared domain is TaskTime and its declared range is decimal."@en ;
    rdfs:domain <https://w3id.org/iprok/schedule#TaskTime> ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#actualFinishDate> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "actualFinishDate"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The actual finish date property in the integrated project information model. Its declared domain is TaskTime and its declared range is dateTime."@en ;
    rdfs:domain <https://w3id.org/iprok/schedule#TaskTime> ;
    rdfs:range xsd:dateTime .

<https://w3id.org/iprok/schedule#actualStartDate> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "actualStartDate"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The actual start date property in the integrated project information model. Its declared domain is TaskTime and its declared range is dateTime."@en ;
    rdfs:domain <https://w3id.org/iprok/schedule#TaskTime> ;
    rdfs:range xsd:dateTime .

<https://w3id.org/iprok/schedule#approvedAt> a owl:DatatypeProperty ;
    rdfs:label "approved at" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/approvedAt> ;
    rdfs:comment "Timestamp when the deviation was approved or rejected. Domain unspecified." ;
    rdfs:range xsd:dateTime .

<https://w3id.org/iprok/schedule#approvedBy> a owl:ObjectProperty ;
    rdfs:label "approved by" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/approvedBy> ;
    rdfs:comment "IRI of the user who approved or rejected the deviation. Domain unspecified." .

<https://w3id.org/iprok/schedule#assignedTo> a owl:ObjectProperty ;
    rdfs:label "assignedTo" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The assigned to property in the integrated project information model. Its declared domain is Task and its declared range is Actor."@en ;
    rdfs:domain <https://w3id.org/iprok/schedule#Task> ;
    rdfs:range <https://w3id.org/iprok#Actor> .

<https://w3id.org/iprok/schedule#atCompleteDuration> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "atCompleteDuration"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The at complete duration property in the integrated project information model. Its declared domain is TaskTime and its declared range is decimal."@en ;
    rdfs:domain <https://w3id.org/iprok/schedule#TaskTime> ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#bac> a owl:DatatypeProperty ;
    rdfs:label "Budget at Completion (BAC)" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/bac> ;
    rdfs:comment "Total contract budget = sum of every BOQItem (tenderedQty × quotedRate). INR. Mandatory on <https://w3id.org/iprok/schedule#EVMSnapshot>." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#baseDays> a owl:DatatypeProperty ;
    rdfs:label "base Days"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/baseDays> ;
    rdfs:comment "Working days before allowances: quantity ÷ (daily output × crews). No rdfs:domain." ;
    rdfs:range xsd:integer .

<https://w3id.org/iprok/schedule#baselineActivityId> a owl:DatatypeProperty ;
    rdfs:label "baseline Activity Id"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/baselineActivityId> ;
    rdfs:comment "The activity's id when frozen. No rdfs:domain." ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/schedule#baselineActivityName> a owl:DatatypeProperty ;
    rdfs:label "baseline Activity Name"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/baselineActivityName> ;
    rdfs:comment "The activity's name when frozen. No rdfs:domain." ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/schedule#baselineBasis> a owl:DatatypeProperty ;
    rdfs:label "baseline Basis"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/baselineBasis> ;
    rdfs:comment "ApprovedProgramme (Clause 5.1) | AgreedAmendment (the programme amended by agreement, 5.1) | ExtensionOfTime (5.2 / 5.3: extension granted, milestones rescheduled). No rdfs:domain." ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/schedule#baselineCost> a owl:DatatypeProperty ;
    rdfs:label "baseline Cost"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/baselineCost> ;
    rdfs:comment "The activity's budget when frozen, in rupees. No rdfs:domain." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#baselineDurationDays> a owl:DatatypeProperty ;
    rdfs:label "baseline Duration Days"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/baselineDurationDays> ;
    rdfs:comment "Calendar days, first to last inclusive. No rdfs:domain." ;
    rdfs:range xsd:integer .

<https://w3id.org/iprok/schedule#baselineFinishDate> a owl:DatatypeProperty ;
    rdfs:label "baseline Finish Date"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/baselineFinishDate> ;
    rdfs:comment "The baseline's last planned day — its completion date. No rdfs:domain." ;
    rdfs:range xsd:date .

<https://w3id.org/iprok/schedule#baselineLabel> a owl:DatatypeProperty ;
    rdfs:label "baseline Label"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/baselineLabel> ;
    rdfs:comment "A human name, e.g. \"Approved programme\", \"Revised programme 1\". No rdfs:domain." ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/schedule#baselineLastDay> a owl:DatatypeProperty ;
    rdfs:label "baseline Last Day"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/baselineLastDay> ;
    rdfs:comment "The activity's last day in the baseline (inclusive). No rdfs:domain." ;
    rdfs:range xsd:date .

<https://w3id.org/iprok/schedule#baselineNo> a owl:DatatypeProperty ;
    rdfs:label "baseline No"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/baselineNo> ;
    rdfs:comment "0 for the approved programme; 1, 2 … for revisions. No rdfs:domain." ;
    rdfs:range xsd:integer .

<https://w3id.org/iprok/schedule#baselineOf> a owl:ObjectProperty ;
    rdfs:label "baseline Of"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/baselineOf> ;
    rdfs:comment "The live activity an entry froze. No rdfs:domain." .

<https://w3id.org/iprok/schedule#baselineReason> a owl:DatatypeProperty ;
    rdfs:label "baseline Reason"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/baselineReason> ;
    rdfs:comment "Why the programme was revised. No rdfs:domain." ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/schedule#baselineStart> a owl:DatatypeProperty ;
    rdfs:label "baseline Start"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/baselineStart> ;
    rdfs:comment "The activity's first day in the baseline. No rdfs:domain." ;
    rdfs:range xsd:date .

<https://w3id.org/iprok/schedule#baselineStartDate> a owl:DatatypeProperty ;
    rdfs:label "baseline Start Date"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/baselineStartDate> ;
    rdfs:comment "The baseline's first planned day. No rdfs:domain." ;
    rdfs:range xsd:date .

<https://w3id.org/iprok/schedule#boqShareOf> a owl:ObjectProperty ;
    rdfs:label "boq Share Of"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/boqShareOf> ;
    rdfs:comment "The BOQ line this activity delivers a share of. EVM does NOT sum the line's amount through this link — the activity's own <https://w3id.org/iprok/schedule#budgetedCost> is its budget. No rdfs:domain / rdfs:range (antipattern #8)." .

<https://w3id.org/iprok/schedule#budgetedCost> a owl:DatatypeProperty ;
    rdfs:label "budgeted Cost"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/budgetedCost> ;
    rdfs:comment "The activity's share of its BOQ line's amount (₹), by quantity. The shares of one line sum to the line's amount exactly. No rdfs:domain." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#budgetedQuantity> a owl:DatatypeProperty ;
    rdfs:label "budgeted Quantity"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/budgetedQuantity> ;
    rdfs:comment "The quantity the activity delivers, in its BOQ line's unit — the denominator of its percent complete in EVM. No rdfs:domain." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#constraintDate> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "constraintDate"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The constraint date property in the integrated project information model. Its declared domain is Constraint and its declared range is dateTime."@en ;
    rdfs:domain <https://w3id.org/iprok#Constraint> ;
    rdfs:range xsd:dateTime .

<https://w3id.org/iprok/schedule#constraintType> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "constraintType"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The constraint type property in the integrated project information model. Its declared domain is Constraint and its declared range is string."@en ;
    rdfs:domain <https://w3id.org/iprok#Constraint> ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/schedule#cpi> a owl:DatatypeProperty ;
    rdfs:label "Cost Performance Index" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/cpi> ;
    rdfs:comment "EV / AC. >1.0 under budget, <1.0 over budget. Optional — undefined (omitted) when AC=0." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#crewCount> a owl:DatatypeProperty ;
    rdfs:label "crew Count"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/crewCount> ;
    rdfs:comment "Parallel crews assumed. No rdfs:domain." ;
    rdfs:range xsd:integer .

<https://w3id.org/iprok/schedule#crewDescription> a owl:DatatypeProperty ;
    rdfs:label "crew Description"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/crewDescription> ;
    rdfs:comment "The standard crew the rate refers to, e.g. '1 mason gang (12)'. No rdfs:domain." ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/schedule#cv> a owl:DatatypeProperty ;
    rdfs:label "Cost Variance" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/cv> ;
    rdfs:comment "EV − AC. Positive = under budget. INR. Mandatory on <https://w3id.org/iprok/schedule#EVMSnapshot>." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#dailyOutput> a owl:DatatypeProperty ;
    rdfs:label "daily Output"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/dailyOutput> ;
    rdfs:comment "Output of ONE standard crew per working day, in <https://w3id.org/iprok/integrated#unit> — the rate the duration used. No rdfs:domain." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#dataDate> a owl:DatatypeProperty ;
    rdfs:label "data Date"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/dataDate> ;
    rdfs:comment "The day a programme was taken as of: the progress it reflects. No rdfs:domain." ;
    rdfs:range xsd:date .

<https://w3id.org/iprok/schedule#durationBasis> a owl:DatatypeProperty ;
    rdfs:label "duration Basis"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/durationBasis> ;
    rdfs:comment "The plain-language reason for the duration, as the planner explained it. No rdfs:domain." ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/schedule#eac> a owl:DatatypeProperty ;
    rdfs:label "Estimate at Completion" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/eac> ;
    rdfs:comment "BAC / CPI when CPI>0, else BAC. INR. Mandatory on <https://w3id.org/iprok/schedule#EVMSnapshot>." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#entryCount> a owl:DatatypeProperty ;
    rdfs:label "entry Count"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/entryCount> ;
    rdfs:comment "How many activities a baseline froze. No rdfs:domain." ;
    rdfs:range xsd:integer .

<https://w3id.org/iprok/schedule#eotClause> a owl:DatatypeProperty ;
    rdfs:label "eot Clause"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/eotClause> ;
    rdfs:comment "The Clause 5 sub-clause an extension of time was granted under: 5.2 (beyond the contractor's control) or 5.3 (hindrance by the department). No rdfs:domain." ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/schedule#estimateId> a owl:DatatypeProperty ;
    rdfs:label "estimate Id"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/estimateId> ;
    rdfs:comment "Human-facing id, DE-<activity id>. Polymorphic — no rdfs:domain (antipattern #8)." ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/schedule#estimatedAt> a owl:DatatypeProperty ;
    rdfs:label "estimated At"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/estimatedAt> ;
    rdfs:comment "When the estimate was made. No rdfs:domain." ;
    rdfs:range xsd:dateTime .

<https://w3id.org/iprok/schedule#etc> a owl:DatatypeProperty ;
    rdfs:label "Estimate to Complete" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/etc> ;
    rdfs:comment "EAC − AC, the remaining cost forecast. INR. Mandatory on <https://w3id.org/iprok/schedule#EVMSnapshot>." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#ev> a owl:DatatypeProperty ;
    rdfs:label "Earned Value (BCWP)" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/ev> ;
    rdfs:comment "Budgeted cost of work actually performed by statusDate. INR. Mandatory on <https://w3id.org/iprok/schedule#EVMSnapshot>. Domain unspecified." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#extensionDays> a owl:DatatypeProperty ;
    rdfs:label "extension Days"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/extensionDays> ;
    rdfs:comment "Days of extension granted. No rdfs:domain." ;
    rdfs:range xsd:integer .

<https://w3id.org/iprok/schedule#finalDays> a owl:DatatypeProperty ;
    rdfs:label "final Days"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/finalDays> ;
    rdfs:comment "Planned duration after allowances. No rdfs:domain." ;
    rdfs:range xsd:integer .

