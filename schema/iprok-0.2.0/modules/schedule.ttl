<https://w3id.org/iprok/schedule#scheduleRevision> a owl:DatatypeProperty ;
    rdfs:label "schedule revision id" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/scheduleRevision> ;
    rdfs:comment "UUID stamped on every <https://w3id.org/iprok/schedule#Activity> written by one POST /schedule/ingest/{id}/confirm. Lets a re-import supersede the prior revision (PROV-O) and the UI list revision history." ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/schedule#seededDailyOutput> a owl:DatatypeProperty ;
    rdfs:label "seeded Daily Output"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/seededDailyOutput> ;
    rdfs:comment "The default (CPWD-style) crew-day output, kept beside a measured rate so the difference stays visible. No rdfs:domain." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#spi> a owl:DatatypeProperty ;
    rdfs:label "Schedule Performance Index" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/spi> ;
    rdfs:comment "EV / PV. >1.0 ahead of schedule, <1.0 behind. Optional — undefined (omitted) when PV=0." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#statusDate> a owl:DatatypeProperty ;
    rdfs:label "EVM status date" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/statusDate> ;
    rdfs:comment "The data-date of the EVM snapshot — every activity and bill is rolled up as of this calendar day. Mandatory on <https://w3id.org/iprok/schedule#EVMSnapshot>. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:date .

<https://w3id.org/iprok/schedule#stipulatedFinishDate> a owl:DatatypeProperty ;
    rdfs:label "stipulated Finish Date"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/stipulatedFinishDate> ;
    rdfs:comment "The completion date the contract stipulates while this baseline is in force: the approved programme's last day plus every extension of time granted (CPWD Clause 5.2/5.3). Clause 5.4's 10% is of the period to this date. An agreed amendment does not move it. No rdfs:domain." ;
    rdfs:range xsd:date .

<https://w3id.org/iprok/schedule#sv> a owl:DatatypeProperty ;
    rdfs:label "Schedule Variance" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/sv> ;
    rdfs:comment "EV − PV. Positive = ahead of schedule. INR-equivalent. Mandatory on <https://w3id.org/iprok/schedule#EVMSnapshot>." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#taskPriority> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "taskPriority"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The task priority property in the integrated project information model. Its declared domain is Task and its declared range is integer."@en ;
    rdfs:domain <https://w3id.org/iprok/schedule#Task> ;
    rdfs:range xsd:integer .

<https://w3id.org/iprok/schedule#taskRelationshipType> a owl:DatatypeProperty,
