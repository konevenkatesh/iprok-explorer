    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/totalFloat> ;
    rdfs:comment "Mirrors iprok:totalFloat. Days; may be negative on a behind-schedule critical path." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#vac> a owl:DatatypeProperty ;
    rdfs:label "Variance at Completion" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/vac> ;
    rdfs:comment "BAC − EAC. INR. Mandatory on <https://w3id.org/iprok/schedule#EVMSnapshot>." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#wbsCode> a owl:DatatypeProperty ;
    rdfs:label "WBS code" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/wbsCode> ;
    rdfs:comment "The wbs code property in the integrated project information model."@en ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/schedule#wbsLevel> a owl:DatatypeProperty ;
    rdfs:label "WBS level" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/wbsLevel> ;
    rdfs:comment "Depth in the tree: 1 = project root, 2 = block/zone, 3 = system, deeper = work packages. Server-assigned from parent depth." ;
    rdfs:range xsd:integer .

<https://w3id.org/iprok/schedule#wbsName> a owl:DatatypeProperty ;
    rdfs:label "WBS node name" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/wbsName> ;
    rdfs:comment "Human-readable name of the WBS node (e.g. 'Block A', 'Substructure', 'Footing RCC'). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/schedule#wbsPlannedCost> a owl:DatatypeProperty ;
    rdfs:label "WBS planned cost (rollup)" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/wbsPlannedCost> ;
    rdfs:comment "Rollup: sum of governed <https://w3id.org/iprok/billing#BOQItem> amounts at a work package, rolled up the tree to the root. In Slice 1 this is COMPUTED ON READ in list_wbs_nodes (never persisted) — always-correct and it sidesteps a Fuseki/TDB2 quirk deleting xsd:decimal triples. The property + optional SHACL stanza are reserved for a future slice that may persist a snapshot." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#weatherPadPct> a owl:DatatypeProperty ;
    rdfs:label "weather Pad Pct"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/weatherPadPct> ;
    rdfs:comment "Monsoon/heat allowance as a fraction of base days, for the window the activity actually occupies. No rdfs:domain." ;
    rdfs:range xsd:decimal .

<https://w3id.org/iprok/schedule#Activity> a owl:Class ;
    rdfs:label "Activity" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/Activity> ;
    rdfs:comment "A schedule activity. In v0, manually entered; in v1 ingested from P6." ;
    rdfs:subClassOf <https://w3id.org/iprok/schedule#Task> .

<https://w3id.org/iprok/schedule#WBSNode> a owl:Class ;
    rdfs:label "WBS node" ;
    dcterms:isPartOf <https://w3id.org/iprok/schedule> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/WBSNode> ;
    rdfs:comment "One node in the project work-breakdown structure. Recursive via <https://w3id.org/iprok/schedule#parentWBS>; a leaf (<https://w3id.org/iprok/schedule#isWorkPackage> true) is a work package." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/iprok/schedule#WBS_Element> a owl:Class ;
    rdfs:label "WBS_Element" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "An element of the work breakdown structure used to organise tasks."@en ;
    rdfs:subClassOf <https://w3id.org/iprok#IproKThing> .

<https://w3id.org/iprok/schedule#WorkPackage> a owl:Class ;
    rdfs:label "WorkPackage" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A grouping of project work represented in the work breakdown structure."@en ;
    rdfs:subClassOf <https://w3id.org/iprok#IproKThing> .

<https://w3id.org/iprok/schedule#Project> a owl:Class ;
    rdfs:label "Project" ;
    dcterms:isPartOf <https://w3id.org/iprok> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/Project> ;
    rdfs:comment "The construction-project context in which work, records and control decisions are organised."@en ;
    rdfs:subClassOf <https://w3id.org/iprok#IproKThing> .

<https://w3id.org/iprok/schedule#TaskDependency> a owl:Class ;
    rdfs:label "TaskDependency" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A relationship record describing precedence between scheduled tasks."@en ;
    rdfs:subClassOf <https://w3id.org/iprok#IproKThing> .

<https://w3id.org/iprok/schedule#TaskTime> a owl:Class ;
    rdfs:label "TaskTime" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A time record associated with a scheduled task."@en ;
    rdfs:subClassOf <https://w3id.org/iprok#IproKThing> .

<https://w3id.org/iprok/schedule#Task> a owl:Class ;
    rdfs:label "Task" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A unit of scheduled work within a project."@en ;
    rdfs:subClassOf <https://w3id.org/iprok#IproKThing> .

