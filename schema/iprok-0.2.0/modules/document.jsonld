      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "RFI lifecycle. Transitions (enforced in the API): Draft->Submitted (raiser); Submitted->UnderReview (assignee/PM); UnderReview->Answered (assignee); Answered->Closed (raiser confirms); Answered->UnderReview (raiser rejects); any->Cancelled (PM/Admin). Modelled like <https://w3id.org/iprok/document#DrawingState> / <https://w3id.org/iprok/quality#NCRStatus>."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "RFI state"
      }
    ]
  },
