      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "One AI-detected change between two drawing revisions (added / removed / modified element, dimension, annotation, or spec). Produced by the compare_revisions task; never hand-authored."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Drawing change"
      }
