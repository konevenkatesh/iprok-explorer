    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Points at one <https://w3id.org/iprok/document#RFIState> individual. SHACL constrains via sh:in (sh:in ONLY, no sh:class — the API validates a node's turtle in isolation, per the V0.37 cross-graph caveat). Domain unspecified (antipattern #8)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
