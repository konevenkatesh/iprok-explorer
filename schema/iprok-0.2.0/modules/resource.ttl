@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/IproK/resource#CrewComposition> a owl:Class ;
    rdfs:label "Crew Composition"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/resource> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/CrewComposition> ;
    rdfs:comment "One trade line within a crew type: N of a given trade at a given skill level." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/resource#CrewType> a owl:Class ;
    rdfs:label "Crew Type"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/resource> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/CrewType> ;
    rdfs:comment "A named gang the organisation deploys; 'Mason gang (6)', 'Bar bender gang (4)'. Org-level catalogue." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/resource#EquipmentResource> a owl:Class ;
    rdfs:label "EquipmentResource" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A resource-type classification for equipment."@en ;
    rdfs:subClassOf <https://w3id.org/IproK/resource#ResourceType> .

<https://w3id.org/IproK/resource#LaborResource> a owl:Class ;
    rdfs:label "LaborResource" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A resource-type classification for labour."@en ;
    rdfs:subClassOf <https://w3id.org/IproK/resource#ResourceType> .

<https://w3id.org/IproK/resource#MaterialResource> a owl:Class ;
    rdfs:label "MaterialResource" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A resource-type classification for materials."@en ;
    rdfs:subClassOf <https://w3id.org/IproK/resource#ResourceType> .

<https://w3id.org/IproK/resource#ProductivityContribution> a owl:Class ;
    rdfs:label "Productivity Contribution"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/resource> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/ProductivityContribution> ;
    rdfs:comment "A project's site days counted in its organisation's measured rates. Withdrawn by prov:invalidatedAtTime with who and why; publishing again creates a new one." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/resource#ProductivityNorm> a owl:Class ;
    rdfs:label "Productivity Norm"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/resource> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/ProductivityNorm> ;
    rdfs:comment "The organisation's rolled-up rate for a work type + crew type, derived from observations. Falls back to a seeded default until enough observations exist." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/resource#ProductivityObservation> a owl:Class ;
    rdfs:label "Productivity Observation"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/resource> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/ProductivityObservation> ;
    rdfs:comment "One measured data point: quantity achieved by a crew of a known size over a known period on a known activity." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/resource#ProductivityRecompute> a owl:Class ;
    rdfs:label "Productivity recompute" ;
    dcterms:isPartOf <https://w3id.org/IproK/resource> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/ProductivityRecompute> ;
    rdfs:comment "The per-organisation claim token for writing measured rates." .

<https://w3id.org/IproK/resource#SkillCertification> a owl:Class ;
    rdfs:label "Skill Certification"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/resource> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/SkillCertification> ;
    rdfs:comment "A certification held by a worker, with a validity window so expiry is queryable." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK/resource#UserDefinedResource> a owl:Class ;
    rdfs:label "UserDefinedResource" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "A resource-type classification defined for a project-specific need."@en ;
    rdfs:subClassOf <https://w3id.org/IproK/resource#ResourceType> .

<https://w3id.org/IproK/resource#Worker> a owl:Class ;
    rdfs:label "Worker"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/resource> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/Worker> ;
    rdfs:comment "A person performing site labour. NOT a <https://w3id.org/IproK#User>; most site labour never logs in. Org-level catalogue." ;
    rdfs:subClassOf prov:Agent .

