<https://w3id.org/IproK#approvalLevel1Limit> a owl:DatatypeProperty ;
    rdfs:label "approval Level1Limit"@en ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/approvalLevel1Limit> ;
    rdfs:comment "Deviation value (INR) up to which level 1 approves." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK#approvalLevel2Label> a owl:DatatypeProperty ;
    rdfs:label "approval Level2Label"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
