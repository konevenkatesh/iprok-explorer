@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/IproK#Actor> a owl:Class ;
    rdfs:label "Actor" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The actor class in the integrated project information model."@en ;
    rdfs:subClassOf <https://w3id.org/IproK#IproKThing> .

<https://w3id.org/IproK#Calendar> a owl:Class ;
    rdfs:label "Calendar" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The calendar class in the integrated project information model."@en ;
    rdfs:subClassOf <https://w3id.org/IproK#IproKThing> .

<https://w3id.org/IproK#Constraint> a owl:Class ;
    rdfs:label "Constraint" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The constraint class in the integrated project information model."@en ;
    rdfs:subClassOf <https://w3id.org/IproK#IproKThing> .

<https://w3id.org/IproK#Decision> a owl:Class ;
    rdfs:label "Decision"@en ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/Decision> ;
    rdfs:comment "A question about the project and the answer a named person gave to it." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK#IdSequence> a owl:Class ;
    rdfs:label "Id Sequence"@en ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/IdSequence> ;
    rdfs:comment "The last number issued for one kind of register id in one project." .

<https://w3id.org/IproK#MastersAdoption> a owl:Class ;
    rdfs:label "Masters adoption" ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/MastersAdoption> ;
    rdfs:comment "A project taking a version of its organisation's masters — at creation or when its PM adopts a newer one." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK#OrganisationMasters> a owl:Class ;
    rdfs:label "Organisation masters" ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/OrganisationMasters> ;
    rdfs:comment "One version of an organisation's defaults: contract deductions, deviation routing, financial year and legal identity." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/IproK#SignatureEvent> a owl:Class ;
    rdfs:label "Signature Event" ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/SignatureEvent> ;
    rdfs:comment "A single act of signing a platform document via an e-signature provider. Carries who signed, when, the provider, purpose, and a reference to the signed document." ;
    rdfs:subClassOf prov:Activity .

<https://w3id.org/IproK#adoptedAt> a owl:DatatypeProperty ;
    rdfs:label "adopted At"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/adoptedAt> ;
    rdfs:comment "The adopted at property in the integrated project information model."@en ;
    rdfs:range xsd:dateTime .

<https://w3id.org/IproK#adoptedMastersVersion> a owl:DatatypeProperty ;
    rdfs:label "adopted Masters Version"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/adoptedMastersVersion> ;
    rdfs:comment "The adopted masters version property in the integrated project information model."@en ;
    rdfs:range xsd:integer .

<https://w3id.org/IproK#affectsActivity> a owl:ObjectProperty ;
    rdfs:label "affects Activity"@en ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/affectsActivity> ;
    rdfs:comment "An activity the decision changes. Repeatable. No rdfs:domain / rdfs:range." .

<https://w3id.org/IproK#approvalLevel1Label> a owl:DatatypeProperty ;
