    rdfs:comment "The approval level2label property in the integrated project information model."@en ;
    rdfs:range xsd:string .

<https://w3id.org/IproK#approvalLevel2Limit> a owl:DatatypeProperty ;
    rdfs:label "approval Level2Limit"@en ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/approvalLevel2Limit> ;
    rdfs:comment "Deviation value (INR) up to which level 2 approves; above it, level 3." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK#approvalLevel3Label> a owl:DatatypeProperty ;
    rdfs:label "approval Level3Label"@en ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/approvalLevel3Label> ;
    rdfs:comment "Display names only. The stored deviation states stay ApprovedEE / ApprovedSE / ApprovedCE, so a renamed level never orphans an approval." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK#cin> a owl:DatatypeProperty ;
    rdfs:label "cin"@en ;
