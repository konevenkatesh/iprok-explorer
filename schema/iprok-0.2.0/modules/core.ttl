    dcterms:source <https://bimsaarthi.com/ontology/v0/pilotStatus> ;
    rdfs:comment "An Organisation's pilot-lifecycle state. Domain intentionally unspecified (polymorphic-predicate discipline, antipattern #8) even though v0 uses it only on <https://w3id.org/IproK#Organisation>; OrgShape constrains the allowed individuals." ;
    rdfs:range <https://w3id.org/IproK#PilotStatus> .

<https://w3id.org/IproK#plannedEnd> a owl:DatatypeProperty ;
    rdfs:label "planned end date" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/plannedEnd> ;
    rdfs:comment "The planned end property in the integrated project information model. Its declared domain is Project and its declared range is date."@en ;
    rdfs:domain <https://w3id.org/IproK/schedule#Project> ;
    rdfs:range xsd:date .

<https://w3id.org/IproK#plannedStart> a owl:DatatypeProperty ;
    rdfs:label "planned start date" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/plannedStart> ;
    rdfs:comment "The planned start property in the integrated project information model. Its declared domain is Project and its declared range is date."@en ;
    rdfs:domain <https://w3id.org/IproK/schedule#Project> ;
    rdfs:range xsd:date .

<https://w3id.org/IproK#securityDepositPct> a owl:DatatypeProperty ;
    rdfs:label "security Deposit Pct"@en ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/securityDepositPct> ;
    rdfs:comment "Retention deducted from each contractor bill, in percent." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK#signatureId> a owl:DatatypeProperty ;
    rdfs:label "signature ID" ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/signatureId> ;
    rdfs:comment "Platform-generated or provider-issued unique identifier for this signing event." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK#signatureProvider> a owl:DatatypeProperty ;
    rdfs:label "signature provider" ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/signatureProvider> ;
    rdfs:comment "Name of the e-signature service used: 'eMudhra', 'DigiLocker', or 'Stub'. sh:in constraint in SignatureEventShape." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK#signaturePurpose> a owl:DatatypeProperty ;
    rdfs:label "signature purpose" ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/signaturePurpose> ;
    rdfs:comment "Why the document was signed. One of: DrawingApproval, RFIConfirmation, TransmittalApproval, JointMeasurement. sh:in in SignatureEventShape." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK#signedAt> a owl:DatatypeProperty ;
    rdfs:label "signed at" ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/signedAt> ;
    rdfs:comment "ISO-8601 datetime when the signature was applied (server-stamped for stub; provider-returned for real modes)." ;
    rdfs:range xsd:dateTime .

<https://w3id.org/IproK#signedBy> a owl:ObjectProperty ;
    rdfs:label "signed by" ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/signedBy> ;
    rdfs:comment "IRI of the <https://w3id.org/IproK#User> who performed the signing action. Polymorphic — also used on <https://w3id.org/IproK/billing#JointMeasurement> (M3)." .

<https://w3id.org/IproK#signedDocument> a owl:ObjectProperty ;
    rdfs:label "signed document" ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/signedDocument> ;
    rdfs:comment "IRI of the <https://w3id.org/IproK/document#Drawing>, <https://w3id.org/IproK/document#RFI>, <https://w3id.org/IproK/document#Transmittal>, or <https://w3id.org/IproK/billing#Measurement> that was signed. Mandatory." .

<https://w3id.org/IproK#userRole> a owl:DatatypeProperty ;
    rdfs:label "user role" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/userRole> ;
    rdfs:comment "The user role property in the integrated project information model. Its declared domain is User and its declared range is string."@en ;
    rdfs:domain <https://w3id.org/IproK#User> ;
    rdfs:range xsd:string .

<https://w3id.org/IproK#zoneConfig> a owl:DatatypeProperty ;
    rdfs:label "zone config (JSON)" ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/zoneConfig> ;
    rdfs:comment "JSON array of {name, lat, lng, radius_m} dicts. v0 hack — gets a proper schema (and SHACL shape) when polygon zones land." ;
    rdfs:domain <https://w3id.org/IproK/schedule#Project> ;
    rdfs:range xsd:string .

<https://w3id.org/IproK#PilotStatus> a owl:Class ;
    rdfs:label "Pilot Status" ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/PilotStatus> ;
    rdfs:comment "Enum of organisation pilot-lifecycle states." .

<https://w3id.org/IproK#Organisation> a owl:Class ;
    rdfs:label "Organisation" ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/Organisation> ;
    rdfs:comment "A tenant. One organisation owns many <https://w3id.org/IproK/schedule#Project> nodes. Per V0.30, every Project must declare its parent Organisation via <https://w3id.org/IproK/integrated#ofOrganisation>; the API enforces same-org access on every project-scoped route." .

<https://w3id.org/IproK#ProjectMembership> a owl:Class ;
    rdfs:label "Project membership" ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/ProjectMembership> ;
    rdfs:comment "An (project, user) edge with a joinedAt timestamp." .

<https://w3id.org/IproK#User> a owl:Class ;
    rdfs:label "User" ;
    dcterms:isPartOf <https://w3id.org/IproK> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/User> ;
    rdfs:comment "A platform user — site engineer, QC, PM, etc." ;
    rdfs:subClassOf prov:Agent .

<https://w3id.org/IproK#IproKThing> a owl:Class ;
    rdfs:label "IproKThing" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The ipro kthing class in the integrated project information model."@en ;
    rdfs:subClassOf owl:Thing .

