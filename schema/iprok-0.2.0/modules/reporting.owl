<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#reportedQuantity">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <rdfs:comment xml:lang="en">The reported quantity property in the integrated project information model. Its declared domain is DPREntry and its declared range is decimal.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>reported quantity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/reporting#DPREntry"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/reportedQuantity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#clientId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>UUID assigned by the submitting client. Server treats repeated values within the same project graph as the same submission.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>client id (idempotency key)</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/clientId"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#displayOrder">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/displayOrder"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:label>display order on the dashboard</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <rdfs:comment xml:lang="en">The display order property in the integrated project information model.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#isPinned">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>pinned to project home?</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/isPinned"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>Pinned widgets appear on the project home below the V0.23 SummaryBar.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#photoUri">
    <rdfs:comment xml:lang="en">The photo uri property in the integrated project information model. Its declared domain is Photo and its declared range is anyURI.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/reporting#Photo"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <rdfs:label>photo URI</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/photoUri"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#queryRole">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <rdfs:comment>One of Any / PM / Director / Auditor. Enforced in the route layer with a role-rank comparison.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/queryRole"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>minimum role to view this widget</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#locationWkt">
    <rdfs:label>location (WKT)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/locationWkt"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Inline WKT POINT(lng lat) literal. Used on DPREntry and Photo.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#reportedAgainst">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/reportedAgainst"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:comment xml:lang="en">The reported against property in the integrated project information model. Its declared domain is DPREntry and its declared range is Activity.</rdfs:comment>
    <rdfs:label>reported against</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="https://w3id.org/iprok/schedule#Activity"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/reporting#DPREntry"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#SavedQuery">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/SavedQuery"/>
    <rdfs:label>Saved SPARQL query (dashboard widget)</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A persisted, named SPARQL query attached to a project. Renders as a dashboard widget per its visualType.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#createdBy">
    <rdfs:label>created by</rdfs:label>
    <rdfs:comment>User who authored a graph node (S4.6: &lt;https://w3id.org/iprok/reporting#SavedQuery&gt;). Domain unspecified (antipattern #8).</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/createdBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#queryName">
    <rdfs:comment>Display title for the dashboard widget. Unique per project — enforced in the route layer.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <rdfs:label>query name</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/queryName"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#sparqlText">
    <rdfs:comment>Raw SPARQL as the user saved it (before the firewall rewrite). Mandatory on &lt;https://w3id.org/iprok/reporting#SavedQuery&gt;.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <rdfs:label>SPARQL source text</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/sparqlText"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#DPREntry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Daily Progress Report Entry</rdfs:label>
    <rdfs:comment>A single field-reported progress entry against an Activity.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/DPREntry"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#weatherHoursLost">
    <rdfs:label xml:lang="en">weather Hours Lost</rdfs:label>
    <rdfs:comment>Working hours of this work lost to the weather that day (0–12). Needs a weatherCondition. Polymorphic — antipattern #8.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/weatherHoursLost"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#visualType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>One of table / number / bar / line / pie. Drives client-side rendering.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <rdfs:label>visualisation type</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/visualType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#Photo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A geo-tagged site photo, stored in MinIO and linked to the entity it documents.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <rdfs:label>Photo</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/Photo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/reporting#weatherCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>The weather on site for this report: Fair | Cloudy | LightRain | HeavyRain | Waterlogged | ExtremeHeat | HighWind. Polymorphic — antipattern #8.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/weatherCondition"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/reporting"/>
    <rdfs:label xml:lang="en">weather Condition</rdfs:label>
  </rdf:Description>
</rdf:RDF>
