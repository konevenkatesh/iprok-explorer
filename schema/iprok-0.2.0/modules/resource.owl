  <rdf:Description rdf:about="https://w3id.org/iprok/resource#compositionCount">
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">The composition count property in the integrated project information model.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/compositionCount"/>
    <rdfs:label xml:lang="en">composition Count</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#reportCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
    <rdfs:comment>Daily reports of this work type considered for a norm — counted or set aside.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/reportCount"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">report Count</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#compositionRole">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/compositionRole"/>
    <rdfs:comment>Mason | Helper | Bar bender | Carpenter | Operator | Supervisor…</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
    <rdfs:label xml:lang="en">composition Role</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#ProductivityRecompute">
    <rdfs:label>Productivity recompute</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>The per-organisation claim token for writing measured rates.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/ProductivityRecompute"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#withdrawnBy">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/withdrawnBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Who took the project's days out of the organisation's rates.</rdfs:comment>
    <rdfs:label xml:lang="en">withdrawn By</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#TrackingTag">
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok#IproKThing"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:comment xml:lang="en">An identifier concept used to track a resource.</rdfs:comment>
    <rdfs:label>TrackingTag</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#productivityRate">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/productivityRate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="en">productivity Rate</rdfs:label>
    <rdfs:comment>observedQuantity ÷ crewDays, i.e. output per person-day. Server-computed; never trusted from the client.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#ProductivityContribution">
    <rdfs:comment>A project's site days counted in its organisation's measured rates. Withdrawn by prov:invalidatedAtTime with who and why; publishing again creates a new one.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/ProductivityContribution"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
    <rdfs:label xml:lang="en">Productivity Contribution</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#withdrawalReason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
    <rdfs:label xml:lang="en">withdrawal Reason</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/withdrawalReason"/>
    <rdfs:comment>Why the project's days no longer count — kept with the record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/resource#ProductivityNorm">
    <rdfs:label xml:lang="en">Productivity Norm</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>The organisation's rolled-up rate for a work type + crew type, derived from observations. Falls back to a seeded default until enough observations exist.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/resource"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/ProductivityNorm"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
