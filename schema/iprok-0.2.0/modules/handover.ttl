@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/iprok/handover#DLPDefect> a owl:Class ;
    rdfs:label "DLPDefect"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/handover> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/DLPDefect> ;
    rdfs:comment "A post-handover defect inside the liability period; RERA S.14(3): rectify within 30 days." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/iprok/handover#HandoverPackage> a owl:Class ;
    rdfs:label "Handover Package"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/handover> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/HandoverPackage> ;
    rdfs:comment "The project's digital handover record: readiness, transfer, and the defect-liability window." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/iprok/handover#SnagItem> a owl:Class ;
    rdfs:label "Snag Item"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/handover> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/SnagItem> ;
    rdfs:comment "One punch-list item found during handover inspection. Open Critical snags block transfer." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/iprok/handover#WarrantyRecord> a owl:Class ;
    rdfs:label "Warranty Record"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/handover> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/WarrantyRecord> ;
    rdfs:comment "One asset/system warranty (vendor, start, duration) handed to operations." ;
    rdfs:subClassOf prov:Entity .

<https://w3id.org/iprok/handover#committedHandoverDate> a owl:DatatypeProperty ;
    rdfs:label "committed Handover Date"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/iprok/handover> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/committedHandoverDate> ;
    rdfs:comment "The committed handover date property in the integrated project information model."@en ;
    rdfs:range xsd:date .

<https://w3id.org/iprok/handover#defectId> a owl:DatatypeProperty ;
    rdfs:label "defect Id"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/iprok/handover> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/defectId> ;
    rdfs:comment "The defect id property in the integrated project information model."@en ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/handover#defectStatus> a owl:DatatypeProperty ;
    rdfs:label "defect Status"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/handover> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/defectStatus> ;
    rdfs:comment "Reported | InRepair | Rectified | Disputed." ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/handover#dlpMonths> a owl:DatatypeProperty ;
    rdfs:label "DLP (months)" ;
    dcterms:isPartOf <https://w3id.org/iprok/handover> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/dlpMonths> ;
    rdfs:comment "Defect-liability window in months. RERA default 60 (5 years from possession)." ;
    rdfs:range xsd:integer .

<https://w3id.org/iprok/handover#handoverStatus> a owl:DatatypeProperty ;
    rdfs:label "handover Status"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/handover> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/handoverStatus> ;
    rdfs:comment "Preparing | Transferred." ;
    rdfs:range xsd:string .

<https://w3id.org/iprok/handover#rectifiedAt> a owl:DatatypeProperty ;
    rdfs:label "rectified At"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/iprok/handover> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/rectifiedAt> ;
    rdfs:comment "The rectified at property in the integrated project information model."@en ;
    rdfs:range xsd:dateTime .

<https://w3id.org/iprok/handover#snagDescription> a owl:DatatypeProperty ;
    rdfs:label "snag Description"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
