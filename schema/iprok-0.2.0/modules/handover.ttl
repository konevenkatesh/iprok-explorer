<https://w3id.org/iprok/handover#snagSeverity> a owl:DatatypeProperty ;
    rdfs:label "snag Severity"@en ;
    dcterms:isPartOf <https://w3id.org/iprok/handover> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/snagSeverity> ;
    rdfs:comment "Minor | Major | Critical." ;
