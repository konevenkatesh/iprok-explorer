    dcterms:source <https://bimsaarthi.com/ontology/v0/approvalConditions> ;
    rdfs:comment "Free-text conditions attached by the authority on approval. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#approvalDecidedAt> a owl:DatatypeProperty ;
    rdfs:label "decided at" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
