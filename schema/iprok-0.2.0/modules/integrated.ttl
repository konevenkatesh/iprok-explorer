    dcterms:source <https://bimsaarthi.com/ontology/v0/snagLocation> ;
    rdfs:comment "The snag location property in the integrated project information model."@en ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#sorState> a owl:DatatypeProperty ;
