<https://w3id.org/IproK/integrated#assignedTo> a owl:ObjectProperty ;
    rdfs:label "assigned to" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/assignedTo> ;
    rdfs:comment "The <https://w3id.org/IproK#User> the RFI is routed to (discipline auto-routing). Domain unspecified (antipattern #8)." ;
    rdfs:range prov:Agent .

<https://w3id.org/IproK/integrated#atLocation> a owl:ObjectProperty ;
    rdfs:label "at location" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
