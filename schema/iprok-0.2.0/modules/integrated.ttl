    rdfs:label "activity Assigned Actor"@en ;
    dcterms:created "2026-10-19"^^xsd:date ;
    dcterms:description "Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate."@en ;
