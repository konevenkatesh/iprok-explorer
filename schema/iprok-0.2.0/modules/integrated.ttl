    dcterms:source <https://bimsaarthi.com/ontology/v0/bcfGuid> ;
    rdfs:comment "The original BCF topic GUID — used for idempotent round-trip import/export (same GUID → update, not duplicate)." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#bgValidityDays> a owl:DatatypeProperty ;
    rdfs:label "BG validity (days)" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/bgValidityDays> ;
    rdfs:comment "The bg validity days property in the integrated project information model."@en ;
