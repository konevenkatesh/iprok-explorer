<https://w3id.org/IproK/integrated#titleBlockConfirmedAt> a owl:DatatypeProperty ;
    rdfs:label "title block confirmed at" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/titleBlockConfirmedAt> ;
    rdfs:comment "The title block confirmed at property in the integrated project information model."@en ;
    rdfs:range xsd:dateTime .

<https://w3id.org/IproK/integrated#titleBlockConfirmedBy> a owl:ObjectProperty ;
    rdfs:label "title block confirmed by" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/titleBlockConfirmedBy> ;
    rdfs:comment "The <https://w3id.org/IproK#User> who confirmed the AI title-block extraction. Domain unspecified (antipattern #8)." ;
    rdfs:range prov:Agent .

<https://w3id.org/IproK/integrated#titleBlockExtracted> a owl:DatatypeProperty ;
    rdfs:label "title block extracted" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/titleBlockExtracted> ;
    rdfs:comment "Boolean on <https://w3id.org/IproK/document#Drawing> — true once the extract_title_block task has run (success OR fail-soft no-op marks nothing; only a successful extraction sets it true). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:boolean .

<https://w3id.org/IproK/integrated#titleBlockJson> a owl:DatatypeProperty ;
    rdfs:label "title block JSON" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/titleBlockJson> ;
    rdfs:comment "The raw AI extraction as a JSON string: {field: {value, confidence}} for drawing_number / drawing_title / revision / discipline / scale / drawn_by / checked_by / approved_by / date / project_name. The GET .../title-block endpoint returns this verbatim. Kept as one literal so the ontology stays lean (the spec mandates only titleBlockExtracted + needsReview as new predicates)." ;
    rdfs:range xsd:string .

