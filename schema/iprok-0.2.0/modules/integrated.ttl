<https://w3id.org/IproK/integrated#actualFinish> a owl:DatatypeProperty ;
    rdfs:label "actual finish" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/actualFinish> ;
    rdfs:comment "The actual finish property in the integrated project information model."@en ;
    rdfs:range xsd:dateTime .

<https://w3id.org/IproK/integrated#actualStart> a owl:DatatypeProperty ;
    rdfs:label "actual start" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/actualStart> ;
    rdfs:comment "The actual start property in the integrated project information model."@en ;
    rdfs:range xsd:dateTime .

<https://w3id.org/IproK/integrated#affectsSoldUnits> a owl:DatatypeProperty ;
    rdfs:label "affects Sold Units"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/affectsSoldUnits> ;
    rdfs:comment "True when the option changes sanctioned plans or specs of sold units — triggers the RERA Section 14(2) 2/3-allottee-consent gate at decision time." ;
    rdfs:range xsd:boolean .

<https://w3id.org/IproK/integrated#allocatedUnits> a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "allocatedUnits"@en ;
    rdfs:comment "" ;
    rdfs:domain <https://w3id.org/IproK/integrated#ResourceAllocation> ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/integrated#allocationAssignsResource> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "allocationAssignsResource" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    rdfs:comment "The allocation assigns resource property in the integrated project information model. Its declared domain is ResourceAllocation and its declared range is Resource."@en ;
    rdfs:domain <https://w3id.org/IproK/integrated#ResourceAllocation> ;
    rdfs:range <https://w3id.org/IproK/resource#Resource> .

<https://w3id.org/IproK/integrated#allocationForTask> a owl:FunctionalProperty,
