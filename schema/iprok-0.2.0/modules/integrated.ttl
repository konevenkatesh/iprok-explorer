<https://w3id.org/IproK/integrated#spatialZone> a owl:DatatypeProperty ;
    rdfs:label "spatial zone" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/spatialZone> ;
    rdfs:comment "Name of the containing IfcSpace / IfcBuildingStorey the element belongs to, copied verbatim from the IFC spatial hierarchy. Deliberately distinct from <https://w3id.org/IproK/integrated#zone> (V0.23 GPS-haversine zone) — IFC storeys and site GPS zones are orthogonal." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#superBuiltUpAreaSqft> a owl:DatatypeProperty ;
    rdfs:label "super Built Up Area Sqft"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/superBuiltUpAreaSqft> ;
    rdfs:comment "Saleable (super built-up) area, sqft — the pricing basis in the mid-market convention." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/integrated#supersedes> a owl:ObjectProperty ;
