    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/bidValidityDays> ;
    rdfs:comment "The bid validity days property in the integrated project information model."@en ;
    rdfs:range xsd:integer .

<https://w3id.org/IproK/integrated#builtUpAreaSqft> a owl:DatatypeProperty ;
    rdfs:label "built Up Area Sqft"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/builtUpAreaSqft> ;
    rdfs:comment "The built up area sqft property in the integrated project information model."@en ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/integrated#certifyingBody> a owl:DatatypeProperty ;
    rdfs:label "certifying Body"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/certifyingBody> ;
    rdfs:comment "The certifying body property in the integrated project information model."@en ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#changedProperty> a owl:ObjectProperty ;
    rdfs:label "changed Property"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/changedProperty> ;
    rdfs:comment "The property that changed. No rdfs:domain." .

<https://w3id.org/IproK/integrated#changedSubject> a owl:ObjectProperty ;
    rdfs:label "changed Subject"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/changedSubject> ;
    rdfs:comment "Which node a change record is about, when one activity changes several (a BOQ rate and the activity budgets split from it). No rdfs:domain." .

<https://w3id.org/IproK/integrated#checklistTemplate> a owl:DatatypeProperty ;
    rdfs:label "checklist template id" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/checklistTemplate> ;
    rdfs:comment "Reference to the checklist library template this inspection used (e.g. 'IS-456-concrete-pour-v0'). Hardcoded in v0; resolves to a real catalogue node in a later slice." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#closureNote> a owl:DatatypeProperty ;
    rdfs:label "closure note" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/closureNote> ;
    rdfs:comment "The closure note property in the integrated project information model."@en ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#computedAt> a owl:DatatypeProperty ;
    rdfs:label "computed at",
        "snapshot computed at" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/computedAt> ;
    rdfs:comment "Timestamp when the comparator wrote this ComparableProject node. Mandatory (every audit row must carry a timestamp).",
        "Wall-clock time the snapshot was computed. Distinct from <https://w3id.org/IproK/schedule#statusDate> (which is the as-of data date). Mandatory on <https://w3id.org/IproK/schedule#EVMSnapshot>. Domain unspecified — reused on other ad-hoc analytics rows." ;
    rdfs:range xsd:dateTime .

<https://w3id.org/IproK/integrated#consentRecordedCount> a owl:DatatypeProperty ;
    rdfs:label "consent Recorded Count"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/consentRecordedCount> ;
    rdfs:comment "Allottee consents the PMC recorded before approving a S.14(2)-gated option. Full consent records (per-allottee) land with the sales module." ;
    rdfs:range xsd:integer .

<https://w3id.org/IproK/integrated#contingencyPlan> a owl:DatatypeProperty ;
    rdfs:label "contingency plan" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/contingencyPlan> ;
    rdfs:comment "The contingency plan property in the integrated project information model."@en ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#contractorOTPRef> a owl:DatatypeProperty ;
    rdfs:label "contractor OTP reference" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/contractorOTPRef> ;
    rdfs:comment "Optional OTP transaction reference from the SMS provider (MSG91). Domain unspecified." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#costBaselineAmount> a owl:DatatypeProperty ;
    rdfs:label "cost Baseline Amount"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/costBaselineAmount> ;
    rdfs:comment "The locked concept/feasibility estimate on the <https://w3id.org/IproK/schedule#Project> node — the top of the 5D cascade and the RERA cost baseline. Updated only by PROV-O supersession." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/integrated#costImpact> a owl:DatatypeProperty ;
    rdfs:label "estimated cost impact (INR)" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/costImpact> ;
    rdfs:comment "The cost impact property in the integrated project information model."@en ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/integrated#countedAsElement> a owl:DatatypeProperty ;
    rdfs:label "counted as element" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/countedAsElement> ;
    rdfs:comment "On a <https://w3id.org/IproK/building#Element> whose work another model also carries: the IFC GlobalId of an element of the model the take-off counted it from — the same work, occupying the same space. Repeatable (a placeholder slab is counted as the planks under it). A literal GlobalId, because that is how BOQ lines and activities scope their elements (<https://w3id.org/IproK/integrated#hasIFCScope>). Polymorphic — no rdfs:domain (antipattern #8)." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#countedInModel> a owl:ObjectProperty ;
    rdfs:label "counted in model" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/countedInModel> ;
    rdfs:comment "On a <https://w3id.org/IproK/building#Element> whose work another model also carries: the <https://w3id.org/IproK/building#IfcModel> whose copy the take-off counted. No rdfs:domain." .

<https://w3id.org/IproK/integrated#coversMeasurement> a owl:ObjectProperty ;
