    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/supersedes> ;
    rdfs:comment "Links a new revision to the prior <https://w3id.org/IproK/document#Drawing> of the same drawingId it replaces. Domain unspecified (antipattern #8 — RFI/markup reuse later)." ;
    rdfs:range <https://w3id.org/IproK/document#Drawing> .

<https://w3id.org/IproK/integrated#tallyVoucherId> a owl:DatatypeProperty ;
