    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    rdfs:comment "The designated account from which certified funds are withdrawn."@en ;
    rdfs:domain <https://w3id.org/IproK/finance#EscrowWithdrawal> ;
    rdfs:isDefinedBy <https://w3id.org/IproK/0.2.0> ;
    rdfs:range <https://w3id.org/IproK/finance#EscrowAccount> .

<https://w3id.org/IproK/integrated#withdrawalSupportedByDocument> a owl:ObjectProperty ;
    rdfs:label "withdrawal Supported By Document"@en ;
    dcterms:created "2026-10-19"^^xsd:date ;
    dcterms:description "Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    rdfs:comment "A controlled certificate or document supporting the escrow withdrawal."@en ;
    rdfs:domain <https://w3id.org/IproK/finance#EscrowWithdrawal> ;
    rdfs:isDefinedBy <https://w3id.org/IproK/0.2.0> ;
    rdfs:range <https://w3id.org/IproK/document#Document> .

<https://w3id.org/IproK/integrated#workConstraintAssignedUser> a owl:ObjectProperty ;
    rdfs:label "work Constraint Assigned User"@en ;
    dcterms:created "2026-10-19"^^xsd:date ;
    dcterms:description "Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    rdfs:comment "The user responsible for clearing the work-readiness constraint."@en ;
