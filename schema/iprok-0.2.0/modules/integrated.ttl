    dcterms:source <https://bimsaarthi.com/ontology/v0/approvalAuthority> ;
    rdfs:comment "The authority the application goes to (TG-bPASS, DTCP, AAI/NOCAS, PCB, DISCOM, RERA authority …). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#approvalConditions> a owl:DatatypeProperty ;
    rdfs:label "conditions of approval" ;
