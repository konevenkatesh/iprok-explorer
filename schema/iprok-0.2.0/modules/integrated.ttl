<https://w3id.org/IproK/integrated#issuedFor> a owl:ObjectProperty ;
    rdfs:label "issued for" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/issuedFor> ;
    rdfs:comment "Optional link to the <https://w3id.org/IproK/schedule#Activity> this material issue supports. Domain unspecified (antipattern #8)." .

<https://w3id.org/IproK/integrated#issuingDepartment> a owl:DatatypeProperty ;
    rdfs:label "issuing department" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/issuingDepartment> ;
    rdfs:comment "The issuing department property in the integrated project information model."@en ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#itemCode> a owl:DatatypeProperty ;
    rdfs:label "item code" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/itemCode> ;
    rdfs:comment "Stable identifier for a checklist row (V0.17 — e.g. 'IS-456-7.4.1') or for a BOQ line (V0.29 — e.g. 'B-01'). Domain intentionally left unspecified — adding `rdfs:domain <https://w3id.org/IproK/quality#ChecklistItem>` would make every BOQItem carrying <https://w3id.org/IproK/integrated#itemCode> get RDFS-inferred as a ChecklistItem and trip ChecklistItemShape (antipattern #8)." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#lastClaim> a owl:DatatypeProperty ;
    rdfs:label "last Claim"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/lastClaim> ;
    rdfs:comment "One-off token of the writer that last advanced a sequence. No rdfs:domain." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#lastIssued> a owl:DatatypeProperty ;
    rdfs:label "last Issued"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/lastIssued> ;
    rdfs:comment "The last number issued from a sequence. No rdfs:domain." ;
    rdfs:range xsd:integer .

<https://w3id.org/IproK/integrated#lateFinish> a owl:DatatypeProperty ;
    rdfs:label "late finish (CPM backward pass)" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/lateFinish> ;
    rdfs:comment "The late finish property in the integrated project information model."@en ;
    rdfs:range xsd:dateTime .

<https://w3id.org/IproK/integrated#lateStart> a owl:DatatypeProperty ;
    rdfs:label "late start (CPM backward pass)" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/lateStart> ;
    rdfs:comment "Latest the activity can start without delaying the project end." ;
    rdfs:range xsd:dateTime .

<https://w3id.org/IproK/integrated#linkedAnnotation> a owl:ObjectProperty ;
    rdfs:label "linked annotation" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/linkedAnnotation> ;
    rdfs:comment "Optional — the <https://w3id.org/IproK/document#Annotation> markup that raised this RFI (the cross-domain join markup→RFI). Domain unspecified (antipattern #8)." ;
    rdfs:range <https://w3id.org/IproK/document#Annotation> .

<https://w3id.org/IproK/integrated#linkedBOQItem> a owl:ObjectProperty ;
    rdfs:label "linked BOQ item" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/linkedBOQItem> ;
    rdfs:comment "Cross-domain bridge from <https://w3id.org/IproK/schedule#Activity> to its governing <https://w3id.org/IproK/billing#BOQItem> (alternative to BOQItem.linkedActivity). Domain unspecified (antipattern #8). S4.2." .

<https://w3id.org/IproK/integrated#linkedDrawing> a owl:ObjectProperty ;
    rdfs:label "linked drawing" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/linkedDrawing> ;
    rdfs:comment "Optional — the <https://w3id.org/IproK/document#Drawing> this RFI is about. Domain unspecified (antipattern #8)." ;
    rdfs:range <https://w3id.org/IproK/document#Drawing> .

<https://w3id.org/IproK/integrated#linkedRFI> a owl:ObjectProperty ;
    rdfs:label "linked RFI" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/linkedRFI> ;
    rdfs:comment "Optional — the <https://w3id.org/IproK/document#RFI> this markup spawned / references. Populated in S2.5. Domain unspecified (antipattern #8)." ;
    rdfs:range <https://w3id.org/IproK/document#RFI> .

<https://w3id.org/IproK/integrated#material> a owl:DatatypeProperty ;
    rdfs:label "material",
        "material name" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/material> ;
    rdfs:comment "Material identifier: 'Steel-TMT' | 'Cement' | 'Bitumen' | 'Aggregate' | 'Sand' | 'Brick'. Polymorphic; matches the <https://w3id.org/IproK/procurement#MaterialIssue>.material vocabulary.",
        "Material type: Cement, Steel, Bitumen, Sand, Aggregate, Brick, Other. Mandatory. Domain unspecified." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#mitigationPlan> a owl:DatatypeProperty ;
    rdfs:label "mitigation plan" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/mitigationPlan> ;
    rdfs:comment "The mitigation plan property in the integrated project information model."@en ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#modeOfMeasurement> a owl:DatatypeProperty ;
    rdfs:label "mode of measurement" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/modeOfMeasurement> ;
    rdfs:comment "Optional IS 1200 reference, e.g. 'IS 1200 Part-1'." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#modelRevision> a owl:DatatypeProperty ;
    rdfs:label "model revision" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/modelRevision> ;
    rdfs:comment "Project-unique identifier of the IFC upload that produced this element. Plain string — typically a short id minted server-side. Lets a later revision supersede prior elements without losing the audit chain (PROV-O carries the activity). Polymorphic — carried on <https://w3id.org/IproK/building#Element> and <https://w3id.org/IproK/building#IfcModel>." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#normSource> a owl:DatatypeProperty ;
    rdfs:label "norm Source"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/normSource> ;
    rdfs:comment "measured | seeded — a seeded default must never be mistaken for a measured norm, the same posture as BS_Audit.QuantitySource on an enriched IFC." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#noticePeriodDays> a owl:DatatypeProperty ;
    rdfs:label "notice period (days)" ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/noticePeriodDays> ;
    rdfs:comment "The notice period days property in the integrated project information model."@en ;
    rdfs:range xsd:integer .

<https://w3id.org/IproK/integrated#observationCount> a owl:DatatypeProperty ;
    rdfs:label "observation Count"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/observationCount> ;
    rdfs:comment "How many observations this norm averages. Below MIN_OBSERVATIONS the norm stays 'seeded'." ;
    rdfs:range xsd:integer .

<https://w3id.org/IproK/integrated#observedActivity> a owl:ObjectProperty ;
    rdfs:label "observed Activity"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/observedActivity> ;
    rdfs:comment "The <https://w3id.org/IproK/schedule#Activity> the work was booked against." .

<https://w3id.org/IproK/integrated#observedCrewType> a owl:ObjectProperty ;
    rdfs:label "observed Crew Type"@en ;
    dcterms:description "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/observedCrewType> ;
    rdfs:comment "The observed crew type property in the integrated project information model."@en .

<https://w3id.org/IproK/integrated#ofOrganisation> a owl:ObjectProperty ;
    rdfs:label "of organisation" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/ofOrganisation> ;
    rdfs:comment "Mandatory from V0.30 on every <https://w3id.org/IproK/schedule#Project>. Same naming convention as <https://w3id.org/IproK/integrated#ofProject> (V0.29) and <https://w3id.org/IproK#ofUser> (V0.22). Domain intentionally unspecified so the predicate stays polymorphic — V0.31's SPARQL firewall will use it on user / project / drawing nodes alike." ;
    rdfs:range <https://w3id.org/IproK#Organisation> .

<https://w3id.org/IproK/integrated#ofProject> a owl:ObjectProperty ;
    rdfs:label "of project" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/ofProject> ;
    rdfs:comment "Same naming convention as <https://w3id.org/IproK#ofUser> on <https://w3id.org/IproK#ProjectMembership>. Domain intentionally unspecified so M3 / M4 can reuse the predicate on other classes (e.g. <https://w3id.org/IproK/document#Drawing>, <https://w3id.org/IproK/billing#RABill>) without retripping antipattern #8." ;
    rdfs:range <https://w3id.org/IproK/schedule#Project> .

