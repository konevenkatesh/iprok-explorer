    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/governedByWBS> ;
    rdfs:comment "Polymorphic bridge (antipattern #8): placed on a <https://w3id.org/IproK/billing#BOQItem> / <https://w3id.org/IproK/building#Element> / <https://w3id.org/IproK/schedule#Activity> to point UP at its governing work package (<https://w3id.org/IproK/schedule#WBSNode>). The existing catalogue classes are otherwise untouched." ;
    rdfs:range <https://w3id.org/IproK/schedule#WBSNode> .

