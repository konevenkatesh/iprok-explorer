<https://w3id.org/IproK/integrated#baseRatePerSqft> a owl:DatatypeProperty ;
    rdfs:label "base Rate Per Sqft"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/baseRatePerSqft> ;
    rdfs:comment "Base price per sqft SBA for this unit type. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:decimal .

<https://w3id.org/IproK/integrated#baselineWriteToken> a owl:DatatypeProperty ;
    rdfs:label "baseline Write Token"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/baselineWriteToken> ;
    rdfs:comment "Concurrency state, not a fact: proves which of two simultaneous approvals was written. No rdfs:domain." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#bcfGuid> a owl:DatatypeProperty ;
    rdfs:label "BCF GUID" ;
