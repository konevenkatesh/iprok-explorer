<https://w3id.org/IproK/integrated#workType> a owl:DatatypeProperty ;
    rdfs:label "work type" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/workType> ;
    rdfs:comment "Optional category inferred from the SOR discipline, e.g. 'Civil', 'Electrical', 'MEP'. Domain unspecified.",
        "The work-type bucket a norm applies to, matching the P2B phase vocabulary." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#workerHasCertification> a owl:ObjectProperty ;
    rdfs:label "worker Has Certification"@en ;
    dcterms:created "2026-10-19"^^xsd:date ;
    dcterms:description "Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of the connected source classes; not a claim that the retained runtime already writes this predicate."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    rdfs:comment "A skill certification held by the worker."@en ;
    rdfs:domain <https://w3id.org/IproK/resource#Worker> ;
    rdfs:isDefinedBy <https://w3id.org/IproK/0.2.0> ;
    rdfs:range <https://w3id.org/IproK/resource#SkillCertification> .

<https://w3id.org/IproK/integrated#workerPerformsActivity> a owl:ObjectProperty ;
    rdfs:label "worker Performs Activity"@en ;
    dcterms:created "2026-10-19"^^xsd:date ;
    dcterms:description "Newly proposed IproK integration relationship. Authored schema design based on the declared meanings of Worker and Activity; not a claim that the retained runtime already writes this predicate."@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    rdfs:comment "The scheduled activity to which the worker is assigned to perform site work."@en ;
    rdfs:domain <https://w3id.org/IproK/resource#Worker> ;
    rdfs:isDefinedBy <https://w3id.org/IproK/0.2.0> ;
