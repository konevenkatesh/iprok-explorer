<https://w3id.org/IproK/integrated#selectedOffer> a owl:ObjectProperty ;
    rdfs:label "selected Offer"@en ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/selectedOffer> ;
    rdfs:comment "The <https://w3id.org/IproK/procurement#ProductOffer> a project picked for a <https://w3id.org/IproK/billing#BOQItem> — written with a ProcurementDecision PROV activity; optionally re-rates the BOQ line (5D impact)." .

<https://w3id.org/IproK/integrated#signatureCertificate> a owl:DatatypeProperty ;
    rdfs:label "signature certificate" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/signatureCertificate> ;
    rdfs:comment "Optional PEM/base64 certificate provided by the signature provider." ;
    rdfs:range xsd:string .

<https://w3id.org/IproK/integrated#slaBreached> a owl:DatatypeProperty ;
    rdfs:label "SLA breached" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/slaBreached> ;
    rdfs:comment "Computed boolean — true when dueDate < now and state not in {Answered, Closed, Cancelled}. Set by the daily rfi_sla Celery task and on the Answered transition. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:boolean .

<https://w3id.org/IproK/integrated#snagLocation> a owl:DatatypeProperty ;
