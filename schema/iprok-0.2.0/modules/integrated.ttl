    rdfs:comment "The actor assigned responsibility for the activity."@en ;
    rdfs:domain <https://w3id.org/IproK/schedule#Activity> ;
    rdfs:isDefinedBy <https://w3id.org/IproK/0.2.0> ;
    rdfs:range <https://w3id.org/IproK#Actor> .

