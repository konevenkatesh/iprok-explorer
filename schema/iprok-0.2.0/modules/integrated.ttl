<https://w3id.org/IproK/integrated#provisional> a owl:DatatypeProperty ;
    rdfs:label "provisional" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/provisional> ;
    rdfs:comment "Boolean — true for an AI-suggested markup awaiting a human Accept (the Review-with-AI flow). Cleared (or the node deleted) on Accept/Dismiss. Polymorphic; domain unspecified (antipattern #8)." ;
    rdfs:range xsd:boolean .

<https://w3id.org/IproK/integrated#queryDescription> a owl:DatatypeProperty ;
