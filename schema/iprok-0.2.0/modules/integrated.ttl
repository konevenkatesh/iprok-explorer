<https://w3id.org/IproK/integrated#approvalRequired> a owl:DatatypeProperty ;
    rdfs:label "approval required" ;
    dcterms:isPartOf <https://w3id.org/IproK/integrated> ;
    dcterms:source <https://bimsaarthi.com/ontology/v0/approvalRequired> ;
    rdfs:comment "Approval level required by PWD norms: EE (≤₹5L) | SE (≤₹25L) | CE (>₹25L). Domain unspecified." ;
