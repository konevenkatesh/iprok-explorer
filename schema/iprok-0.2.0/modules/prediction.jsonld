[
  {
    "@id": "https://w3id.org/iprok/prediction#modelVersion",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "https://w3id.org/iprok/prediction"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://bimsaarthi.com/ontology/v0/modelVersion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Model identifier like 'gat-v1'. Lets the UI flag stale predictions when the model is retrained."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "model version"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/iprok/prediction#ActivityPrediction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "https://w3id.org/iprok/prediction"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://bimsaarthi.com/ontology/v0/ActivityPrediction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A versioned record describing an activity-level prediction and its input, model and baseline provenance."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Activity prediction (GAT-derived)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/iprok/prediction#predictedAt",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record."
      }
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "https://w3id.org/iprok/prediction"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://bimsaarthi.com/ontology/v0/predictedAt"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The predicted at property in the integrated project information model."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "predicted at"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTime"
      }
    ]
  },
  {
    "@id": "https://w3id.org/iprok/prediction#confidenceScore",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "https://w3id.org/iprok/prediction"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://bimsaarthi.com/ontology/v0/confidenceScore"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Model's self-reported confidence in this prediction (1 − attention entropy, normalised)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "model confidence (0–1)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/iprok/prediction#costOverrunRisk",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "https://w3id.org/iprok/prediction"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://bimsaarthi.com/ontology/v0/costOverrunRisk"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Probability the activity's BOQ-linked cost will overrun by >10%. Sigmoid output of the GAT cost head."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "cost overrun risk (0–1)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/iprok/prediction#predictedFloatChange",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "https://w3id.org/iprok/prediction"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://bimsaarthi.com/ontology/v0/predictedFloatChange"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "tanh-bounded change in totalFloat. Negative = float will shrink. Range [-30, +30]."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "predicted float change (days)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/iprok/prediction#delayRisk",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "https://w3id.org/iprok/prediction"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://bimsaarthi.com/ontology/v0/delayRisk"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Probability the activity will be delayed by more than 7 days. Sigmoid output of the GAT delay head."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "delay risk (0–1)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  }
]