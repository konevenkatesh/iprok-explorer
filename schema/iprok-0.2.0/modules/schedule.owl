    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#TaskDependency"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#projectOwner">
    <rdfs:comment xml:lang="en">The project owner property in the integrated project information model. Its declared domain is Project and its declared range is string.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Project"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">projectOwner</rdfs:label>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#activityId">
    <rdfs:label>activity id</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:comment>Source-schedule unique id (P6 task_code / MSP UID / sheet key). Stable across re-imports so revisions supersede rather than duplicate.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/activityId"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#wbsPlannedCost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:label>WBS planned cost (rollup)</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>Rollup: sum of governed &lt;https://w3id.org/iprok/billing#BOQItem&gt; amounts at a work package, rolled up the tree to the root. In Slice 1 this is COMPUTED ON READ in list_wbs_nodes (never persisted) — always-correct and it sidesteps a Fuseki/TDB2 quirk deleting xsd:decimal triples. The property + optional SHACL stanza are reserved for a future slice that may persist a snapshot.</rdfs:comment>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/wbsPlannedCost"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#baselineCost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The activity's budget when frozen, in rupees. No rdfs:domain.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:label xml:lang="en">baseline Cost</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/baselineCost"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#estimateId">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/estimateId"/>
    <rdfs:label xml:lang="en">estimate Id</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:comment>Human-facing id, DE-&lt;activity id&gt;. Polymorphic — no rdfs:domain (antipattern #8).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#eotClause">
    <rdfs:label xml:lang="en">eot Clause</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/eotClause"/>
    <rdfs:comment>The Clause 5 sub-clause an extension of time was granted under: 5.2 (beyond the contractor's control) or 5.3 (hindrance by the department). No rdfs:domain.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#finalDays">
    <rdfs:label xml:lang="en">final Days</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/finalDays"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment>Planned duration after allowances. No rdfs:domain.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#estimatedAt">
    <rdfs:comment>When the estimate was made. No rdfs:domain.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:label xml:lang="en">estimated At</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/estimatedAt"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#bac">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>Total contract budget = sum of every BOQItem (tenderedQty × quotedRate). INR. Mandatory on &lt;https://w3id.org/iprok/schedule#EVMSnapshot&gt;.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:label>Budget at Completion (BAC)</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/bac"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#approvedBy">
    <rdfs:comment>IRI of the user who approved or rejected the deviation. Domain unspecified.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/approvedBy"/>
    <rdfs:label>approved by</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#baselineFinishDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:comment>The baseline's last planned day — its completion date. No rdfs:domain.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:label xml:lang="en">baseline Finish Date</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/baselineFinishDate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#baselineReason">
    <rdfs:comment>Why the programme was revised. No rdfs:domain.</rdfs:comment>
    <rdfs:label xml:lang="en">baseline Reason</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/baselineReason"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#boqShareOf">
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/boqShareOf"/>
    <rdfs:label xml:lang="en">boq Share Of</rdfs:label>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>The BOQ line this activity delivers a share of. EVM does NOT sum the line's amount through this link — the activity's own &lt;https://w3id.org/iprok/schedule#budgetedCost&gt; is its budget. No rdfs:domain / rdfs:range (antipattern #8).</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
