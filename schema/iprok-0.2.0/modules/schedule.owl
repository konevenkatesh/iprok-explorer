    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The actual duration property in the integrated project information model. Its declared domain is TaskTime and its declared range is decimal.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#TaskTime"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#etc">
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/etc"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label>Estimate to Complete</rdfs:label>
    <rdfs:comment>EAC − AC, the remaining cost forecast. INR. Mandatory on &lt;https://w3id.org/iprok/schedule#EVMSnapshot&gt;.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#WorkPackage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/iprok#IproKThing"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:comment xml:lang="en">A grouping of project work represented in the work breakdown structure.</rdfs:comment>
    <rdfs:label>WorkPackage</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#extensionDays">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/extensionDays"/>
    <rdfs:label xml:lang="en">extension Days</rdfs:label>
    <rdfs:comment>Days of extension granted. No rdfs:domain.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#lagTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:comment xml:lang="en">The lag time property in the integrated project information model. Its declared domain is TaskDependency and its declared range is decimal.</rdfs:comment>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:label xml:lang="en">lagTime</rdfs:label>
