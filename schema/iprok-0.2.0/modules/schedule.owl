    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:comment>The activity's id when frozen. No rdfs:domain.</rdfs:comment>
    <rdfs:label xml:lang="en">baseline Activity Id</rdfs:label>
  </rdf:Description>
