    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">The link lag property in the integrated project information model.</rdfs:comment>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/linkLag"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#approvedAt">
    <rdfs:comment>Timestamp when the deviation was approved or rejected. Domain unspecified.</rdfs:comment>
    <rdfs:label>approved at</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/approvedAt"/>
