    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#spi">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <rdfs:label>Schedule Performance Index</rdfs:label>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/spi"/>
    <rdfs:comment>EV / PV. &gt;1.0 ahead of schedule, &lt;1.0 behind. Optional — undefined (omitted) when PV=0.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#plannedStartDate">
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#TaskTime"/>
