    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment xml:lang="en">The planned start date property in the integrated project information model. Its declared domain is TaskTime and its declared range is dateTime.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#plannedQuantity">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:comment>The quantity the activity is planned to deliver, in &lt;https://w3id.org/iprok/integrated#unit&gt;. Distinct from &lt;https://w3id.org/iprok/billing#quantity&gt; (a measurement). No rdfs:domain.</rdfs:comment>
    <rdfs:label xml:lang="en">planned Quantity</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/plannedQuantity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#ac">
    <rdfs:comment>Sum of approved/finalised RA Bill netPayable by statusDate. INR. Mandatory on &lt;https://w3id.org/iprok/schedule#EVMSnapshot&gt;. Domain unspecified.</rdfs:comment>
    <dcterms:isPartOf rdf:resource="https://w3id.org/iprok/schedule"/>
    <dcterms:source rdf:resource="https://bimsaarthi.com/ontology/v0/ac"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
