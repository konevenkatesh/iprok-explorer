  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#hasConstraint">
    <rdfs:comment xml:lang="en">The has constraint property in the integrated project information model. Its declared domain is Task and its declared range is Constraint.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:label>hasConstraint</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/iprok#Constraint"/>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Task"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#projectCategory">
    <rdfs:label xml:lang="en">projectCategory</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">The project category property in the integrated project information model. Its declared domain is Project and its declared range is string.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dcterms:description xml:lang="en">Editorial definition added for proposed IproK 0.2.0; inspect the retained source and mapping record.</dcterms:description>
    <rdfs:domain rdf:resource="https://w3id.org/iprok/schedule#Project"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/iprok/schedule#actualDuration">
