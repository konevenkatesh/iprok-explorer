  {
    "@id": "https://w3id.org/iprok/building#ElementCopiesRecorded",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "https://w3id.org/iprok/building"
      }
    ],
