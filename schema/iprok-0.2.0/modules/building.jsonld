      {
        "@id": "https://bimsaarthi.com/ontology/v0/Element"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "One parseable IFC entity (wall / column / beam / slab / door / MEP fixture) extracted from an uploaded IFC model and persisted as triples for cross-domain joins. The single most important predicate is <https://w3id.org/iprok/building#ifcGuid>; every Issue / Annotation / future cost+schedule attribution that already carries an ifcGuid lights up automatically."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "IFC Element"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/iprok/building#elementsRetired",
