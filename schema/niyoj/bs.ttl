@prefix bs:    <https://bimsaarthi.com/ontology/v0/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix time:  <http://www.w3.org/2006/time#> .
@prefix geo:   <http://www.opengis.net/ont/geosparql#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# =========================================================
# BIMSaarthi BS Ontology v0.1 (M1 subset)
# Slice V0.02 — Sprint 1 Wk 1.
# Mirror of github.com/bimsaarthi/bs-ontology (CC-BY 4.0).
# =========================================================

<https://bimsaarthi.com/ontology/v0> a owl:Ontology ;
    dct:title "BIMSaarthi BS Ontology v0.1 (M1 subset)" ;
    dct:description "M1 subset for v0 — covers Project, Activity, DPREntry, Photo, User. Full ontology in v1." ;
    dct:creator "Venkatesh Kone, BIMSaarthi Technologies" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "0.1.0" ;
    owl:imports <http://www.w3.org/ns/prov> ,
                <http://www.w3.org/2006/time> ,
                <http://www.opengis.net/ont/geosparql> .

# ---------- Classes ----------

bs:Project a owl:Class ;
    rdfs:label "Project" ;
    rdfs:comment "A construction project. Each project lives in its own named graph." .

# V0.22 — Project membership.
#
# Membership is modelled as a separate node so we can carry joined-at
# timestamps and (later) per-project role overrides without polluting the
# Project entity with a stack of properties. The membership URI is
# deterministic from project + user, so re-invites collapse to the
# existing record idempotently.
bs:ProjectMembership a owl:Class ;
    rdfs:label "Project membership" ;
    rdfs:comment "An (project, user) edge with a joinedAt timestamp." .

bs:Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:comment "A schedule activity. In v0, manually entered; in v1 ingested from P6." .

bs:DPREntry a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Daily Progress Report Entry" ;
    rdfs:comment "A single field-reported progress entry against an Activity." .

bs:Photo a owl:Class ;
    rdfs:label "Photo" ;
    rdfs:comment "A geo-tagged site photo, stored in MinIO and linked to the entity it documents." .

bs:User a owl:Class ;
    rdfs:subClassOf prov:Agent ;
    rdfs:label "User" ;
    rdfs:comment "A platform user — site engineer, QC, PM, etc." .

# ---------- Properties ----------

bs:partOfProject a owl:ObjectProperty ;
    rdfs:label "part of project" ;
    rdfs:domain bs:Activity ;
    rdfs:range bs:Project .

bs:reportedAgainst a owl:ObjectProperty ;
    rdfs:label "reported against" ;
    rdfs:domain bs:DPREntry ;
    rdfs:range bs:Activity .

bs:reportedQuantity a owl:DatatypeProperty ;
    rdfs:label "reported quantity" ;
    rdfs:domain bs:DPREntry ;
    rdfs:range xsd:decimal .

bs:unit a owl:DatatypeProperty ;
    rdfs:label "unit" ;
    rdfs:range xsd:string .

bs:reportedAt a owl:DatatypeProperty ;
    rdfs:label "reported at" ;
    rdfs:comment "Timestamp at which an entity (DPREntry, Photo, etc.) was reported. Domain widened in V0.14 from bs:DPREntry only." ;
    rdfs:range xsd:dateTime .

bs:locationWkt a owl:DatatypeProperty ;
    rdfs:label "location (WKT)" ;
    rdfs:comment "Inline WKT POINT(lng lat) literal. Used on DPREntry and Photo." ;
    rdfs:range xsd:string .

bs:hasPhoto a owl:ObjectProperty ;
    rdfs:label "has photo" ;
    rdfs:range bs:Photo .

bs:photoUri a owl:DatatypeProperty ;
    rdfs:label "photo URI" ;
    rdfs:domain bs:Photo ;
    rdfs:range xsd:anyURI .

bs:atLocation a owl:ObjectProperty ;
    rdfs:label "at location" ;
    rdfs:range geo:Geometry .

bs:phoneNumber a owl:DatatypeProperty ;
    rdfs:label "phone number" ;
    rdfs:domain bs:User ;
    rdfs:range xsd:string .

bs:userRole a owl:DatatypeProperty ;
    rdfs:label "user role" ;
    rdfs:domain bs:User ;
    rdfs:range xsd:string .

# V0.15 — client-supplied idempotency key. The mobile offline queue stamps
# every queued submission (DPR or Photo) with a UUID v4 before its first
# send attempt; server-side, repeated client_ids return the existing entity
# instead of creating a duplicate. Optional but unique-per-graph when present.
bs:clientId a owl:DatatypeProperty ;
    rdfs:label "client id (idempotency key)" ;
    rdfs:comment "UUID assigned by the submitting client. Server treats repeated values within the same project graph as the same submission." ;
    rdfs:range xsd:string .

# =========================================================
# V0.17 — Quality inspection checklist
# =========================================================
#
# Modelled around three classes:
#   bs:Inspection      a checklist run against one bs:Activity
#   bs:ChecklistItem   one row of the checklist (linked from Inspection
#                      via bs:hasItem). v0 ships an 8-item IS 456 concrete
#                      pour template hardcoded on mobile; the checklist
#                      library lands in a later slice.
#   bs:NCR             non-conformance report. Auto-created for every
#                      failed item; closure workflow is V0.19.
#
# Why one node per item rather than a JSON literal: makes SHACL enforce
# "failed item must carry failureNote", and lets V0.18 NCR analytics SPARQL
# the failures directly without parsing JSON literals.

bs:Inspection a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Inspection" ;
    rdfs:comment "A quality-checklist run against a single bs:Activity." .

bs:ChecklistItem a owl:Class ;
    rdfs:label "Checklist item" ;
    rdfs:comment "One row of an inspection checklist with a pass/fail outcome and an optional failure note." .

bs:NCR a owl:Class ;
    rdfs:label "Non-Conformance Report" ;
    rdfs:comment "Raised automatically when a checklist item fails. Status starts Open; closure flow added in V0.19." .

# V0.19 — NCR status state machine.
#
# In V0.17 NCRs carried `bs:ncrStatus "Open"^^xsd:string` (literal). V0.19
# normalises status to an IRI pointing at one of four `bs:NCRStatus`
# individuals via the new `bs:status` object property. `bs:ncrStatus` is
# kept declared for V0.17 read-back only; new writes use `bs:status`.
# An idempotent SPARQL migration (services/api → migrations/v019_ncr_status.py)
# converts existing literal values to the IRI form on API startup.
bs:NCRStatus a owl:Class ;
    rdfs:label "NCR Status" ;
    rdfs:comment "Enum of possible NCR lifecycle states." .

bs:Open         a bs:NCRStatus ; rdfs:label "Open" .
bs:UnderReview  a bs:NCRStatus ; rdfs:label "Under review" .
bs:Closed       a bs:NCRStatus ; rdfs:label "Closed" .
bs:Rejected     a bs:NCRStatus ; rdfs:label "Rejected" .

bs:status a owl:ObjectProperty ;
    rdfs:label "status" ;
    rdfs:comment "Polymorphic lifecycle status. Domain intentionally left unspecified — adding `rdfs:domain bs:NCR` would mark every node carrying bs:status as an NCR (the same RDFS-domain trap that bit V0.17's bs:failureNote, see CLAUDE.md antipattern #8). v0 uses bs:status only on bs:NCR; SHACL constrains it via NCRShape." ;
    rdfs:range bs:NCRStatus .

bs:closedBy a owl:ObjectProperty ;
    rdfs:label "closed by" ;
    rdfs:domain bs:NCR ;
    rdfs:range bs:User .

bs:closedAt a owl:DatatypeProperty ;
    rdfs:label "closed at" ;
    rdfs:domain bs:NCR ;
    rdfs:range xsd:dateTime .

bs:closureNote a owl:DatatypeProperty ;
    rdfs:label "closure note" ;
    # Polymorphic — closes an NCR (V0.19), overrides a clash closure (S4.8)
    # and records why a constraint was withdrawn (N36). No rdfs:domain:
    # antipattern #8 (a domain of bs:NCR made every clash and constraint
    # carrying a note an NCR under RDFS inference).
    rdfs:range xsd:string .

bs:closurePhoto a owl:DatatypeProperty ;
    rdfs:label "closure photo URI" ;
    rdfs:comment "s3:// URI of the evidence photo uploaded with the closure (optional)." ;
    rdfs:domain bs:NCR ;
    rdfs:range xsd:anyURI .

# ---- Inspection properties ----

bs:inspectedActivity a owl:ObjectProperty ;
    rdfs:label "inspected activity" ;
    rdfs:domain bs:Inspection ;
    rdfs:range bs:Activity .

bs:inspectedAt a owl:DatatypeProperty ;
    rdfs:label "inspected at" ;
    rdfs:domain bs:Inspection ;
    rdfs:range xsd:dateTime .

bs:overallResult a owl:DatatypeProperty ;
    rdfs:label "overall result" ;
    rdfs:domain bs:Inspection ;
    rdfs:comment "Either 'pass' (every item passed) or 'fail' (at least one item failed)." ;
    rdfs:range xsd:string .

bs:hasItem a owl:ObjectProperty ;
    rdfs:label "has item" ;
    rdfs:domain bs:Inspection ;
    rdfs:range bs:ChecklistItem .

bs:checklistTemplate a owl:DatatypeProperty ;
    rdfs:label "checklist template id" ;
    rdfs:comment "Reference to the checklist library template this inspection used (e.g. 'IS-456-concrete-pour-v0'). Hardcoded in v0; resolves to a real catalogue node in a later slice." ;
    rdfs:range xsd:string .

# V0.27 — inspection category. Splits the V0.17 inspection flow into
# two parallel surfaces: 'quality' (IS-456 concrete pour, etc.) and
# 'safety' (IS 7969 site safety, MoRTH highway-zone safety, IS 7969
# confined-space). Domain intentionally left unspecified — same
# antipattern-#8 caveat as bs:zone / bs:failureNote: a node carrying
# bs:inspectionCategory should NOT be RDFS-inferred to be a member of
# bs:Inspection just from holding the property.
bs:inspectionCategory a owl:DatatypeProperty ;
    rdfs:label "inspection category" ;
    rdfs:comment "Either 'quality' (IS-456 concrete pour, IS-1786 reinforcement, etc.) or 'safety' (IS 7969 site / MoRTH highway / confined-space). Mandatory on every bs:Inspection from V0.27 onwards. Pre-V0.27 inspections default to 'quality' on read." ;
    rdfs:range xsd:string .

# ---- ChecklistItem properties ----

bs:itemCode a owl:DatatypeProperty ;
    rdfs:label "item code" ;
    rdfs:comment "Stable identifier for a checklist row (V0.17 — e.g. 'IS-456-7.4.1') or for a BOQ line (V0.29 — e.g. 'B-01'). Domain intentionally left unspecified — adding `rdfs:domain bs:ChecklistItem` would make every BOQItem carrying bs:itemCode get RDFS-inferred as a ChecklistItem and trip ChecklistItemShape (antipattern #8)." ;
    rdfs:range xsd:string .

bs:itemDescription a owl:DatatypeProperty ;
    rdfs:label "item description" ;
    rdfs:domain bs:ChecklistItem ;
    rdfs:range xsd:string .

bs:itemResult a owl:DatatypeProperty ;
    rdfs:label "item result" ;
    rdfs:comment "Either 'pass' or 'fail'." ;
    rdfs:domain bs:ChecklistItem ;
    rdfs:range xsd:string .

bs:failureNote a owl:DatatypeProperty ;
    rdfs:label "failure note" ;
    rdfs:comment "Free-text explanation of a quality failure. Used on both bs:ChecklistItem (where SHACL requires it iff itemResult='fail') and bs:NCR (where it's copied from the failed item). Domain intentionally left unspecified — adding `rdfs:domain bs:ChecklistItem` would make every NCR get RDFS-inferred as a ChecklistItem and trip ChecklistItemShape." ;
    rdfs:range xsd:string .

# ---- NCR properties ----

bs:relatedInspection a owl:ObjectProperty ;
    rdfs:label "related inspection" ;
    rdfs:domain bs:NCR ;
    rdfs:range bs:Inspection .

bs:relatedActivity a owl:ObjectProperty ;
    rdfs:label "related activity" ;
    rdfs:domain bs:NCR ;
    rdfs:range bs:Activity .

bs:relatedItem a owl:ObjectProperty ;
    rdfs:label "related checklist item" ;
    rdfs:domain bs:NCR ;
    rdfs:range bs:ChecklistItem .

bs:ncrStatus a owl:DatatypeProperty ;
    rdfs:label "NCR status" ;
    rdfs:comment "'Open' or 'Closed'. v0 only writes 'Open'; closure flow is V0.19." ;
    rdfs:domain bs:NCR ;
    rdfs:range xsd:string .

bs:raisedAt a owl:DatatypeProperty ;
    rdfs:label "raised at" ;
    # Polymorphic — used by bs:NCR (V0.17) and bs:SnagItem (N8).
    # No rdfs:domain: antipattern #8.
    rdfs:range xsd:dateTime .

# V0.22 — Project planning + membership properties.

bs:plannedStart a owl:DatatypeProperty ;
    rdfs:label "planned start date" ;
    rdfs:domain bs:Project ;
    rdfs:range xsd:date .

bs:plannedEnd a owl:DatatypeProperty ;
    rdfs:label "planned end date" ;
    rdfs:domain bs:Project ;
    rdfs:range xsd:date .

bs:hasMember a owl:ObjectProperty ;
    rdfs:label "has member" ;
    rdfs:domain bs:Project ;
    rdfs:range bs:ProjectMembership .

bs:ofUser a owl:ObjectProperty ;
    rdfs:label "of user" ;
    rdfs:domain bs:ProjectMembership ;
    rdfs:range bs:User .

bs:joinedAt a owl:DatatypeProperty ;
    rdfs:label "joined at" ;
    rdfs:domain bs:ProjectMembership ;
    rdfs:range xsd:dateTime .

# V0.23 — Zones (project-level config + per-DPR inferred label).
#
# A project optionally carries a JSON-array literal `bs:zoneConfig` listing
# named circular zones (lat/lng centre + metres radius). On every DPR
# submit the API runs a haversine match against that config and stamps
# `bs:zone "<name>"` on the new triple set; entries with no GPS or no
# matching zone get `"Unassigned"`. Reverse-geocoding / polygons land in
# a later slice; this is the v0 floor.

bs:zone a owl:DatatypeProperty ;
    rdfs:label "zone" ;
    rdfs:comment "Inferred zone name. Written at DPR-submit time from project's bs:zoneConfig + GPS. Domain intentionally unspecified — V0.26 reuses the same property on bs:Incident, and an `rdfs:domain bs:DPREntry` declaration would make every incident-with-zone get RDFS-classified as a DPREntry (same trap as V0.17's bs:failureNote, see CLAUDE.md antipattern #8)." ;
    rdfs:range xsd:string .

bs:zoneConfig a owl:DatatypeProperty ;
    rdfs:label "zone config (JSON)" ;
    rdfs:comment "JSON array of {name, lat, lng, radius_m} dicts. v0 hack — gets a proper schema (and SHACL shape) when polygon zones land." ;
    rdfs:domain bs:Project ;
    rdfs:range xsd:string .

# =========================================================
# V0.26 — Safety incident logging.
# =========================================================
#
# Three-class shape:
#   bs:IncidentType  enum class with four named individuals
#                    (NearMiss / FirstAid / LostTimeInjury / Fatality)
#   bs:Incident      one site safety event; subClassOf prov:Activity so
#                    the V0.05 PROV-O wrapper attaches the standard
#                    attribution chain on every submit
#   alerts           NOT a class — V0.26 only logs structured ALERT lines
#                    to the API console for LTI/Fatality. Real WhatsApp
#                    delivery lands at V0.21 when that dependency is up.
#
# `bs:zone` (V0.23) is reused on incidents so the project home dashboard
# can roll up incident counts by zone in a later slice without schema
# churn. `bs:locationWkt` (V0.14, widened) carries the GPS fix.

bs:IncidentType a owl:Class ;
    rdfs:label "Incident type" ;
    rdfs:comment "Severity bucket for safety incidents. Four-level scale follows IS 14489 / DGMS site-safety classification." .

bs:NearMiss          a bs:IncidentType ; rdfs:label "Near miss" .
bs:FirstAid          a bs:IncidentType ; rdfs:label "First aid" .
bs:LostTimeInjury    a bs:IncidentType ; rdfs:label "Lost-time injury" .
bs:Fatality          a bs:IncidentType ; rdfs:label "Fatality" .

bs:Incident a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Safety incident" ;
    rdfs:comment "A site safety event. Logged by SE/QC/Safety/PM; LTI and Fatality additionally trigger the V0.21 WhatsApp escalation (stubbed as a console ALERT log in V0.26)." .

bs:incidentType a owl:ObjectProperty ;
    rdfs:label "incident type" ;
    rdfs:domain bs:Incident ;
    rdfs:range bs:IncidentType .

bs:incidentAt a owl:DatatypeProperty ;
    rdfs:label "incident at" ;
    rdfs:domain bs:Incident ;
    rdfs:range xsd:dateTime .

bs:personsInvolved a owl:DatatypeProperty ;
    rdfs:label "persons involved" ;
    rdfs:domain bs:Incident ;
    rdfs:range xsd:integer .

bs:immediateCause a owl:DatatypeProperty ;
    rdfs:label "immediate cause" ;
    rdfs:comment "Free-text first-pass cause. Root-cause analysis lives at V0.28." ;
    rdfs:domain bs:Incident ;
    rdfs:range xsd:string .

bs:linkedActivity a owl:ObjectProperty ;
    rdfs:label "linked activity" ;
    rdfs:domain bs:Incident ;
    rdfs:range bs:Activity .

# bs:reportedBy is left without an rdfs:domain so RDFS doesn't classify
# users as Incidents — same trap as V0.17's bs:failureNote (CLAUDE.md
# antipattern #8). The route layer enforces "Incident must have a
# reportedBy IRI" via SHACL.
bs:reportedBy a owl:ObjectProperty ;
    rdfs:label "reported by" ;
    rdfs:range bs:User .

# ====================================================================
# V0.28 — NCR recurrence detection
# ====================================================================
#
# A nightly Celery task groups failed bs:ChecklistItem rows by
# (linked activity, normalised failure note) and asserts a
# bs:RecurrenceAlert when the same defect surfaces >= 2 times across
# inspections. The PM dashboard surfaces open alerts so chronic
# defects (e.g. "low slump on column C-12") are visible without a
# spreadsheet sweep.
#
# bs:status is reused from V0.19's NCRStatus enum (bs:Open /
# bs:Acknowledged are the two valid values for an alert; we keep
# the existing class so we don't need a parallel taxonomy). The
# bs:Acknowledged individual is added below alongside the other
# four NCR statuses — that's the cleanest place since "Acknowledged"
# is conceptually a sibling of Open / UnderReview / Closed / Rejected.

bs:Acknowledged a bs:NCRStatus ; rdfs:label "Acknowledged" .

bs:RecurrenceAlert a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Recurrence alert" ;
    rdfs:comment "A repeated defect on the same activity, surfaced from grouping failed checklist items by (activity, normalised failure note). Status uses the bs:NCRStatus IRIs (bs:Open / bs:Acknowledged at V0.28; UnderReview/Closed/Rejected reserved for later)." .

bs:alertedActivity a owl:ObjectProperty ;
    rdfs:label "alerted activity" ;
    rdfs:domain bs:RecurrenceAlert ;
    rdfs:range bs:Activity .

bs:defectDescription a owl:DatatypeProperty ;
    rdfs:label "defect description" ;
    rdfs:comment "Lowercase-normalised, whitespace-collapsed copy of the repeated bs:failureNote. Normalisation lives in the Celery task and is the join key — keep it stable. Also reused by bs:DLPDefect (N8)." ;
    # Polymorphic — no rdfs:domain (antipattern #8).
    rdfs:range xsd:string .

bs:occurrenceCount a owl:DatatypeProperty ;
    rdfs:label "occurrence count" ;
    rdfs:domain bs:RecurrenceAlert ;
    rdfs:range xsd:integer .

bs:firstSeenAt a owl:DatatypeProperty ;
    rdfs:label "first seen at" ;
    rdfs:domain bs:RecurrenceAlert ;
    rdfs:range xsd:dateTime .

bs:lastSeenAt a owl:DatatypeProperty ;
    rdfs:label "last seen at" ;
    rdfs:domain bs:RecurrenceAlert ;
    rdfs:range xsd:dateTime .

bs:generatedAt a owl:DatatypeProperty ;
    rdfs:label "generated at" ;
    rdfs:comment "Timestamp the recurrence-detection task wrote (or last refreshed) this alert. Polymorphic — also reused by S6.2 bs:SiteIntelligence (auto-generated site-context report). Domain-free per antipattern #8 so RDFS inference doesn't cross-contaminate the two classes." ;
    rdfs:range xsd:dateTime .

# ====================================================================
# V0.29 — Measurement Book (light)
# ====================================================================
#
# Mobile MB entry against a per-project BOQ catalogue. The classes +
# properties are sized so M3's joint-signature flow (OTP dual-sign
# between contractor + departmental JE) layers on top without
# refactoring the data model. M3 will add bs:contractorSignedAt /
# bs:contractorSignedBy / bs:jeSignedAt / bs:jeSignedBy + a
# state-machine status; v0 lives in the un-signed default state.

bs:BOQItem a owl:Class ;
    rdfs:label "BOQ item" ;
    rdfs:comment "One line in the project's Bill of Quantities. Catalogue node — measurements reference it via bs:measuredItem." .

bs:Measurement a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Measurement" ;
    rdfs:comment "One MB entry: dimensions or direct quantity for one BOQ item, captured by a Site Engineer / QC. Joint OTP signature is M3 — V0.29 just records the measurement." .

# ---- BOQItem properties ----
#
# bs:itemCode is declared in the V0.17 block above (with no rdfs:domain
# so it can be reused on both bs:ChecklistItem and bs:BOQItem without
# tripping antipattern #8). Same for bs:unit (V0.09).

# bs:description is left without an rdfs:domain — it's reused on
# Measurement narrative if a slice ever needs it; same antipattern-#8
# caveat as bs:zone / bs:failureNote.
bs:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string .

# bs:unit is already used by DPREntry (V0.09) without a declared
# domain. Reuse — Measurement and BOQItem read the same predicate.
# (See V0.09 declaration above; do not re-declare here.)

bs:tenderedQty a owl:DatatypeProperty ;
    rdfs:label "tendered quantity" ;
    rdfs:comment "Quantity the BOQ line was awarded for. Polymorphic — used by BOQItem and Deviation; rdfs:domain unspecified (antipattern #8)." ;
    rdfs:range xsd:decimal .

bs:ofProject a owl:ObjectProperty ;
    rdfs:label "of project" ;
    rdfs:comment "Same naming convention as bs:ofUser on bs:ProjectMembership. Domain intentionally unspecified so M3 / M4 can reuse the predicate on other classes (e.g. bs:Drawing, bs:RABill) without retripping antipattern #8." ;
    rdfs:range bs:Project .

# ---- Measurement properties ----

bs:measuredItem a owl:ObjectProperty ;
    rdfs:label "measured item" ;
    rdfs:comment "Polymorphic — links either a bs:Measurement or bs:JointMeasurement to the bs:BOQItem it covers. Domain intentionally left unspecified (antipattern #8): declaring rdfs:domain bs:Measurement would cause RDFS inference to classify every bs:JointMeasurement that carries this predicate as also a bs:Measurement, tripping MeasurementShape." ;
    rdfs:range bs:BOQItem .

bs:length a owl:DatatypeProperty ;
    rdfs:label "length" ;
    rdfs:comment "Length in metres. Optional — direct-quantity entries skip the L×B×D fields." ;
    rdfs:domain bs:Measurement ;
    rdfs:range xsd:decimal .

bs:breadth a owl:DatatypeProperty ;
    rdfs:label "breadth" ;
    rdfs:domain bs:Measurement ;
    rdfs:range xsd:decimal .

bs:depth a owl:DatatypeProperty ;
    rdfs:label "depth" ;
    rdfs:domain bs:Measurement ;
    rdfs:range xsd:decimal .

bs:quantity a owl:DatatypeProperty ;
    rdfs:label "quantity" ;
    rdfs:comment "Final quantity for this measurement entry. If L+B+D were supplied, the server computes L×B×D and stores the result here — never the client-side calc. Direct-quantity entries store the user-entered value." ;
    rdfs:domain bs:Measurement ;
    rdfs:range xsd:decimal .

bs:locationRef a owl:DatatypeProperty ;
    rdfs:label "location reference" ;
    rdfs:comment "Free-text location label (e.g. 'Col C-12, Floor 2'). Distinct from bs:locationWkt (GPS) and bs:zone (auto-inferred from GPS)." ;
    rdfs:domain bs:Measurement ;
    rdfs:range xsd:string .

# bs:measuredBy is left without an rdfs:domain so RDFS doesn't
# classify Users as Measurements (same trap as bs:reportedBy).
bs:measuredBy a owl:ObjectProperty ;
    rdfs:label "measured by" ;
    rdfs:range bs:User .

bs:measuredAt a owl:DatatypeProperty ;
    rdfs:label "measured at" ;
    rdfs:domain bs:Measurement ;
    rdfs:range xsd:dateTime .

bs:measurementNo a owl:DatatypeProperty ;
    rdfs:label "measurement number" ;
    rdfs:comment "Sequential entry number within a single BOQ item (1, 2, 3, …). Auto-assigned server-side via SPARQL MAX(?n)+1; the mobile UI does not pick this." ;
    rdfs:domain bs:Measurement ;
    rdfs:range xsd:integer .

# ====================================================================
# V0.30 — Multi-tenant isolation: Organisation
# ====================================================================
#
# Up through V0.29 the platform was effectively single-tenant: one
# named graph per project, no organisation layer. V0.30 adds the
# Organisation as the multi-tenant boundary that V0.31's SPARQL
# firewall will enforce.
#
# Per-project named graphs change shape with V0.30:
#   - Pre-V0.30 (legacy):  https://bimsaarthi.com/data/project/{id}
#   - V0.30+ (org-scoped): https://bimsaarthi.com/data/org/{oid}/project/{id}
# Both forms coexist — the Postgres `projects` mirror table records
# which form a project uses (`graph_uri` column). Existing seeded
# projects keep the legacy form and are reassigned to a default
# "bimsaarthi-dev" org via a startup data migration.

bs:Organisation a owl:Class ;
    rdfs:label "Organisation" ;
    rdfs:comment "A tenant. One organisation owns many bs:Project nodes. Per V0.30, every Project must declare its parent Organisation via bs:ofOrganisation; the API enforces same-org access on every project-scoped route." .

bs:orgName a owl:DatatypeProperty ;
    rdfs:label "organisation name" ;
    rdfs:domain bs:Organisation ;
    rdfs:range xsd:string .

bs:orgSlug a owl:DatatypeProperty ;
    rdfs:label "organisation slug" ;
    rdfs:comment "URL-safe short identifier; unique across the platform." ;
    rdfs:domain bs:Organisation ;
    rdfs:range xsd:string .

bs:orgPlan a owl:DatatypeProperty ;
    rdfs:label "organisation plan" ;
    rdfs:comment "Subscription tier. One of pilot / project / enterprise / sovereign." ;
    rdfs:domain bs:Organisation ;
    rdfs:range xsd:string .

# bs:createdAt has no rdfs:domain — it's reused on Organisation,
# Project, BOQItem, etc. Same antipattern-#8 caveat.
bs:createdAt a owl:DatatypeProperty ;
    rdfs:label "created at" ;
    rdfs:range xsd:dateTime .

bs:ofOrganisation a owl:ObjectProperty ;
    rdfs:label "of organisation" ;
    rdfs:comment "Mandatory from V0.30 on every bs:Project. Same naming convention as bs:ofProject (V0.29) and bs:ofUser (V0.22). Domain intentionally unspecified so the predicate stays polymorphic — V0.31's SPARQL firewall will use it on user / project / drawing nodes alike." ;
    rdfs:range bs:Organisation .

# ====================================================================
# V0.37 — Pilot lifecycle: bs:PilotStatus on bs:Organisation
# ====================================================================
#
# First-paying-pilot provisioning. An Organisation moves through a
# four-state lifecycle. Modelled as an IRI enum (same shape as V0.19's
# bs:NCRStatus) rather than a string literal so PROV-O supersession
# can point bs:pilotStatus at a stable individual and the platform
# admin dashboard can filter on it without string parsing.
#
#   Invited   — org created, not yet onboarded (default at POST /orgs)
#   Active    — welcome flow fired, the pilot is live
#   Churned   — pilot ended without converting
#   Converted — pilot turned into a paying contract
#
# PATCH /orgs/{id}/status drives the transitions; Invited→Active
# triggers the welcome-pack flow. The org node itself (and its
# bs:pilotStatus triple) lives in the org catalogue graph
# https://bimsaarthi.com/data/org/{org_id} — V0.30 only mirrored
# orgs in Postgres; V0.37 is the first slice to assert the org node
# in Fuseki so OrgShape actually has something to validate.

bs:PilotStatus a owl:Class ;
    rdfs:label "Pilot Status" ;
    rdfs:comment "Enum of organisation pilot-lifecycle states." .

bs:Invited   a bs:PilotStatus ; rdfs:label "Invited" .
bs:Active    a bs:PilotStatus ; rdfs:label "Active" .
bs:Churned   a bs:PilotStatus ; rdfs:label "Churned" .
bs:Converted a bs:PilotStatus ; rdfs:label "Converted" .

bs:pilotStatus a owl:ObjectProperty ;
    rdfs:label "pilot status" ;
    rdfs:comment "An Organisation's pilot-lifecycle state. Domain intentionally unspecified (polymorphic-predicate discipline, antipattern #8) even though v0 uses it only on bs:Organisation; OrgShape constrains the allowed individuals." ;
    rdfs:range bs:PilotStatus .

# ====================================================================
# S1.1 — Schedule ingestion: bs:Activity scheduling properties
# ====================================================================
#
# Phase 1. The BS Ontology is the scheduling OS (see CLAUDE.md
# "Schedule Ingestion Architecture"). These properties mirror the
# IproK schedule vocabulary (Kone, NIT Karnataka — iprok:plannedStart
# Date / iprok:totalFloat / iprok:isCritical / iprok:hasPredecessor /
# iprok:percentComplete …) under the bs: namespace. We are NOT
# reinventing the schedule schema — bs: names track IproK 1:1.
#
# Domains are intentionally left unspecified on the shared scalar
# predicates (antipattern #8): bs:percentComplete is reused on
# bs:Measurement-style rollups, bs:wbsCode may appear on grouping
# nodes, etc. ActivityShape constrains what an Activity must carry.
# bs:ScheduleLink is a reified predecessor edge (P6 allows FS/SS/FF/SF
# with a lag) — a plain object property can't carry the type + lag.

bs:activityId a owl:DatatypeProperty ;
    rdfs:label "activity id" ;
    rdfs:comment "Source-schedule unique id (P6 task_code / MSP UID / sheet key). Stable across re-imports so revisions supersede rather than duplicate." ;
    rdfs:range xsd:string .

bs:activityName a owl:DatatypeProperty ;
    rdfs:label "activity name" ;
    rdfs:comment "Domain intentionally unspecified — antipattern #8. ActivityShape constrains format." ;
    rdfs:range xsd:string .

bs:wbsCode a owl:DatatypeProperty ;
    rdfs:label "WBS code" ;
    rdfs:range xsd:string .

# IproK-faithful names. NOT the V0.22 bs:plannedStart / bs:plannedEnd
# — those are rdfs:domain bs:Project + range xsd:date (project
# planning fields). Reusing them on a bs:Activity would (a) retrip
# antipattern #8 (RDFS infers the Activity is a Project, so
# ProjectShape's mandatory dct:title rejects every schedule row)
# and (b) clash on xsd:date vs xsd:dateTime. iprok:plannedStartDate
# is the lineage name; bs:plannedStartDate mirrors it 1:1, domain
# unspecified, xsd:dateTime.
bs:plannedStartDate a owl:DatatypeProperty ;
    rdfs:label "planned start (datetime)" ;
    rdfs:comment "Mirrors iprok:plannedStartDate. Domain unspecified (antipattern #8). Distinct from the V0.22 Project bs:plannedStart." ;
    rdfs:range xsd:dateTime .

bs:plannedFinishDate a owl:DatatypeProperty ;
    rdfs:label "planned finish (datetime)" ;
    rdfs:comment "Mirrors iprok:plannedFinishDate. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:dateTime .

bs:actualStart a owl:DatatypeProperty ;
    rdfs:label "actual start" ;
    rdfs:range xsd:dateTime .

bs:actualFinish a owl:DatatypeProperty ;
    rdfs:label "actual finish" ;
    rdfs:range xsd:dateTime .

bs:totalFloat a owl:DatatypeProperty ;
    rdfs:label "total float (days)" ;
    rdfs:comment "Mirrors iprok:totalFloat. Days; may be negative on a behind-schedule critical path." ;
    rdfs:range xsd:decimal .

bs:isCritical a owl:DatatypeProperty ;
    rdfs:label "is on the critical path" ;
    rdfs:range xsd:boolean .

# S4.1 CPM-computed properties — written back by CPMEngine after a
# forward + backward pass over the bs:Activity dependency graph.
# All mirror IproK doctoral-research names 1:1; all rdfs:domain-free
# (antipattern #8). totalFloat + isCritical were declared above for
# the S1.1 ingest path — S4.1 just starts WRITING them computationally.
# A future schedule import that carries these from the source file
# (e.g. P6 XER's TaskRsrc.float) will continue to land in the same
# slots; CPM recomputes overwrite via PROV-O supersession.

bs:freeFloat a owl:DatatypeProperty ;
    rdfs:label "free float (days)" ;
    rdfs:comment "Mirrors iprok:freeFloat. Slack available without delaying any successor. Always <= totalFloat." ;
    rdfs:range xsd:decimal .

bs:earlyStart a owl:DatatypeProperty ;
    rdfs:label "early start (CPM forward pass)" ;
    rdfs:comment "Earliest the activity can start given its predecessors. Domain-free (antipattern #8)." ;
    rdfs:range xsd:dateTime .

bs:earlyFinish a owl:DatatypeProperty ;
    rdfs:label "early finish (CPM forward pass)" ;
    rdfs:range xsd:dateTime .

bs:lateStart a owl:DatatypeProperty ;
    rdfs:label "late start (CPM backward pass)" ;
    rdfs:comment "Latest the activity can start without delaying the project end." ;
    rdfs:range xsd:dateTime .

bs:lateFinish a owl:DatatypeProperty ;
    rdfs:label "late finish (CPM backward pass)" ;
    rdfs:range xsd:dateTime .

bs:cpmComputedAt a owl:DatatypeProperty ;
    rdfs:label "CPM last computed at" ;
    rdfs:comment "Wall-clock time the CPM engine last wrote results onto this activity. PROV-O wasInvalidatedBy chains older values." ;
    rdfs:range xsd:dateTime .

bs:percentComplete a owl:DatatypeProperty ;
    rdfs:label "percent complete (0-100)" ;
    rdfs:range xsd:decimal .

bs:ScheduleLink a owl:Class ;
    rdfs:label "Schedule link" ;
    rdfs:comment "A reified predecessor edge: which activity precedes which, the P6 relationship type (FS/SS/FF/SF) and the lag in days." .

# Domain unspecified (antipattern #8). Range bs:ScheduleLink only
# types the object, which IS a ScheduleLink — harmless. The link
# structure is enforced by ScheduleLinkShape (sh:targetClass),
# not by rdfs:domain.
bs:hasPredecessor a owl:ObjectProperty ;
    rdfs:label "has predecessor" ;
    rdfs:range bs:ScheduleLink .

bs:linkSource a owl:DatatypeProperty ;
    rdfs:label "predecessor activity id" ;
    rdfs:range xsd:string .

bs:linkType a owl:DatatypeProperty ;
    rdfs:label "relationship type" ;
    rdfs:comment "One of FS / SS / FF / SF (P6 convention)." ;
    rdfs:range xsd:string .

bs:linkLag a owl:DatatypeProperty ;
    rdfs:label "lag (days)" ;
    rdfs:range xsd:decimal .

# Provenance of the import that produced an Activity revision.
bs:scheduleRevision a owl:DatatypeProperty ;
    rdfs:label "schedule revision id" ;
    rdfs:comment "UUID stamped on every bs:Activity written by one POST /schedule/ingest/{id}/confirm. Lets a re-import supersede the prior revision (PROV-O) and the UI list revision history." ;
    rdfs:range xsd:string .

bs:sourceFileName a owl:DatatypeProperty ;
    rdfs:label "source file name" ;
    rdfs:range xsd:string .

bs:sourceFileType a owl:DatatypeProperty ;
    rdfs:label "source file type" ;
    rdfs:comment "xerparser / msp_xml / excel / pdf — the input adapter, not a runtime data source." ;
    rdfs:range xsd:string .

# ---------- S2.1 — Drawing & document control (Phase 2 / Module 2) ----------
#
# bs:Document is the ISO-19650 information-container superclass; M2's
# RFI / markup / CDE slices hang off it. bs:Drawing is the only
# subclass in S2.1. subClassOf is safe under RDFS inference (no
# DocumentShape exists, so an inferred `a bs:Document` triggers no
# spurious shape) — unlike rdfs:domain on a shared predicate, which
# is antipattern #8.

bs:Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A controlled project document / drawing artefact (ISO 19650 information container)." .

bs:Drawing a owl:Class ;
    rdfs:subClassOf bs:Document ;
    rdfs:label "Drawing" ;
    rdfs:comment "A construction drawing (GA / Detail / Section / Elevation / Layout / Schematic). One node per (drawingId, revision); bs:supersedes links a new revision to the one it replaces (S2.1)." .

# ISO 19650 information-container lifecycle. Five individuals.
# Valid transitions (enforced in the API, see drawing_routes.py):
#   WIP -> Shared -> Published -> Archived
#   <any state> -> Superseded   (when a newer revision of the same
#                                drawingId is Published)
bs:DrawingState a owl:Class ;
    rdfs:label "Drawing state" ;
    rdfs:comment "ISO 19650 information-container lifecycle state. Transitions: WIP->Shared->Published->Archived; any->Superseded on a newer published revision. Modelled like bs:NCRStatus / bs:IncidentType." .

bs:WIP        a bs:DrawingState ; rdfs:label "Work in progress" .
bs:Shared     a bs:DrawingState ; rdfs:label "Shared" .
bs:Published  a bs:DrawingState ; rdfs:label "Published" .
bs:Archived   a bs:DrawingState ; rdfs:label "Archived" .
bs:Superseded a bs:DrawingState ; rdfs:label "Superseded" .

# Drawing properties. rdfs:domain intentionally left unspecified on
# ALL of them (antipattern #8): M2's RFI / markup / submittal slices
# will reuse fileRef / lifecycleState / uploadedAt / supersedes /
# thumbnailRef on other classes, and an rdfs:domain bs:Drawing would
# RDFS-misclassify those nodes. Range is safe to pin. SHACL
# DrawingShape carries the actual constraints. bs:ofProject is the
# existing polymorphic predicate (declared above) — reused, not
# re-declared.

bs:drawingId a owl:DatatypeProperty ;
    rdfs:label "drawing id" ;
    rdfs:comment "Project-unique sheet number, e.g. \"S-101\". Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:drawingTitle a owl:DatatypeProperty ;
    rdfs:label "drawing title" ;
    rdfs:range xsd:string .

bs:discipline a owl:DatatypeProperty ;
    rdfs:label "discipline" ;
    rdfs:comment "Structural / Architectural / MEP / Civil / Electrical / Plumbing." ;
    rdfs:range xsd:string .

bs:drawingType a owl:DatatypeProperty ;
    rdfs:label "drawing type" ;
    rdfs:comment "GA / Detail / Section / Elevation / Layout / Schematic." ;
    rdfs:range xsd:string .

bs:revision a owl:DatatypeProperty ;
    rdfs:label "revision" ;
    rdfs:comment "Revision tag, e.g. \"Rev A\", \"P1\", \"C3\". Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:lifecycleState a owl:ObjectProperty ;
    rdfs:label "lifecycle state" ;
    rdfs:comment "Points at one bs:DrawingState individual. Domain unspecified (antipattern #8); SHACL DrawingShape constrains the value via sh:in (sh:in ONLY, no sh:class — the API validates a node's turtle in isolation with no ontology import, per the V0.37 cross-graph-validation caveat)." ;
    rdfs:range bs:DrawingState .

bs:fileRef a owl:DatatypeProperty ;
    rdfs:label "file ref" ;
    rdfs:comment "Canonical s3:// URI of the stored original. Domain unspecified (antipattern #8 — M2 reuse)." ;
    rdfs:range xsd:anyURI .

bs:fileFormat a owl:DatatypeProperty ;
    rdfs:label "file format" ;
    rdfs:comment "PDF / IFC / DWG / DXF." ;
    rdfs:range xsd:string .

bs:pageCount a owl:DatatypeProperty ;
    rdfs:label "page count" ;
    rdfs:range xsd:integer .

bs:uploadedAt a owl:DatatypeProperty ;
    rdfs:label "uploaded at" ;
    rdfs:comment "Server commit timestamp. Domain unspecified (antipattern #8 — M2 reuse)." ;
    rdfs:range xsd:dateTime .

bs:thumbnailRef a owl:DatatypeProperty ;
    rdfs:label "thumbnail ref" ;
    rdfs:comment "Canonical s3:// URI of the server-generated first-page thumbnail (written by the drawing_thumbnails Celery task). Optional. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:anyURI .

bs:supersedes a owl:ObjectProperty ;
    rdfs:label "supersedes" ;
    rdfs:comment "Links a new revision to the prior bs:Drawing of the same drawingId it replaces. Domain unspecified (antipattern #8 — RFI/markup reuse later)." ;
    rdfs:range bs:Drawing .

# ---------- S2.2 — AI-assisted drawing review (Phase 2 / Module 2) ----------
#
# bs:DrawingChange is an AI-detected semantic diff between two
# revisions (compare_revisions Celery task, Gemini Vision). The
# title-block extraction + needs-review flags ride on the existing
# bs:Drawing node. All domains intentionally unspecified
# (antipattern #8) — only the range is pinned. SHACL DrawingChangeShape
# carries the constraints.

bs:DrawingChange a owl:Class ;
    rdfs:label "Drawing change" ;
    rdfs:comment "One AI-detected change between two drawing revisions (added / removed / modified element, dimension, annotation, or spec). Produced by the compare_revisions task; never hand-authored." .

bs:changeType a owl:DatatypeProperty ;
    rdfs:label "change type" ;
    rdfs:comment "Added / Removed / Modified. SHACL constrains via sh:in (string literal — same idiom as bs:linkType)." ;
    rdfs:range xsd:string .

bs:changeDescription a owl:DatatypeProperty ;
    rdfs:label "change description" ;
    rdfs:range xsd:string .

bs:locationHint a owl:DatatypeProperty ;
    rdfs:label "location hint" ;
    rdfs:comment "Optional free-text where-on-the-sheet hint from the vision model (e.g. \"grid C-4, near the stair core\")." ;
    rdfs:range xsd:string .

bs:detectedAt a owl:DatatypeProperty ;
    rdfs:label "detected at" ;
    rdfs:range xsd:dateTime .

bs:detectedBy a owl:DatatypeProperty ;
    rdfs:label "detected by" ;
    rdfs:comment "Model identifier, e.g. \"gemini-2.0-flash\". A literal, not an agent IRI — this is machine-detected, the PROV-O wrap still records the triggering user." ;
    rdfs:range xsd:string .

bs:inDrawing a owl:ObjectProperty ;
    rdfs:label "in drawing" ;
    rdfs:comment "The (new) bs:Drawing this change was detected on. Domain unspecified (antipattern #8)." ;
    rdfs:range bs:Drawing .

bs:comparedWith a owl:ObjectProperty ;
    rdfs:label "compared with" ;
    rdfs:comment "The prior bs:Drawing revision the new one was diffed against. Domain unspecified (antipattern #8)." ;
    rdfs:range bs:Drawing .

bs:titleBlockExtracted a owl:DatatypeProperty ;
    rdfs:label "title block extracted" ;
    rdfs:comment "Boolean on bs:Drawing — true once the extract_title_block task has run (success OR fail-soft no-op marks nothing; only a successful extraction sets it true). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:boolean .

bs:titleBlockJson a owl:DatatypeProperty ;
    rdfs:label "title block JSON" ;
    rdfs:comment "The raw AI extraction as a JSON string: {field: {value, confidence}} for drawing_number / drawing_title / revision / discipline / scale / drawn_by / checked_by / approved_by / date / project_name. The GET .../title-block endpoint returns this verbatim. Kept as one literal so the ontology stays lean (the spec mandates only titleBlockExtracted + needsReview as new predicates)." ;
    rdfs:range xsd:string .

bs:needsReview a owl:DatatypeProperty ;
    rdfs:label "needs review" ;
    rdfs:comment "Boolean — set true when any AI-extracted title-block field has confidence < 0.7, cleared when a user confirms the extraction. Polymorphic (any AI-written node can carry it); domain unspecified (antipattern #8)." ;
    rdfs:range xsd:boolean .

bs:titleBlockConfirmedBy a owl:ObjectProperty ;
    rdfs:label "title block confirmed by" ;
    rdfs:comment "The bs:User who confirmed the AI title-block extraction. Domain unspecified (antipattern #8)." ;
    rdfs:range prov:Agent .

bs:titleBlockConfirmedAt a owl:DatatypeProperty ;
    rdfs:label "title block confirmed at" ;
    rdfs:range xsd:dateTime .

# ---------- S2.3 — SVG markup engine (Phase 2 / Module 2) ----------
#
# Every on-canvas markup is one bs:Annotation in the project graph,
# queryable alongside schedule / NCRs / RFIs. AI "Review with AI"
# findings are the same class with bs:provisional true until a user
# accepts them. bs:RFI is forward-declared here (a bare class, no
# shape) so bs:linkedRFI's range is well-formed; S2.5 fleshes RFI
# out. All annotation predicates are rdfs:domain-free (antipattern
# #8 — colour / annotatedBy / annotatedAt / geometry / pageNumber
# are obvious M2 reuse candidates for RFI / submittal nodes).

# ---------- S2.5 — RFI workflow (Phase 2 / Module 2) ----------
#
# bs:RFI was forward-declared at S2.3; S2.5 fleshes it out fully.
# subClassOf bs:Document (ISO-19650 information container) AND
# prov:Entity (append-only state machine, like bs:Annotation /
# bs:RecurrenceAlert). Reuses the polymorphic bs:discipline (S2.1),
# bs:linkedActivity (V0.26), bs:ofProject — NOT re-declared
# (antipattern #8). All new predicates are rdfs:domain-free; range
# pinned. The 6-state machine is enforced in the API
# (rfi_routes.py); SHACL only constrains the value set + the
# Answered ⇒ answeredBy+rfiAnswer rule.

bs:RFI a owl:Class ;
    rdfs:subClassOf bs:Document, prov:Entity ;
    rdfs:label "RFI" ;
    rdfs:comment "Request For Information — the core Indian-EPC document workflow, modelled as a graph node with a 6-state machine and SLA tracking, linked to the drawing / markup / activity that raised it." .

bs:RFIState a owl:Class ;
    rdfs:label "RFI state" ;
    rdfs:comment "RFI lifecycle. Transitions (enforced in the API): Draft->Submitted (raiser); Submitted->UnderReview (assignee/PM); UnderReview->Answered (assignee); Answered->Closed (raiser confirms); Answered->UnderReview (raiser rejects); any->Cancelled (PM/Admin). Modelled like bs:DrawingState / bs:NCRStatus." .

bs:RFIDraft       a bs:RFIState ; rdfs:label "Draft" .
bs:RFISubmitted   a bs:RFIState ; rdfs:label "Submitted" .
bs:RFIUnderReview a bs:RFIState ; rdfs:label "Under review" .
bs:RFIAnswered    a bs:RFIState ; rdfs:label "Answered" .
bs:RFIClosed      a bs:RFIState ; rdfs:label "Closed" .
bs:RFICancelled   a bs:RFIState ; rdfs:label "Cancelled" .

bs:rfiId a owl:DatatypeProperty ;
    rdfs:label "RFI id" ;
    rdfs:comment "Project-unique, zero-padded, e.g. \"RFI-0042\". Sequential per project (SPARQL MAX+1, same proven pattern as V0.29 measurementNo — FusekiRepo is Fuseki-only per the Layering rule, so no Redis client in the SPARQL layer). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:rfiSubject a owl:DatatypeProperty ;
    rdfs:label "RFI subject" ;
    rdfs:range xsd:string .

bs:rfiBody a owl:DatatypeProperty ;
    rdfs:label "RFI body" ;
    rdfs:comment "The question being asked." ;
    rdfs:range xsd:string .

bs:priority a owl:DatatypeProperty ;
    rdfs:label "priority" ;
    rdfs:comment "Low / Medium / High / Critical. Domain unspecified (antipattern #8 — reused by submittals later)." ;
    rdfs:range xsd:string .

bs:dueDate a owl:DatatypeProperty ;
    rdfs:label "due date" ;
    rdfs:comment "Optional SLA target date. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:date .

bs:rfiState a owl:ObjectProperty ;
    rdfs:label "RFI state" ;
    rdfs:comment "Points at one bs:RFIState individual. SHACL constrains via sh:in (sh:in ONLY, no sh:class — the API validates a node's turtle in isolation, per the V0.37 cross-graph caveat). Domain unspecified (antipattern #8)." ;
    rdfs:range bs:RFIState .

bs:raisedBy a owl:ObjectProperty ;
    rdfs:label "raised by" ;
    rdfs:comment "The bs:User who raised the RFI. Domain unspecified (antipattern #8)." ;
    rdfs:range prov:Agent .

bs:assignedTo a owl:ObjectProperty ;
    rdfs:label "assigned to" ;
    rdfs:comment "The bs:User the RFI is routed to (discipline auto-routing). Domain unspecified (antipattern #8)." ;
    rdfs:range prov:Agent .

bs:answeredBy a owl:ObjectProperty ;
    rdfs:label "answered by" ;
    rdfs:comment "The bs:User who answered. Mandatory once state = RFIAnswered (RFIShape sh:or rule). Domain unspecified (antipattern #8)." ;
    rdfs:range prov:Agent .

bs:rfiAnswer a owl:DatatypeProperty ;
    rdfs:label "RFI answer" ;
    rdfs:comment "The answer text. Mandatory once state = RFIAnswered." ;
    rdfs:range xsd:string .

bs:answeredAt a owl:DatatypeProperty ;
    rdfs:label "answered at" ;
    rdfs:range xsd:dateTime .

bs:linkedDrawing a owl:ObjectProperty ;
    rdfs:label "linked drawing" ;
    rdfs:comment "Optional — the bs:Drawing this RFI is about. Domain unspecified (antipattern #8)." ;
    rdfs:range bs:Drawing .

bs:linkedAnnotation a owl:ObjectProperty ;
    rdfs:label "linked annotation" ;
    rdfs:comment "Optional — the bs:Annotation markup that raised this RFI (the cross-domain join markup→RFI). Domain unspecified (antipattern #8)." ;
    rdfs:range bs:Annotation .

bs:slaBreached a owl:DatatypeProperty ;
    rdfs:label "SLA breached" ;
    rdfs:comment "Computed boolean — true when dueDate < now and state not in {Answered, Closed, Cancelled}. Set by the daily rfi_sla Celery task and on the Answered transition. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:boolean .

bs:Annotation a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Annotation" ;
    rdfs:comment "One SVG markup on a drawing (revision cloud / callout / text / dimension / stamp). Append-only: a deleted markup is prov:invalidated, never removed. Modelled like bs:RecurrenceAlert (prov:Entity subclass)." .

bs:annotationType a owl:DatatypeProperty ;
    rdfs:label "annotation type" ;
    rdfs:comment "RevisionCloud / Callout / Text / Dimension / Stamp. SHACL constrains via sh:in (string literal, no sh:class)." ;
    rdfs:range xsd:string .

bs:annotationText a owl:DatatypeProperty ;
    rdfs:label "annotation text" ;
    rdfs:comment "Optional — the callout / text-box content." ;
    rdfs:range xsd:string .

bs:stampType a owl:DatatypeProperty ;
    rdfs:label "stamp type" ;
    rdfs:comment "Optional — APPROVED / FOR CONSTRUCTION / FOR REVIEW / SUPERSEDED / NOT FOR CONSTRUCTION (only on Stamp annotations)." ;
    rdfs:range xsd:string .

bs:pageNumber a owl:DatatypeProperty ;
    rdfs:label "page number" ;
    rdfs:comment "1-based PDF page the markup sits on. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:integer .

bs:geometry a owl:DatatypeProperty ;
    rdfs:label "geometry" ;
    rdfs:comment "SVG path data or a coordinate-JSON string. Page-normalised so it survives zoom. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:colour a owl:DatatypeProperty ;
    rdfs:label "colour" ;
    rdfs:comment "Hex stroke/fill colour, e.g. \"#1d4ed8\". Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:onDrawing a owl:ObjectProperty ;
    rdfs:label "on drawing" ;
    rdfs:comment "The bs:Drawing this annotation marks up. Domain unspecified (antipattern #8)." ;
    rdfs:range bs:Drawing .

bs:annotatedBy a owl:ObjectProperty ;
    rdfs:label "annotated by" ;
    rdfs:comment "The bs:User (or, for AI suggestions, the model agent IRI) that made the markup. Domain unspecified (antipattern #8)." ;
    rdfs:range prov:Agent .

bs:annotatedAt a owl:DatatypeProperty ;
    rdfs:label "annotated at" ;
    rdfs:range xsd:dateTime .

bs:resolvedAt a owl:DatatypeProperty ;
    rdfs:label "resolved at" ;
    rdfs:comment "Optional — when the markup was actioned/closed (e.g. linked RFI answered)." ;
    rdfs:range xsd:dateTime .

bs:linkedRFI a owl:ObjectProperty ;
    rdfs:label "linked RFI" ;
    rdfs:comment "Optional — the bs:RFI this markup spawned / references. Populated in S2.5. Domain unspecified (antipattern #8)." ;
    rdfs:range bs:RFI .

bs:linkedElement a owl:DatatypeProperty ;
    rdfs:label "linked element" ;
    rdfs:comment "Optional — an IFC GlobalId (GUID) the markup points at. The cross-domain join to the model." ;
    rdfs:range xsd:string .

bs:provisional a owl:DatatypeProperty ;
    rdfs:label "provisional" ;
    rdfs:comment "Boolean — true for an AI-suggested markup awaiting a human Accept (the Review-with-AI flow). Cleared (or the node deleted) on Accept/Dismiss. Polymorphic; domain unspecified (antipattern #8)." ;
    rdfs:range xsd:boolean .

# ---------- S2.6 — CDE / transmittals (Phase 2 / Module 2) ----------
#
# bs:Transmittal is the ISO-19650 issue record — modelled as a
# subClassOf prov:Activity so it lives inside the same PROV-O audit
# chain as every other write. Auto-created on every drawing state
# transition (Shared / Published / Superseded) AND manually
# constructible. Reuses bs:ofProject; all new predicates are
# rdfs:domain-free (antipattern #8 — issuedBy/issuedTo/purpose
# are obvious M3/M4 submittal reuse candidates).

bs:Transmittal a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Transmittal" ;
    rdfs:comment "ISO-19650 transmittal record. Auto-numbered T-NNNN, auto-PDF, append-only; one per drawing state transition + ad-hoc batches via POST /transmittals." .

bs:transmittalId a owl:DatatypeProperty ;
    rdfs:label "transmittal id" ;
    rdfs:comment "Project-unique zero-padded short id, e.g. \"T-0042\". SPARQL MAX+1 (V0.29 measurementNo posture, same as RFI-NNNN). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:transmittalDate a owl:DatatypeProperty ;
    rdfs:label "transmittal date" ;
    rdfs:range xsd:dateTime .

bs:issuedBy a owl:ObjectProperty ;
    rdfs:label "issued by" ;
    rdfs:comment "The bs:User who issued the transmittal. Domain unspecified (antipattern #8)." ;
    rdfs:range prov:Agent .

bs:issuedTo a owl:ObjectProperty ;
    rdfs:label "issued to" ;
    rdfs:comment "Repeatable — the bs:User(s) the transmittal is addressed to. SHACL requires sh:minCount 1. Domain unspecified (antipattern #8)." ;
    rdfs:range prov:Agent .

bs:purpose a owl:DatatypeProperty ;
    rdfs:label "purpose" ;
    rdfs:comment "ForConstruction / ForReview / ForApproval / ForInformation / AsBuilt / Superseded. SHACL constrains via sh:in (string literal, no sh:class — same idiom as DrawingChangeShape). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:transmittalNote a owl:DatatypeProperty ;
    rdfs:label "transmittal note" ;
    rdfs:range xsd:string .

bs:includesDrawings a owl:ObjectProperty ;
    rdfs:label "includes drawings" ;
    rdfs:comment "Repeatable. SHACL requires sh:minCount 1 — a transmittal with no drawings is meaningless. Domain unspecified (antipattern #8)." ;
    rdfs:range bs:Drawing .

bs:includesDocuments a owl:ObjectProperty ;
    rdfs:label "includes documents" ;
    rdfs:comment "Repeatable. Optional — non-drawing bs:Document references (specs, calc notes, etc.). Domain unspecified (antipattern #8)." ;
    rdfs:range bs:Document .

bs:transmittalPdfRef a owl:DatatypeProperty ;
    rdfs:label "transmittal PDF ref" ;
    rdfs:comment "Canonical s3:// URI of the auto-generated transmittal PDF (WeasyPrint + Jinja2, V0.36 split). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:anyURI .

# ---------- S2.7 — BCF 3.0 issues (Phase 2 / Module 2) ----------
#
# bs:Event is a thin superclass for issue-like nodes (parallel to
# bs:Document for transmittals). No shape — safe under RDFS
# inference. bs:Issue is the first subclass; future M2 slices may
# add Inspection-event variants etc. Reuses bs:linkedRFI (S2.3) /
# bs:linkedDrawing (S2.5) / bs:linkedActivity (V0.26) /
# bs:assignedTo (S2.5) / bs:dueDate (S2.5) / bs:resolvedAt (S2.3) /
# bs:ofProject — not re-declared (antipattern #8). All new
# predicates are rdfs:domain-free; range pinned.

bs:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "Superclass for issue-like nodes (BCF issues, future inspection events). No shape — concrete subclasses carry the constraints." .

bs:Issue a owl:Class ;
    rdfs:subClassOf bs:Event, prov:Entity ;
    rdfs:label "Issue" ;
    rdfs:comment "A BCF-imported clash / coordination / design / safety / construction issue, or a manually-raised graph-native one. Linked to an IFC element GUID + optionally to an RFI / Drawing / Activity — the cross-domain closure chain (Clash → RFI → Drawing → Activity) that no point solution can answer natively." .

bs:issueId a owl:DatatypeProperty ;
    rdfs:label "issue id" ;
    rdfs:comment "Project-unique short id. For BCF-imported topics this is the BCF topic GUID; for manually-raised ones it's an auto-generated short id. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:issueTitle a owl:DatatypeProperty ;
    rdfs:label "issue title" ;
    rdfs:range xsd:string .

bs:issueDescription a owl:DatatypeProperty ;
    rdfs:label "issue description" ;
    rdfs:range xsd:string .

bs:issueType a owl:DatatypeProperty ;
    rdfs:label "issue type" ;
    rdfs:comment "Clash / Coordination / Design / Construction / Safety / Other. SHACL constrains via sh:in (string literal, no sh:class — same idiom as DrawingChangeShape)." ;
    rdfs:range xsd:string .

bs:issuePriority a owl:DatatypeProperty ;
    rdfs:label "issue priority" ;
    rdfs:comment "Low / Normal / High / Critical. Kept separate from bs:priority (RFI semantics) to avoid cross-contamination of any future sh:in." ;
    rdfs:range xsd:string .

bs:issueStatus a owl:DatatypeProperty ;
    rdfs:label "issue status" ;
    rdfs:comment "Open / InProgress / Resolved / Closed / ReOpened / WontFix. SHACL constrains via sh:in (string literal, no sh:class)." ;
    rdfs:range xsd:string .

bs:ifcGuid a owl:DatatypeProperty ;
    rdfs:label "IFC GUID" ;
    rdfs:comment "IfcGloballyUniqueId of the element the issue is on. The single most important field for cross-domain joins (Clash on IFC element → Drawing → Activity)." ;
    rdfs:range xsd:string .

bs:viewpointSnapshot a owl:DatatypeProperty ;
    rdfs:label "viewpoint snapshot" ;
    rdfs:comment "Canonical s3:// URI of the BCF viewpoint screenshot stored in MinIO. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:anyURI .

bs:bcfGuid a owl:DatatypeProperty ;
    rdfs:label "BCF GUID" ;
    rdfs:comment "The original BCF topic GUID — used for idempotent round-trip import/export (same GUID → update, not duplicate)." ;
    rdfs:range xsd:string .

bs:createdAt a owl:DatatypeProperty ;
    rdfs:label "created at" ;
    rdfs:comment "Server commit timestamp on Issue / future Event subclasses. Polymorphic — domain unspecified (antipattern #8)." ;
    rdfs:range xsd:dateTime .

# ---------- S2.8 — IFC elements (Phase 2 / Module 2: 3D viewer) ----------
#
# bs:Element is the graph-native representation of one parseable IFC
# entity (IfcWall / IfcColumn / IfcBeam / IfcSlab / IfcDoor / ...).
# One bs:Element per IFC GlobalId per uploaded model revision —
# uploading a new revision of the same model writes a fresh set of
# elements tagged with the new modelRevision (PROV-O, append-only).
# The cross-domain join (Element → Issue / RFI / NCR / DPR / Annotation)
# runs off bs:ifcGuid, which is already declared above (S2.7), polymorphic
# and rdfs:domain-free (antipattern #8). bs:discipline + bs:ofProject
# are also reused — not re-declared.
#
# 3D-viewer ergonomics live in elements.json (MinIO sidecar) — the
# graph carries the identity + cross-link triples only.

bs:Element a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "IFC Element" ;
    rdfs:comment "One parseable IFC entity (wall / column / beam / slab / door / MEP fixture) extracted from an uploaded IFC model and persisted as triples for cross-domain joins. The single most important predicate is bs:ifcGuid — every Issue / Annotation / future cost+schedule attribution that already carries an ifcGuid lights up automatically." .

bs:elementType a owl:DatatypeProperty ;
    rdfs:label "element type" ;
    rdfs:comment "IFC class name verbatim, e.g. 'IfcWall', 'IfcColumn', 'IfcBeam', 'IfcSlab', 'IfcDoor'. Polymorphic — domain unspecified (antipattern #8) so other classes can carry it in future without RDFS contamination." ;
    rdfs:range xsd:string .

bs:elementName a owl:DatatypeProperty ;
    rdfs:label "element name" ;
    rdfs:comment "The IFC Name attribute (optional in IFC, may be empty). Free text — surfaced in the element tree + detail panel." ;
    rdfs:range xsd:string .

bs:spatialZone a owl:DatatypeProperty ;
    rdfs:label "spatial zone" ;
    rdfs:comment "Name of the containing IfcSpace / IfcBuildingStorey the element belongs to, copied verbatim from the IFC spatial hierarchy. Deliberately distinct from bs:zone (V0.23 GPS-haversine zone) — IFC storeys and site GPS zones are orthogonal." ;
    rdfs:range xsd:string .

bs:modelRevision a owl:DatatypeProperty ;
    rdfs:label "model revision" ;
    rdfs:comment "Project-unique identifier of the IFC upload that produced this element. Plain string — typically a short id minted server-side. Lets a later revision supersede prior elements without losing the audit chain (PROV-O carries the activity). Polymorphic — carried on bs:Element and bs:IfcModel." ;
    rdfs:range xsd:string .

bs:elementCount a owl:DatatypeProperty ;
    rdfs:label "element count" ;
    rdfs:comment "Number of bs:Element triples extracted from a model upload. Polymorphic — domain unspecified (antipattern #8)." ;
    rdfs:range xsd:integer .

# bs:IfcModel is a thin subclass of bs:Document — the upload metadata
# record. Element triples live separately (one bs:Element per IFC
# GlobalId) and reference the model via bs:modelRevision (string
# match). No SHACL shape: the route is the gatekeeper (mandatory
# fields are enforced at the POST handler), and bs:IfcModel inherits
# nothing else's constraints. Same posture as bs:Event from S2.7.
bs:IfcModel a owl:Class ;
    rdfs:subClassOf bs:Document ;
    rdfs:label "IFC Model" ;
    rdfs:comment "One uploaded IFC model revision. Carries fileRef, fileFormat ('IFC'), uploadedAt, modelRevision, elementCount, ofProject. Element-level detail lives in bs:Element triples." .

# ---------- S2.9 — eSign approval flow (Phase 2 / Module 2) ----------
#
# bs:SignatureEvent records the act of signing a document via an
# electronic-signature provider (eMudhra, DigiLocker, or the dev/CI
# Stub mode). It is a prov:Activity so the append-only PROV-O chain
# captures who signed what and when without DELETE.
#
# Design decisions:
# • Domain unspecified on all properties (antipattern #8) — a
#   SignatureEvent sits on drawings, RFIs, transmittals, and later
#   joint measurements; hard-coding the domain would cause RDFS to
#   misclassify those nodes.
# • bs:SignatureProvider + bs:SignaturePurpose are plain xsd:string
#   with sh:in constraints in SignatureEventShape (string sh:in, no
#   sh:class — same cross-graph-validation posture as DrawingState,
#   NCRStatus, etc.).
# • bs:legallyBinding is xsd:boolean so queries can reliably filter
#   stub (false) from real (true) signatures.

bs:SignatureEvent a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Signature Event" ;
    rdfs:comment "A single act of signing a platform document via an e-signature provider. Carries who signed, when, the provider, purpose, and a reference to the signed document." .

# -- SignatureEvent properties (all rdfs:domain-free, antipattern #8) --

bs:signatureId a owl:DatatypeProperty ;
    rdfs:label "signature ID" ;
    rdfs:comment "Platform-generated or provider-issued unique identifier for this signing event." ;
    rdfs:range xsd:string .

bs:signedBy a owl:ObjectProperty ;
    rdfs:label "signed by" ;
    rdfs:comment "IRI of the bs:User who performed the signing action. Polymorphic — also used on bs:JointMeasurement (M3)." .

bs:signedAt a owl:DatatypeProperty ;
    rdfs:label "signed at" ;
    rdfs:comment "ISO-8601 datetime when the signature was applied (server-stamped for stub; provider-returned for real modes)." ;
    rdfs:range xsd:dateTime .

bs:signatureProvider a owl:DatatypeProperty ;
    rdfs:label "signature provider" ;
    rdfs:comment "Name of the e-signature service used: 'eMudhra', 'DigiLocker', or 'Stub'. sh:in constraint in SignatureEventShape." ;
    rdfs:range xsd:string .

bs:signaturePurpose a owl:DatatypeProperty ;
    rdfs:label "signature purpose" ;
    rdfs:comment "Why the document was signed. One of: DrawingApproval, RFIConfirmation, TransmittalApproval, JointMeasurement. sh:in in SignatureEventShape." ;
    rdfs:range xsd:string .

bs:signedDocument a owl:ObjectProperty ;
    rdfs:label "signed document" ;
    rdfs:comment "IRI of the bs:Drawing, bs:RFI, bs:Transmittal, or bs:Measurement that was signed. Mandatory." .

bs:signatureCertificate a owl:DatatypeProperty ;
    rdfs:label "signature certificate" ;
    rdfs:comment "Optional PEM/base64 certificate provided by the signature provider." ;
    rdfs:range xsd:string .

bs:legallyBinding a owl:DatatypeProperty ;
    rdfs:label "legally binding" ;
    rdfs:comment "xsd:boolean. True for real eMudhra/DigiLocker signatures; False for Stub mode. Allows queries to filter compliance-grade from development signatures." ;
    rdfs:range xsd:boolean .

# ---------- S3.1 — SOR library ingestion (Phase 3 / Module 3) ----------
#
# bs:SORLibrary is a platform-wide catalogue node (stored in the SOR
# catalog named graph, not per-project). bs:SORItem is one rate-book
# entry. All properties are rdfs:domain-free (antipattern #8).

bs:SORLibrary a owl:Class ;
    rdfs:label "SOR Library" ;
    rdfs:comment "A Schedule of Rates publication ingested into the platform. Platform-wide reference data, not per-project." .

bs:SORItem a owl:Class ;
    rdfs:label "SOR Item" ;
    rdfs:comment "One rate item from a bs:SORLibrary. Carries sorCode + description + unit + baseRate." .

bs:sorLibraryId a owl:DatatypeProperty ;
    rdfs:label "SOR library ID" ;
    rdfs:range xsd:string .

bs:publisher a owl:DatatypeProperty ;
    rdfs:label "publisher" ;
    rdfs:comment "Issuing authority: CPWD, AP-PWD, MES, NHAI, Railway, State-PWD. Polymorphic — domain unspecified." ;
    rdfs:range xsd:string .

bs:sorYear a owl:DatatypeProperty ;
    rdfs:label "SOR year" ;
    rdfs:range xsd:integer .

bs:sorState a owl:DatatypeProperty ;
    rdfs:label "SOR state" ;
    rdfs:comment "Optional state name for state-PWD SORs, e.g. 'Andhra Pradesh'." ;
    rdfs:range xsd:string .

bs:edition a owl:DatatypeProperty ;
    rdfs:label "edition" ;
    rdfs:range xsd:string .

bs:sorCode a owl:DatatypeProperty ;
    rdfs:label "SOR code" ;
    rdfs:comment "Rate-book item code, e.g. '2.1.1.1'. Polymorphic — domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:sorDescription a owl:DatatypeProperty ;
    rdfs:label "SOR description" ;
    rdfs:range xsd:string .

bs:baseRate a owl:DatatypeProperty ;
    rdfs:label "base rate" ;
    rdfs:comment "Unit rate in INR as published in the SOR." ;
    rdfs:range xsd:decimal .

bs:rateYear a owl:DatatypeProperty ;
    rdfs:label "rate year" ;
    rdfs:range xsd:integer .

bs:modeOfMeasurement a owl:DatatypeProperty ;
    rdfs:label "mode of measurement" ;
    rdfs:comment "Optional IS 1200 reference, e.g. 'IS 1200 Part-1'." ;
    rdfs:range xsd:string .

bs:itemCount a owl:DatatypeProperty ;
    rdfs:label "item count" ;
    rdfs:comment "Denormalised count of SOR items in a library. Polymorphic — domain unspecified." ;
    rdfs:range xsd:integer .

bs:ingestedAt a owl:DatatypeProperty ;
    rdfs:label "ingested at" ;
    rdfs:comment "Server timestamp when the library was ingested. Polymorphic — domain unspecified." ;
    rdfs:range xsd:dateTime .

# ---------- S3.2 — BOQ upload + SOR auto-match (Phase 3 / Module 3) ----------

bs:governedBy a owl:ObjectProperty ;
    rdfs:label "governed by" ;
    rdfs:comment "Link from bs:BOQItem to the bs:SORItem that provides its rate. Null for star-rate items. Domain unspecified — antipattern #8." .

bs:quotedRate a owl:DatatypeProperty ;
    rdfs:label "quoted rate" ;
    rdfs:comment "Unit rate in INR as entered on the BOQ. Mandatory. Domain unspecified." ;
    rdfs:range xsd:decimal .

bs:amount a owl:DatatypeProperty ;
    rdfs:label "amount" ;
    rdfs:comment "Contract amount = tenderedQty × quotedRate, server-computed. Mandatory. Domain unspecified." ;
    rdfs:range xsd:decimal .

bs:isStarRate a owl:DatatypeProperty ;
    rdfs:label "is star rate" ;
    rdfs:comment "True when this BOQ item has no SOR match (star-rate / DSR-deviation item). Mandatory. Domain unspecified." ;
    rdfs:range xsd:boolean .

bs:boqItemNo a owl:DatatypeProperty ;
    rdfs:label "BOQ item number" ;
    rdfs:comment "The hierarchical item number as it appears in the BOQ, e.g. '1.1', '2.3.4'. Mandatory. Domain unspecified." ;
    rdfs:range xsd:string .

bs:workType a owl:DatatypeProperty ;
    rdfs:label "work type" ;
    rdfs:comment "Optional category inferred from the SOR discipline, e.g. 'Civil', 'Electrical', 'MEP'. Domain unspecified." ;
    rdfs:range xsd:string .

# ---------- S3.3 — BOQ-to-IFC element mapper (Phase 3 / Module 3) ----------

bs:hasIFCScope a owl:DatatypeProperty ;
    rdfs:label "has IFC scope" ;
    rdfs:comment "IFC GlobalId (22-char string) of a physical element that this BOQ item covers. Repeatable — one BOQ item can span many elements (e.g. all M30 columns on a floor). Written by the BOQ-to-IFC mapper. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:governedByBOQ a owl:ObjectProperty ;
    rdfs:label "governed by BOQ item" ;
    rdfs:comment "Inverse of bs:hasIFCScope: points from a bs:Element to the bs:BOQItem that covers it. Optional — elements without a mapped BOQ item simply lack this predicate. Domain unspecified (antipattern #8)." .

# ---------- S3.4 — Mobile MB entry, hardened (Phase 3 / Module 3) ----------

bs:mbPageRef a owl:DatatypeProperty ;
    rdfs:label "MB page reference" ;
    rdfs:comment "Optional free-text reference to the physical Measurement Book page, e.g. 'Page 42, Item 7'. Written by the mobile entry form. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:jointSignatureRequired a owl:DatatypeProperty ;
    rdfs:label "joint signature required" ;
    rdfs:comment "Computed server-side: true when the cumulative amount for this BOQ item (sum of measurement quantities × quoted rate) exceeds the project's joint_measurement_threshold. A true flag primes the SE to get the JE/AE co-sign in S3.5. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:boolean .

# ---------- S3.5 — Joint measurement OTP dual-sign (Phase 3 / Module 3) ----------

# JMStatus enum — 4 individuals
bs:JMStatus a owl:Class ;
    rdfs:label "Joint Measurement Status" ;
    rdfs:comment "State of a bs:JointMeasurement. Four individuals: JMPendingContractor (initial, awaiting contractor OTP), JMPendingDepartmental (contractor signed, awaiting JE/AE), JMComplete (both signed, legally binding), JMRejected (either party rejected)." .

bs:JMPendingContractor a bs:JMStatus ;
    rdfs:label "Pending Contractor Signature" .

bs:JMPendingDepartmental a bs:JMStatus ;
    rdfs:label "Pending Departmental Signature" .

bs:JMComplete a bs:JMStatus ;
    rdfs:label "Complete" .

bs:JMRejected a bs:JMStatus ;
    rdfs:label "Rejected" .

# JointMeasurement class
bs:JointMeasurement a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Joint Measurement" ;
    rdfs:comment "A legally-binding dual-signed measurement record. The contractor signatory and departmental JE/AE each authenticate via OTP before the JM reaches JMComplete status. This is the first software implementation of the Indian PWD joint measurement requirement as a native knowledge-graph workflow. Defined in S3.5." .

# JointMeasurement properties (all rdfs:domain-free — antipattern #8)
bs:jmId a owl:DatatypeProperty ;
    rdfs:label "JM ID" ;
    rdfs:comment "Auto-numbered JM identifier, e.g. JM-0001. Mandatory. Domain unspecified." ;
    rdfs:range xsd:string .

bs:jmStatus a owl:ObjectProperty ;
    rdfs:label "JM status" ;
    rdfs:comment "Points at one of the four bs:JMStatus individuals. Mandatory. Domain unspecified." .

bs:contractorSignatory a owl:ObjectProperty ;
    rdfs:label "contractor signatory" ;
    rdfs:comment "Points at the bs:User who represents the contractor. Mandatory. Domain unspecified." .

bs:departmentalSignatory a owl:ObjectProperty ;
    rdfs:label "departmental signatory" ;
    rdfs:comment "Points at the bs:User (JE/AE) who counter-signs on behalf of the department. Mandatory. Domain unspecified." .

bs:contractorSignedAt a owl:DatatypeProperty ;
    rdfs:label "contractor signed at" ;
    rdfs:comment "Timestamp of contractor OTP verification. Set when jmStatus transitions from JMPendingContractor to JMPendingDepartmental. Domain unspecified." ;
    rdfs:range xsd:dateTime .

bs:departmentalSignedAt a owl:DatatypeProperty ;
    rdfs:label "departmental signed at" ;
    rdfs:comment "Timestamp of departmental JE/AE OTP verification. Set when jmStatus transitions to JMComplete. Domain unspecified." ;
    rdfs:range xsd:dateTime .

bs:contractorOTPRef a owl:DatatypeProperty ;
    rdfs:label "contractor OTP reference" ;
    rdfs:comment "Optional OTP transaction reference from the SMS provider (MSG91). Domain unspecified." ;
    rdfs:range xsd:string .

bs:departmentalOTPRef a owl:DatatypeProperty ;
    rdfs:label "departmental OTP reference" ;
    rdfs:comment "Optional OTP transaction reference from the SMS provider. Domain unspecified." ;
    rdfs:range xsd:string .

bs:coversMeasurement a owl:ObjectProperty ;
    rdfs:label "covers measurement" ;
    rdfs:comment "Links a bs:JointMeasurement to the bs:Measurement nodes it certifies. Repeatable. Domain unspecified." .

bs:rejectedBy a owl:ObjectProperty ;
    rdfs:label "rejected by" ;
    rdfs:comment "Points at the bs:User who rejected the JointMeasurement. Set when jmStatus = JMRejected. Domain unspecified." .

bs:rejectionReason a owl:DatatypeProperty ;
    rdfs:label "rejection reason" ;
    rdfs:comment "Free-text reason provided when rejecting a JointMeasurement. Domain unspecified." ;
    rdfs:range xsd:string .

# ---------------------------------------------------------------------------
# S3.6 — RA Bill computation engine
# ---------------------------------------------------------------------------

# BillState enum — 4 individuals
bs:BillState a owl:Class ;
    rdfs:label "Bill State" ;
    rdfs:comment "Lifecycle state of a bs:RABill. Four individuals: BillDraft (initial, editable), BillSubmitted (sent for approval), BillApproved (departmental approval given), BillFinalised (payment authorised, immutable)." .

bs:BillDraft a bs:BillState ;
    rdfs:label "Draft" .

bs:BillSubmitted a bs:BillState ;
    rdfs:label "Submitted" .

bs:BillApproved a bs:BillState ;
    rdfs:label "Approved" .

bs:BillFinalised a bs:BillState ;
    rdfs:label "Finalised" .

# RABill class
bs:RABill a owl:Class ;
    rdfs:subClassOf bs:Document, prov:Entity ;
    rdfs:label "Running Account Bill" ;
    rdfs:comment "A Running Account Bill (RA Bill) — the payment instrument in Indian government and PSU construction contracts. Aggregates all approved measurements for a billing period, applies BOQ rates, deducts previous payments and recoveries, and produces the net payable amount. This is the first software implementation of the RA Bill as a native knowledge-graph workflow — the numbers are always live and traceable to source measurements. Defined in S3.6." .

# RABill properties (all rdfs:domain-free — antipattern #8)
bs:billNo a owl:DatatypeProperty ;
    rdfs:label "bill number" ;
    rdfs:comment "Auto-numbered RA Bill identifier (e.g. RA-1, RA-2). Mandatory. Domain unspecified." ;
    rdfs:range xsd:string .

bs:billDate a owl:DatatypeProperty ;
    rdfs:label "bill date" ;
    rdfs:comment "Date the bill was prepared. Mandatory. Domain unspecified." ;
    rdfs:range xsd:date .

bs:billingPeriodStart a owl:DatatypeProperty ;
    rdfs:label "billing period start" ;
    rdfs:comment "Start date of the billing period (inclusive). Mandatory. Domain unspecified." ;
    rdfs:range xsd:date .

bs:billingPeriodEnd a owl:DatatypeProperty ;
    rdfs:label "billing period end" ;
    rdfs:comment "End date of the billing period (inclusive). Measurements up to this date are included. Mandatory. Domain unspecified." ;
    rdfs:range xsd:date .

bs:cumulativeGross a owl:DatatypeProperty ;
    rdfs:label "cumulative gross" ;
    rdfs:comment "Sum of all approved measurements to period end × BOQ rates (INR). Mandatory. Domain unspecified." ;
    rdfs:range xsd:decimal .

bs:previousBillAmount a owl:DatatypeProperty ;
    rdfs:label "previous bill amount" ;
    rdfs:comment "Value of work done up to the immediately preceding RA Bill: that bill's cumulativeGross (INR), as CPWD Form 26 deducts it. NOT its netPayable — recoveries are payments made on the contractor's behalf, not unbilled work. Zero for the first bill. Mandatory. Domain unspecified." ;
    rdfs:range xsd:decimal .

bs:currentGross a owl:DatatypeProperty ;
    rdfs:label "current gross" ;
    rdfs:comment "cumulativeGross minus previousBillAmount (INR). The gross value for this billing period. Mandatory. Domain unspecified." ;
    rdfs:range xsd:decimal .

bs:totalRecoveries a owl:DatatypeProperty ;
    rdfs:label "total recoveries" ;
    rdfs:comment "Sum of all recovery deductions (TDS-IT, GST-TDS, LabourCess, SecurityDeposit, AdvanceRecovery, etc.) in INR. Mandatory. Domain unspecified." ;
    rdfs:range xsd:decimal .

bs:netPayable a owl:DatatypeProperty ;
    rdfs:label "net payable" ;
    rdfs:comment "currentGross minus totalRecoveries (INR). The actual payment due to the contractor. Mandatory. SHACL arithmetic invariant: netPayable = currentGross − totalRecoveries (tolerance ±₹0.01). Domain unspecified." ;
    rdfs:range xsd:decimal .

bs:billState a owl:ObjectProperty ;
    rdfs:label "bill state" ;
    rdfs:comment "Points at one of the four bs:BillState individuals. Mandatory. Domain unspecified (antipattern #8)." .

bs:preparedBy a owl:ObjectProperty ;
    rdfs:label "prepared by" ;
    rdfs:comment "Points at the bs:User (PM/Admin) who prepared the bill. Mandatory. Domain unspecified (antipattern #8)." .

# Recovery class
bs:Recovery a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Recovery" ;
    rdfs:comment "A single statutory deduction line item within a bs:RABill. Each recovery has a type (TDS-IT, GST-TDS, LabourCess, SecurityDeposit, AdvanceRecovery, WaterElectricity, Royalty, Other), a rate (percentage), and a computed amount. Defined in S3.6." .

# Recovery properties (all rdfs:domain-free — antipattern #8)
bs:recoveryType a owl:DatatypeProperty ;
    rdfs:label "recovery type" ;
    rdfs:comment "Statutory deduction type. One of: TDS-IT, GST-TDS, LabourCess, SecurityDeposit, AdvanceRecovery, WaterElectricity, Royalty, Other. Domain unspecified." ;
    rdfs:range xsd:string .

bs:recoveryRate a owl:DatatypeProperty ;
    rdfs:label "recovery rate" ;
    rdfs:comment "Percentage rate applied to the recovery base (e.g. 0.02 for 2%). Mandatory. Domain unspecified." ;
    rdfs:range xsd:decimal .

bs:recoveryAmount a owl:DatatypeProperty ;
    rdfs:label "recovery amount" ;
    rdfs:comment "Computed recovery amount in INR (rate × base amount). Mandatory. Domain unspecified." ;
    rdfs:range xsd:decimal .

bs:recoveryBase a owl:DatatypeProperty ;
    rdfs:label "recovery base" ;
    rdfs:comment "What the rate applies to: GrossAmount | LabourComponent | MaterialComponent. Domain unspecified." ;
    rdfs:range xsd:string .

bs:forBill a owl:ObjectProperty ;
    rdfs:label "for bill" ;
    rdfs:comment "Links a bs:Recovery to its parent bs:RABill. Mandatory. Domain unspecified (antipattern #8)." .

# ==========================================================
# S3.7 — Deviation class + properties
# ==========================================================

bs:Deviation a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Deviation" ;
    rdfs:comment "A BOQ quantity deviation: measured quantity exceeds tendered quantity by >25%. Triggers approval routing before bill submission. Defined in S3.7." .

# Deviation properties (all rdfs:domain-free — antipattern #8)
bs:forBOQItem a owl:ObjectProperty ;
    rdfs:label "for BOQ item" ;
    rdfs:comment "Links a bs:Deviation to the bs:BOQItem that exceeded its tendered quantity. Mandatory. Domain unspecified." .

bs:measuredQty a owl:DatatypeProperty ;
    rdfs:label "measured quantity" ;
    rdfs:comment "Cumulative measured quantity at the time of the bill computation. Mandatory on Deviation. Domain unspecified." ;
    rdfs:range xsd:decimal .

bs:deviationPct a owl:DatatypeProperty ;
    rdfs:label "deviation percentage" ;
    rdfs:comment "Deviation as a percentage of tendered quantity: (measured - tendered) / tendered × 100. Mandatory. Domain unspecified." ;
    rdfs:range xsd:decimal .

bs:deviationAmount a owl:DatatypeProperty ;
    rdfs:label "deviation amount" ;
    rdfs:comment "Excess amount in INR at the BOQ rate: (measured - tendered) × rate. Mandatory. Domain unspecified." ;
    rdfs:range xsd:decimal .

bs:deviationState a owl:DatatypeProperty ;
    rdfs:label "deviation state" ;
    rdfs:comment "Workflow state. One of: Pending | ApprovedEE | ApprovedSE | ApprovedCE | Rejected. Domain unspecified." ;
    rdfs:range xsd:string .

bs:approvalRequired a owl:DatatypeProperty ;
    rdfs:label "approval required" ;
    rdfs:comment "Approval level required by PWD norms: EE (≤₹5L) | SE (≤₹25L) | CE (>₹25L). Domain unspecified." ;
    rdfs:range xsd:string .

bs:approvalNote a owl:DatatypeProperty ;
    rdfs:label "approval note" ;
    rdfs:comment "Justification note recorded when a deviation is approved or rejected. Domain unspecified." ;
    rdfs:range xsd:string .

bs:approvedBy a owl:ObjectProperty ;
    rdfs:label "approved by" ;
    rdfs:comment "IRI of the user who approved or rejected the deviation. Domain unspecified." .

bs:approvedAt a owl:DatatypeProperty ;
    rdfs:label "approved at" ;
    rdfs:comment "Timestamp when the deviation was approved or rejected. Domain unspecified." ;
    rdfs:range xsd:dateTime .

# S3.9 — Tally XML payment reconciliation + material reconciliation

bs:Payment a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Payment" ;
    rdfs:comment "A payment made by the client against a certified RA Bill, imported from Tally ERP XML exports. Each payment corresponds to one Tally voucher." .

bs:MaterialIssue a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Material Issue" ;
    rdfs:comment "A site store issue of construction material (cement, steel, etc.) against a project activity. Used for IS-coefficient-based consumption reconciliation." .

# bs:Payment properties (all domain-free — antipattern #8)

bs:paymentId a owl:DatatypeProperty ;
    rdfs:label "payment ID" ;
    rdfs:comment "Tally voucher number. Mandatory. Used as idempotency key on re-import." ;
    rdfs:range xsd:string .

bs:paymentDate a owl:DatatypeProperty ;
    rdfs:label "payment date" ;
    rdfs:comment "Date the payment was made (from Tally voucher DATE tag). Mandatory." ;
    rdfs:range xsd:date .

bs:paymentAmount a owl:DatatypeProperty ;
    rdfs:label "payment amount" ;
    rdfs:comment "INR amount of the payment (absolute value — Tally stores as negative). Mandatory." ;
    rdfs:range xsd:decimal .

bs:paymentMode a owl:DatatypeProperty ;
    rdfs:label "payment mode" ;
    rdfs:comment "Mode of payment: RTGS, NEFT, Cheque, DD. Parsed from Tally narration. Domain unspecified." ;
    rdfs:range xsd:string .

bs:paymentReference a owl:DatatypeProperty ;
    rdfs:label "payment reference" ;
    rdfs:comment "Bank transaction reference or cheque number. Extracted from Tally narration. Optional. Domain unspecified." ;
    rdfs:range xsd:string .

bs:tallyVoucherId a owl:DatatypeProperty ;
    rdfs:label "Tally voucher ID" ;
    rdfs:comment "Tally internal voucher ID used for idempotent re-import detection. Optional. Domain unspecified." ;
    rdfs:range xsd:string .

# bs:MaterialIssue properties (all domain-free — antipattern #8)

bs:material a owl:DatatypeProperty ;
    rdfs:label "material" ;
    rdfs:comment "Material type: Cement, Steel, Bitumen, Sand, Aggregate, Brick, Other. Mandatory. Domain unspecified." ;
    rdfs:range xsd:string .

bs:issueDate a owl:DatatypeProperty ;
    rdfs:label "issue date" ;
    rdfs:comment "Date the material was issued from the site store. Mandatory. Domain unspecified." ;
    rdfs:range xsd:date .

bs:quantityIssued a owl:DatatypeProperty ;
    rdfs:label "quantity issued" ;
    rdfs:comment "Quantity of material issued. Mandatory. Domain unspecified." ;
    rdfs:range xsd:decimal .

bs:issuedFor a owl:ObjectProperty ;
    rdfs:label "issued for" ;
    rdfs:comment "Optional link to the bs:Activity this material issue supports. Domain unspecified (antipattern #8)." .

# ====================================================================
# S4.2 — Earned Value Management
# ====================================================================
#
# A bs:EVMSnapshot is one daily (or on-demand) computation of the
# project's PV / EV / AC and derived metrics (CPI, SPI, EAC, ETC, CV,
# SV, VAC, BAC). Each snapshot is an immutable record stamped with
# bs:computedAt; a re-run on the same statusDate creates a NEW
# snapshot (older ones supersede via prov:invalidatedAtTime when the
# Celery sweep prunes beyond the 90-day retention window). EVM is
# computed across the schedule + BOQ + DPR + RA Bill graphs — the
# whole join lives in the project graph, so the answer is a single
# SPARQL query, not an ETL.
#
# All properties below are rdfs:domain-free (antipattern #8). CPI and
# SPI are intentionally NOT mandatory in EVMSnapshotShape — they are
# undefined when AC=0 (fresh project, no bills paid) or PV=0 (status
# date earlier than every activity's planned start), and the snapshot
# must still record PV/EV/BAC in those edge cases.

bs:EVMSnapshot a owl:Class ;
    rdfs:label "EVM snapshot" ;
    rdfs:comment "One computation of PV/EV/AC and derived metrics for a project at a status date." ;
    rdfs:subClassOf prov:Entity .

bs:statusDate a owl:DatatypeProperty ;
    rdfs:label "EVM status date" ;
    rdfs:comment "The data-date of the EVM snapshot — every activity and bill is rolled up as of this calendar day. Mandatory on bs:EVMSnapshot. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:date .

bs:pv a owl:DatatypeProperty ;
    rdfs:label "Planned Value (BCWS)" ;
    rdfs:comment "Time-phased budget that should have been earned by statusDate. INR. Mandatory on bs:EVMSnapshot. Domain unspecified." ;
    rdfs:range xsd:decimal .

bs:ev a owl:DatatypeProperty ;
    rdfs:label "Earned Value (BCWP)" ;
    rdfs:comment "Budgeted cost of work actually performed by statusDate. INR. Mandatory on bs:EVMSnapshot. Domain unspecified." ;
    rdfs:range xsd:decimal .

bs:ac a owl:DatatypeProperty ;
    rdfs:label "Actual Cost (ACWP)" ;
    rdfs:comment "Sum of approved/finalised RA Bill netPayable by statusDate. INR. Mandatory on bs:EVMSnapshot. Domain unspecified." ;
    rdfs:range xsd:decimal .

bs:bac a owl:DatatypeProperty ;
    rdfs:label "Budget at Completion (BAC)" ;
    rdfs:comment "Total contract budget = sum of every BOQItem (tenderedQty × quotedRate). INR. Mandatory on bs:EVMSnapshot." ;
    rdfs:range xsd:decimal .

bs:cpi a owl:DatatypeProperty ;
    rdfs:label "Cost Performance Index" ;
    rdfs:comment "EV / AC. >1.0 under budget, <1.0 over budget. Optional — undefined (omitted) when AC=0." ;
    rdfs:range xsd:decimal .

bs:spi a owl:DatatypeProperty ;
    rdfs:label "Schedule Performance Index" ;
    rdfs:comment "EV / PV. >1.0 ahead of schedule, <1.0 behind. Optional — undefined (omitted) when PV=0." ;
    rdfs:range xsd:decimal .

bs:eac a owl:DatatypeProperty ;
    rdfs:label "Estimate at Completion" ;
    rdfs:comment "BAC / CPI when CPI>0, else BAC. INR. Mandatory on bs:EVMSnapshot." ;
    rdfs:range xsd:decimal .

bs:etc a owl:DatatypeProperty ;
    rdfs:label "Estimate to Complete" ;
    rdfs:comment "EAC − AC, the remaining cost forecast. INR. Mandatory on bs:EVMSnapshot." ;
    rdfs:range xsd:decimal .

bs:cv a owl:DatatypeProperty ;
    rdfs:label "Cost Variance" ;
    rdfs:comment "EV − AC. Positive = under budget. INR. Mandatory on bs:EVMSnapshot." ;
    rdfs:range xsd:decimal .

bs:sv a owl:DatatypeProperty ;
    rdfs:label "Schedule Variance" ;
    rdfs:comment "EV − PV. Positive = ahead of schedule. INR-equivalent. Mandatory on bs:EVMSnapshot." ;
    rdfs:range xsd:decimal .

bs:vac a owl:DatatypeProperty ;
    rdfs:label "Variance at Completion" ;
    rdfs:comment "BAC − EAC. INR. Mandatory on bs:EVMSnapshot." ;
    rdfs:range xsd:decimal .

bs:computedAt a owl:DatatypeProperty ;
    rdfs:label "snapshot computed at" ;
    rdfs:comment "Wall-clock time the snapshot was computed. Distinct from bs:statusDate (which is the as-of data date). Mandatory on bs:EVMSnapshot. Domain unspecified — reused on other ad-hoc analytics rows." ;
    rdfs:range xsd:dateTime .

# BOQ-to-Activity linkage. Optional; either direction works:
#   bs:BOQItem  bs:linkedActivity   <activity> .  (BOQ → Activity)
#   bs:Activity bs:linkedBOQItem    <boq> .       (Activity → BOQ)
# EVMEngine accepts either.
#
# bs:linkedActivity is already declared above for V0.26 / S2.3 / S2.7
# (it's a polymorphic cross-domain bridge predicate); we re-use it on
# bs:BOQItem here without re-declaration to avoid an OWL duplicate-
# declaration warning. bs:linkedBOQItem is new — rdfs:domain-free per
# antipattern #8.

bs:linkedBOQItem a owl:ObjectProperty ;
    rdfs:label "linked BOQ item" ;
    rdfs:comment "Cross-domain bridge from bs:Activity to its governing bs:BOQItem (alternative to BOQItem.linkedActivity). Domain unspecified (antipattern #8). S4.2." .

# ====================================================================
# S4.5 — Issue / Risk log
# ====================================================================
#
# bs:Risk is the proactive twin of bs:Issue (S2.7). An Issue is a
# problem that has materialised; a Risk is a problem that might.
# Both are bs:Event sub-classes, both can carry cross-domain links
# to bs:Activity / bs:BOQItem / bs:Issue. Risks are auto-numbered
# RSK-NNNN per project; their score = probability × impact mapped
# onto a 1-16 matrix.
#
# All Risk-related properties are rdfs:domain-free (antipattern #8)
# — riskCategory / probability / impact / riskStatus could be reused
# on other catalogues later, and RiskShape enforces presence + the
# sh:in value sets directly.

bs:Risk a owl:Class ;
    rdfs:label "Risk" ;
    rdfs:comment "A proactive risk-register row. Sub-class of bs:Event so issue + risk reuse the same superclass; sub-class of prov:Entity for PROV-O attribution." ;
    rdfs:subClassOf bs:Event , prov:Entity .

bs:riskId a owl:DatatypeProperty ;
    rdfs:label "risk id (RSK-NNNN)" ;
    rdfs:range xsd:string .

bs:riskTitle a owl:DatatypeProperty ;
    rdfs:label "risk title" ;
    rdfs:range xsd:string .

bs:riskDescription a owl:DatatypeProperty ;
    rdfs:label "risk description" ;
    rdfs:range xsd:string .

bs:riskCategory a owl:DatatypeProperty ;
    rdfs:label "risk category" ;
    rdfs:comment "One of Design / Commercial / Resource / External / Technical / Regulatory / Environmental / Safety. Enforced by RiskShape sh:in." ;
    rdfs:range xsd:string .

bs:probability a owl:DatatypeProperty ;
    rdfs:label "probability" ;
    rdfs:comment "Low / Medium / High / Critical. Mapped to 1/2/3/4 for scoring." ;
    rdfs:range xsd:string .

bs:impact a owl:DatatypeProperty ;
    rdfs:label "impact" ;
    rdfs:comment "Low / Medium / High / Critical. Mapped to 1/2/3/4 for scoring." ;
    rdfs:range xsd:string .

bs:riskScore a owl:DatatypeProperty ;
    rdfs:label "risk score (1-16)" ;
    rdfs:comment "Computed server-side as probability_int * impact_int. Range 1-16." ;
    rdfs:range xsd:integer .

bs:riskStatus a owl:DatatypeProperty ;
    rdfs:label "risk status" ;
    rdfs:comment "Open / Mitigating / Closed / Accepted. Transitions enforced in route layer; sh:in in RiskShape." ;
    rdfs:range xsd:string .

bs:mitigationPlan a owl:DatatypeProperty ;
    rdfs:label "mitigation plan" ;
    rdfs:range xsd:string .

bs:contingencyPlan a owl:DatatypeProperty ;
    rdfs:label "contingency plan" ;
    rdfs:range xsd:string .

bs:costImpact a owl:DatatypeProperty ;
    rdfs:label "estimated cost impact (INR)" ;
    rdfs:range xsd:decimal .

bs:scheduleImpact a owl:DatatypeProperty ;
    rdfs:label "estimated schedule impact (days)" ;
    rdfs:range xsd:integer .

# bs:linkedActivity, bs:linkedBOQItem, bs:linkedIssue, bs:raisedBy,
# bs:dueDate, bs:ofProject are all reused from earlier slices —
# NOT re-declared (V0.26 / S2.3 / S2.5 / S2.7 already declared them
# as polymorphic bridge predicates per antipattern #8). Only
# bs:owner is new — domain-free for the same reason.

bs:owner a owl:ObjectProperty ;
    rdfs:label "owner" ;
    rdfs:comment "User responsible for managing a graph node (S4.5: bs:Risk). Domain unspecified (antipattern #8)." .

# ====================================================================
# S4.6 — Saved SPARQL queries (dashboard widgets)
# ====================================================================
#
# A bs:SavedQuery is a named, persisted SPARQL query that a PM has
# decided is useful enough to keep around — typically pinned to the
# project dashboard. Each saved query carries a visual_type (table /
# number / bar / line / pie) the web client uses to render results
# without any per-query frontend code. queryRole gates which roles
# can read the widget (mirrors the V0.31 firewall's audit posture
# but lifted to a project resource).
#
# All properties below are rdfs:domain-free (antipattern #8); the
# shape enforces presence + the sh:in value sets.

bs:SavedQuery a owl:Class ;
    rdfs:label "Saved SPARQL query (dashboard widget)" ;
    rdfs:comment "A persisted, named SPARQL query attached to a project. Renders as a dashboard widget per its visualType." ;
    rdfs:subClassOf prov:Entity .

bs:queryName a owl:DatatypeProperty ;
    rdfs:label "query name" ;
    rdfs:comment "Display title for the dashboard widget. Unique per project — enforced in the route layer." ;
    rdfs:range xsd:string .

bs:queryDescription a owl:DatatypeProperty ;
    rdfs:label "query description" ;
    rdfs:range xsd:string .

bs:sparqlText a owl:DatatypeProperty ;
    rdfs:label "SPARQL source text" ;
    rdfs:comment "Raw SPARQL as the user saved it (before the firewall rewrite). Mandatory on bs:SavedQuery." ;
    rdfs:range xsd:string .

bs:queryRole a owl:DatatypeProperty ;
    rdfs:label "minimum role to view this widget" ;
    rdfs:comment "One of Any / PM / Director / Auditor. Enforced in the route layer with a role-rank comparison." ;
    rdfs:range xsd:string .

bs:visualType a owl:DatatypeProperty ;
    rdfs:label "visualisation type" ;
    rdfs:comment "One of table / number / bar / line / pie. Drives client-side rendering." ;
    rdfs:range xsd:string .

bs:displayOrder a owl:DatatypeProperty ;
    rdfs:label "display order on the dashboard" ;
    rdfs:range xsd:integer .

bs:isPinned a owl:DatatypeProperty ;
    rdfs:label "pinned to project home?" ;
    rdfs:comment "Pinned widgets appear on the project home below the V0.23 SummaryBar." ;
    rdfs:range xsd:boolean .

# bs:createdBy is new — used here on SavedQuery, kept domain-free
# so it generalises later (audit log nodes, attachments, etc).
bs:createdBy a owl:ObjectProperty ;
    rdfs:label "created by" ;
    rdfs:comment "User who authored a graph node (S4.6: bs:SavedQuery). Domain unspecified (antipattern #8)." .

# ====================================================================
# S4.8 — BCF clash lifecycle
# ====================================================================
#
# bs:ClashBatch is one BCF-zip import. Each imported bs:Issue carries
# bs:inBatch → ClashBatch so the closure-tracking dashboard can roll
# up per-batch closure rates. Count properties (totalClashes /
# openClashes / resolvedClashes) are SHACL-mandatory and refreshed by
# the recompute path on every status change.
#
# All properties below are rdfs:domain-free (antipattern #8).

bs:ClashBatch a owl:Class ;
    rdfs:label "BCF clash batch" ;
    rdfs:comment "One BCF-zip import. Used by the clash lifecycle dashboard to roll up closure rates per batch." ;
    rdfs:subClassOf prov:Entity .

bs:batchId a owl:DatatypeProperty ;
    rdfs:label "batch id (BCH-NNNN)" ;
    rdfs:range xsd:string .

bs:importedAt a owl:DatatypeProperty ;
    rdfs:label "imported at" ;
    rdfs:range xsd:dateTime .

bs:sourceFile a owl:DatatypeProperty ;
    rdfs:label "source file" ;
    rdfs:comment "Original BCF zip filename. Audit only; the bytes are not stored." ;
    rdfs:range xsd:string .

bs:totalClashes a owl:DatatypeProperty ;
    rdfs:label "total clashes in batch" ;
    rdfs:range xsd:integer .

bs:openClashes a owl:DatatypeProperty ;
    rdfs:label "open clashes in batch" ;
    rdfs:comment "Recomputed by the closure-tracking refresher on every issue-status transition." ;
    rdfs:range xsd:integer .

bs:resolvedClashes a owl:DatatypeProperty ;
    rdfs:label "resolved clashes in batch" ;
    rdfs:range xsd:integer .

bs:closureRate a owl:DatatypeProperty ;
    rdfs:label "closure rate (% — 0..1)" ;
    rdfs:range xsd:decimal .

bs:inBatch a owl:ObjectProperty ;
    rdfs:label "in batch" ;
    rdfs:comment "Link from a bs:Issue back to its bs:ClashBatch import. Domain unspecified (antipattern #8) — re-usable on future batch-style imports." .

# bs:closureNote was declared at V0.19 for NCR closure. S4.8 re-uses
# it on bs:Issue (Clash type) for the PM/Admin override path.

# ====================================================================
# S4.9 — SAP PO-to-BOQ gap bridge
# ====================================================================
#
# bs:PurchaseOrder mirrors one SAP ME21N/ME22N PO header; bs:GoodsReceipt
# mirrors one SAP MIGO MIGO_GR row. Both can be imported from SAP XML
# (transaction ME2M / SE16 export) or — when SAP_MODE=rfc and pyrfc
# is installed — via direct ME_READ_PO / MB_READ_MAT_DOC RFC calls.
#
# All properties below are rdfs:domain-free (antipattern #8).

bs:PurchaseOrder a owl:Class ;
    rdfs:label "Purchase order (SAP)" ;
    rdfs:comment "One SAP PO header. linkedBOQItem connects procurement back to the contract chain so the gap-report engine can compute committed vs certified per BOQ row." ;
    rdfs:subClassOf prov:Entity .

bs:poNumber a owl:DatatypeProperty ;
    rdfs:label "SAP PO number (EBELN)" ;
    rdfs:range xsd:string .

bs:poDate a owl:DatatypeProperty ;
    rdfs:label "PO date (BEDAT)" ;
    rdfs:range xsd:date .

bs:vendor a owl:DatatypeProperty ;
    rdfs:label "vendor name / SAP vendor code (LIFNR)" ;
    rdfs:range xsd:string .

bs:poAmount a owl:DatatypeProperty ;
    rdfs:label "PO net value (NETWR), INR" ;
    rdfs:range xsd:decimal .

bs:poStatus a owl:DatatypeProperty ;
    rdfs:label "PO status" ;
    rdfs:comment "Open / PartiallyDelivered / FullyDelivered / Cancelled. Mirrors SAP EKKO.STATU but flattened to the four states a BIMSaarthi PM actually cares about." ;
    rdfs:range xsd:string .

bs:GoodsReceipt a owl:Class ;
    rdfs:label "Goods receipt (SAP)" ;
    rdfs:comment "One SAP material-document line (MIGO MIGO_GR). Links back to its bs:PurchaseOrder via bs:forPO." ;
    rdfs:subClassOf prov:Entity .

bs:grnNumber a owl:DatatypeProperty ;
    rdfs:label "SAP GRN / material-document number (MBLNR)" ;
    rdfs:range xsd:string .

bs:grnDate a owl:DatatypeProperty ;
    rdfs:label "GRN posting date (BUDAT)" ;
    rdfs:range xsd:date .

bs:forPO a owl:ObjectProperty ;
    rdfs:label "for purchase order" ;
    rdfs:comment "Link from a bs:GoodsReceipt to its bs:PurchaseOrder. Domain unspecified (antipattern #8)." .

bs:receivedAmount a owl:DatatypeProperty ;
    rdfs:label "received amount (INR)" ;
    rdfs:range xsd:decimal .

bs:receivedQty a owl:DatatypeProperty ;
    rdfs:label "received quantity" ;
    rdfs:range xsd:decimal .

# bs:unit reused (already declared for measurements); bs:ofProject and
# bs:linkedBOQItem reused too — antipattern #8 polymorphic bridge
# predicates, NOT re-declared.

# ====================================================================
# S4.10 — GNN delay/cost/risk predictions (IproK-GAT)
# ====================================================================
#
# bs:ActivityPrediction is the daily-inference output of the
# IproK-GAT model. Each row carries a delay-risk + cost-overrun-risk
# probability in [0, 1] (sigmoid output), a predicted float change
# in days, the model version, and a wall-clock predictedAt. The
# inference task supersedes the previous prediction for an activity
# via prov:invalidatedAtTime on the older row (append-only).
#
# All properties below are rdfs:domain-free (antipattern #8).

bs:ActivityPrediction a owl:Class ;
    rdfs:label "Activity prediction (GAT-derived)" ;
    rdfs:comment "One GAT inference output per activity. PROV-O supersession on re-run." ;
    rdfs:subClassOf prov:Entity .

bs:forActivity a owl:ObjectProperty ;
    rdfs:label "for activity" ;
    rdfs:comment "Link from a prediction to its bs:Activity. Domain unspecified (antipattern #8)." .

bs:delayRisk a owl:DatatypeProperty ;
    rdfs:label "delay risk (0–1)" ;
    rdfs:comment "Probability the activity will be delayed by more than 7 days. Sigmoid output of the GAT delay head." ;
    rdfs:range xsd:decimal .

bs:costOverrunRisk a owl:DatatypeProperty ;
    rdfs:label "cost overrun risk (0–1)" ;
    rdfs:comment "Probability the activity's BOQ-linked cost will overrun by >10%. Sigmoid output of the GAT cost head." ;
    rdfs:range xsd:decimal .

bs:predictedFloatChange a owl:DatatypeProperty ;
    rdfs:label "predicted float change (days)" ;
    rdfs:comment "tanh-bounded change in totalFloat. Negative = float will shrink. Range [-30, +30]." ;
    rdfs:range xsd:decimal .

bs:confidenceScore a owl:DatatypeProperty ;
    rdfs:label "model confidence (0–1)" ;
    rdfs:comment "Model's self-reported confidence in this prediction (1 − attention entropy, normalised)." ;
    rdfs:range xsd:decimal .

bs:modelVersion a owl:DatatypeProperty ;
    rdfs:label "model version" ;
    rdfs:comment "Model identifier like 'gat-v1'. Lets the UI flag stale predictions when the model is retrained." ;
    rdfs:range xsd:string .

bs:predictedAt a owl:DatatypeProperty ;
    rdfs:label "predicted at" ;
    rdfs:range xsd:dateTime .

# ─────────────────────────────────────────────────────────────────────────────
# S5.1 — Tender ingestion. bs:Tender + bs:TenderBOQItem.
#
# Tenders sit at the ORG level (a contractor evaluates many tenders, only some
# become projects). Distinct from bs:BOQItem (project-side, post-award): a
# bs:TenderBOQItem is what's extracted from a tender PDF during the bidding
# phase, before any award.
#
# Predicates ported from ProcureAI's ap_procurement_base.ttl, but ALL declared
# rdfs:domain-free per antipattern #8 — the same predicate (e.g. bs:estimatedValue)
# may later be reused on a bs:Project. SHACL shapes constrain usage per-target.
# ─────────────────────────────────────────────────────────────────────────────

bs:Tender a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Tender" ;
    rdfs:comment "A tender document under consideration by the org. Lives in the org catalogue graph (data/org/{oid}); pre-award. Becomes a bs:Project only on award." .

bs:TenderBOQItem a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Tender BOQ Item" ;
    rdfs:comment "One BOQ row extracted from a tender PDF during ingestion. Distinct from bs:BOQItem (post-award, project-side). Carries bs:ofTender, bs:needsReview (L24 hallucination guard), and bs:dedupCount (5-gram Jaccard collapse)." .

# bs:ExtractionStatus enumeration — same posture as bs:NCRStatus/bs:PilotStatus
bs:ExtractionStatus a owl:Class ;
    rdfs:label "Extraction Status" ;
    rdfs:comment "Lifecycle state of the tender PDF → BOQ extraction pipeline. Values: Pending, Running, Complete, Failed, NeedsReview." .

bs:Pending      a bs:ExtractionStatus ; rdfs:label "Pending" .
bs:Running      a bs:ExtractionStatus ; rdfs:label "Running" .
bs:Complete     a bs:ExtractionStatus ; rdfs:label "Complete" .
bs:Failed       a bs:ExtractionStatus ; rdfs:label "Failed" .
bs:NeedsReview  a bs:ExtractionStatus ; rdfs:label "Needs Review" .

# ─── Tender attributes (18 EPC-relevant predicates from ProcureAI inventory) ──
# All rdfs:domain-free per antipattern #8 (polymorphic across Tender/Project).

bs:tenderId            a owl:DatatypeProperty ; rdfs:label "tender id"            ; rdfs:range xsd:string  .
bs:tenderTitle         a owl:DatatypeProperty ; rdfs:label "tender title"         ; rdfs:range xsd:string  .
bs:issuingDepartment   a owl:DatatypeProperty ; rdfs:label "issuing department"   ; rdfs:range xsd:string  .
bs:estimatedValue      a owl:DatatypeProperty ; rdfs:label "estimated value (INR)" ; rdfs:range xsd:decimal .
bs:emdAmount           a owl:DatatypeProperty ; rdfs:label "EMD amount (INR)"     ; rdfs:range xsd:decimal .
bs:emdPercentage       a owl:DatatypeProperty ; rdfs:label "EMD percentage"       ; rdfs:range xsd:decimal .
bs:pbgPercentage       a owl:DatatypeProperty ; rdfs:label "PBG percentage"       ; rdfs:range xsd:decimal .
bs:bidValidityDays     a owl:DatatypeProperty ; rdfs:label "bid validity (days)"  ; rdfs:range xsd:integer .
bs:bgValidityDays      a owl:DatatypeProperty ; rdfs:label "BG validity (days)"   ; rdfs:range xsd:integer .
bs:dlpMonths           a owl:DatatypeProperty ; rdfs:label "DLP (months)"         ; rdfs:range xsd:integer .
bs:noticePeriodDays    a owl:DatatypeProperty ; rdfs:label "notice period (days)" ; rdfs:range xsd:integer .
bs:coverSystem         a owl:DatatypeProperty ; rdfs:label "cover system"         ; rdfs:range xsd:string  .   # "Single" | "Two" | "Three"
bs:procurementMode     a owl:DatatypeProperty ; rdfs:label "procurement mode"     ; rdfs:range xsd:string  .   # "Open" | "Limited" | "Single" | "Two-Stage" | "Reverse"
bs:contractForm        a owl:DatatypeProperty ; rdfs:label "contract form"        ; rdfs:range xsd:string  .   # "Lump-sum" | "Rate" | "BOT" | "Other"
bs:reverseTenderFlag   a owl:DatatypeProperty ; rdfs:label "reverse tender flag"  ; rdfs:range xsd:boolean .
bs:integrityPactFlag   a owl:DatatypeProperty ; rdfs:label "integrity pact flag"  ; rdfs:range xsd:boolean .
bs:eProcurementFlag    a owl:DatatypeProperty ; rdfs:label "e-procurement flag"   ; rdfs:range xsd:boolean .
bs:turnoverRequired    a owl:DatatypeProperty ; rdfs:label "turnover required"    ; rdfs:range xsd:decimal .
bs:experienceRequired  a owl:DatatypeProperty ; rdfs:label "experience required (yrs)" ; rdfs:range xsd:decimal .

# ─── Tender lifecycle ─────────────────────────────────────────────────
bs:extractionStatus    a owl:ObjectProperty   ; rdfs:label "extraction status"    ; rdfs:range bs:ExtractionStatus .
bs:extractedAt         a owl:DatatypeProperty ; rdfs:label "extracted at"         ; rdfs:range xsd:dateTime .
bs:extractionError     a owl:DatatypeProperty ; rdfs:label "extraction error"     ; rdfs:range xsd:string  .

# ─── Tender BOQ item attributes ───────────────────────────────────────
# Distinct field names from bs:BOQItem (project-side) so the two coexist
# without RDFS-inference cross-contamination.
bs:tenderBoqSno          a owl:DatatypeProperty ; rdfs:label "tender BOQ sno"         ; rdfs:range xsd:integer .
bs:tenderItemDescription a owl:DatatypeProperty ; rdfs:label "tender item description"; rdfs:range xsd:string  .
bs:tenderShortDesc       a owl:DatatypeProperty ; rdfs:label "tender short desc"      ; rdfs:range xsd:string  .
bs:tenderEstQty          a owl:DatatypeProperty ; rdfs:label "tender est qty"         ; rdfs:range xsd:decimal .
bs:tenderUnit            a owl:DatatypeProperty ; rdfs:label "tender unit (canonical)"; rdfs:range xsd:string  .
bs:tenderRate            a owl:DatatypeProperty ; rdfs:label "tender rate (INR)"      ; rdfs:range xsd:decimal .
bs:tenderAmount          a owl:DatatypeProperty ; rdfs:label "tender amount (INR)"    ; rdfs:range xsd:decimal .
bs:tenderWorkType        a owl:DatatypeProperty ; rdfs:label "tender work type"       ; rdfs:range xsd:string  .
bs:tenderDiscipline      a owl:DatatypeProperty ; rdfs:label "tender discipline"      ; rdfs:range xsd:string  .
bs:tenderSorCodeHint     a owl:DatatypeProperty ; rdfs:label "tender SOR code hint"   ; rdfs:range xsd:string  .
bs:tenderCitation        a owl:DatatypeProperty ; rdfs:label "tender citation"        ; rdfs:range xsd:string  .  # repeatable
bs:ofTender              a owl:ObjectProperty   ; rdfs:label "of tender"              ; rdfs:range bs:Tender   .
bs:needsReview           a owl:DatatypeProperty ; rdfs:label "needs review"           ; rdfs:range xsd:boolean .
bs:sourceChunk           a owl:DatatypeProperty ; rdfs:label "source chunk index"     ; rdfs:range xsd:integer .
bs:dedupCount            a owl:DatatypeProperty ; rdfs:label "dedup count"            ; rdfs:range xsd:integer .

# ─────────────────────────────────────────────────────────────────────────────
# S5.2 — Tender BOQ → SOR auto-match. Adds 5 OPTIONAL predicates to
# bs:TenderBOQItem so the matcher's output (which SOR item / how confident /
# how it matched / the snapshot rate at match time / the rate variance vs
# the SOR base rate) becomes part of the tender graph for audit + reporting.
# All rdfs:domain-free per antipattern #8 (matchConfidence may later be
# reused for bs:BOQItem etc.).
# ─────────────────────────────────────────────────────────────────────────────

bs:matchedSORItem a owl:ObjectProperty ;
    rdfs:label "matched SOR item" ;
    rdfs:comment "IRI of the bs:SORItem the tender BOQ row matched against. Absent when match-strategy is 'no-match'." ;
    rdfs:range bs:SORItem .

bs:matchConfidence a owl:DatatypeProperty ;
    rdfs:label "match confidence (0–1)" ;
    rdfs:comment "S3.2-style confidence: exact-code = 1.0; fuzzy-desc = 0.5 + 0.4×ratio; jargon-normalised = same but after Indian-PWD jargon stripped; no-match = 0.0. SHACL bounds enforce [0, 1]." ;
    rdfs:range xsd:decimal .

bs:matchStrategy a owl:DatatypeProperty ;
    rdfs:label "match strategy" ;
    rdfs:comment "How the match landed. Values: 'exact-code' | 'fuzzy-desc' | 'jargon-normalised' | 'no-match'. SHACL sh:in (string literals, antipattern #13)." ;
    rdfs:range xsd:string .

# bs:quotedRate already declared at line ~1458 (S3.2 — the project-side
# BOQ item's unit rate). S5.2 reuses it on bs:TenderBOQItem as the
# snapshot-at-match-time rate that variance is computed against. Same
# predicate, same datatype — polymorphic per antipattern #8 — so the
# S5.2 redeclaration that originally landed here is removed. The S3.2
# comment stays canonical; S5.2 / S5.3 callers attach it to TenderBOQItem
# nodes without breaking the BOQItem-side semantics (rdflib treats both
# triple sites as equivalent property uses).

bs:rateVariance a owl:DatatypeProperty ;
    rdfs:label "rate variance (percent, signed)" ;
    rdfs:comment "(quotedRate − sorBaseRate) / sorBaseRate × 100. Positive = tender priced higher than SOR; negative = tender priced lower. |variance| > 20% is flagged in the match report. Absent when no SOR match OR quotedRate is null." ;
    rdfs:range xsd:decimal .

# ─────────────────────────────────────────────────────────────────────────────
# S5.3 — Comparable project matcher (bid intelligence). bs:ComparableProject
# is the audit-trail entity that records "for this tender, here's a past
# project we found similar, and here's the similarity decomposition + the
# historical project's outcome signals (EVM CPI, deviation count, risks-that-
# became-issues)". Written by the comparator at /find-comparable time so the
# bid-rate decision is anchored to a queryable, supersedable record (a
# re-run via PROV invalidation supersedes the prior comparison).
# ─────────────────────────────────────────────────────────────────────────────

bs:ComparableProject a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Comparable Project" ;
    rdfs:comment "One row of the bid-intelligence audit trail for a tender. Links a bs:Tender to a historical bs:Project that the comparator scored as similar, with the score decomposition + the historical project's outcome signals attached." .

bs:forTender a owl:ObjectProperty ;
    rdfs:label "for tender" ;
    rdfs:comment "Link from bs:ComparableProject to the bs:Tender this comparison was run for. Domain-free (antipattern #8)." ;
    rdfs:range bs:Tender .

bs:similarProject a owl:ObjectProperty ;
    rdfs:label "similar project" ;
    rdfs:comment "The historical bs:Project the comparator picked. Domain-free." ;
    rdfs:range bs:Project .

bs:similarityScore a owl:DatatypeProperty ;
    rdfs:label "similarity score (0–1)" ;
    rdfs:comment "Weighted average of the comparator's three sub-scores: BOQ overlap (0.5) + work-type Jaccard (0.3) + scale similarity (0.2). Domain-free." ;
    rdfs:range xsd:decimal .

bs:matchedBOQItems a owl:DatatypeProperty ;
    rdfs:label "matched BOQ items" ;
    rdfs:comment "Count of tender BOQ items whose matchedSORItem also appears as bs:governedBy on some bs:BOQItem in the historical project. The numerator of the BOQ-overlap sub-score. Domain-free." ;
    rdfs:range xsd:integer .

bs:avgRateVariance a owl:DatatypeProperty ;
    rdfs:label "average rate variance (percent, signed)" ;
    rdfs:comment "Mean of the tender BOQ items' rateVariance across the rows that matched into this historical project. Positive = tender priced higher than the historical actual; negative = lower. Domain-free." ;
    rdfs:range xsd:decimal .

bs:actualCPI a owl:DatatypeProperty ;
    rdfs:label "actual CPI" ;
    rdfs:comment "The historical project's most recent CPI (cost-performance index) from bs:EVMSnapshot (S4.2). > 1.0 = under budget; < 1.0 = over budget. Null when the project has no EVM history. Domain-free." ;
    rdfs:range xsd:decimal .

bs:deviationCount a owl:DatatypeProperty ;
    rdfs:label "deviation count" ;
    rdfs:comment "Number of bs:Deviation nodes (S3.7) recorded on the historical project — counts how often measured quantity exceeded tendered quantity by >25%. Domain-free." ;
    rdfs:range xsd:integer .

bs:riskMaterialisedCount a owl:DatatypeProperty ;
    rdfs:label "risks that materialised" ;
    rdfs:comment "Number of bs:Risk nodes (S4.5) on the historical project whose bs:linkedIssue is set — risks that became real issues. Useful as a proxy for how well risk management worked. Domain-free." ;
    rdfs:range xsd:integer .

bs:computedAt a owl:DatatypeProperty ;
    rdfs:label "computed at" ;
    rdfs:comment "Timestamp when the comparator wrote this ComparableProject node. Mandatory (every audit row must carry a timestamp)." ;
    rdfs:range xsd:dateTime .

# ─────────────────────────────────────────────────────────────────────────────
# S5.4 — Bid recommendation report. bs:BidRecommendation is the audit-trail
# entity that records "for this tender, here's our recommended bid, here's
# what it adds up to, here's how much contingency we baked in, here's how
# many high-risk items we surfaced". Written by the recommender at
# /recommend time so the rate-decision provenance is queryable (a re-run
# supersedes the prior recommendation via PROV invalidation).
# ─────────────────────────────────────────────────────────────────────────────

bs:BidRecommendation a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Bid Recommendation" ;
    rdfs:comment "The final bid-output document for a tender: total quoted, contingency, recommended bid, item-count + high-risk-count breakdown. The line-item detail is NOT stored on this node — it is re-derivable from the underlying S5.2 + S5.3 graph state, and persisting it would create stale-data risk on a SOR-rate or comparable-project update. The PDF lives in MinIO via bs:fileRef." .

bs:totalQuoted a owl:DatatypeProperty ;
    rdfs:label "total quoted (INR)" ;
    rdfs:comment "Sum of (recommended_rate × estimated_qty) across every matched bs:TenderBOQItem. The base bid before contingency. Domain-free (antipattern #8)." ;
    rdfs:range xsd:decimal .

bs:contingencyPct a owl:DatatypeProperty ;
    rdfs:label "contingency percentage" ;
    rdfs:comment "Risk buffer percentage applied to total_quoted. Selected from the comparable projects' average historical CPI: 5% when avg_CPI ≥ 1.0 (historicals delivered on budget), 10% when 0.9-1.0 (slight over-runs), 15% when < 0.9 (significant historical over-runs). Domain-free." ;
    rdfs:range xsd:decimal .

bs:contingencyAmount a owl:DatatypeProperty ;
    rdfs:label "contingency amount (INR)" ;
    rdfs:comment "total_quoted × contingency_pct / 100. Domain-free." ;
    rdfs:range xsd:decimal .

bs:recommendedBid a owl:DatatypeProperty ;
    rdfs:label "recommended bid (INR)" ;
    rdfs:comment "total_quoted + contingency_amount. The MD-facing single number. Domain-free." ;
    rdfs:range xsd:decimal .

bs:itemCount a owl:DatatypeProperty ;
    rdfs:label "item count" ;
    rdfs:comment "Count of bs:TenderBOQItem rows in the recommendation (matched items only — unmatched are excluded since no rate can be recommended)." ;
    rdfs:range xsd:integer .

bs:highRiskCount a owl:DatatypeProperty ;
    rdfs:label "high-risk count" ;
    rdfs:comment "Count of line items the recommender flagged as risk_level=High (historical deviation OR rate_variance > 30%)." ;
    rdfs:range xsd:integer .


# ─────────────────────────────────────────────────────────────────────
# S6.1 — External Signal ontology (Phase 6A)
#
# Signals live in their OWN named graph (data/external/signals/{type}),
# NOT in any project graph. They are referenced by projects via
# bs:forProject. The thesis Chapter 5 ETL pipeline writes these.
# ─────────────────────────────────────────────────────────────────────

bs:ExternalSignal a owl:Class ;
    rdfs:label "external signal" ;
    rdfs:comment "Abstract parent — concrete subclasses (WeatherSignal, MaterialPriceSignal, LabourSignal) carry the data. Domain-free; signal triples are written to data/external/signals/{type}." .

bs:WeatherSignal a owl:Class ;
    rdfs:subClassOf bs:ExternalSignal ;
    rdfs:label "weather signal" ;
    rdfs:comment "Daily weather snapshot at a project's GPS — rainfall, max temp, working-day-loss-risk. Source: IMD via indianapi.in (free tier) with OpenWeatherMap fallback." .

bs:MaterialPriceSignal a owl:Class ;
    rdfs:subClassOf bs:ExternalSignal ;
    rdfs:label "material price signal" ;
    rdfs:comment "Weekly market price for a material (Steel-TMT, Cement, Bitumen, etc.) with 30-day rolling volatility and percent-deviation vs the BOQ quoted rate. Sources: SAIL website scrape (steel), RBI WPI index (cement)." .

bs:LabourSignal a owl:Class ;
    rdfs:subClassOf bs:ExternalSignal ;
    rdfs:label "labour signal" ;
    rdfs:comment "Per-week per-state labour availability score (0-1, where 0 = peak festival/harvest absence). Reason field carries the cause: Diwali / Pongal / Kharif harvest / Normal. Source: calendarific.com API + ICAR crop calendar." .

# ─── Properties (domain-free — antipattern #8) ───────────────────────

bs:signalDate a owl:DatatypeProperty ;
    rdfs:label "signal date" ;
    rdfs:comment "Calendar date the signal value pertains to (weather: that day; material price: that week's settlement; labour: week start). Domain-free." ;
    rdfs:range xsd:date .

bs:rainfallMM a owl:DatatypeProperty ;
    rdfs:label "rainfall (mm)" ;
    rdfs:comment "Daily rainfall in millimetres at the project's GPS coordinates. Used by the auto-risk engine to gate monsoon triggers." ;
    rdfs:range xsd:decimal .

bs:maxTempC a owl:DatatypeProperty ;
    rdfs:label "max temperature (°C)" ;
    rdfs:comment "Daily maximum temperature in degrees Celsius. >42°C correlates with reduced productivity in north India." ;
    rdfs:range xsd:decimal .

bs:workingDayLossRisk a owl:DatatypeProperty ;
    rdfs:label "working day loss risk" ;
    rdfs:comment "Probability [0, 1] that this calendar day will be lost to weather (rain > 25mm, extreme heat, cyclone). Computed from the underlying numbers — the GNN consumes this scalar directly." ;
    rdfs:range xsd:decimal .

bs:isMonsoonPeriod a owl:DatatypeProperty ;
    rdfs:label "monsoon period flag" ;
    rdfs:comment "True when the signal date falls inside the regional monsoon window (SW: Jun–Sep all India; NE: Oct–Dec for Tamil Nadu/Andhra)." ;
    rdfs:range xsd:boolean .

bs:material a owl:DatatypeProperty ;
    rdfs:label "material name" ;
    rdfs:comment "Material identifier: 'Steel-TMT' | 'Cement' | 'Bitumen' | 'Aggregate' | 'Sand' | 'Brick'. Polymorphic; matches the bs:MaterialIssue.material vocabulary." ;
    rdfs:range xsd:string .

bs:pricePerUnit a owl:DatatypeProperty ;
    rdfs:label "market price per unit (INR)" ;
    rdfs:comment "Current market price in INR per the material's UOM (Steel: per MT; Cement: per bag; Bitumen: per MT)." ;
    rdfs:range xsd:decimal .

bs:priceDate a owl:DatatypeProperty ;
    rdfs:label "price observation date" ;
    rdfs:comment "Date of the price snapshot — typically the Saturday of the week the price was sampled." ;
    rdfs:range xsd:date .

bs:volatility30d a owl:DatatypeProperty ;
    rdfs:label "30-day rolling volatility" ;
    rdfs:comment "Coefficient of variation (stddev / mean) of the price over the trailing 30 days. >0.05 flags 'volatile' for the auto-risk engine." ;
    rdfs:range xsd:decimal .

bs:vsQuotedRate a owl:DatatypeProperty ;
    rdfs:label "deviation vs BOQ quoted rate" ;
    rdfs:comment "Fractional deviation: (current_price - boq_quoted_rate) / boq_quoted_rate. Positive = market is above quoted; +0.15 (15%) is the steel-escalation trigger." ;
    rdfs:range xsd:decimal .

bs:signalWeek a owl:DatatypeProperty ;
    rdfs:label "signal week" ;
    rdfs:comment "ISO week the labour signal pertains to (gYearMonth gives month granularity; combined with a state code identifies the week)." ;
    rdfs:range xsd:gYearMonth .

bs:availabilityScore a owl:DatatypeProperty ;
    rdfs:label "labour availability score" ;
    rdfs:comment "Score in [0, 1]. 0 = peak festival absence (Diwali week, Pongal week, Kharif harvest); 1 = normal availability. <0.5 triggers the festival_labour_shortage auto-risk." ;
    rdfs:range xsd:decimal .

bs:reason a owl:DatatypeProperty ;
    rdfs:label "labour availability reason" ;
    rdfs:comment "Free-text reason: 'Diwali' | 'Pongal' | 'Kharif harvest' | 'Rabi harvest' | 'Holi' | 'Normal'. Surfaced on the UI alongside the score." ;
    rdfs:range xsd:string .

bs:stateCode a owl:DatatypeProperty ;
    rdfs:label "Indian state ISO code" ;
    rdfs:comment "Two-letter state code (KA / TN / MH / TG / AP / UP). Labour signals are state-specific because the festival calendar differs by region." ;
    rdfs:range xsd:string .

bs:forProject a owl:ObjectProperty ;
    rdfs:label "for project" ;
    rdfs:comment "Cross-graph link from a signal in data/external/signals/{type} to the bs:Project it pertains to. Domain-free (antipattern #8) so other downstream entities can reuse it without RDFS-inference cross-contamination." .


# ─────────────────────────────────────────────────────────────────────
# S6.6+ — Historical Weather Profile (NASA POWER 10-year baseline)
#
# Fetched ONCE at project geocoding (S6.2) from NASA POWER's free
# climatology API. Gives the GNN learnable per-week variance for
# weather even when live signals are empty — week 26 (mid-monsoon)
# has a known higher rain probability than week 50 (winter), and
# the model learns this seasonal bias from training data.
#
# Stored in dedicated graph: data/external/historical-weather/{project_id}
# ─────────────────────────────────────────────────────────────────────

bs:HistoricalWeatherProfile a owl:Class ;
    rdfs:subClassOf bs:ExternalSignal ;
    rdfs:label "historical weather profile" ;
    rdfs:comment "10-year climatology snapshot at a project's GPS — 52 weekly buckets, each with avg rainfall + rain probability + extreme-heat probability. Source: NASA POWER (power.larc.nasa.gov), free climatology API, no auth required. Fetched once at project geocoding; treated as static climate context (re-fetch only if site GPS changes)." .

bs:HistoricalWeatherWeek a owl:Class ;
    rdfs:label "historical weather week" ;
    rdfs:comment "One ISO week-of-year bucket (1..53) of the climatology profile. 52 instances per HistoricalWeatherProfile; the GNN reads three scalars from the week-bucket whose ISO week matches an activity's planned-start." .

# ─── Properties (domain-free — antipattern #8) ───────────────────────

bs:profileLat a owl:DatatypeProperty ;
    rdfs:label "profile latitude" ;
    rdfs:comment "Site latitude (degrees, WGS84) the profile was fetched for. Stored on the profile so a later GPS edit can compare + decide whether to refetch." ;
    rdfs:range xsd:decimal .

bs:profileLng a owl:DatatypeProperty ;
    rdfs:label "profile longitude" ;
    rdfs:comment "Site longitude (degrees, WGS84) the profile was fetched for." ;
    rdfs:range xsd:decimal .

bs:sourceYears a owl:DatatypeProperty ;
    rdfs:label "source years" ;
    rdfs:comment "Length of the climatology window in years (NASA POWER default: 10)." ;
    rdfs:range xsd:integer .

bs:fetchedAt a owl:DatatypeProperty ;
    rdfs:label "profile fetched at" ;
    rdfs:comment "When the NASA POWER fetch ran. The Celery worker re-fetches only when this is > 1 year old." ;
    rdfs:range xsd:dateTime .

bs:weeklyStats a owl:ObjectProperty ;
    rdfs:label "weekly stats" ;
    rdfs:comment "Link from a HistoricalWeatherProfile to its 52 HistoricalWeatherWeek buckets. Domain-free." .

bs:weekOfYear a owl:DatatypeProperty ;
    rdfs:label "week of year" ;
    rdfs:comment "ISO week number 1..53. Activities query historical features by computing ISO week from their planned_start date." ;
    rdfs:range xsd:integer .

bs:avgRainfallMM a owl:DatatypeProperty ;
    rdfs:label "average rainfall (mm)" ;
    rdfs:comment "10-year mean of weekly rainfall (mm) for this calendar week at this site. Drives the historical_rain_mm_avg_this_week GNN feature." ;
    rdfs:range xsd:decimal .

bs:rainProbability a owl:DatatypeProperty ;
    rdfs:label "rain probability" ;
    rdfs:comment "Empirical probability [0, 1] that this calendar week sees > 25mm total rainfall, computed across the 10 years of the climatology window. Activities planned in high-rain-prob weeks should learn a delay bias." ;
    rdfs:range xsd:decimal .

bs:heatProbability a owl:DatatypeProperty ;
    rdfs:label "extreme heat probability" ;
    rdfs:comment "Empirical probability [0, 1] that this calendar week sees at least one day with max temp > 40°C, computed across the 10 years of the climatology window. Indian-summer concrete-pour productivity drops sharply above 40°C." ;
    rdfs:range xsd:decimal .

# ====================================================================
# Scope Management — WBS spine (Module: Scope Management, Slice 1)
# ====================================================================
# bs:WBSNode is the hierarchical project breakdown the platform was
# missing — see docs/MODULE_SCOPE_MANAGEMENT_DESIGN.md. A recursive
# tree (Project ▸ block/zone ▸ system ▸ work package). Leaf nodes
# (bs:isWorkPackage true) are the unit of planning + control: the
# existing flat BOQ / IFC / Activity catalogues hang off them via the
# polymorphic bs:governedByWBS bridge, and cost rolls up the tree as a
# computed bs:wbsPlannedCost (written like S4.1 writes CPM float —
# never trusted from the client). bs:wbsCode (declared above for
# Activity) is reused here — it finally has a node to live on.

bs:WBSNode a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "WBS node" ;
    rdfs:comment "One node in the project work-breakdown structure. Recursive via bs:parentWBS; a leaf (bs:isWorkPackage true) is a work package." .

bs:parentWBS a owl:ObjectProperty ;
    rdfs:label "parent WBS node" ;
    rdfs:comment "Self-referential link to the parent bs:WBSNode. Absent on the project-root node. Domain unspecified (antipattern #8)." ;
    rdfs:range bs:WBSNode .

bs:wbsName a owl:DatatypeProperty ;
    rdfs:label "WBS node name" ;
    rdfs:comment "Human-readable name of the WBS node (e.g. 'Block A', 'Substructure', 'Footing RCC'). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:wbsLevel a owl:DatatypeProperty ;
    rdfs:label "WBS level" ;
    rdfs:comment "Depth in the tree: 1 = project root, 2 = block/zone, 3 = system, deeper = work packages. Server-assigned from parent depth." ;
    rdfs:range xsd:integer .

bs:isWorkPackage a owl:DatatypeProperty ;
    rdfs:label "is work package" ;
    rdfs:comment "True when this is a leaf work package — the unit of planning + control that governs BOQ / IFC / Activity. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:boolean .

bs:wbsPlannedCost a owl:DatatypeProperty ;
    rdfs:label "WBS planned cost (rollup)" ;
    rdfs:comment "Rollup: sum of governed bs:BOQItem amounts at a work package, rolled up the tree to the root. In Slice 1 this is COMPUTED ON READ in list_wbs_nodes (never persisted) — always-correct and it sidesteps a Fuseki/TDB2 quirk deleting xsd:decimal triples. The property + optional SHACL stanza are reserved for a future slice that may persist a snapshot." ;
    rdfs:range xsd:decimal .

bs:governedByWBS a owl:ObjectProperty ;
    rdfs:label "governed by WBS node" ;
    rdfs:comment "Polymorphic bridge (antipattern #8): placed on a bs:BOQItem / bs:Element / bs:Activity to point UP at its governing work package (bs:WBSNode). The existing catalogue classes are otherwise untouched." ;
    rdfs:range bs:WBSNode .

# ====================================================================
# NIYOJ N1 — Statutory approvals & RERA spine (owner-side)
# ====================================================================
# One bs:Approval node per statutory approval / NOC / registration a
# development project must clear (plan sanction, CC, NALA, fire, AAI,
# PCB, EC, utilities, mortgage-to-ULB, RERA registration, APF, lift
# licence, OC/CC …). The chain template (which approvals apply, their
# order, deemed-approval SLA clocks, per-approval document checklists)
# lives in bimsaarthi_api/approvals/chains.py until the R-workstream
# replaces it with sourced, versioned authority tables.

bs:Approval a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Statutory approval" ;
    rdfs:comment "A statutory approval, NOC, registration or certificate the project must obtain. Status transitions are PROV-O supersessions; the record is append-only." .

bs:approvalId a owl:DatatypeProperty ;
    rdfs:label "approval id" ;
    rdfs:comment "Stable id within the project, e.g. APR-0003. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:approvalType a owl:DatatypeProperty ;
    rdfs:label "approval type" ;
    rdfs:comment "One of the ApprovalShape sh:in set (PlanSanction / CommencementCertificate / NALAConversion / FireNOC / …). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:approvalStatus a owl:DatatypeProperty ;
    rdfs:label "approval status" ;
    rdfs:comment "NotStarted / Preparing / Submitted / QueryRound / Approved / Rejected. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:approvalAuthority a owl:DatatypeProperty ;
    rdfs:label "sanctioning authority" ;
    rdfs:comment "The authority the application goes to (TG-bPASS, DTCP, AAI/NOCAS, PCB, DISCOM, RERA authority …). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:applicationRef a owl:DatatypeProperty ;
    rdfs:label "application reference" ;
    rdfs:comment "The authority's application / file number once submitted. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:approvalSubmittedAt a owl:DatatypeProperty ;
    rdfs:label "submitted at" ;
    rdfs:range xsd:dateTime .

bs:approvalDecidedAt a owl:DatatypeProperty ;
    rdfs:label "decided at" ;
    rdfs:range xsd:dateTime .

bs:slaDays a owl:DatatypeProperty ;
    rdfs:label "SLA / deemed-approval days" ;
    rdfs:comment "Statutory or practical service-level clock in days from submission (TG-bPASS style deemed approvals). 0 = no clock. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:integer .

bs:approvalConditions a owl:DatatypeProperty ;
    rdfs:label "conditions of approval" ;
    rdfs:comment "Free-text conditions attached by the authority on approval. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:requiredDocsJson a owl:DatatypeProperty ;
    rdfs:label "required-document checklist (JSON)" ;
    rdfs:comment "JSON array literal [{name, ready}] — the per-approval document checklist. JSON-as-TEXT follows the bs:zoneConfig precedent; the document register joins land at a later slice. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:dependsOnApproval a owl:ObjectProperty ;
    rdfs:label "depends on approval" ;
    rdfs:comment "Chain edge: this approval is normally taken up after the referenced one (e.g. CC depends on PlanSanction). Advisory ordering, not a hard gate. Domain unspecified (antipattern #8)." ;
    rdfs:range bs:Approval .

# ====================================================================
# NIYOJ N2 — Unit inventory (Tower / UnitType / Unit)
# ====================================================================
# The sellable inventory of a development project. bs:Unit carries the
# allottee-facing lifecycle (Available → Blocked → Booked → Agreement →
# Registered → Possession) whose sold states feed the Section 14(2)
# consent gate and, in N3, the payment-schedule chain. Pricing lives on
# bs:UnitType (base rate on SBA) with an optional per-unit override.

bs:Tower a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Tower / wing" ;
    rdfs:comment "A tower, wing or block of the project." .

bs:UnitType a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Unit type" ;
    rdfs:comment "A sellable unit archetype (2BHK / 3BHK …) with its area set and base rate." .

bs:Unit a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Unit" ;
    rdfs:comment "One sellable unit. Status transitions are PROV-O supersessions." .

bs:towerId a owl:DatatypeProperty ;
    rdfs:comment "Stable id within the project (T1, T2 …). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:towerName a owl:DatatypeProperty ;
    rdfs:range xsd:string .

bs:floorsCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

bs:unitTypeId a owl:DatatypeProperty ;
    rdfs:comment "Stable id within the project (UT1 …). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:unitTypeName a owl:DatatypeProperty ;
    rdfs:range xsd:string .

bs:carpetAreaSqft a owl:DatatypeProperty ;
    rdfs:comment "RERA carpet area, sqft. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:decimal .

bs:builtUpAreaSqft a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

bs:superBuiltUpAreaSqft a owl:DatatypeProperty ;
    rdfs:comment "Saleable (super built-up) area, sqft — the pricing basis in the mid-market convention." ;
    rdfs:range xsd:decimal .

bs:baseRatePerSqft a owl:DatatypeProperty ;
    rdfs:comment "Base price per sqft SBA for this unit type. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:decimal .

bs:unitId a owl:DatatypeProperty ;
    rdfs:comment "Stable id within the project, e.g. T1-0503 (tower-floor-unit). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:unitNo a owl:DatatypeProperty ;
    rdfs:comment "Door number on the floor (1, 2, 3 …)." ;
    rdfs:range xsd:integer .

bs:floorNo a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

bs:ofTower a owl:ObjectProperty ;
    rdfs:comment "Unit → its tower. Domain unspecified (antipattern #8)." ;
    rdfs:range bs:Tower .

bs:ofUnitType a owl:ObjectProperty ;
    rdfs:comment "Unit → its archetype. Domain unspecified (antipattern #8)." ;
    rdfs:range bs:UnitType .

bs:unitStatus a owl:DatatypeProperty ;
    rdfs:comment "Available / Blocked / Booked / Agreement / Registered / Possession. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:priceOverride a owl:DatatypeProperty ;
    rdfs:comment "Optional total-price override for this unit (floor-rise, PLC, corner premium baked in). When absent, price = SBA × baseRatePerSqft." ;
    rdfs:range xsd:decimal .

# ====================================================================
# NIYOJ N2.b — Design options & the 5D cost-plan cascade
# ====================================================================
# A bs:DesignOption is one priced, dated design decision ("premium
# lobby: +₹2.1 Cr, +11 days") — the value-engineering log. The cost
# plan itself is COMPUTED ON READ as a cascade: feasibility baseline
# (bs:costBaselineAmount on the project) → approved option deltas →
# working estimate → tender BOQ total (S3.x) → certified to date
# (S3.9) — no parallel cost store to drift out of sync.

bs:DesignOption a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Design option" ;
    rdfs:comment "A priced design decision under consideration or decided. Decisions are PROV-O supersessions; Approved options move the working estimate." .

bs:optionId a owl:DatatypeProperty ;
    rdfs:comment "Stable id within the project (DO-0001). Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:optionTitle a owl:DatatypeProperty ;
    rdfs:range xsd:string .

bs:optionDescription a owl:DatatypeProperty ;
    rdfs:range xsd:string .

bs:optionDiscipline a owl:DatatypeProperty ;
    rdfs:comment "Architecture / Structure / MEP / Finishes. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:optionStatus a owl:DatatypeProperty ;
    rdfs:comment "Proposed / Approved / Rejected / Superseded. Domain unspecified (antipattern #8)." ;
    rdfs:range xsd:string .

bs:costDeltaAmount a owl:DatatypeProperty ;
    rdfs:comment "Signed cost impact in ₹ against the working estimate." ;
    rdfs:range xsd:decimal .

bs:timeDeltaDays a owl:DatatypeProperty ;
    rdfs:comment "Signed schedule impact in days." ;
    rdfs:range xsd:integer .

bs:affectsSoldUnits a owl:DatatypeProperty ;
    rdfs:comment "True when the option changes sanctioned plans or specs of sold units — triggers the RERA Section 14(2) 2/3-allottee-consent gate at decision time." ;
    rdfs:range xsd:boolean .

bs:consentRecordedCount a owl:DatatypeProperty ;
    rdfs:comment "Allottee consents the PMC recorded before approving a S.14(2)-gated option. Full consent records (per-allottee) land with the sales module." ;
    rdfs:range xsd:integer .

bs:decisionNote a owl:DatatypeProperty ;
    rdfs:range xsd:string .

bs:decidedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

bs:costBaselineAmount a owl:DatatypeProperty ;
    rdfs:comment "The locked concept/feasibility estimate on the bs:Project node — the top of the 5D cascade and the RERA cost baseline. Updated only by PROV-O supersession." ;
    rdfs:range xsd:decimal .

# ---------------------------------------------------------------------------
# NIYOJ N6 — Escrow & Cash Control (RERA S.4(2)(l)(D) 70/30 discipline)
# ---------------------------------------------------------------------------
# One bs:EscrowAccount per project; every buyer payment is a
# bs:CollectionReceipt split escrow/operating at receipt time; every
# escrow utilization is a bs:EscrowWithdrawal that MUST carry the
# engineer+architect+CA certificate reference RERA requires.
# All properties rdfs:domain-free (antipattern #8).

bs:EscrowAccount a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "The project's RERA collection account discipline: a designated escrow account receiving the statutory share (default 70%) of every buyer collection." .

bs:CollectionReceipt a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "One buyer payment against a unit, split escrow/operating at receipt time." .

bs:EscrowWithdrawal a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:comment "One utilization of escrow funds against a cost head, certificate-backed per RERA S.4(2)(l)(D)." .

bs:escrowBank a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:escrowAccountRef a owl:DatatypeProperty ;
    rdfs:comment "Masked account reference — never the full account number." ;
    rdfs:range xsd:string .
bs:escrowSplitPct a owl:DatatypeProperty ;
    rdfs:comment "Statutory share of every collection routed to escrow. RERA default 70." ;
    rdfs:range xsd:decimal .
bs:openingBalance a owl:DatatypeProperty ; rdfs:range xsd:decimal .
bs:escrowSetupAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .

bs:receiptId a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:forUnit a owl:ObjectProperty ;
    rdfs:comment "The bs:Unit this receipt pays against. Range left undeclared so RDFS inference never re-classifies referenced IRIs (antipattern #8)." .
bs:receiptAmount a owl:DatatypeProperty ; rdfs:range xsd:decimal .
bs:receiptDate a owl:DatatypeProperty ; rdfs:range xsd:date .
bs:receiptMode a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:escrowShare a owl:DatatypeProperty ;
    rdfs:comment "Server-computed: receiptAmount × escrowSplitPct/100, 2dp." ;
    rdfs:range xsd:decimal .
bs:operatingShare a owl:DatatypeProperty ;
    rdfs:comment "Server-computed: receiptAmount − escrowShare (no penny drift)." ;
    rdfs:range xsd:decimal .

bs:withdrawalId a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:withdrawalAmount a owl:DatatypeProperty ; rdfs:range xsd:decimal .
bs:withdrawalDate a owl:DatatypeProperty ; rdfs:range xsd:date .
bs:costHead a owl:DatatypeProperty ;
    rdfs:comment "RERA utilization head: Land | Construction | Statutory | Consultants | Finance | Other." ;
    rdfs:range xsd:string .
bs:certificateRef a owl:DatatypeProperty ;
    rdfs:comment "Reference to the engineer + architect + CA certificate that authorises this withdrawal (RERA S.4(2)(l)(D)). Mandatory." ;
    rdfs:range xsd:string .

# ---------------------------------------------------------------------------
# NIYOJ N7 — WIR / ITP hold & witness points (deck p.8 execution control)
# ---------------------------------------------------------------------------
# A Hold point BLOCKS downstream field work on its activity until the
# client/consultant releases it (OTP-signed) or the PM waives it with a
# note. A Witness point notifies but does not block. Replaces
# verbal-clearance-by-phone with a legally defensible audit trail.

bs:HoldPoint a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "One inspection/witness point from the ITP, bound to a schedule activity." .

bs:holdPointId a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:holdPointType a owl:DatatypeProperty ;
    rdfs:comment "Hold (blocks downstream work) | Witness (notifies only)." ;
    rdfs:range xsd:string .
bs:holdDescription a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:forActivity a owl:ObjectProperty ;
    rdfs:comment "The bs:Activity this point gates. Range undeclared (antipattern #8)." .
bs:holdStatus a owl:DatatypeProperty ;
    rdfs:comment "Pending | OfferedForInspection | Released | Waived." ;
    rdfs:range xsd:string .
bs:offeredAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
bs:releasedBy a owl:DatatypeProperty ;
    rdfs:comment "Name/designation of the releasing client or consultant authority." ;
    rdfs:range xsd:string .
bs:releasedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
bs:releaseOTPRef a owl:DatatypeProperty ;
    rdfs:comment "OTP transaction reference of the release signature (S3.5 service)." ;
    rdfs:range xsd:string .
bs:releaseNote a owl:DatatypeProperty ; rdfs:range xsd:string .

# ---------------------------------------------------------------------------
# NIYOJ N8 — Handover, Snagging, DLP & Warranty (deck p.13)
# ---------------------------------------------------------------------------
# One bs:HandoverPackage per project. Transfer stamps the DLP start;
# bs:DLPDefect carries RERA's 30-day rectification clock (computed on
# read); bs:WarrantyRecord seeds the asset twin the SUTRA operations
# platform inherits. All properties rdfs:domain-free (antipattern #8).

bs:HandoverPackage a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "The project's digital handover record: readiness, transfer, and the defect-liability window." .

bs:SnagItem a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "One punch-list item found during handover inspection. Open Critical snags block transfer." .

bs:DLPDefect a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "A post-handover defect inside the liability period — RERA S.14(3): rectify within 30 days." .

bs:WarrantyRecord a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "One asset/system warranty (vendor, start, duration) handed to operations." .

bs:handoverStatus a owl:DatatypeProperty ;
    rdfs:comment "Preparing | Transferred." ; rdfs:range xsd:string .
bs:committedHandoverDate a owl:DatatypeProperty ; rdfs:range xsd:date .
bs:transferredAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
bs:transferredTo a owl:DatatypeProperty ;
    rdfs:comment "Receiving party — owner, RWA, or facility team." ;
    rdfs:range xsd:string .
bs:dlpMonths a owl:DatatypeProperty ;
    rdfs:comment "Defect-liability window in months. RERA default 60 (5 years from possession)." ;
    rdfs:range xsd:integer .

bs:snagId a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:snagDescription a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:snagLocation a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:snagSeverity a owl:DatatypeProperty ;
    rdfs:comment "Minor | Major | Critical." ; rdfs:range xsd:string .
bs:snagStatus a owl:DatatypeProperty ;
    rdfs:comment "Open | Fixed | Verified | Deferred." ; rdfs:range xsd:string .
bs:fixedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
bs:verifiedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .

bs:defectId a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:defectStatus a owl:DatatypeProperty ;
    rdfs:comment "Reported | InRepair | Rectified | Disputed." ; rdfs:range xsd:string .
bs:rectifiedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .

bs:warrantyId a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:warrantyAsset a owl:DatatypeProperty ;
    rdfs:comment "Asset/system covered — lifts, DG set, waterproofing, STP…" ;
    rdfs:range xsd:string .
bs:warrantyVendor a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:warrantyStartDate a owl:DatatypeProperty ; rdfs:range xsd:date .
bs:warrantyMonths a owl:DatatypeProperty ; rdfs:range xsd:integer .
bs:warrantyDocRef a owl:DatatypeProperty ; rdfs:range xsd:string .

# ---------------------------------------------------------------------------
# NIYOJ N9 — Vendor & Price Intelligence (deck p.7)
# ---------------------------------------------------------------------------
# Org-level dynamic database: bs:Vendor + bs:ProductOffer live in the
# org catalogue graph (V0.37 posture, like tenders) so every project
# in the org compares against the same market. A project's pick writes
# bs:selectedOffer on the bs:BOQItem — the 5D cost-impact bridge.
# All properties rdfs:domain-free (antipattern #8).

bs:Vendor a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "One supplier/subcontractor in the org's vendor database." .

bs:ProductOffer a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "One vendor's offer for a product/spec: rate, lead time, quality, warranty." .

bs:vendorId a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:vendorName a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:vendorCategory a owl:DatatypeProperty ;
    rdfs:comment "Material | Equipment | Labour | Services | Fixtures | Other." ;
    rdfs:range xsd:string .
bs:vendorLocation a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:vendorGSTIN a owl:DatatypeProperty ; rdfs:range xsd:string .

bs:offerId a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:offerProduct a owl:DatatypeProperty ;
    rdfs:comment "Product/spec offered — e.g. 'Wall-hung WC, Brand X model Y'." ;
    rdfs:range xsd:string .
bs:byVendor a owl:ObjectProperty ;
    rdfs:comment "The bs:Vendor making this offer. Range undeclared (antipattern #8)." .
bs:unitRate a owl:DatatypeProperty ; rdfs:range xsd:decimal .
bs:leadTimeDays a owl:DatatypeProperty ; rdfs:range xsd:integer .
bs:qualityGrade a owl:DatatypeProperty ;
    rdfs:comment "1 (basic) … 5 (premium) — the estimator's grade for compare dashboards." ;
    rdfs:range xsd:integer .
bs:offerNote a owl:DatatypeProperty ; rdfs:range xsd:string .

bs:selectedOffer a owl:ObjectProperty ;
    rdfs:comment "The bs:ProductOffer a project picked for a bs:BOQItem — written with a ProcurementDecision PROV activity; optionally re-rates the BOQ line (5D impact)." .

# ---------------------------------------------------------------------------
# NIYOJ N12 — Milestone payment schedule & demand notes
# ---------------------------------------------------------------------------
# One milestone schedule per project (applies to every sold unit).
# Achieving a milestone lets the promoter raise one bs:DemandNote per
# sold unit (amount = pct × unit price). Settlement is COMPUTED from
# N6 collection receipts (FIFO per unit) — receipts stay the only
# money facts; a demand never duplicates them.
# All properties rdfs:domain-free (antipattern #8).

bs:PaymentMilestone a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "One instalment trigger in the project's payment schedule — e.g. 'Plinth completion — 15%'." .

bs:DemandNote a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "One payment demand to one unit's allottee against an achieved milestone." .

bs:milestoneId a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:milestoneName a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:milestonePct a owl:DatatypeProperty ;
    rdfs:comment "Instalment share of the unit price (0–100]." ;
    rdfs:range xsd:decimal .
bs:milestoneOrder a owl:DatatypeProperty ; rdfs:range xsd:integer .
bs:milestoneStatus a owl:DatatypeProperty ;
    rdfs:comment "Pending | Achieved." ; rdfs:range xsd:string .
bs:achievedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .

bs:demandId a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:forMilestone a owl:ObjectProperty ;
    rdfs:comment "The achieved bs:PaymentMilestone this demand cites. Range undeclared (antipattern #8)." .
bs:demandAmount a owl:DatatypeProperty ; rdfs:range xsd:decimal .
bs:demandDate a owl:DatatypeProperty ; rdfs:range xsd:date .
bs:dueDate2 a owl:DatatypeProperty ;
    rdfs:comment "Payment due date. Named dueDate2 because bs:dueDate exists with task semantics elsewhere; both stay domain-free." ;
    rdfs:range xsd:date .
bs:demandStatus a owl:DatatypeProperty ;
    rdfs:comment "Raised | Cancelled. Settled/overdue are computed from receipts, never asserted." ;
    rdfs:range xsd:string .

# ---------------------------------------------------------------------------
# NIYOJ N13 — design-option comparison ratings (deck p.6/p.7 dashboard)
# ---------------------------------------------------------------------------
# Optional 1–5 estimator grades on bs:DesignOption for the qualitative
# comparison dimensions. Cost and time ratings are COMPUTED from the
# stored deltas, never graded by hand. All domain-free (antipattern #8).

bs:qualityRating a owl:DatatypeProperty ;
    rdfs:comment "Design quality / performance grade 1–5." ; rdfs:range xsd:integer .
bs:maintainabilityRating a owl:DatatypeProperty ; rdfs:range xsd:integer .
bs:userValueRating a owl:DatatypeProperty ; rdfs:range xsd:integer .
bs:flexibilityRating a owl:DatatypeProperty ; rdfs:range xsd:integer .
bs:executionReadinessRating a owl:DatatypeProperty ;
    rdfs:comment "How buildable this option is with the resources at hand, 1–5." ;
    rdfs:range xsd:integer .

# ---------------------------------------------------------------------------
# NIYOJ N14 — Design Coordination Studio (Revit→IFC review loop)
# ---------------------------------------------------------------------------
# Categorized model uploads (bs:IfcModel now also carries the reused
# bs:discipline / bs:revision / bs:supersedes — written, not re-declared)
# and bs:ModelComment: a recorded design-review comment anchored to a
# model revision, a generated view (3D / storey plan / elevation), a
# BCF-style camera viewpoint, an SVG markup overlay, and optionally one
# IFC element (reused bs:ifcGuid, the S2.7 Issue idiom). Author is the
# reused bs:raisedBy; timestamps reuse bs:createdAt / bs:resolvedAt.
# Comments are append-only; Resolve is PROV-O supersession, never a
# delete. All new properties rdfs:domain-free (antipattern #8).

bs:ModelComment a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "One recorded design-review comment on an IFC model view — the graph-native markup that Bluebeam/BIMcollab keep in opaque files." .

bs:commentId a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:onModel a owl:ObjectProperty ;
    rdfs:comment "The bs:IfcModel upload/revision this comment was recorded against. Range undeclared (antipattern #8)." .
bs:commentText a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:commentStatus a owl:DatatypeProperty ;
    rdfs:comment "Open | Resolved." ; rdfs:range xsd:string .
bs:viewName a owl:DatatypeProperty ;
    rdfs:comment "Which generated view the comment was made in — '3D', a storey plan name, or an elevation name." ;
    rdfs:range xsd:string .
bs:viewpointJson a owl:DatatypeProperty ;
    rdfs:comment "BCF-style camera state (position / target / projection / open view) as a JSON literal — the JSON-as-TEXT precedent (bs:zoneConfig)." ;
    rdfs:range xsd:string .
bs:markupJson a owl:DatatypeProperty ;
    rdfs:comment "Drawn markup strokes (pen / arrow / rect / text) in view-normalised 0–1 coordinates, as a JSON literal." ;
    rdfs:range xsd:string .
bs:replyTo a owl:ObjectProperty ;
    rdfs:comment "Optional thread parent — another bs:ModelComment. Range undeclared (antipattern #8)." .
bs:resolvedBy a owl:ObjectProperty ;
    rdfs:comment "Who resolved this comment. Range undeclared (antipattern #8)." .

# ---------------------------------------------------------------------------
# NIYOJ N17 — Fragments geometry cache on bs:IfcModel
# ---------------------------------------------------------------------------
# That Open Fragments (.frag) is the streamable geometry format that
# KEEPS per-element identity (localId ↔ bs:ifcGuid), unlike the S6.8
# glTF/GLB mesh which flattens geometry for map rendering. The viewer
# loads fragments for the picture and joins the graph on the GUID for
# the meaning — so an element stays selectable and answerable.
# Both properties are rdfs:domain-free (antipattern #8).

bs:fragmentsKey a owl:DatatypeProperty ;
    rdfs:comment "Object-store key of the converted .frag payload for a bs:IfcModel." ;
    rdfs:range xsd:string .

bs:fragmentsGeneratedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

# ---------------------------------------------------------------------------
# NIYOJ N26 — Model health audit
# ---------------------------------------------------------------------------
# A dated, auditable record of whether a bs:IfcModel carries the
# information its downstream uses need (QTO / 4D / fire / thermal / FM /
# drawing verification). Kept in the graph rather than recomputed on
# demand so readiness is TRENDABLE across revisions — "did R2 actually
# fix the fire ratings?" is then a SPARQL question.
#
# bs:readinessJson holds the per-use, per-field coverage as a JSON-array
# literal, the bs:zoneConfig / bs:requiredDocsJson precedent: the shape
# of a requirement set is caller-defined (a project BEP/EIR may replace
# the defaults), so modelling each field as a predicate would freeze it.
# Every property below is rdfs:domain-free (antipattern #8).

bs:ModelHealthCheck a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "One health audit of one IFC model at a point in time." .

bs:healthCheckId a owl:DatatypeProperty ;
    rdfs:comment "Human-facing id, MH-NNNN." ;
    rdfs:range xsd:string .

bs:forModel a owl:ObjectProperty ;
    rdfs:comment "The bs:IfcModel this audit measured." .

bs:checkedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

bs:overallScore a owl:DatatypeProperty ;
    rdfs:comment "Mean readiness across the uses that bear on this model, 0-100. Uses with no applicable element are skipped, never scored zero." ;
    rdfs:range xsd:decimal .

bs:elementsAudited a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

bs:readinessJson a owl:DatatypeProperty ;
    rdfs:comment "JSON array of {use, score, verdict, fields[]} — caller-defined requirement set, so JSON-as-TEXT (the bs:zoneConfig precedent)." ;
    rdfs:range xsd:string .

bs:checklistJson a owl:DatatypeProperty ;
    rdfs:comment "JSON array of actionable modelling gaps, worst first." ;
    rdfs:range xsd:string .

bs:quantitiesWritten a owl:DatatypeProperty ;
    rdfs:comment "Quantities NIYOJ computed and wrote back on the enrichment pass, if one ran." ;
    rdfs:range xsd:integer .

bs:enrichedFileRef a owl:DatatypeProperty ;
    rdfs:comment "Object-store key of the enriched IFC, when enrichment produced one. The source model is never modified in place." ;
    rdfs:range xsd:string .

# ---------------------------------------------------------------------------
# P2A — Resource Foundation (crews · workers · productivity)
# ---------------------------------------------------------------------------
# The measurement infrastructure the Planning Module (P2B) depends on.
# Duration = BOQ quantity ÷ (crew size × measured productivity), so a
# plan can only be better than a P6 template once productivity is
# actually MEASURED on executed work. This slice makes that measurement
# possible; P2B consumes it.
#
# bs:Worker is deliberately NOT a bs:User. A User is a platform login
# (nine RBAC roles); a Worker is labour on site. Most site labour never
# logs in, and conflating the two would either force accounts nobody
# uses or lose the workforce entirely. A Worker MAY reference a User
# via bs:workerAccount when the person does happen to have a login.
#
# Crew types and workers live in the ORG catalogue graph, not a project
# graph — a mason gang moves between projects and its measured
# productivity is an organisational asset, which is the whole flywheel.
# Every property below is rdfs:domain-free (antipattern #8).

bs:CrewType a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "A named gang the organisation deploys — 'Mason gang (6)', 'Bar bender gang (4)'. Org-level catalogue." .

bs:CrewComposition a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "One trade line within a crew type: N of a given trade at a given skill level." .

bs:Worker a owl:Class ;
    rdfs:subClassOf prov:Agent ;
    rdfs:comment "A person performing site labour. NOT a bs:User — most site labour never logs in. Org-level catalogue." .

bs:SkillCertification a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "A certification held by a worker, with a validity window so expiry is queryable." .

bs:ProductivityObservation a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "One measured data point: quantity achieved by a crew of a known size over a known period on a known activity." .

bs:ProductivityNorm a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "The organisation's rolled-up rate for a work type + crew type, derived from observations. Falls back to a seeded default until enough observations exist." .

# ── crew type + composition ────────────────────────────────────────────
bs:crewTypeId a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Human-facing id, CT-NNNN." .
bs:crewTypeName a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:crewTrade a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Masonry | Concrete | Reinforcement | Shuttering | Finishing | MEP | Earthwork | General." .
bs:crewSize a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Total headcount of the crew type — the sum of its compositions." .
bs:hasComposition a owl:ObjectProperty ;
    rdfs:comment "CrewType → CrewComposition." .
bs:compositionRole a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Mason | Helper | Bar bender | Carpenter | Operator | Supervisor…" .
bs:compositionCount a owl:DatatypeProperty ; rdfs:range xsd:integer .
bs:skillLevel a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Skilled | SemiSkilled | Unskilled — the Indian wage-schedule categories." .

# ── worker + certification ─────────────────────────────────────────────
bs:workerId a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Human-facing id, W-NNNN." .
bs:workerName a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:workerTrade a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:workerAccount a owl:ObjectProperty ;
    rdfs:comment "Optional link to a bs:User, when this worker also has a platform login. Most do not." .
bs:employedBy a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Subcontractor or labour supplier name; the org itself when direct." .
bs:certificationName a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:certifiedWorker a owl:ObjectProperty .
bs:validFrom a owl:DatatypeProperty ; rdfs:range xsd:date .
bs:validUntil a owl:DatatypeProperty ; rdfs:range xsd:date .
bs:certifyingBody a owl:DatatypeProperty ; rdfs:range xsd:string .

# ── productivity measurement ───────────────────────────────────────────
bs:observationId a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:observedActivity a owl:ObjectProperty ;
    rdfs:comment "The bs:Activity the work was booked against." .
bs:observedCrewType a owl:ObjectProperty .
bs:observedQuantity a owl:DatatypeProperty ; rdfs:range xsd:decimal .
bs:observedUnit a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:crewDays a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "headcount × days worked — the denominator of the rate." .
bs:productivityRate a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "observedQuantity ÷ crewDays, i.e. output per person-day. Server-computed; never trusted from the client." .
bs:observedOn a owl:DatatypeProperty ; rdfs:range xsd:date .
bs:workType a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The work-type bucket a norm applies to, matching the P2B phase vocabulary." .

bs:normId a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:normRate a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "Output per person-day for this work type + crew type." .
bs:normSource a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "measured | seeded — a seeded default must never be mistaken for a measured norm, the same posture as BS_Audit.QuantitySource on an enriched IFC." .
bs:observationCount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "How many observations this norm averages. Below MIN_OBSERVATIONS the norm stays 'seeded'." .
bs:normComputedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .

# ── P2A.2 — what a rate rests on, and which projects feed it ───────────
# An organisation's rate pools the steady site days of every project
# PUBLISHED to it. A publication is its own entity, so a project whose
# data is wrong (a test site, a disrupted job) can be withdrawn — with
# who, when and why — and its days leave the rate. All domain-free (#8).
bs:ProductivityContribution a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "A project's site days counted in its organisation's measured rates. Withdrawn by prov:invalidatedAtTime with who and why; publishing again creates a new one." .
bs:contributingProject a owl:ObjectProperty ;
    rdfs:comment "The project whose steady site days count." .
bs:contributedBy a owl:ObjectProperty ;
    rdfs:comment "Who published the project's days to the organisation." .
bs:contributedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
bs:withdrawnBy a owl:ObjectProperty ;
    rdfs:comment "Who took the project's days out of the organisation's rates." .
bs:withdrawnAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
bs:withdrawalReason a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Why the project's days no longer count — kept with the record." .
bs:reportCount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Daily reports of this work type considered for a norm — counted or set aside." .
bs:projectCount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Projects that contributed a counted site day to a norm." .
bs:steadyDayCount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Steady site days behind a norm, before the outlier trim — compared with the reports read now to tell whether the stored rate is behind. Polymorphic — antipattern #8." .
bs:handObservationCount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Observations recorded by hand that a norm also rests on. Polymorphic — antipattern #8." .

# P2A.2 — an organisation's rates are written in one request, claimed by
# compare-and-swap on this token, so two recomputes at once can neither
# leave a rate with two values nor overwrite a newer rate with an older
# one. Concurrency state, not a fact: the token is replaced, and the rates'
# history is the PROV records written beside them.
bs:ProductivityRecompute a owl:Class ;
    rdfs:label "Productivity recompute" ;
    rdfs:comment "The per-organisation claim token for writing measured rates." .
bs:recomputeToken a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The token of the recompute that last wrote the rates. Polymorphic — antipattern #8." .
bs:recomputedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime ;
    rdfs:comment "When the rates were last written. Polymorphic — antipattern #8." .

# ── headcount on the daily report ──────────────────────────────────────
# The field that makes productivity measurable at all: without knowing
# how many people produced the day's quantity, a DPR cannot yield a rate.
bs:crewHeadcount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "People on the job for this DPR entry. Optional — pre-P2A DPRs have none and must stay conformant." .
bs:crewTypeAssigned a owl:ObjectProperty ;
    rdfs:comment "The bs:CrewType that did the work in this DPR entry." .

# ── weather on the daily report (P2A.3) ─────────────────────────────────
# What the weather did to the day's work. A day with hours lost to weather
# is a short day, not a slow one: it is set aside when the organisation's
# measured rate is worked out, as a day without a headcount is. The hours
# are also the raw material of a hindrance record (CPWD Clause 5).
bs:weatherCondition a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The weather on site for this report: Fair | Cloudy | LightRain | HeavyRain | Waterlogged | ExtremeHeat | HighWind. Polymorphic — antipattern #8." .
bs:weatherHoursLost a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "Working hours of this work lost to the weather that day (0–12). Needs a weatherCondition. Polymorphic — antipattern #8." .

# ====================================================================
# N34 — Organisation masters (versioned defaults a project inherits)
# ====================================================================
# One live bs:OrganisationMasters node per organisation, in the org
# catalogue graph. A change writes a NEW version and supersedes the old
# one (prov:invalidatedAtTime) — the history is the audit trail of who
# changed a statutory default and when.
#
# Inheritance rule (locked 2026-09-29): a project SNAPSHOTS the masters
# at creation. A later change reaches a live project only when its PM
# adopts that version (bs:MastersAdoption). Issued RA bills never move —
# each bs:Recovery already stores the rate it was computed with.
#
# The gazette rates themselves (TDS-IT, GST-TDS, BOCW cess) are NOT
# masters — they come from infra/config/statutory_rates.yaml. The
# organisation decides only whether GST-TDS and the cess APPLY to it:
# CGST s.51 TDS binds government bodies and notified persons, not a
# private developer. All properties are domain-free (antipattern #8).

bs:OrganisationMasters a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Organisation masters" ;
    rdfs:comment "One version of an organisation's defaults: contract deductions, deviation routing, financial year and legal identity." .

bs:MastersAdoption a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Masters adoption" ;
    rdfs:comment "A project taking a version of its organisation's masters — at creation or when its PM adopts a newer one." .

bs:mastersVersion a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "1, 2, 3 … per organisation. Version 0 means the platform defaults (never stored)." .
bs:mastersSetAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
bs:mastersNote a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Why this version was made — shown in the history." .
bs:securityDepositPct a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "Retention deducted from each contractor bill, in percent." .
bs:gstTdsApplicable a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:comment "Whether CGST s.51 TDS applies to this organisation (government bodies and notified persons only)." .
bs:labourCessApplicable a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:comment "Whether BOCW cess is deducted from contractor bills (rather than paid at plan approval)." .
bs:deviationThresholdPct a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "Measured quantity above tendered by more than this percent raises a deviation for approval." .
bs:approvalLevel1Limit a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "Deviation value (INR) up to which level 1 approves." .
bs:approvalLevel2Limit a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "Deviation value (INR) up to which level 2 approves; above it, level 3." .
bs:approvalLevel1Label a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:approvalLevel2Label a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:approvalLevel3Label a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Display names only. The stored deviation states stay ApprovedEE / ApprovedSE / ApprovedCE, so a renamed level never orphans an approval." .
bs:fyStartMonth a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Month the financial year begins, 1–12 (India: 4)." .
bs:legalName a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:gstin a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:pan a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:cin a owl:DatatypeProperty ; rdfs:range xsd:string .
bs:adoptedMastersVersion a owl:DatatypeProperty ; rdfs:range xsd:integer .
bs:adoptedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .

# ─────────────────────────────────────────────────────────────────────────
# NIYOJ N35 — Work package: the duration estimate behind each planned activity
# ─────────────────────────────────────────────────────────────────────────
# A committed plan used to keep only the dates. The crew, the rate, whether
# the rate was the organisation's MEASURED figure or a default, and the
# weather/festival allowances were thrown away at commit — so nobody could
# later ask "does this plan fit our organisation?" or compare site output
# with the rate the plan assumed. The estimate is its own entity (not extra
# triples on the activity) so a re-estimate supersedes it under PROV-O and
# the reasoning history survives.
#
# `bs:quantity` is NOT reused: it carries rdfs:domain bs:Measurement, so an
# estimate using it would be inferred to be a Measurement (antipattern #8).
# Reused, all domain-free: bs:forActivity, bs:workType, bs:unit,
# bs:normSource, bs:observationCount, bs:crewSize, bs:scheduleRevision.
bs:ActivityDurationEstimate a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "How a planned activity's duration was reached: quantity, crew, rate and its source, allowances. Superseded, never overwritten." .

bs:estimateId a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Human-facing id, DE-<activity id>. Polymorphic — no rdfs:domain (antipattern #8)." .
bs:plannedQuantity a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "The quantity the activity is planned to deliver, in bs:unit. Distinct from bs:quantity (a measurement). No rdfs:domain." .
bs:crewCount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Parallel crews assumed. No rdfs:domain." .
bs:crewDescription a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The standard crew the rate refers to, e.g. '1 mason gang (12)'. No rdfs:domain." .
bs:dailyOutput a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "Output of ONE standard crew per working day, in bs:unit — the rate the duration used. No rdfs:domain." .
bs:seededDailyOutput a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "The default (CPWD-style) crew-day output, kept beside a measured rate so the difference stays visible. No rdfs:domain." .
bs:baseDays a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Working days before allowances: quantity ÷ (daily output × crews). No rdfs:domain." .
bs:weatherPadPct a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "Monsoon/heat allowance as a fraction of base days, for the window the activity actually occupies. No rdfs:domain." .
bs:labourPadPct a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "Festival/harvest labour allowance as a fraction of base days. No rdfs:domain." .
bs:finalDays a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Planned duration after allowances. No rdfs:domain." .
bs:durationBasis a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The plain-language reason for the duration, as the planner explained it. No rdfs:domain." .
bs:estimatedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime ;
    rdfs:comment "When the estimate was made. No rdfs:domain." .

# ─────────────────────────────────────────────────────────────────────────
# NIYOJ N38 — Planning a project from its own building models
# ─────────────────────────────────────────────────────────────────────────
# A model plan cuts each BOQ line into one activity PER FLOOR (and per layer,
# and per split the planner approved). Two things the older one-activity-per-
# BOQ-line bridge could not carry:
#
#  * Budget. EVM gave every activity the WHOLE amount of every BOQ line linked
#    to it, so linking one line to its five floor activities would count the
#    line five times in BAC. A floor activity instead records its own SHARE —
#    bs:budgetedCost / bs:budgetedQuantity — and names the line it is a share
#    of with bs:boqShareOf (deliberately NOT bs:linkedActivity, which EVM
#    sums in full). Shares of a line add up to the line's amount exactly.
#  * Element scope. 4D resolved an activity's elements through its BOQ line,
#    so every floor would light up the whole building. The activity now
#    carries bs:hasIFCScope itself (the S3.3 predicate is domain-free), and an
#    activity's own scope wins over its line's.
#
# All three new predicates are domain- and range-free (antipattern #8); a
# range on boqShareOf would make RDFS infer the target is a bs:BOQItem and
# run BOQItemShape against a node the activity's turtle does not carry.
bs:boqShareOf a owl:ObjectProperty ;
    rdfs:comment "The BOQ line this activity delivers a share of. EVM does NOT sum the line's amount through this link — the activity's own bs:budgetedCost is its budget. No rdfs:domain / rdfs:range (antipattern #8)." .
bs:budgetedCost a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "The activity's share of its BOQ line's amount (₹), by quantity. The shares of one line sum to the line's amount exactly. No rdfs:domain." .
bs:budgetedQuantity a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "The quantity the activity delivers, in its BOQ line's unit — the denominator of its percent complete in EVM. No rdfs:domain." .

# A decision a person took about the plan, recorded with who took it and
# when. N38 records the corrections a planner approved on a model plan (and
# the flags they chose to keep as planned); N36 widens the same entity to
# every open question on a project. A Decided decision must name its decider
# and time — "who approved this sequence?" is exactly the question a delay
# claim asks two years later.
bs:Decision a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "A question about the project and the answer a named person gave to it." .

bs:decisionId a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Human-facing id, DEC-NNNN. No rdfs:domain." .
bs:decisionQuestion a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "What had to be decided, in plain language. No rdfs:domain." .
bs:decisionText a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "What was decided. No rdfs:domain." .
bs:decisionBasis a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Why — the rule or evidence the decision rests on. No rdfs:domain." .
bs:decisionStatus a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Open | Decided | Superseded | Withdrawn. No rdfs:domain." .
bs:decisionSource a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Where the question came from, e.g. plan-check. No rdfs:domain." .
bs:decidedBy a owl:ObjectProperty ;
    rdfs:comment "The person who took the decision. No rdfs:domain / rdfs:range (antipattern #8)." .
bs:affectsActivity a owl:ObjectProperty ;
    rdfs:comment "An activity the decision changes. Repeatable. No rdfs:domain / rdfs:range." .

# ─────────────────────────────────────────────────────────────────────────────
# NIYOJ N36 — Decisions and readiness
# ─────────────────────────────────────────────────────────────────────────────
# N36 widens bs:Decision from the plan-check corrections of N38 to every open
# question on a project — the PMBOK decision log: what must be decided, who
# must decide it (bs:owner) and by when (bs:dueDate), the options, and then
# who decided what and why. It reuses bs:owner, bs:dueDate, bs:raisedBy and
# bs:raisedAt (all domain-free). A revised decision is a NEW decision that
# prov:wasRevisionOf the old one, which becomes Superseded — the history of a
# decision is the record a delay claim reads. A withdrawn question keeps who
# withdrew it and why in bs:decidedBy / bs:decidedAt / bs:decisionText.

bs:decisionOptions a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The options considered, in plain language. No rdfs:domain." .

# A constraint is what must be cleared before a planned activity can be done
# as planned — the Last Planner constraint log. Its FLOW names which of the
# preconditions of sound work it concerns (Koskela): prerequisite work,
# information, materials, labour, equipment, space and access, or external
# conditions (approvals, weather, utilities). It has an owner and a need-by
# date (the last responsible moment) and affects one or more activities;
# readiness reads it. Cleared or withdrawn by a named person, with when —
# a withdrawn constraint says why (bs:closureNote).
bs:Constraint a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "Something that must be cleared, by a named person and date, before planned work can proceed." .

bs:constraintId a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Human-facing id, CON-NNNN. No rdfs:domain." .
bs:constraintText a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "What must be cleared, in plain language. No rdfs:domain." .
bs:constraintFlow a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "PrerequisiteWork | Information | Materials | Labour | Equipment | Space | External. No rdfs:domain." .
bs:constraintStatus a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Open | Cleared | Withdrawn. No rdfs:domain." .

# Register numbers (DEC-NNNN, CON-NNNN) are issued from a per-project sequence
# node advanced by a compare-and-swap update — atomic across API processes,
# where MAX+1 over the graph could hand two writers one number (and two nodes
# with one URI merge silently).
bs:IdSequence a owl:Class ;
    rdfs:comment "The last number issued for one kind of register id in one project." .
bs:lastIssued a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "The last number issued from a sequence. No rdfs:domain." .
bs:lastClaim a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "One-off token of the writer that last advanced a sequence. No rdfs:domain." .

# What a change changed, value by value — kept on the change's PROV activity,
# because the old value is gone from the node: who owned a question before it
# was handed on, what its due date was before it slipped.
bs:hadChange a owl:ObjectProperty ;
    rdfs:comment "A property this activity changed on the node it used. No rdfs:domain." .
bs:changedProperty a owl:ObjectProperty ;
    rdfs:comment "The property that changed. No rdfs:domain." .
bs:valueBefore a rdf:Property ;
    rdfs:comment "A value the property had before the change (IRI or literal). No rdfs:domain." .
bs:valueAfter a rdf:Property ;
    rdfs:comment "A value the property has after the change (IRI or literal). No rdfs:domain." .

# ──────────────────────────────────────────────────────────────────────
# NIYOJ N39 — Rate analysis (the analysis of rates under a BOQ line)
# ──────────────────────────────────────────────────────────────────────
# A BOQ line's unit rate, built up from what the work consumes: labour and
# plant from a gang and its output per gang-day, materials per unit, then
# percentage additions (water charges, contractor's profit and overheads),
# in the order a CPWD analysis of rates lists them. The organisation keeps a
# book of basic rates (wages, material prices, plant hire) and a library of
# standard analyses; a project copies what it uses and keeps one price per
# resource. Every property below is domain-free (antipattern #8). Reused:
# bs:unit, bs:workType, bs:ofProject, bs:forBOQItem (S3.7, domain-free).

bs:CostResource a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "An entry in an organisation's book of basic rates: a trade, material, plant item or other cost with its unit and current rate." .
bs:resourceCode a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The organisation's code for a cost resource, e.g. MAT-CEMENT-OPC53. Lines and project prices refer to it. No rdfs:domain." .
bs:resourceName a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "What the resource is, e.g. 'Cement OPC 53 grade, 50 kg bag'. No rdfs:domain." .
bs:resourceKind a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Labour | Material | Plant | Carriage | Other. No rdfs:domain." .
bs:basicRate a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "The organisation's current rate per unit, in rupees. Absent = not priced yet (never read as zero). No rdfs:domain." .
bs:rateAsOf a owl:DatatypeProperty ; rdfs:range xsd:date ;
    rdfs:comment "The date a rate was last confirmed. No rdfs:domain." .
bs:rateSource a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Where a rate came from: a supplier quote, a purchase order, a published schedule. No rdfs:domain." .

bs:RateAnalysis a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "One version of an analysis of rates: a library analysis the organisation keeps, or the analysis behind one BOQ line of a project. A save writes a new version and supersedes the old one." .
bs:analysisId a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Human-facing id: RL-NNNN in the organisation library, RA-NNNN in a project. Shared by every version. No rdfs:domain." .
bs:analysisVersion a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Version number of an analysis, from 1. No rdfs:domain." .
bs:analysisTitle a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The work the analysis prices, in plain words. No rdfs:domain." .
bs:analysisScope a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "library | project. No rdfs:domain." .
bs:analysedQuantity a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "The quantity the details of cost are for (a CPWD analysis is often for 10 m² or 1 quintal); the rate per unit is the total divided by it. No rdfs:domain." .
bs:gangOutput a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "What one gang produces in a day, in the analysis unit. Labour and plant per unit = gang size ÷ this. No rdfs:domain." .
bs:outputSource a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "typed | measured | library — where the gang output came from; measured means the organisation's own site productivity (P2A). No rdfs:domain." .
bs:outputObservations a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "How many measured site days stand behind a measured output. No rdfs:domain." .
bs:fromLibraryAnalysis a owl:ObjectProperty ;
    rdfs:comment "The library analysis version a project analysis was copied from. No rdfs:domain." .
bs:analysisSource a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Where the coefficients come from, e.g. a published analysis of rates or the organisation's own; never blank, so a figure can be traced. No rdfs:domain." .
bs:analysisNote a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Why this version was saved. No rdfs:domain." .

bs:AnalysisLine a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "One resource line of an analysis version." .
bs:inAnalysis a owl:ObjectProperty ;
    rdfs:comment "The analysis version a line or addition belongs to. No rdfs:domain." .
bs:lineOrder a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Position of a line or addition within its analysis, from 1. No rdfs:domain." .
bs:lineKind a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "gang: the quantity is how many of the resource are in the gang (per unit = count × analysed quantity ÷ gang output); perUnit: the quantity is per analysed quantity. No rdfs:domain." .
bs:lineQuantity a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "The gang count or the quantity per analysed quantity, by bs:lineKind. No rdfs:domain." .

bs:AnalysisAddition a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "A percentage added to an analysis in order, on a stated base — water charges on cost, contractor's profit and overheads on the running total." .
bs:additionLabel a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "What the addition is for. No rdfs:domain." .
bs:additionPercent a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "The percentage, 0 to 100. No rdfs:domain." .
bs:additionBase a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Labour | Material | Plant | Cost (all lines) | Running (all lines and every earlier addition). No rdfs:domain." .

bs:ProjectResourcePrice a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "The one rate a project uses for a resource. Copied from the organisation's basic rates when first used; changed only by a person, and every change is recorded." .
bs:priceRate a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "The project's rate per unit, in rupees. No rdfs:domain." .
bs:priceSource a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Where the project's rate came from. No rdfs:domain." .
bs:priceAsOf a owl:DatatypeProperty ; rdfs:range xsd:date ;
    rdfs:comment "The date the project's rate was set. No rdfs:domain." .

bs:rateFromAnalysis a owl:ObjectProperty ;
    rdfs:comment "On a BOQ line: the analysis version whose rate was applied to it. No rdfs:domain." .

bs:changedSubject a owl:ObjectProperty ;
    rdfs:comment "Which node a change record is about, when one activity changes several (a BOQ rate and the activity budgets split from it). No rdfs:domain." .

# ──────────────────────────────────────────────────────────────────────
# NIYOJ N40 — CPWD analyses imported from VIDHI
# ──────────────────────────────────────────────────────────────────────
# VIDHI (BIMSaarthi's knowledge core) serves CPWD Delhi Analysis of Rates
# analyses over MCP (VIDHI ADR 005). An organisation imports one into its
# rate library: the coefficients come from VIDHI, the prices stay its own.
# Each imported version says exactly which VIDHI record and version it came
# from; a person's edit drops that, so an edited analysis is never mistaken
# for (or overwritten by) the source. Every property is domain-free
# (antipattern #8).

bs:importedFrom a owl:ObjectProperty ;
    rdfs:comment "The outside record (a VIDHI rate-analysis or basic-rate record IRI) an analysis version or a resource was imported from. No rdfs:domain." .
bs:importedRecordVersion a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The outside record's content version at import, e.g. sha256:… — the key for 'already imported, unchanged'. No rdfs:domain." .
bs:importedEdition a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The source edition, e.g. cpwd-dar-2023. No rdfs:domain." .
bs:importedItemCode a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The source's own code: the CPWD item number of an analysis, the DAR resource code of a resource. No rdfs:domain." .
bs:sourceCitation a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Document, edition, volume, page and item of the printed source, in words a quantity surveyor can look up. No rdfs:domain." .
bs:importedReviewState a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The source's review state at import: proposed (machine-extracted, not approved by an engineer) or approved. No rdfs:domain." .
bs:importedCheckStatus a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The source's arithmetic check at import: reconciled, reconciled_with_unchecked or flagged. No rdfs:domain." .
bs:importedDescription a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The source item's full description, kept because a title is shortened. No rdfs:domain." .

bs:lineGroup a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "A group letter on an analysis line (CPWD marks lines that use another item's rate with 'A'), so an addition can leave the group out. No rdfs:domain." .
bs:lineNote a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "What the source printed for a line, when it differs from the resource's name (or several source lines merged into one). No rdfs:domain." .
bs:excludesGroup a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "On an addition with a Cost or Running base: a line group left out of the base, as CPWD writes 'Add 15% CPOH on Y-A'. Repeatable. No rdfs:domain." .

bs:ResourceMapping a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "Which of the organisation's resources a code of an outside source stands for (a CPWD DAR resource code, a cited CPWD item). Chosen by a person, never guessed; a change supersedes the old mapping." .
bs:externalScheme a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The code list an external code belongs to, e.g. cpwd-dar-resource. No rdfs:domain." .
bs:externalCode a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "A code of an outside source, e.g. the DAR resource code 0114. No rdfs:domain." .

# ─────────────────────────────────────────────────────────────────────
# P2B.8 — Schedule baselines: the approved programme and its revisions
# (CPWD GCC 2023 Clause 5). All properties are domain-free
# (antipattern #8). Entries carry predicates of their own — never
# bs:activityId / bs:plannedStartDate — so a frozen copy is never read
# as a live activity.
# ─────────────────────────────────────────────────────────────────────

bs:ScheduleBaseline a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "A frozen copy of the programme. Baseline 0 is the approved programme (Clause 5.1); later ones are revised programmes (Clause 5.4), each with its basis, reason and approver. Never changed or removed; the newest is the active baseline that variance and planned value are measured against." .

bs:BaselineEntry a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "One activity as a baseline froze it: its start, last day and budget then." .

bs:baselineNo a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "0 for the approved programme; 1, 2 … for revisions. No rdfs:domain." .
bs:baselineLabel a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "A human name, e.g. \"Approved programme\", \"Revised programme 1\". No rdfs:domain." .
bs:baselineBasis a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "ApprovedProgramme (Clause 5.1) | AgreedAmendment (the programme amended by agreement, 5.1) | ExtensionOfTime (5.2 / 5.3: extension granted, milestones rescheduled). No rdfs:domain." .
bs:baselineReason a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Why the programme was revised. No rdfs:domain." .
bs:eotClause a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The Clause 5 sub-clause an extension of time was granted under: 5.2 (beyond the contractor's control) or 5.3 (hindrance by the department). No rdfs:domain." .
bs:extensionDays a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Days of extension granted. No rdfs:domain." .
bs:dataDate a owl:DatatypeProperty ; rdfs:range xsd:date ;
    rdfs:comment "The day a programme was taken as of: the progress it reflects. No rdfs:domain." .
bs:baselineStartDate a owl:DatatypeProperty ; rdfs:range xsd:date ;
    rdfs:comment "The baseline's first planned day. No rdfs:domain." .
bs:baselineFinishDate a owl:DatatypeProperty ; rdfs:range xsd:date ;
    rdfs:comment "The baseline's last planned day — its completion date. No rdfs:domain." .
bs:stipulatedFinishDate a owl:DatatypeProperty ; rdfs:range xsd:date ;
    rdfs:comment "The completion date the contract stipulates while this baseline is in force: the approved programme's last day plus every extension of time granted (CPWD Clause 5.2/5.3). Clause 5.4's 10% is of the period to this date. An agreed amendment does not move it. No rdfs:domain." .
bs:entryCount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "How many activities a baseline froze. No rdfs:domain." .
bs:baselineWriteToken a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "Concurrency state, not a fact: proves which of two simultaneous approvals was written. No rdfs:domain." .
bs:inBaseline a owl:ObjectProperty ;
    rdfs:comment "The baseline an entry belongs to. No rdfs:domain." .
bs:baselineOf a owl:ObjectProperty ;
    rdfs:comment "The live activity an entry froze. No rdfs:domain." .
bs:baselineActivityId a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The activity's id when frozen. No rdfs:domain." .
bs:baselineActivityName a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:comment "The activity's name when frozen. No rdfs:domain." .
bs:baselineStart a owl:DatatypeProperty ; rdfs:range xsd:date ;
    rdfs:comment "The activity's first day in the baseline. No rdfs:domain." .
bs:baselineLastDay a owl:DatatypeProperty ; rdfs:range xsd:date ;
    rdfs:comment "The activity's last day in the baseline (inclusive). No rdfs:domain." .
bs:baselineDurationDays a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Calendar days, first to last inclusive. No rdfs:domain." .
bs:baselineCost a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "The activity's budget when frozen, in rupees. No rdfs:domain." .

# ---------- NIYOJ N41.1 — which model's copy of the work counts ----------
# A federated take-off counts work modelled in two discipline files once,
# from the responsible model (ifc/dedupe.py): the architect's copy of a
# structural slab, the MEP model's copy of the plumbing runs. The copy's
# quantity leaves the BOQ, so no line and no activity names the copy. These
# record, on the copy, what counted it — so the element card can say which
# work package builds it instead of "none". Written when the take-off is
# priced, and only for a copy that is itself unpriced while something it
# was counted as is priced.

bs:countedAsElement a owl:DatatypeProperty ;
    rdfs:label "counted as element" ;
    rdfs:range xsd:string ;
    rdfs:comment "On a bs:Element whose work another model also carries: the IFC GlobalId of an element of the model the take-off counted it from — the same work, occupying the same space. Repeatable (a placeholder slab is counted as the planks under it). A literal GlobalId, because that is how BOQ lines and activities scope their elements (bs:hasIFCScope). Polymorphic — no rdfs:domain (antipattern #8)." .

bs:countedInModel a owl:ObjectProperty ;
    rdfs:label "counted in model" ;
    rdfs:comment "On a bs:Element whose work another model also carries: the bs:IfcModel whose copy the take-off counted. No rdfs:domain." .

bs:ElementCopiesRecorded a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "element copies recorded" ;
    rdfs:comment "N41.1 — the act of keeping, on each copy, which model's element the take-off counted it as. Carries the person, the time, the take-off it came from (rdfs:comment) and how many elements changed; each changed element points back at it (prov:wasInfluencedBy)." .

bs:elementsRecorded a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:comment "How many elements an ElementCopiesRecorded activity changed. No rdfs:domain." .

# ---------- NIYOJ N41.2 — one element node per element ----------
# Until N41.2 the IFC parser indexed an element once for every listed class
# it belongs to (an IfcWallStandardCase as IfcWall too; every IfcFlowSegment,
# Fitting and Terminal as IfcDistributionElement too), so a graph held two
# bs:Element nodes for one element of one model revision. The parser keeps
# each GlobalId once now; a startup migration retires the extra nodes already
# stored — append-only: the most specific node survives, every relation on
# the other moves to it, and the other is stamped invalidated.

bs:duplicateOf a owl:ObjectProperty ;
    rdfs:label "duplicate of" ;
    rdfs:comment "On a retired bs:Element: the node that carries the same element (same GlobalId, same model revision) now. The retired node keeps only its identity and generation triples. No rdfs:domain." .

bs:ElementDuplicatesRetired a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "element duplicates retired" ;
    rdfs:comment "N41.2 — the startup migration retiring, in one project graph, the extra element nodes the pre-N41.2 parser wrote. Carries when it started and ended, how many nodes it retired, and (bs:hadChange) each model element count it corrected from the duplicated count to the number of distinct elements." .

bs:elementsRetired a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:comment "How many element nodes an ElementDuplicatesRetired activity retired. No rdfs:domain." .

# ---------------------------------------------------------------------------
# NIYOJ N42 — Steel member IS identity from VIDHI (VIDHI ADR 013,
# contract vidhi.element-identity/1)
# ---------------------------------------------------------------------------
# VIDHI decides a steel member's IS-code identity (IS 808 section or
# "foreign", grade, IS 800 classification); NIYOJ stores VIDHI's answer and
# never decides one itself. One node per distinct member description of one
# model: the members it covers are named by their IFC GlobalId (bs:ifcGuid,
# repeated). The answer is kept as JSON (the bs:readinessJson precedent),
# less every value VIDHI marks may_store:false (printed IS 808 values: BIS
# copyright counsel is open). A result nobody has approved carries its
# label, and NIYOJ shows it wherever the result is used. Append-only: a new
# run supersedes the model's previous identities (prov:invalidatedAtTime).
# Every property below is rdfs:domain-free (antipattern #8).

bs:MemberIdentity a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "VIDHI's IS-code identity of the steel members of one model that NIYOJ described identically." .

bs:inputSha256 a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "VIDHI's hash of the question it answered (sha256:…). No rdfs:domain." .

bs:memberSignature a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "NIYOJ's hash of the member description it sent (sha256:…): identical descriptions are asked once. No rdfs:domain." .

bs:contentVersion a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "VIDHI's content version of an answer (sha256:…); it excludes the review state, so a review changes the label, not the version. No rdfs:domain." .

bs:reviewState a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "VIDHI's review state of an answer: proposed or approved. No rdfs:domain." .

bs:reviewLabel a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "The label shown wherever the answer is shown or used (e.g. 'proposed, not approved by a reviewer'). No rdfs:domain." .

bs:sectionStatus a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "is808_exact | is808_ambiguous | measurement_too_uncertain | foreign | unidentified | inconsistent | not_in_catalogue; absent when VIDHI refused the member whole. No rdfs:domain." .

bs:sectionDesignation a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "The IS 808 designation VIDHI named, on an exact fit only. No rdfs:domain." .

bs:gradeStatus a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "is2062 | foreign_stated | stated_strength | assumed | not_stated | unrecognised; absent when VIDHI refused the member whole. No rdfs:domain." .

bs:identityJson a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "VIDHI's answer as JSON, less every value marked may_store:false. No rdfs:domain." .

bs:vidhiContract a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "The VIDHI contract an answer was given under (vidhi.element-identity/1). No rdfs:domain." .

bs:identifiedAt a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:comment "When NIYOJ asked VIDHI. No rdfs:domain." .
